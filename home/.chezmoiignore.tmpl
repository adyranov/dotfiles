{{- if not .secrets.age }}
{{- /* With encryption unconfigured, chezmoi's NoEncryption.EncryptedSuffix() is
     "", so the .age suffix is NOT stripped: the computed target of an
     encrypted_*.age source keeps .age, and only the catch-all pattern below
     drops it before apply tries to decrypt (the "encryption not configured"
     failure). The stripped names below are not dead code: they protect the
     decrypted targets applied on age-on hosts from exact_ directory pruning. */}}
**/*.age
.config/docker/buildkitd/buildkitd.work.toml
.config/git/work
.config/git/work-user
.config/maven/work.settings.xml
.config/ssh/config.d/personal.conf
.config/ssh/config.d/work.conf
.local/share/mkcert/readonly_rootCA-key.pem
.local/share/mkcert/rootCA.pem
{{- end }}
