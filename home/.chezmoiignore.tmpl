README.md
install.sh
.keys
.chezmoiscripts/*/**
!.chezmoiscripts/before/**
!.chezmoiscripts/common/**
!.chezmoiscripts/os/{{ .host.distro.id }}/**
!.chezmoiscripts/profile/{{ .host.profile }}/**
!.chezmoiscripts/post/**
{{- if .toolchains.ai }}
!.chezmoiscripts/toolchains/ai/**
{{- end }}
{{- if .toolchains.java }}
!.chezmoiscripts/toolchains/java/**
{{- end }}
{{- if ne .host.distro.family "darwin" }}
Library
{{- end }}
{{- if not .secrets.age }}
**/*.age
{{- end }}
{{- if not .toolchains.ai }}
.agents
.config/agents/**
.config/llama-swap/**
.config/skypilot/**
.config/runpod/**
.config/zsh/functions.d/skyl
.runpod
.local/bin/llm-serve
.local/share/dotfiles/test/test-ai-*.bats
{{- end }}
{{- /* Per-agent toolchains: stop managing (and --remove can prune) the whole agent tree. */ -}}
{{- if not (get .toolchains "pi" | default false) }}
.config/pi/**
.local/bin/pi-agent
{{- end }}
{{- if not (get .toolchains "opencode" | default false) }}
.config/opencode/**
.local/bin/opencode-agent
{{- end }}
{{- if not (get .toolchains "omp" | default false) }}
.config/omp/**
.local/bin/omp-agent
{{- end }}
{{- $hasPi := get .toolchains "pi" | default false -}}
{{- $hasOc := get .toolchains "opencode" | default false -}}
{{- $hasOmp := get .toolchains "omp" | default false -}}
{{- if and (not $hasPi) (not $hasOc) (not $hasOmp) }}
.local/bin/agent-launch
{{- end }}
.gitkeep
