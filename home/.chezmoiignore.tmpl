.config/agents/**
.config/dcg/**
.config/llama-swap/**
.config/nono/**
.config/skypilot/**
.config/runpod/**
.config/zsh/functions.d/skyl
.runpod
.local/bin/llm-serve
.local/share/dotfiles/test/test-ai-*.bats
{{- end }}
{{- /* Per-agent toolchains: stop managing (and --remove can prune) the whole agent tree. */ -}}
{{- if not (get .toolchains "pi" | default false) }}
.config/pi/**
{{- end }}
{{- if not (get .toolchains "opencode" | default false) }}
.config/opencode/**
{{- end }}
{{- if not (get .toolchains "omp" | default false) }}
.config/omp/**
{{- end }}
{{- /* Launcher gate: manage ~/.local/bin/agent while any agent toolchain is
       enabled; keep this predicate in sync with the launcher's agent set. */ -}}
{{- if not (or (get .toolchains "pi" | default false) (get .toolchains "opencode" | default false) (get .toolchains "omp" | default false)) }}
.local/bin/agent
{{- end }}
