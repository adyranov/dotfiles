{{- if .toolchains.kubernetes -}}
{{- includeTemplate "base/headers/script" (dict "root" .) -}}


# Bash 3.2-compatible: indexed parallel arrays instead of an associative array
declare -a HELM_PLUGIN_NAMES=()
declare -a HELM_PLUGIN_URLS=()
{{- $packages := splitList " " (includeTemplate "base/packages/collect-packages" (dict "root" . "manager" "helm" "format" "install")) -}}
{{- range $pkg := $packages -}}
{{- if ne $pkg "" }}
  {{- $basename := regexReplaceAll ".*\\/([^/]+?)(\\.git)?$" $pkg "${1}" }}
  {{- $name := regexReplaceAll "^helm-" $basename "" }}
HELM_PLUGIN_NAMES+=("{{ $name }}")
HELM_PLUGIN_URLS+=("{{ $pkg }}")
{{- end -}}
{{- end }}

echo "☸️  Ensuring Helm plugins..."

# Collect currently installed plugins
installed=()
while IFS= read -r line; do
    [[ -n "$line" ]] && installed+=("$line")
done < <(helm plugin list | awk 'NR>1 {print $1}')

# Install declared plugins
for i in "${!HELM_PLUGIN_NAMES[@]}"; do
    name="${HELM_PLUGIN_NAMES[$i]}"
    url="${HELM_PLUGIN_URLS[$i]}"
    if printf '%s\n' ${installed[@]+"${installed[@]}"} | grep -qx "$name"; then
        echo "  ✅ Already installed: $name"
    else
        echo "  ↳ Installing: $name"
        install_output=$(helm plugin install "$url" --verify=false 2>&1) || {
            if echo "$install_output" | grep -qi "already exists"; then
                echo "    ⚠️  Stale plugin directory detected, removing..."
                plugin_dir="${HELM_PLUGINS_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/helm/plugins}"
                # Remove both possible directory names (helm-<name> and <name>)
                rm -rf "$plugin_dir/helm-$name" "$plugin_dir/$name"
                helm plugin install "$url" --verify=false || {
                    echo "  ❌ Failed to reinstall: $name" >&2
                    exit 1
                }
            else
                echo "$install_output" >&2
                echo "  ❌ Failed to install: $name" >&2
                exit 1
            fi
        }
    fi
done

# Remove undeclared plugins
for name in ${installed[@]+"${installed[@]}"}; do
    if ! printf '%s\n' ${HELM_PLUGIN_NAMES[@]+"${HELM_PLUGIN_NAMES[@]}"} | grep -qx "$name"; then
        echo "  🗑️ Removing undeclared plugin: $name"
        helm plugin uninstall "$name"
    fi
done

echo "✅ Helm plugins ensured."
{{- end -}}
