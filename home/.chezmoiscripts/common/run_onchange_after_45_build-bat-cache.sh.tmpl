{{- includeTemplate "base/headers/script" (dict "root" .) -}}
# bat config/theme hash: {{ include "private_dot_config/exact_bat/config" | sha256sum }} {{ include ".chezmoiexternals/themes.toml.tmpl" | sha256sum }}
# bat version: {{ output "sh" "-c" "bat --version 2>/dev/null || true" | trim }}

bat_bin=""
if command -v bat >/dev/null 2>&1; then
  bat_bin=bat
fi

if [ -z "$bat_bin" ]; then
  exit 0
fi

echo "🦇 Rebuilding bat syntax/theme cache..."
"$bat_bin" cache --build
echo "✅ bat cache rebuilt."
