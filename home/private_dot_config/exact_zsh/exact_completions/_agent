#compdef agent
# zsh completion for the agent launcher (~/.local/bin/agent).
# Level 1: agent names and aliases; level 2: the launcher flags. The launcher
# has no named profiles: any other word or flag is forwarded to the agent
# binary and is not completed here. claude's -w is the native-worktree
# opt-in.

if (( CURRENT == 2 )); then
  _values 'agent' 'pi' 'oc' 'opencode' 'omp' 'claude' 'cc'
  return
fi

case "${words[2]}" in
  claude|cc)
    _values 'agent flags' \
      '-h' '--help' '--print-env' '--no-sandbox' '-w'
    ;;
  *)
    _values 'agent flags' \
      '-h' '--help' '--print-env' '--no-sandbox'
    ;;
esac
