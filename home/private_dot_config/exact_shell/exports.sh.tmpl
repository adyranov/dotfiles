#!/usr/bin/env sh
# Shell environment orchestrator.
#
# Order owned by this file:
#   1. XDG base dirs
#   2. Locale
#   3. Tool dirs consumed by PATH composition or mise activate
#   4. Homebrew shell environment (defines HOMEBREW_PREFIX)
#   5. Drop-in fragments from exports.d/ (order-independent)
#   6. PATH composition (consumes HOMEBREW_PREFIX, MacPorts, and the dirs above)
#   7. mise activate (must be last; prepends shims to PATH)
#
# Per-tool XDG redirections (passive: declared in exports.d/, read by external
# tools, never consumed by the orchestrator itself). Drop-ins under exports.d/
# MUST be order-independent
# and MUST NOT mutate PATH.

# https://wiki.archlinux.org/index.php/XDG_Base_Directory
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_STATE_HOME="$HOME/.local/state"
{{- if eq .host.distro.family "darwin" }}
[ -z "${XDG_RUNTIME_DIR:-}" ] && [ -n "${TMPDIR:-}" ] && export XDG_RUNTIME_DIR="$TMPDIR"
{{- else if .host.interactive }}
if [ -z "${XDG_RUNTIME_DIR:-}" ]; then
  if [ -d "/run/user/$(id -u)" ]; then
    export XDG_RUNTIME_DIR="/run/user/$(id -u)"
  else
    export XDG_RUNTIME_DIR="/tmp"
  fi
fi
{{- else }}
[ -z "${XDG_RUNTIME_DIR:-}" ] && export XDG_RUNTIME_DIR="/tmp"
{{- end }}
{{- if .host.interactive }}
export XDG_MUSIC_DIR="$HOME/Music"
export XDG_VIDEOS_DIR="$HOME/Videos"
export XDG_DESKTOP_DIR="$HOME/Desktop"
export XDG_PICTURES_DIR="$HOME/Pictures"
export XDG_DOWNLOAD_DIR="$HOME/Downloads"
export XDG_DOCUMENTS_DIR="$HOME/Documents"
export XDG_TEMPLATES_DIR="$HOME/Templates"
export XDG_PUBLICSHARE_DIR="$HOME/Public"
{{- end }}

# Language
export LANG="en_US.UTF-8"
export LC_ALL="en_US.UTF-8"

# Tool dirs consumed by PATH composition / mise activate below.
# cargo (and let mise reuse this CARGO_HOME for its rust backend)
export CARGO_HOME="$XDG_DATA_HOME/cargo"
export MISE_CARGO_HOME="$CARGO_HOME"
# go
export GOPATH="$XDG_DATA_HOME/go"
export GOBIN="$GOPATH/bin"
export GOPROXY="https://proxy.golang.org,direct"
# rustup (and let mise reuse this RUSTUP_HOME for its rust backend)
export RUSTUP_HOME="$XDG_DATA_HOME/rustup"
export MISE_RUSTUP_HOME="$RUSTUP_HOME"
# Executed caches kept outside ~/.cache so agent sandboxes cannot plant host code.
export PREK_HOME="$XDG_DATA_HOME/prek"
export PRE_COMMIT_HOME="$XDG_DATA_HOME/pre-commit"
export UV_CACHE_DIR="$XDG_DATA_HOME/uv-cache"

# Homebrew shell environment (defines HOMEBREW_PREFIX; consumed by PATH below).
{{- if and (eq .host.distro.family "darwin") (stat .brew.path) }}
{{ output .brew.path "shellenv" -}}
{{- if .host.restricted }}
export HOMEBREW_CASK_OPTS="--appdir=~/Applications"
{{- end }}
{{- end }}

# Order-independent drop-ins.
EXPORTS_D_DIR="$XDG_CONFIG_HOME/shell/exports.d"
if [ -d "$EXPORTS_D_DIR" ]; then
  for EXPORTS_FILE in "$EXPORTS_D_DIR"/*; do
    [ -r "$EXPORTS_FILE" ] || continue
    # shellcheck source=/dev/null
    . "$EXPORTS_FILE"
  done
  unset EXPORTS_FILE
fi
unset EXPORTS_D_DIR

# PATH composition (depends on HOMEBREW_PREFIX, CARGO_HOME, GOBIN).
add_to_path() {
  case ":$PATH:" in
    *:"$1":*) ;;
    *) export PATH="$1:$PATH" ;;
  esac
}

{{- if eq .host.distro.family "darwin" }}
{{- if eq .host.arch "amd64" }}
add_to_path "/opt/local/libexec/gnubin"
# Intel ownership policy: MacPorts-owned commands precede Homebrew's.
add_to_path "/opt/local/sbin"
add_to_path "/opt/local/bin"
{{- else }}
add_to_path "$HOMEBREW_PREFIX/opt/coreutils/libexec/gnubin"
{{- end }}
{{- end }}
add_to_path "$XDG_DATA_HOME/npm/bin"
add_to_path "$GOBIN"
add_to_path "$CARGO_HOME/bin"
add_to_path "$HOME/.local/bin"

unset -f add_to_path

# Source a tool's init script from a cache under $XDG_DATA_HOME (never ~/.cache:
# agents can write there). The first line records the binary path; the cache is
# rebuilt when that path changes or the binary is newer. Also used by interactive.sh.
# Usage: _source_cached_init <tool> <shell> <command...>
_source_cached_init() {
  _ci_tool="$1"
  _ci_sh="$2"
  shift 2
  _ci_bin="$(command -v "$_ci_tool" 2>/dev/null)" || return 0
  _ci_key="# bin: ${_ci_bin}"
  _ci_dir="${XDG_DATA_HOME:-$HOME/.local/share}/shell/init"
  _ci_file="${_ci_dir}/${_ci_tool}.${_ci_sh}"
  _ci_first=""
  [ -r "$_ci_file" ] && { IFS= read -r _ci_first <"$_ci_file" || true; }
  # shellcheck disable=SC3013
  if [ -r "$_ci_file" ] && [ "$_ci_first" = "$_ci_key" ] && [ ! "$_ci_bin" -nt "$_ci_file" ]; then
    # shellcheck source=/dev/null
    . "$_ci_file"
  else
    [ -d "$_ci_dir" ] || { mkdir -p "$_ci_dir" && chmod 700 "${_ci_dir%/init}"; } 2>/dev/null
    _ci_tmp="${_ci_file}.tmp.$$"
    if { printf '%s\n' "$_ci_key" && "$@"; } 2>/dev/null >"$_ci_tmp" && [ -s "$_ci_tmp" ]; then
      mv -f "$_ci_tmp" "$_ci_file"
      # shellcheck source=/dev/null
      . "$_ci_file"
    else
      rm -f "$_ci_tmp" 2>/dev/null
      eval "$("$@")"
    fi
  fi
  unset _ci_tool _ci_sh _ci_bin _ci_key _ci_dir _ci_file _ci_first _ci_tmp
}

# mise activate (final step; prepends shims to PATH).
if command -v mise >/dev/null 2>&1; then
  if [ -n "${ZSH_VERSION:-}" ]; then
    _source_cached_init mise zsh mise activate zsh
  elif [ -n "${BASH_VERSION:-}" ]; then
    _source_cached_init mise bash mise activate bash
  elif command -v ps >/dev/null 2>&1; then
    _shell=$(ps -p $$ -o comm= | awk -F/ '{print $NF}' | sed 's/^-//')
    [ -n "$_shell" ] && eval "$(mise activate "$_shell")"
    unset _shell
  fi
fi
