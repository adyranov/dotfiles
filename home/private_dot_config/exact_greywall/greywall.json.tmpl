{{- /* Greywall kernel sandbox config — derived from shared AI path policy and package command policy.
  Level 1 (sandbox): deny-all default with allow + deny lists.
  Level 2 (agent permissions): handled by pi-permission-system / opencode.json permission object. */ -}}
{{- $cmdPolicies := includeTemplate "base/ai/collect-policies" (dict "root" .) | mustFromJson -}}
{{- $cmdDeny := index $cmdPolicies "deny" | default list -}}
{{- $greyproxy := (includeTemplate "base/helpers/load-section" (dict "root" . "section" "ai.sandbox.greyproxy" "required" true) | mustFromJson) -}}
{{- $fs := (includeTemplate "base/ai/render-greywall-fs" (dict "root" .) | mustFromJson) -}}
{{- $networkRules := (includeTemplate "base/ai/render-network-rules" (dict "root" .) | mustFromJson) -}}
{{- $creds := (includeTemplate "base/ai/render-credentials" . | mustFromJson) -}}
{{- $netPolicy := (includeTemplate "base/helpers/load-section" (dict "root" . "section" "ai.permissions.network" "required" false) | mustFromJson) -}}
{{- $localhost := index $netPolicy "localhost" | default dict -}}
{{- $network := dict
  "proxyUrl" (printf "socks5://localhost:%v" $greyproxy.socks)
  "httpProxyUrl" (printf "http://localhost:%v" $greyproxy.http)
  "dnsAddr" (printf "localhost:%v" $greyproxy.dns)
  "rules" $networkRules
-}}
{{- if hasKey $localhost "allow_outbound" -}}{{- $_ := set $network "allowLocalOutbound" $localhost.allow_outbound -}}{{- end -}}
{{- if hasKey $localhost "forward_ports" -}}{{- $_ := set $network "forwardPorts" $localhost.forward_ports -}}{{- end -}}
{{- if hasKey $netPolicy "allow_unix_sockets" -}}{{- $_ := set $network "allowUnixSockets" (index $netPolicy "allow_unix_sockets") -}}{{- end -}}
{{- $ssh := dict
  "allowedHosts" (list "github.com")
  "allowedCommands" (list "git-upload-pack")
  "deniedCommands" (list "git-receive-pack" "git-upload-archive" "scp" "sftp" "rsync" "sh" "bash" "zsh" "sudo" "curl" "wget" "nc" "ncat")
  "inheritDeny" true
-}}
{{- dict
  "network" $network
  "filesystem" (dict "defaultDenyRead" true "allowGitConfig" true "allowRead" $fs.allowRead "allowWrite" $fs.allowWrite "denyRead" $fs.denyRead "denyWrite" $fs.denyWrite)
  "command" (dict "deny" $cmdDeny "useDefaults" true)
  "ssh" $ssh
  "credentials" (dict "inject" $creds.inject "secrets" $creds.secrets "ignore" $creds.ignore)
| toPrettyJson -}}
