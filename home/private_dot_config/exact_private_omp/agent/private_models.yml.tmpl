{{- /* OMP custom model registry (~/.config/omp/agent/models.yml).
  Renders the local loopback gateway (127.0.0.1:<port>/v1) plus each declared
  OpenAI-compatible serving endpoint (e.g. infer01) as keyless (`auth: none`). */ -}}
{{- $root := . -}}
{{- $providers := dict -}}
{{- $serving := dig "ai" "profiles" $root.host.profile "serving" dict $root -}}

{{- /* ── Local loopback gateway ── */ -}}
{{- $localServing := index $serving "local" | default dict -}}
{{- if dig "enabled" true $localServing -}}
{{-   $localList := list -}}
{{-   range $m := get $localServing "models" | default list -}}
{{-     $localList = append $localList (dict
          "id" $m.id
          "name" (get $m "name" | default $m.id)
          "reasoning" (get $m "reasoning" | default false)
          "input" (list "text")
          "contextWindow" (get $m "context_window" | default 128000 | int)
          "maxTokens" (get $m "max_output" | default 8192 | int)
          "cost" (dict "input" 0 "output" 0 "cacheRead" 0 "cacheWrite" 0)
        ) -}}
{{-   end -}}
{{-   if $localList -}}
{{-     $_ := set $providers "local" (dict
          "baseUrl" (printf "http://127.0.0.1:%v/v1" (get $localServing "port" | default 8321))
          "api" "openai-completions"
          "auth" "none"
          "models" $localList
        ) -}}
{{-   end -}}
{{- end -}}

{{- /* ── Declared OpenAI-compatible endpoints ── */ -}}
{{- range $spId, $sp := $serving -}}
{{-   if not (kindIs "map" $sp) -}}{{ continue }}{{- end -}}
{{-   $spEnabled := dig "enabled" true $sp -}}
{{-   if and $spEnabled (eq (get $sp "kind" | default "") "openai-compatible") -}}
{{-     $baseUrl := get $sp "base_url" | default "" -}}
{{-     if not $baseUrl -}}
{{-       fail (printf "omp models.yml: serving provider %q (openai-compatible) has no base_url" $spId) -}}
{{-     end -}}
{{-     $remoteList := list -}}
{{-     range $m := get $sp "models" | default list -}}
{{-       $id := get $m "id" | default "" -}}
{{-       if not $id -}}
{{-         fail (printf "omp models.yml: serving provider %q has a model without id" $spId) -}}
{{-       end -}}
{{-       $entry := dict
            "id" $id
            "name" (get $m "name" | default $id)
            "reasoning" (get $m "reasoning" | default false)
            "input" (get $m "inputs" | default (list "text"))
            "contextWindow" (get $m "context_window" | default 128000 | int)
          -}}
{{-       if hasKey $m "max_output" -}}
{{-         $_ := set $entry "maxTokens" ($m.max_output | int) -}}
{{-       end -}}
{{-       if and (get $m "reasoning" | default false) (get $m "chat_format" | default "") -}}
{{-         $cfFormat := get $m "chat_format" -}}
{{-         $cfCatalog := dict
              "qwen-chat-template" (dict "mode" "effort" "efforts" (list "low" "medium" "xhigh") "requiresEffort" false)
            -}}
{{-         $cf := index $cfCatalog $cfFormat -}}
{{-         if not $cf -}}
{{-           fail (printf "omp models.yml: model %q has unknown chat_format %q (not in catalog)" $id $cfFormat) -}}
{{-         end -}}
{{-         $efforts := get $m "efforts" | default (get $cf "efforts") -}}
{{-         $thinking := dict
              "mode" (get $cf "mode")
              "efforts" $efforts
              "requiresEffort" (get $cf "requiresEffort" | default false)
              "defaultLevel" (last $efforts)
            -}}
{{-         $_ := set $entry "thinking" $thinking -}}
{{-         $_ := set $entry "compat" (dict "thinkingFormat" $cfFormat) -}}
{{-       end -}}
{{-       $cost := get $m "cost" | default dict -}}
{{-       $_ := set $entry "cost" (dict
            "input" (get $cost "input" | default 0)
            "output" (get $cost "output" | default 0)
            "cacheRead" (get $cost "cacheRead" | default 0)
            "cacheWrite" (get $cost "cacheWrite" | default 0)
          ) -}}
{{-       $remoteList = append $remoteList $entry -}}
{{-     end -}}
{{-     if $remoteList -}}
{{-       $_ := set $providers $spId (dict
            "baseUrl" $baseUrl
            "api" "openai-completions"
            "auth" "none"
            "models" $remoteList
          ) -}}
{{-     end -}}
{{-   end -}}
{{- end -}}

{{- dict "providers" $providers | toYaml -}}
