{{- /* Managed user-level MCP config for OMP from shared .ai.mcp.servers. */ -}}
{{- $mcpServers := dict -}}
{{- range $name := .ai.agents.omp.mcp_servers -}}
{{-   $srv := index $.ai.mcp.servers $name -}}
{{-   $_ := set $mcpServers $name (dict "args" (get $srv "args" | default list) "command" $srv.command "instructions" false) -}}
{{- end -}}
{{- dict "mcpServers" $mcpServers | toPrettyJson -}}
