{{- $local := dig "ai" "profiles" .host.profile "serving" "local" dict . -}}
{{- $defaultEngine := ternary "omlx" "llamacpp" (and (eq .host.distro.family "darwin") (eq .host.arch "arm64")) -}}
{{- $engine := get $local "engine" | default $defaultEngine -}}
{{- if and .toolchains.ai (eq $engine "llamacpp") -}}
{{- $intelMac := and (eq .host.distro.family "darwin") (eq .host.arch "amd64") -}}
{{- $defaultModel := get $local "default_model" | default "" -}}
{{- $models := get $local "models" | default list -}}
{{- $qwenTemplate := printf "%s/.config/llama.cpp/qwen-froggeric.jinja" .host.home -}}
version = 1

[*]
gpu-layers = auto
jinja = true
reasoning-format = deepseek
slot-save-path = {{ .host.home }}/.cache/llama.cpp/slots
flash-attn = auto
{{- if $intelMac }}
fit-target = 2048
{{- end }}
parallel = 1
batch-size = {{ ternary 1024 2048 $intelMac }}
ubatch-size = {{ ternary 256 512 $intelMac }}
cache-type-k = q8_0
cache-type-v = q8_0

{{ range $m := $models -}}
{{-   $gguf := get $m "gguf" | default dict -}}
{{-   if get $gguf "repo" -}}
{{-     $sampling := get $m "sampling" | default dict -}}
{{-     $chatTemplate := get $m "chat_template_file" | default "" -}}
{{-     if and (not $chatTemplate) (regexMatch "^qwen(3\\.[5-9]|3\\.[1-9][0-9]+|[4-9])" $m.id) -}}
{{-       $chatTemplate = $qwenTemplate -}}
{{-     end -}}
[{{ $m.id }}]
hf-repo = {{ $gguf.repo }}
{{-     if get $gguf "file" }}
hf-file = {{ $gguf.file }}
{{-     end }}
ctx-size = {{ get $m "context_window" | default 128000 }}
reasoning = {{ ternary "true" "false" (get $m "reasoning" | default false) }}
{{-     if $chatTemplate }}
chat-template-file = {{ $chatTemplate }}
{{-     end }}
{{-     if hasKey $sampling "temperature" }}
temp = {{ index $sampling "temperature" }}
{{-     end }}
{{-     if hasKey $sampling "top_p" }}
top-p = {{ index $sampling "top_p" }}
{{-     end }}
{{-     if hasKey $sampling "top_k" }}
top-k = {{ index $sampling "top_k" }}
{{-     end }}
{{-     if hasKey $sampling "min_p" }}
min-p = {{ index $sampling "min_p" }}
{{-     end }}
{{-     if hasKey $sampling "presence_penalty" }}
presence-penalty = {{ index $sampling "presence_penalty" }}
{{-     end }}
{{-     if hasKey $sampling "repetition_penalty" }}
repeat-penalty = {{ index $sampling "repetition_penalty" }}
{{-     end }}
load-on-startup = {{ eq $m.id $defaultModel }}

{{   end -}}
{{ end -}}
{{- end -}}
