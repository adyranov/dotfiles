{{- /* oh-my-opencode-slim plugin config for factory profile */ -}}
{{- /* Render oh-my-opencode-slim plugin config from managed tier data */ -}}
{{- $root := . -}}

{{- $presetsConfig := includeTemplate "base/helpers/load-section" (dict "root" $root "section" "ai.presets" "required" true) | mustFromJson -}}

{{- /* Mapping: slim agent to tier, from data (ai.agents.opencode.agent_tiers;
     opencode-specific agent names; the tiers are the primary data, resolved
     per preset). */ -}}
{{- $agentMap := includeTemplate "base/helpers/load-section" (dict "root" $root "section" "ai.agents.opencode.agent_tiers" "required" true) | mustFromJson -}}

{{- /* MCP/skills per agent */ -}}
{{- $engramMcps := list "engram" -}}
{{- $explorerMcps := list "codegraph" -}}
{{- $emptyMcps := list -}}
{{- $orchestratorSkills := list "*" -}}
{{- $oracleSkills := list "ce-pov" "ce-code-review" -}}
{{- $designerSkills := list "ce-polish" "ce-test-browser" -}}
{{- $fixerSkills := list "ce-work" "ce-debug" "ce-simplify-code" -}}
{{- $emptySkills := list -}}

{{- /* Unattended policy: only the orchestrator asks, and the path axis is
  not gated in-agent: subagents declare no external_directory key, so they
  inherit the factory's standing allow and nono + DCG stay the boundary
  (parity with pi/omp, which have no native path layer). */ -}}
{{- $asklessPermissions := dict "question" "deny" -}}
{{- /* Read-only research permissions for advisory agents */ -}}
{{- $researchPermissions := merge (deepCopy $asklessPermissions) (dict "edit" "deny" "shell" "deny" "subagent" "deny") -}}

{{- /*  Build per-preset agent configs  */ -}}
{{- $allPresets := dict -}}
{{- $allCouncilPresets := dict -}}
{{- $activePreset := "balanced" -}}
{{-   $activePreset = get $presetsConfig "default" | default "balanced" -}}
{{-   range $presetName, $_ := $presetsConfig -}}
{{-     if eq $presetName "default" -}}{{- continue -}}{{- end -}}
{{-     $presetData := index $presetsConfig $presetName -}}
{{-     $tiers := index $presetData "tiers" -}}
{{-     $councilMap := index $presetData "council" -}}
{{-     $presetAgents := dict -}}
{{-     range $agent, $tier := $agentMap -}}
{{-       $route := index $tiers $tier -}}
{{-       if not $route -}}
{{-         fail (printf "render-opencode-slim-config: preset %q has no route for tier %q (mapped by slim agent %q)" $presetName $tier $agent) -}}
{{-       end -}}
{{-       $models := includeTemplate "base/ai/models/render-route-model-list" (dict "route" $route "root" $root "label" $agent) | mustFromJson -}}
{{-       $cfg := dict "model" $models -}}

{{-       if eq $agent "orchestrator" -}}
{{-         $_ := set $cfg "mcps" $engramMcps -}}
{{-         $_ := set $cfg "skills" $orchestratorSkills -}}
{{-       else if eq $agent "oracle" -}}
{{-         $_ := set $cfg "mcps" $engramMcps -}}
{{-         $_ := set $cfg "skills" $oracleSkills -}}
{{-         $_ := set $cfg "permission" $asklessPermissions -}}
{{-       else if eq $agent "explorer" -}}
{{-         $_ := set $cfg "mcps" $explorerMcps -}}
{{-         $_ := set $cfg "skills" $emptySkills -}}
{{-         $_ := set $cfg "permission" $researchPermissions -}}
{{-       else if eq $agent "designer" -}}
{{-         $_ := set $cfg "mcps" $emptyMcps -}}
{{-         $_ := set $cfg "skills" $designerSkills -}}
{{-         $_ := set $cfg "permission" $asklessPermissions -}}
{{-       else if eq $agent "fixer" -}}
{{-         $_ := set $cfg "mcps" $emptyMcps -}}
{{-         $_ := set $cfg "skills" $fixerSkills -}}
{{-         $_ := set $cfg "permission" $asklessPermissions -}}
{{-       else -}}
{{-         $_ := set $cfg "mcps" $emptyMcps -}}
{{-         $_ := set $cfg "skills" $emptySkills -}}
{{-       end -}}

{{-       $_ := set $presetAgents $agent $cfg -}}
{{-     end -}}

{{- /*  Build council councillors for this preset  */ -}}
{{-     $councillors := dict -}}
{{-     range $name, $route := $councilMap -}}
{{-       if not (kindIs "map" $route) -}}{{- continue -}}{{- end -}}
{{-       if not (and (hasKey $route "provider") (hasKey $route "model")) -}}
{{-         fail (printf "render-opencode-slim-config: council entry %q missing provider/model" $name) -}}
{{-       end -}}
{{-       $models := includeTemplate "base/ai/models/render-route-model-list" (dict "route" $route "root" $root "label" (printf "council.%s" $name)) | mustFromJson -}}
{{-       $cfg := dict "model" $models -}}
{{-       $_ := set $councillors $name $cfg -}}
{{-     end -}}
{{-     $_ := set $allPresets $presetName $presetAgents -}}
{{- /* Presets without council seats are omitted; a missing council key disables council in the plugin. */ -}}
{{-     if gt (len $councillors) 0 -}}
{{-       $_ := set $allCouncilPresets $presetName $councillors -}}
{{-     end -}}
{{-   end -}}


{{- $backgroundJobs := dict
  "wallClockTimeoutMs" 3600000
  "abortGraceMs" 10000
  "concurrency" (dict "defaultConcurrency" (includeTemplate "base/ai/agents/resolve-subagent-limit" (dict "root" $root) | int))
-}}
{{- $fallback := dict
  "enabled" true
  "maxRetries" 3
-}}

{{- $result := dict
  "$schema" "https://unpkg.com/oh-my-opencode-slim@latest/oh-my-opencode-slim.schema.json"
  "preset" $activePreset
  "setDefaultAgent" true
  "autoUpdate" true
  "backgroundJobs" $backgroundJobs
  "fallback" $fallback
  "presets" $allPresets
-}}
{{- /* Council is only emitted when the active preset declares council seats;
  a missing council key disables council in the slim plugin. */ -}}
{{- if index $allCouncilPresets $activePreset -}}
{{-   $_ := set $result "council" (dict "default_preset" $activePreset "presets" $allCouncilPresets) -}}
{{- end -}}

{{- $result | toPrettyJson -}}
