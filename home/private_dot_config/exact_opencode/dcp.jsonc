{
  "$schema": "https://raw.githubusercontent.com/Opencode-DCP/opencode-dynamic-context-pruning/master/dcp.schema.json",
  "enabled": true,
  "autoUpdate": true,
  "debug": false,
  "pruneNotification": "minimal",
  "turnProtection": {
    "enabled": true,
    "turns": 6
  },
  "protectedFilePatterns": [],
  "commands": {
    "enabled": true,
    "protectedTools": []
  },
  "compress": {
    "mode": "range",
    "permission": "allow",
    "maxContextLimit": "75%",
    "minContextLimit": "50%",
    "nudgeFrequency": 15,
    "nudgeForce": "soft",
    "protectUserMessages": true,
    "summaryBuffer": true
  },
  "strategies": {
    "deduplication": {
      "enabled": true,
      "protectedTools": []
    },
    "purgeErrors": {
      "enabled": true,
      "turns": 4,
      "protectedTools": []
    }
  }
}
