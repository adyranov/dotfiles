{
  "$schema": "https://raw.githubusercontent.com/Opencode-DCP/opencode-dynamic-context-pruning/master/dcp.schema.json",
  "enabled": true,
  "autoUpdate": false,
  "debug": false,
  "pruneNotification": "minimal",
  "turnProtection": {
    "enabled": true,
    "turns": 6
  },
  "protectedFilePatterns": [],
  "commands": {
    "enabled": true,
    "protectedTools": []
  },
  "compress": {
    "nudgeFrequency": 10
  },
  "strategies": {
    "deduplication": {
      "enabled": true,
      "protectedTools": []
    },
    "purgeErrors": {
      "enabled": true,
      "turns": 4,
      "protectedTools": []
    }
  }
}
