{{- $tiers := includeTemplate "base/ai/models/load-default-tiers" (dict "root" . "required" true) | mustFromJson -}}
{{- $skills := includeTemplate "base/ai/agents/pi/render-model-category-map" (dict "root" . "field" "skills") | mustFromJson -}}
{{- $agents := includeTemplate "base/ai/agents/pi/render-model-category-map" (dict "root" . "field" "agents") | mustFromJson -}}
{{- $defaultRole := default "medium" (get $tiers "default") -}}
{{- $default := get $tiers $defaultRole -}}
{{- if not $default -}}{{- fail (printf "ai.models.tiers.default resolves to unknown tier %q" $defaultRole) -}}{{- end -}}

{{- dict
  "defaults" (dict "model" (includeTemplate "base/ai/agents/pi/render-pi-model-ref" $default) "thinking" (get $default "thinking"))
  "agents" $agents
  "skills" $skills
  | toPrettyJson
}}
