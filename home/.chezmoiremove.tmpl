{{- /*
Prune lists for gated content: gate off -> targets are gone.
Renames self-heal via exact_ dirs + `chezmoi apply --remove '<target>'`
(chezmoi prunes files no longer present in source). Patterns are TARGET
names; each gated block below mirrors home/.chezmoiignore.tmpl exactly.
*/ -}}
{{- if ne .host.distro.family "darwin" }}
Library
{{- end }}
{{- if not .secrets.age }}
{{- /* Age targets with no non-age twin; the ssh config.d confs are also
     listed here in .chezmoiignore.tmpl but pruned by the profile block.
     Intentional asymmetry: .chezmoiignore.tmpl carries a .age catch-all that is
     deliberately not mirrored here — targets listed in .chezmoiignore are never
     removed, so a .age pattern here would be inert, and an age-off host never
     writes a .age target (apply dies before writing it). */}}
.config/docker/buildkitd/buildkitd.work.toml
.config/git/work
.config/git/work-user
.config/maven/work.settings.xml
.local/share/mkcert/readonly_rootCA-key.pem
.local/share/mkcert/rootCA.pem
{{- end }}
{{- if not .toolchains.ai }}
.agents
.config/agents
.config/agents/**
.config/dcg
.config/dcg/**
.config/llama-swap
.config/llama-swap/**
.config/nono
.config/nono/**
.config/skypilot
.config/skypilot/**
.config/runpod
.config/runpod/**
.config/zsh/functions.d/skyl
.runpod
.local/bin/llm-serve
.local/share/dotfiles/test/test-ai-*.bats
{{- end }}
{{- /* Legacy argv0 symlinks (subcommand dispatch replaced them):
       pruned unconditionally on every host. */}}
.local/bin/pi-agent
.local/bin/opencode-agent
.local/bin/omp-agent
{{- /* Retired greywall-era artifacts: LaunchAgent plist (booted out by the
       darwin retire script), the Application Support convenience symlinks,
       and the greywall-open-url bridge pair (the bridge wrote /tmp/
       greywall-open-url; macOS keeps /usr/bin/open). */}}
Library/LaunchAgents/com.user.openurl-bridge.plist
Library/Application Support/greywall
Library/Application Support/greyproxy
.local/bin/open
.local/bin/openurl-bridge.sh
{{- if not (get .toolchains "pi" | default false) }}
.config/pi
.config/pi/**
{{- end }}
{{- if not (get .toolchains "opencode" | default false) }}
.config/opencode
.config/opencode/**
{{- end }}
{{- if not (get .toolchains "omp" | default false) }}
.config/omp
.config/omp/**
{{- end }}
{{- /* Launcher gate: mirrors home/.chezmoiignore.tmpl. */ -}}
{{- if not (or (get .toolchains "pi" | default false) (get .toolchains "opencode" | default false) (get .toolchains "omp" | default false)) }}
.local/bin/agent
{{- end }}
{{ if eq .host.profile "work" -}}
.config/ssh/config.d/personal.conf
{{- else -}}
.config/ssh/config.d/work.conf
{{- end }}
