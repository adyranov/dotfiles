#!/usr/bin/env bats

# bats file_tags=suite:runner

load 'common-helper'

setup() {
  common_setup
  RUNNER="$HOME/.local/bin/check-dotfiles"
  [ -x "$RUNNER" ] || skip "applied runner not present at $RUNNER"
}

# bats test_tags=suite:runner
@test "runner rejects an unknown package key" {
  run "$RUNNER" definitely-not-a-key
  assert_failure
  assert_output --partial "unknown package key"
}

# The enforcement suite set is the gate: a zero-suite run exiting green is
# the decay this pins. Fail, never skip — mirror the DCG require-binary
# pattern: a stub tree drives the applied runner's own resolution/verdicts.

runner_stub() { # runner_stub DIR — applied runner copy + real bats bin, no suite files
  local stub="$1" realdir
  realdir="$(dirname "$(readlink -f "$RUNNER")")"
  mkdir -p "$stub"
  cp -L "$RUNNER" "$stub/check-dotfiles.sh"
  ln -s "$realdir/bats" "$stub/bats"
}

# bats test_tags=suite:runner
@test "runner exits nonzero when zero suites resolve" {
  local stub
  stub="$(mktemp -d "$BATS_TEST_TMPDIR/stub.XXXXXX")"
  runner_stub "$stub"
  run "$stub/check-dotfiles.sh"
  assert_failure
  assert_output --partial "no suites resolved"
}

# bats test_tags=suite:runner
@test "runner exits nonzero when resolved suites contain zero tests" {
  # The empty-suite verdict: 0 tests must land on the WARN non-zero path,
  # never the green "all N passed" line.
  local stub
  stub="$(mktemp -d "$BATS_TEST_TMPDIR/stub.XXXXXX")"
  runner_stub "$stub"
  : >"$stub/test-config.bats"
  run "$stub/check-dotfiles.sh"
  assert_failure
  assert_output --partial "no tests matched"
}

# bats test_tags=suite:runner
@test "runner verdict counts a suite whose junit report counts no failures" {
  # A setup_file abort can produce a zero-failure JUnit row.
  local stub
  stub="$(mktemp -d "$BATS_TEST_TMPDIR/stub.XXXXXX")"
  runner_stub "$stub"
  printf '@test "passing probe" { true; }\n' >"$stub/test-config.bats"
  printf 'setup_file() { exit 7; }\n@test "never runs" { true; }\n' >"$stub/test-mise-packages.bats"
  run "$stub/check-dotfiles.sh" --suite config,mise-packages
  assert_failure
  assert_output --partial "FAIL: suite mise-packages exited"
  assert_output --partial "FAIL: 1 test(s) failed in 1 suite(s)"
  refute_output --partial "OK: all"
}

# bats test_tags=suite:runner
@test "runner aggregates suite verdicts in parallel suite mode" {
  # Bounded-concurrent launch must keep per-suite junit collection and the
  # verdict: one red fake suite among greens yields FAIL, never "OK: all".
  local stub
  stub="$(mktemp -d "$BATS_TEST_TMPDIR/stub.XXXXXX")"
  runner_stub "$stub"
  printf '@test "green" { sleep 0.2; true; }\n' >"$stub/test-config.bats"
  printf '@test "red" { false; }\n@test "green too" { sleep 0.2; true; }\n' >"$stub/test-mise-packages.bats"
  run env CHECK_DOTFILES_PARALLEL_SUITES=4 "$stub/check-dotfiles.sh" --suite config,mise-packages
  assert_failure
  assert_output --partial "FAIL: 1 test(s) failed in 1 suite(s)"
  refute_output --partial "OK: all"
}

{{- if .toolchains.ai }}

# bats test_tags=suite:runner
@test "ai-permissions chezmoi fixtures are timeout-capped" {
  # One hanging chezmoi boot must fail its own test, not eat the suite cap:
  # every nested-render fixture spawns through the runCapped guard.
  local f
  f="$(dirname "$(readlink -f "$RUNNER")")/test-ai-permissions.bats"
  [ -f "$f" ] || skip "applied test-ai-permissions.bats not present"
  run grep -c 'runCapped "\$cb" execute-template' "$f"
  assert_success
  assert_output "8"
}
{{- else }}

# bats test_tags=suite:runner
@test "ai-permissions chezmoi fixtures are timeout-capped" {
  skip "ai toolchain is off (test-ai-permissions.bats is unapplied)"
}
{{- end }}
