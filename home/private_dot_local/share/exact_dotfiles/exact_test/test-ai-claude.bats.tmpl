#!/usr/bin/env bats

# bats file_tags=suite:ai

load 'common-helper'

setup() {
  common_setup
}

{{- if get .toolchains "claude" | default false }}
# Every Claude render fact is derived at template time from the same data the
# renderer reads, so the applied tree and the assertion cannot drift. Two preset
# roots (personal/qwen, work/anthropic) are built explicitly so the runner
# matrix pins BOTH presets on any host (the runner-matrix contract).
{{- $ctx := includeTemplate "base/ai/agents/claude/render-claude-context" (dict "root" .) | mustFromJson }}
{{- $pRoot := merge (dict) . }}{{- $ph := merge (dict) .host }}{{- $_ := set $ph "profile" "personal" }}{{- $_ := set $pRoot "host" $ph }}
{{- $wRoot := merge (dict) . }}{{- $wh := merge (dict) .host }}{{- $_ := set $wh "profile" "work" }}{{- $_ := set $wRoot "host" $wh }}
{{- $pctx := includeTemplate "base/ai/agents/claude/render-claude-context" (dict "root" $pRoot) | mustFromJson }}
{{- $wctx := includeTemplate "base/ai/agents/claude/render-claude-context" (dict "root" $wRoot) | mustFromJson }}
{{- $fanout := 0 }}{{- if $ctx.has_serving }}{{- $fanout = sub (int (index $ctx.serving $ctx.serving_provider).slots) 1 }}{{- end }}
{{- $aliasId := "" }}{{- if $ctx.has_serving }}{{- $aliasId = (index (index $ctx.serving $ctx.serving_provider).models 0).id }}{{- end }}
{{- $claude := $ctx.claude }}
{{- /* Managed settings.json top-level keys, baked from the same renderer the
       modify template merges (anti-drift: no hand-copied key list). */ -}}
{{- $managedKeys := includeTemplate "base/ai/agents/claude/render-claude-settings" (dict "root" . "chezmoi" .chezmoi) | mustFromJson | keys | sortAlpha }}
{{- /* Plugin sets baked from the same plugins data the renderer shapes: the
       enabled id renders as "<id>@<marketplace>"=true, each marketplace as
       {source:{source,repo}}. Empty data renders {} and the set assertions
       still pin it. */ -}}
{{- $pluginIds := list }}{{- range $p := $claude.plugins.enabled }}{{- $pluginIds = append $pluginIds (printf "%s@%s" $p.id $p.marketplace) }}{{- end }}
{{- $pluginMkts := dict }}{{- range $n, $m := $claude.plugins.marketplaces }}{{- $pluginMkts = mergeOverwrite $pluginMkts (dict $n (dict "source" $m.source "repo" $m.repo)) }}{{- end }}

setup_file() {
  # Shared static renders for the active (applied) profile's config tree.
  render_source "$(tmplFile private_dot_config/claude/modify_settings.json)" "$BATS_FILE_TMPDIR/settings.json"
  render_source "$(tmplFile private_dot_config/claude/modify_settings.json)" "$BATS_FILE_TMPDIR/settings-work.json" '{"host":{"profile":"work"}}'
  render_source "$(tmplFile private_dot_config/claude/agents/orchestrator.md.tmpl)" "$BATS_FILE_TMPDIR/orchestrator.md"
{{- range $prof := list "personal" "work" }}
{{-   range $a := list "designer" "explorer" "fixer" "oracle" "orchestrator" }}
  render_source "$(tmplFile private_dot_config/claude/agents/{{ $a }}.md.tmpl)" "$BATS_FILE_TMPDIR/{{ $prof }}-{{ $a }}.md" '{"host":{"profile":"{{ $prof }}"}}'
{{-   end }}
{{- end }}
  render_source "$(tmplFile private_dot_config/claude/.chezmoiignore.tmpl)" "$BATS_FILE_TMPDIR/ignore-personal" '{"host":{"profile":"personal"}}'
  render_source "$(tmplFile private_dot_config/claude/.chezmoiignore.tmpl)" "$BATS_FILE_TMPDIR/ignore-work" '{"host":{"profile":"work"}}'
  render_source "$(tmplFile private_dot_config/claude/workflows/factory-deepwork.js.tmpl)" "$BATS_FILE_TMPDIR/deepwork-personal.js" '{"host":{"profile":"personal"}}'
  render_source "$(tmplFile private_dot_config/claude/workflows/factory-deepwork.js.tmpl)" "$BATS_FILE_TMPDIR/deepwork-work.js" '{"host":{"profile":"work"}}'
{{- if $ctx.has_serving }}
  render_source "$(tmplFile private_dot_config/claude/duer.json.tmpl)" "$BATS_FILE_TMPDIR/duer.json"
{{- end }}
  render_source "$(tmplFile private_dot_config/claude/hooks/dcg-guard.mjs.tmpl)" "$BATS_FILE_TMPDIR/dcg-guard.mjs"
  # Language-server package keys, baked from the same packages.ai data the
  # package renderer reads (anti-drift). The LSP test greps the APPLIED
  # settings.json for each key an *-lsp plugin needs.
  cat >"$BATS_FILE_TMPDIR/pkg.keys" <<'PKGKEYS'
{{ includeTemplate "base/helpers/load-section" (dict "root" . "section" "packages.ai" "required" true) | fromJson | keys | sortAlpha | join "\n" }}
PKGKEYS
}

# --- a. Runner matrix: every role of BOTH presets -> runner+model+effort+tools ---

# The plan's contract is the baked literal; the left-hand side is the runner the
# committed render-claude-runner partial produces from data. Duer roles (serving
# presets only) carry the exact --tools string baked from duers.role_tools (an
# over-grant drifts the assert); native roles carry no tools key.
# bats test_tags=toolchain:claude,kind:model
@test "claude runner maps every qwen (personal) role to the plan runner/model/effort/tools" {
  local offenders="" role kind model effort tools got
{{- range $role := list "explorer" "fixer" "designer" "oracle" "orchestrator" }}
{{-   $r := includeTemplate "base/ai/agents/claude/render-claude-runner" (dict "ctx" $pctx "role" $role) | mustFromJson }}
{{-   $rt := index ($pctx.claude.duers.role_tools | default dict) $role | default $pctx.claude.duers.tools }}
  role="{{ $role }}"; kind="{{ $r.kind }}"; model="{{ $r.model }}"; effort="{{ $r.effort }}"
  tools="{{ get $r "tools" | default "" }}"; got="$role:$kind:$model:$effort:tools=$tools"
  run test "$got" = "$role:{{ if eq $role "explorer" }}duer:qwen3.8-flash-next:low:tools={{ $rt }}{{ else if eq $role "fixer" }}duer:qwen3.8-flash-next:xhigh:tools={{ $rt }}{{ else if eq $role "designer" }}duer:qwen3.8-flash-next:xhigh:tools={{ $rt }}{{ else if eq $role "oracle" }}subagent:claude-opus-5-5:xhigh:tools={{ else }}subagent:claude-opus-5-5:xhigh:tools={{ end }}"
  [ "$status" -eq 0 ] || offenders="$offenders [$role $(printf '%s' "$output" | tr -d '\n')]"
{{- end }}
  # Research-class roles (roles.toml permission=research) must never get an
  # exec/edit tool: the duer runs under bypassPermissions, so tools is the gate.
  while IFS='|' read -r role tools; do
    case " $tools " in *"Edit"*|*"Write"*|*"Bash"*) offenders="$offenders $role-overgrant";; esac
  done <<'RESEARCH'
{{- range $n, $rd := $pctx.roles }}{{- if eq $rd.permission "research" }}
{{ $n }}|{{ get (includeTemplate "base/ai/agents/claude/render-claude-runner" (dict "ctx" $pctx "role" $n) | mustFromJson) "tools" | default "" }}
{{- end }}{{- end }}
RESEARCH
  [ -z "$offenders" ] || { printf 'qwen runner matrix drift:%s\n' "$offenders"; return 1; }
}

# bats test_tags=toolchain:claude,kind:model
@test "claude runner maps every anthropic (work) role to native subagents (no duers)" {
  local offenders="" role kind model effort tools got
{{- range $role := list "explorer" "fixer" "designer" "oracle" "orchestrator" }}
{{-   $r := includeTemplate "base/ai/agents/claude/render-claude-runner" (dict "ctx" $wctx "role" $role) | mustFromJson }}
  role="{{ $role }}"; kind="{{ $r.kind }}"; model="{{ $r.model }}"; effort="{{ $r.effort }}"
  tools="{{ get $r "tools" | default "" }}"; got="$role:$kind:$model:$effort:tools=$tools"
  run test "$got" = "$role:{{ if eq $role "explorer" }}subagent:claude-haiku-5-5:low:tools={{ else if eq $role "fixer" }}subagent:claude-sonnet-5-5:medium:tools={{ else if eq $role "designer" }}subagent:claude-sonnet-5-5:medium:tools={{ else if eq $role "oracle" }}subagent:claude-opus-5-5:xhigh:tools={{ else }}subagent:claude-opus-5-5:high:tools={{ end }}"
  [ "$status" -eq 0 ] || offenders="$offenders [$role $(printf '%s' "$output" | tr -d '\n')]"
{{- end }}
  [ -z "$offenders" ] || { printf 'anthropic runner matrix drift:%s\n' "$offenders"; return 1; }
}

# bats test_tags=toolchain:claude,kind:model
@test "claude serving-preset tier thinking stays inside the endpoint effort set" {
  # Every duer command's --effort renders from a serving tier's thinking (off
  # renders as thinking_off_effort). The llama.cpp chat template takes
  # low/medium/xhigh only — a high/max tier makes every duer launch 400.
  local offenders=""
{{- range $name, $tier := $pctx.tiers }}
  case "{{ $tier.thinking | default "off" }}" in
    off|low|medium|xhigh) ;;
    *) offenders="$offenders {{ $name }}={{ $tier.thinking | default "off" }}";;
  esac
{{- end }}
  case "{{ $claude.tier_routing.thinking_off_effort }}" in
    low|medium|xhigh) ;;
    *) offenders="$offenders off-effort={{ $claude.tier_routing.thinking_off_effort }}";;
  esac
  [ -z "$offenders" ] || { printf 'serving effort outside endpoint set:%s\n' "$offenders"; return 1; }
}

# --- b. autoMode: prose lists restoring the built-ins via "$defaults" ---

# bats test_tags=toolchain:claude,kind:config
@test "claude autoMode prose lists restore the built-ins and cover the duer launch" {
  # autoMode entries are prose rules read by the LLM classifier (the
  # byte-prefix parity design is dead); a list WITHOUT the literal "$defaults"
  # replaces the entire built-in list, so both sections must open with it.
  local file="$BATS_FILE_TMPDIR/settings.json"
  run jq -e '
    (.autoMode.allow[0] == "$defaults") and
    (.autoMode.environment[0] == "$defaults") and
    ([.autoMode.allow[] | select(test("duer"; "i"))] | length > 0) and
    ([.autoMode.environment[] | select(contains("infer01"))] | length > 0)
  ' "$file"
  assert_success
}

# --- c. settings.json managed key set ---

# bats test_tags=toolchain:claude,kind:config
@test "claude settings.json carries the managed policy set (auto mode, cross-session, attribution, env)" {
  local file="$BATS_FILE_TMPDIR/settings.json"
  run jq -e --argjson fbm '{{ $claude.settings.fallback_model | toJson }}' '
    (.permissions.defaultMode == "auto") and
    (.permissions.deny | index("Agent(general-purpose)")) and
    (.permissions.deny | index("Agent(fork)")) and
    (.crossSessionInbound == "refuse") and
    (.isolatePeerMachines == true) and
    (.sandbox.enabled == false) and
    (.autoMemoryEnabled == false) and
    (.ultracode == false) and
    (.attribution.commit == "") and
    (.attribution.pr == "") and
    (.syncClaudeAiSkills == false) and
    (.syncClaudeAiPlugins == false) and
    (.theme | length > 0) and
    (.preferredNotifChannel | length > 0) and
    (.spinnerTipsEnabled | type == "boolean") and
    (.fallbackModel | type == "array") and
    (.fallbackModel | length > 0) and
    (all(.fallbackModel[]; type == "string")) and
    (.fallbackModel == $fbm) and
    (.hooks.PreToolUse[0].hooks[0].command | startswith("node "))
  ' "$file"
  assert_success
  run jq -e --arg n "{{ $ctx.subagent_limit }}" '
    (.env.CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS == $n) and
    (all(.env[]; type == "string"))
  ' "$file"
  assert_success
}

# --- c2. modify-template merge: Claude's own writes survive the managed render ---

# bats test_tags=toolchain:claude,kind:config
@test "claude modify_settings.json keeps user keys, wins managed keys, strips comments, stays JSON" {
  # modify_settings.json (plain modifier — chezmoi renders it once with the
  # target as stdin) exists ONLY so Claude's own writes survive: merge
  # it over a seeded JSONC file (user key + // comment + trailing comma, the
  # shape Claude itself writes) and pin the merge contract, including migration
  # from a scalar fallbackModel to the managed array, and from a seeded NUMERIC
  # CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS (the pre-stringify shape) to the
  # managed STRING cap, while a user-owned env key survives.
  local cb out
  cb="$(chezmoiBin)"
  run "$cb" execute-template -f "$(tmplFile private_dot_config/claude/modify_settings.json)" --with-stdin <<'SEED'
{
  // user comment: editorMode is mine
  "editorMode": "vim",
  "theme": "light",
  "fallbackModel": "stale-scalar-model",
  "env": {"CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": 42, "USER_OWNED_TEST": "keep"},
}
SEED
  assert_success
  out="$BATS_TEST_TMPDIR/merged.json"
  printf '%s\n' "$output" >"$out"
  # Parses as JSON (jq reads it), the user key survives, every managed key is
  # present, managed wins on conflict (theme was seeded "light"), the seeded
  # scalar fallbackModel is replaced by the managed array, the seeded numeric
  # cap migrates to the managed string cap, and USER_OWNED_TEST survives.
  run jq -e --argjson keys '{{ $managedKeys | toJson }}' --arg theme "{{ $claude.settings.theme }}" --argjson fbm '{{ $claude.settings.fallback_model | toJson }}' --arg cap "{{ $ctx.subagent_limit }}" '
    (.editorMode == "vim") and (.theme == $theme) and
    (.fallbackModel == $fbm) and
    (.env.CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS == $cap) and
    (.env.CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS | type == "string") and
    (.env.USER_OWNED_TEST == "keep") and
    (. as $r | all($keys[]; . as $k | ($r | has($k))))
  ' "$out"
  assert_success
  run grep -F 'user comment' "$out"
  assert_failure
}

# --- c3. Plugin sets: data-derived keys, wholesale replace on merge ---

# bats test_tags=toolchain:claude,kind:config
@test "claude settings.json enabledPlugins/extraKnownMarketplaces are the data-derived sets" {
  # Anti-drift: both expected sets bake from the same ai.agents.claude.plugins
  # data the renderer reads, so a data edit needs no test edit. Enabled ids
  # render as "<id>@<marketplace>" = true; marketplaces as
  # {source:{source,repo}}. Empty plugin data renders {} and passes.
  local file="$BATS_FILE_TMPDIR/settings.json"
  run jq -e --argjson ids '{{ $pluginIds | toJson }}' '
    (.enabledPlugins | keys | sort) == ($ids | sort) and
    (all(.enabledPlugins[]; . == true))
  ' "$file"
  assert_success
  run jq -e --argjson mkts '{{ $pluginMkts | toJson }}' '
    . as $r |
    ((.extraKnownMarketplaces | keys | sort) == ($mkts | keys | sort)) and
    (all($mkts | keys[]; . as $k | $r.extraKnownMarketplaces[$k] == {source: $mkts[$k]}))
  ' "$file"
  assert_success
}

# bats test_tags=toolchain:claude,kind:config
@test "claude modify_settings.json wholesale-replaces enabledPlugins: stale plugin dies, user keys stay" {
  # mergeOverwrite is deep, so a plugin REMOVED from the data would survive a
  # plain merge (deep merge has no delete); the modify template replaces this
  # one key wholesale. extraKnownMarketplaces rides the deep merge, so a
  # user-added marketplace survives — the deliberate asymmetry.
  local cb out
  cb="$(chezmoiBin)"
  run "$cb" execute-template -f "$(tmplFile private_dot_config/claude/modify_settings.json)" --with-stdin <<'SEED'
{
  "editorMode": "vim",
  "enabledPlugins": {"stale-removed-plugin@stale-marketplace": true},
  "extraKnownMarketplaces": {"user-added-marketplace": {"source": {"source": "github", "repo": "someone/else"}}}
}
SEED
  assert_success
  out="$BATS_TEST_TMPDIR/merged-plugins.json"
  printf '%s\n' "$output" >"$out"
  # Stale entry gone, managed set exactly the data set, user key intact.
  run jq -e --argjson ids '{{ $pluginIds | toJson }}' '
    (.enabledPlugins | keys | sort) == ($ids | sort) and
    (.enabledPlugins | has("stale-removed-plugin@stale-marketplace") | not)
  ' "$out"
  assert_success
  run jq -e '(.editorMode == "vim") and (.extraKnownMarketplaces | has("user-added-marketplace"))' "$out"
  assert_success
}

# --- d. duer.json (serving preset only): bypass + serving endpoint + aliases ---
{{- if $ctx.has_serving }}

# bats test_tags=toolchain:claude,kind:config
@test "claude duer.json points duers at the serving endpoint with bypass + DCG hook" {
  local file="$BATS_FILE_TMPDIR/duer.json"
  run jq -e '
    (.permissions.defaultMode == "bypassPermissions") and
    (.autoMemoryEnabled == false) and
    (.hooks.PreToolUse[0].hooks[0].command | startswith("node ")) and
    (.env.ANTHROPIC_API_KEY == "local") and
    (.env.CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC == "1")
  ' "$file"
  assert_success
  # Alias pins derive from the serving provider's first model id (duers.env
  # carries no literals).
  run jq -e --arg m "{{ $aliasId }}" '
    (.env.ANTHROPIC_DEFAULT_HAIKU_MODEL == $m) and
    (.env.ANTHROPIC_DEFAULT_OPUS_MODEL == $m) and
    (.env.ANTHROPIC_DEFAULT_SONNET_MODEL == $m)
  ' "$file"
  assert_success
  # The Anthropic surface is the host root: base_url with /v1 stripped.
  run jq -e --arg url "{{ trimSuffix "/v1" (index $ctx.serving $ctx.serving_provider).base_url }}" '.env.ANTHROPIC_BASE_URL == $url' "$file"
  assert_success
}

