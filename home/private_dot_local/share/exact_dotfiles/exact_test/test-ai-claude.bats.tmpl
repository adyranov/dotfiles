# --- d2. Agent frontmatter contract (both presets) ---

# bats test_tags=toolchain:claude,kind:config
@test "claude agent files use effort: (never effortLevel:) with in-set values, both presets" {
  # frontmatter key is `effort`; valid values low|medium|high|xhigh|max
  # (effortLevel is a settings.json key, silently ignored in frontmatter).
  local offenders="" f p
  for f in designer explorer fixer oracle orchestrator; do
    for p in personal work; do
      if ! grep -Eq '^effort: (low|medium|high|xhigh|max)$' "$BATS_FILE_TMPDIR/$p-$f.md"; then
        offenders="$offenders $p/$f:effort"
      fi
      if grep -q '^effortLevel:' "$BATS_FILE_TMPDIR/$p-$f.md"; then
        offenders="$offenders $p/$f:effortLevel"
      fi
    done
  done
  [ -z "$offenders" ] || { printf 'agent effort frontmatter drift:%s\n' "$offenders"; return 1; }
}

# bats test_tags=toolchain:claude,kind:config
@test "claude orchestrator frontmatter carries no tools/agent/fallbackModel keys" {
  # tools: omission grants all (deny Agent(...) rules live in settings.json);
  # agent/fallbackModel are settings.json keys, not frontmatter.
  local fm
  fm="$(awk '/^---$/{n++; next} n==1' "$BATS_FILE_TMPDIR/orchestrator.md")"
  if grep -Eq '^(tools|agent|fallbackModel):' <<<"$fm"; then
    printf 'orchestrator frontmatter offenders:\n'
    grep -En '^(tools|agent|fallbackModel):' <<<"$fm"
    return 1
  fi
}

# bats test_tags=toolchain:claude,kind:config
@test "claude orchestrator frontmatter preloads the roster's three skills" {
  # roles.toml lists the orchestrator skills explicitly (no wildcard); the
  # frontmatter renders them, so the preload survives without prose.
  run grep -Eq '^skills: deepwork, verification-planning, step-back$' "$BATS_FILE_TMPDIR/orchestrator.md"
