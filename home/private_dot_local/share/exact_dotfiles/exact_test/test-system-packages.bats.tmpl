# bats test_tags=suite:packages,kind:selector
@test "package ids are canonical and renders from shared input are order-independent" {
  # Whole-token comparison: "openssh" must not match "openssh-client" and vice versa.
  assert_equal "{{ contains (printf " %s " "openssh") (printf " %s " $armFirst) }}" "true"
  assert_equal "{{ contains (printf " %s " "openssh-client") (printf " %s " $armFirst) }}" "false"
  assert_equal "{{ contains (printf " %s " "openssh +fido2") (printf " %s " $intelFirst) }}" "true"
  assert_equal "{{ contains (printf " %s " "openssh-client") (printf " %s " $intelFirst) }}" "false"
  # All five former -arm64 twins resolve under their canonical ids only.
  assert_equal "{{ contains "-arm64" $armFirst }}" "false"
  assert_equal "{{ contains "-arm64" $intelFirst }}" "false"
  assert_equal "{{ contains (printf " %s " "gnupg") (printf " %s " $armFirst) }}" "true"
  assert_equal "{{ contains (printf " %s " "ykman") (printf " %s " $armFirst) }}" "true"
  assert_equal "{{ contains (printf " %s " "docker-buildx") (printf " %s " $armFirst) }}" "true"
  assert_equal "{{ contains (printf " %s " "docker-compose") (printf " %s " $armFirst) }}" "true"
  # Intel and ARM rendered in both orders from the same data give identical results.
  assert_equal "{{ $armFirst }}" "{{ $armSecond }}"
  assert_equal "{{ $intelFirst }}" "{{ $intelSecond }}"
}

