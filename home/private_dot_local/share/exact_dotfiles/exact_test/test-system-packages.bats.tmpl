{{- /* Real layered package data under synthetic hosts: Darwin cask routing, Intel MacPorts routing, Docker names. */ -}}
{{- $dcPkgs := dict "base" (index .packages "base" | default dict) "os" (index .packages "os" | default dict) "profile" (index .packages "profile" | default dict) -}}
