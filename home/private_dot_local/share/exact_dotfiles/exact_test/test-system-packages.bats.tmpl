{{- /* One synthetic entry per selector axis plus combination/precedence corners, evaluated on a
  work + linux + ubuntu + arm64 + headless + rootless + ephemeral host with cloud enabled. */ -}}
{{- $axBrew := dict "manager" "brew" -}}
{{- $axPkgs := dict "base" (dict "core" (dict
  "a1" (merge (dict "include" (dict "profile" (list "work"))) $axBrew)
  "a2" (merge (dict "include" (dict "os" (list "linux"))) $axBrew)
  "a3" (merge (dict "include" (dict "distro" (list "ubuntu"))) $axBrew)
  "a4" (merge (dict "include" (dict "arch" (list "arm64"))) $axBrew)
  "a5" (merge (dict "include" (dict "mode" (list "headless"))) $axBrew)
  "a6" (merge (dict "include" (dict "privilege" (list "rootless"))) $axBrew)
  "a7" (merge (dict "include" (dict "type" (list "ephemeral"))) $axBrew)
  "a8" (merge (dict "include" (dict "toolchains" (list "cloud"))) $axBrew)
  "a9" (merge (dict "include" (dict "arch" (list "amd64") "mode" (list "interactive"))) $axBrew)
  "a10" (merge (dict "exclude" (dict "mode" (list "headless")) "include" (dict "mode" (list "headless"))) $axBrew)
  "a11" (merge (dict "include" (dict "arch" (list))) $axBrew)
)) "os" (dict) "profile" (dict) -}}
{{- $axHost := dict "arch" "arm64" "distro" (dict "id" "ubuntu" "family" "linux") "interactive" false "profile" "work" "restricted" true "type" "ephemeral" -}}
{{- $axBrewList := includeTemplate "base/packages/collect-packages" (dict "root" (dict "host" $axHost "toolchains" (dict "cloud" true) "packages" $axPkgs) "manager" "brew" "format" "install") }}

# bats test_tags=suite:packages,kind:selector
@test "selectors match every axis with OR inside an axis and exclusion winning" {
  # a1-a8 match their axis (host: work, linux, ubuntu, arm64, headless, rootless, ephemeral, cloud).
  # a9 fails AND (amd64+interactive); a10 is excluded (exclude wins over include); a11 has an empty axis.
  assert_equal "{{ $axBrewList }}" "a1 a11 a2 a3 a4 a5 a6 a7 a8"
}

{{- $varPkgs := dict "base" (dict "core" (dict
  "reenabled" (dict "disabled" true "manager" "brew" "variants" (list (dict "include" (dict "profile" (list "work")) "disabled" false)))
  "still-disabled" (dict "disabled" true "manager" "brew" "variants" (list (dict "include" (dict "profile" (list "personal")) "disabled" false)))
  "keepeexclude" (dict "exclude" (dict "arch" (list "arm64")) "manager" "brew" "variants" (list (dict "include" (dict "profile" (list "work")) "package" "cleared-name")))
  "laterwins" (dict "manager" "brew" "variants" (list (dict "package" "first") (dict "include" (dict "arch" (list "arm64")) "package" "second")))
  "mgrreset" (dict "manager" "mise" "package" "provider-name")
  "mgrname" (dict "manager" "mise" "package" "provider-name")
)) "os" (dict "ubuntu" (dict "core" (dict
  "mgrreset" (dict "manager" "system")
  "mgrname" (dict "manager" "system" "package" "explicit-name")
))) "profile" (dict "work" (dict "core" (dict "laterwins" (dict "package" "profile-layer")))) -}}
{{- $varBrewList := includeTemplate "base/packages/collect-packages" (dict "root" (dict "host" $axHost "toolchains" (dict) "packages" $varPkgs) "manager" "brew" "format" "install") -}}
{{- $varSystemList := includeTemplate "base/packages/collect-packages" (dict "root" (dict "host" $axHost "toolchains" (dict) "packages" $varPkgs) "manager" "system" "format" "install") }}

# bats test_tags=suite:packages,kind:selector
@test "variants honor explicit false, apply in order, and reset inherited names on manager change" {
  # reenabled (variant flips disabled=true); keepeexclude keeps its entry exclude (a matching
  # variant's include is only its match predicate); laterwins -> the profile layer's name wins
  # over both matching variants (second then profile-layer).
  assert_equal "{{ $varBrewList }}" "profile-layer reenabled"
  assert_equal "{{ contains "cleared-name" $varBrewList }}" "false"
  # still-disabled stays absent; mgrreset loses provider-name (id used); mgrname keeps the explicit name.
  assert_equal "{{ $varSystemList }}" "explicit-name mgrreset"
}

{{- /* Bug reproductions: entry selectors survive a matching variant, layer selector maps
  merge axis-wise, and the manager-change reset uses unbounded application ordering. */ -}}
{{- $persBrew := dict "manager" "brew" -}}
{{- $persPkgs := dict "base" (dict "core" (dict
  "widget" (merge (dict "include" (dict "profile" (list "work")) "variants" (list (dict "include" (dict "arch" (list "arm64")) "package" "widget-arm"))) $persBrew)
  "cross" (merge (dict "exclude" (dict "profile" (list "personal"))) $persBrew)
)) "os" (dict "ubuntu" (dict "core" (dict "cross" (dict "exclude" (dict "arch" (list "amd64")))))) "profile" (dict) -}}
{{- $persPersonal := dict "arch" "arm64" "distro" (dict "id" "ubuntu" "family" "linux") "interactive" true "profile" "personal" "restricted" false "type" "workstation" -}}
