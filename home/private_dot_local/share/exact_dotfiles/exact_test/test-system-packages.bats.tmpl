{{- /* Synthetic brew layers: name-keyed casks merge across layers, so the arch-selected Darwin cask and profile casks coexist, and a profile exclusion on an OS cask cannot resurrect it there. */ -}}
{{- $dcLayerBrew := dict
  "base" (dict)
  "os" (dict "darwin" (dict "casks" (dict
    "Arm64 Cask" (dict "include" (dict "arch" (list "arm64")))
    "Shared Cask" (dict)
    "Personal-Only Cask" (dict "exclude" (dict "profile" (list "personal")))
  )))
  "profile" (dict
    "personal" (dict "casks" (dict "Personal Cask" (dict)))
    "work" (dict "casks" (dict "Arm64 Cask" (dict "exclude" (dict "profile" (list "work")))))
  )
-}}
{{- $dcLayerPkgs := dict "base" (dict) "os" (dict) "profile" (dict) -}}
{{- $dcLayerPersonalArm := includeTemplate "os/darwin/brewfile" (dict "host" $dcArm "toolchains" $dcCloudDocker "packages" $dcLayerPkgs "brew" $dcLayerBrew) -}}
{{- $dcLayerPersonalIntel := includeTemplate "os/darwin/brewfile" (dict "host" $dcIntel "toolchains" $dcCloudDocker "packages" $dcLayerPkgs "brew" $dcLayerBrew) -}}
{{- $dcLayerWork := includeTemplate "os/darwin/brewfile" (dict "host" $dcArmWork "toolchains" $dcCloudDocker "packages" $dcLayerPkgs "brew" $dcLayerBrew) -}}
{{- $dcIntelNoCloudRoot := dict "host" $dcIntel "toolchains" (dict "docker" true) "packages" $dcPkgs "brew" .brew -}}
{{- $dcIntelPorts := includeTemplate "base/packages/collect-packages" (dict "root" $dcIntelRoot "manager" "macports" "format" "install") -}}
{{- $dcIntelWorkPorts := includeTemplate "base/packages/collect-packages" (dict "root" $dcIntelWorkRoot "manager" "macports" "format" "install") -}}
{{- $dcIntelNoCloudPorts := includeTemplate "base/packages/collect-packages" (dict "root" $dcIntelNoCloudRoot "manager" "macports" "format" "install") -}}
{{- $dcArmPorts := includeTemplate "base/packages/collect-packages" (dict "root" $dcArmRoot "manager" "macports" "format" "install") }}

# bats test_tags=suite:packages,kind:selector
@test "interactive ARM emits exactly one Azure CLI cask on every profile and without the cloud toolchain" {
  assert_equal "{{ len (regexFindAll "cask \"azure-cli\"" $dcArmBrewfile -1) }}" "1"
  assert_equal "{{ len (regexFindAll "cask \"azure-cli\"" (includeTemplate "os/darwin/brewfile" $dcArmWorkRoot) -1) }}" "1"
  # The cask comes from the brew data domain, so the cloud toolchain is not required.
  assert_equal "{{ len (regexFindAll "cask \"azure-cli\"" $dcArmNoCloudBrewfile -1) }}" "1"
  # Name-keyed Darwin casks merge with the profile casks; Intel skips the arm64 cask, other profiles skip personal casks.
  assert_equal "{{ contains "cask \"Arm64 Cask\"" $dcLayerPersonalArm }}" "true"
  assert_equal "{{ contains "cask \"Personal Cask\"" $dcLayerPersonalArm }}" "true"
  assert_equal "{{ contains "cask \"Arm64 Cask\"" $dcLayerPersonalIntel }}" "false"
  assert_equal "{{ contains "cask \"Personal Cask\"" $dcLayerPersonalIntel }}" "true"
  # The work profile excludes the OS-level Arm64 cask there without removing it from personal hosts.
  assert_equal "{{ contains "cask \"Arm64 Cask\"" $dcLayerWork }}" "false"
  assert_equal "{{ contains "cask \"Personal Cask\"" $dcLayerWork }}" "false"
  # A cask excluded for the personal profile stays absent there while the OS-level cask keeps working on work hosts.
  assert_equal "{{ contains "cask \"Shared Cask\"" $dcLayerPersonalArm }}" "true"
  assert_equal "{{ contains "cask \"Shared Cask\"" $dcLayerWork }}" "true"
  assert_equal "{{ contains "cask \"Personal-Only Cask\"" $dcLayerPersonalArm }}" "false"
  assert_equal "{{ contains "cask \"Personal-Only Cask\"" $dcLayerWork }}" "true"
}

# bats test_tags=suite:packages,kind:selector
@test "interactive Intel emits no Azure CLI cask and provisions it from MacPorts on every profile and without the cloud toolchain" {
  assert_equal "{{ len (regexFindAll "cask \"azure-cli\"" $dcIntelBrewfile -1) }}" "0"
  assert_equal "{{ len (regexFindAll "cask \"azure-cli\"" (includeTemplate "os/darwin/brewfile" $dcIntelWorkRoot) -1) }}" "0"
  # The core package is independent of the cloud toolchain.
  assert_equal "{{ contains "azure-cli" $dcIntelPorts }}" "true"
  assert_equal "{{ contains "azure-cli" $dcIntelWorkPorts }}" "true"
  assert_equal "{{ contains "azure-cli" $dcIntelNoCloudPorts }}" "true"
}

