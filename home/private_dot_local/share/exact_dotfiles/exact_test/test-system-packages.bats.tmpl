{{- $dcIntelRoot := dict "host" $dcIntel "toolchains" $dcCloudDocker "packages" $dcPkgs "brew" .brew -}}
{{- $dcIntelQuietRoot := dict "host" $dcIntelQuiet "toolchains" $dcCloudDocker "packages" $dcPkgs "brew" .brew -}}
