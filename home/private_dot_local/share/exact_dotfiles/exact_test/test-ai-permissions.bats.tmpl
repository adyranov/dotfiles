{{- $r := includeTemplate "base/test/deep-copy-set-path" (dict "root" $r1 "path" (list "ai" "base" "permissions" "apply" "sandbox" "git" "fs_write") "value" (list "tmp_workspace" "agents_scratch" "/private/var/folders")) | mustFromJson -}}
{{- includeTemplate "base/ai/security/render-nono-cmd" (dict "root" $r "applyDests" (includeTemplate "base/ai/security/render-apply-dests" (dict "root" $r) | mustFromJson)) -}}` }}
