# bats test_tags=toolchain:pi,kind:permission
@test "pi permission-system config renders secure defaults" {
  assert_file_exists "$HOME/.config/pi/agent/extensions/pi-permission-system/config.json"
  run jsoncJq -e '
    .yoloMode == false and
    .permissionReviewLog == true and
    .permission["*"] == "allow" and
    .permission.bash["*"] == "allow"
  ' "$HOME/.config/pi/agent/extensions/pi-permission-system/config.json"
  assert_success
}

# bats test_tags=toolchain:pi,kind:permission
@test "pi permission-system config protects key sensitive paths" {
  run jsoncJq -e '
    .permission.path["**/.env"] == "deny" and
    .permission.path["~/.ssh/**"] == "deny" and
    .permission.path["~/.config/pi/agent/auth.json"] == "deny"
  ' "$HOME/.config/pi/agent/extensions/pi-permission-system/config.json"
  assert_success
}


