# bats test_tags=kind:nono
@test "nono base profile enforces network and environment control-axis invariants" {
  run jq -e --argjson want '{{ $wantHosts | toJson }}' --argjson inject '{{ $creds.inject | sortAlpha | toJson }}' --argjson routed '{{ $routedNames | toJson }}' '
    . as $r |
    # Presence derived from the data at render time: every category value must
    # land in the rendered profile. pi.dev stays an explicit pin: the
    # pi.dev relocation into base is the load-bearing half of this assertion.
    ($want - .network.allow_domain | length) == 0 and
    (.network.allow_domain | index("pi.dev")) != null and
    # browsable docs / search-site hosts are gone
    (["docs.comfy.org", "docs.litellm.ai", "docs.runpod.io", "docs.sglang.ai",
      "docs.vllm.ai", "support.apple.com", "www.anthropic.com", "ai.google.dev",
      "brave.com", "infer01"]
      | all(. as $h | ($r.network.allow_domain | index($h)) == null)) and
    # flat render, deduped, bounded; the base total is pinned at the rendered
    # data count (the group-catalog refactor is value-neutral in base: no base
    # category references a group, so flattening equals the literal set; the
    # count includes the coding-plan auth-store host approved for omp)
    ((.network.allow_domain | unique | length) == (.network.allow_domain | length)) and
    ((.network.allow_domain | length) == {{ len $wantHosts }}) and
    ((.network.allow_domain | length) <= 200) and
    (.network.open_port | index(7437) != null) and
    (.network.open_port | index(8321) != null) and
    (.filesystem.unix_socket_subtree | index("~/.local/share/tmux") != null) and
    # environment: DCG_* scrub is load-bearing; ambient injects and ignores stay out;
    # wildcard denies repeat into diagnostics.redaction (nono redacts exact names only)
    (.environment.deny_vars | index("DCG_*") != null) and
    (.diagnostics.redaction.extra_env_vars | index("DCG_*") != null) and
    (.environment.deny_vars | index("PUBLIC_API_TOKEN") == null) and
    (all($inject[]; . as $k | ($r.environment.deny_vars | index($k)) == null)) and
    # routed names are scrubbed, gap names are not (they pass through, redacted);
    # env_credentials are fatal at launch on unset sources, so nothing emits them.
    (all($routed[]; . as $k | ($r.environment.deny_vars | index($k)) != null)) and
    (has("env_credentials") | not) and
    (all($inject[]; . as $k | (.diagnostics.redaction.extra_env_vars | index($k)) != null))
  ' "{{ $nonoProfiles }}/base.json"
  assert_success
}

