# bats test_tags=kind:nono
@test "sandbox resolvers loud-fail on typos and resolve fs group refs" {
  # Reason markers: the loud-fail reason must be IN the output — EXIT!=0 plus
  # the typo name alone is vacuously green on a fixture-internal crash (the
  # name sits on the echoed template line). Both typo axes route through
  # expand-path-groups, whose fail() carries this marker. The fsGood EXIT:0
  # canary proves the nested-render harness itself works. Violations→fail
  # wiring: a protected destination must die in the nested render-apply-dests
  # naming apply-dest-guard (only this fixture reaches its fail line).
  local cb json offenders=""
  cb="$(chezmoiBin)"

  cat >"$BATS_TEST_TMPDIR/net-typo.tmpl" <<'FIXTURE'
{{ $typoTpl }}
FIXTURE
  cat >"$BATS_TEST_TMPDIR/fs-typo.tmpl" <<'FIXTURE'
{{ $fsTypoTpl }}
FIXTURE
  cat >"$BATS_TEST_TMPDIR/fs-good.tmpl" <<'FIXTURE'
{{ $fsGoodTpl }}
FIXTURE
  cat >"$BATS_TEST_TMPDIR/bad-dests.tmpl" <<'FIXTURE'
{{ $badDestsTpl }}
FIXTURE

  run "$cb" execute-template -f "$BATS_TEST_TMPDIR/net-typo.tmpl"
  [ "$status" -ne 0 ] || offenders="$offenders net:typo.fails-render"
  [[ "$output" == *git_forge_typo* ]] || offenders="$offenders net:typo.named"
  [[ "$output" == *"expand-path-groups: unknown path group"* ]] || offenders="$offenders net:typo.reason-marker"

  run "$cb" execute-template -f "$BATS_TEST_TMPDIR/fs-typo.tmpl"
  [ "$status" -ne 0 ] || offenders="$offenders fs:typo.fails-render"
  [[ "$output" == *no_such_fs_group_typo* ]] || offenders="$offenders fs:typo.named"
  [[ "$output" == *"expand-path-groups: unknown path group"* ]] || offenders="$offenders fs:typo.reason-marker"

  run "$cb" execute-template -f "$BATS_TEST_TMPDIR/fs-good.tmpl"
  [ "$status" -eq 0 ] || offenders="$offenders fs-resolve:canary.renders"
  json="$(sed -n '/^{/,$p' <<<"$output")"
  jq -e '(.commands.git.from.session.sandbox.fs_read | index("/bin") != null) and
         (.commands.git.from.session.sandbox.fs_write | index("'"${TMPDIR:-/tmp}"'" | rtrimstr("/")) != null)' <<<"$json" >/dev/null ||
    offenders="$offenders fs-resolve:group-ref+tmpdir-expanded"
  [[ "$output" != *'$TMPDIR'* ]] || offenders="$offenders fs-resolve:no.tmpdir-leak"

  run "$cb" execute-template -f "$BATS_TEST_TMPDIR/bad-dests.tmpl"
  { [ "$status" -ne 0 ] && [[ "$output" == *apply-dest-guard* ]]; } || offenders="$offenders dests-guard:wiring.fails-render"

  if [ -n "$offenders" ]; then
    printf 'loud-fail/resolve fixtures (offending checks):%s\n' "$offenders"
    return 1
  fi
}

# bats test_tags=kind:nono
@test "cross-agent grants live once in shared.toml and never in per-agent files" {
