# bats test_tags=toolchain:claude,kind:nono
@test "claude oauth token: anthropic route is env:// placeholder mechanics with no token literal in any profile" {
  # The real CLAUDE_CODE_OAUTH_TOKEN is read supervisor-side (env://) and swapped
  # by the proxy at api.anthropic.com; the sandbox sees only the placeholder. A
  # rendered profile must never carry a token VALUE (route mechanics: env:// key,
  # "Bearer {}" format template, deny_vars name only).
  local profiles
  profiles=$(echo "{{ $nonoProfiles }}"/*.json)
  # Empty discovery (missing/empty dir) leaves the literal glob, grep exits 2,
  # and assert_failure would pass vacuously on zero profiles scanned.
  [ -f "{{ $nonoProfiles }}/base.json" ] || {
    printf 'no rendered nono profiles under %s\n' "{{ $nonoProfiles }}"; return 1; }
  run jq -e '
    (.network.custom_credentials.anthropic // {}) as $c |
    ($c.credential_key == "env://CLAUDE_CODE_OAUTH_TOKEN") and
    ($c.credential_format == "Bearer {}")
  ' "{{ $nonoProfiles }}/claude.json"
  assert_success
{{- if .toolchains.pi }}
  # pi: pi-claude-bridge's claude child authenticates through the route.
  run jq -e '
    (.network.custom_credentials.anthropic // {}) as $c |
    ($c.credential_key == "env://CLAUDE_CODE_OAUTH_TOKEN") and
    ($c.credential_format == "Bearer {}") and
    ((.network.credentials // []) | index("anthropic") != null)
  ' "{{ $nonoProfiles }}/pi.json"
  assert_success
{{- end }}
{{- if (get .toolchains "omp" | default false) }}
  # omp: no bridge lane installed, so the OAuth token is not injectable
  # here; the env stays scrubbed.
  run jq -e '
    ((.network.custom_credentials // {}) | has("anthropic") | not) and
    ((.network.credentials // []) | index("anthropic") | not) and
    (.environment.deny_vars | index("CLAUDE_CODE_OAUTH_TOKEN") != null)
  ' "{{ $nonoProfiles }}/omp.json"
  assert_success
{{- end }}
{{- if .toolchains.opencode }}
  # opencode: no bridge wired, so the OAuth token is not injectable here.
  run jq -e '
    ((.network.custom_credentials // {}) | has("anthropic") | not) and
    ((.network.credentials // []) | index("anthropic") | not)
  ' "{{ $nonoProfiles }}/opencode.json"
  assert_success
{{- end }}
  # No profile (incl. base) bakes a token literal.
  run grep -lF 'sk-ant-' $profiles
  assert_failure
}
{{- end }}

