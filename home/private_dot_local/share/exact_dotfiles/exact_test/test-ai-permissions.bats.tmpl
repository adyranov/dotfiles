# bats test_tags=toolchain:pi,kind:permission
@test "pi permission-system config: mcp and skills allowed by default" {
  run jq -e '
    # With default "*" = "allow", mcp and skill are allowed without explicit sub-namespaces
    .permission["*"] == "allow" and
    (.permission.mcp == null or .permission.mcp == "allow") and
    (.permission.skill == null or .permission.skill == "allow" or .permission.skill["*"] == "allow")
  ' "$HOME/.config/pi/agent/extensions/pi-permission-system/config.json"
  assert_success
}

{{- if .toolchains.ai }}
# bats test_tags=toolchain:pi,kind:permission,toolchain:ai
@test "pi permission-system: AI package rules" {
