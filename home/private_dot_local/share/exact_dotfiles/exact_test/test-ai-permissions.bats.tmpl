# bats test_tags={{ $agent.tag }},kind:permission
@test "{{ $agent.name }} bash: core deny rules" {
  run jsoncJq -e '
    .permission.bash["git * push --force*"] == "deny" and
    .permission.bash["rm -rf /*"] == "deny" and
    .permission.bash["sudo *"] == "deny" and
    .permission.bash["chezmoi apply"] == "deny" and
    (.permission.bash["chezmoi apply *"] | not) and
    (.permission.bash["gh auth token"] == "deny" or .permission.bash["gh auth token"] == "ask") and
    (.permission.bash["mise run apply"] == "deny" or .permission.bash["mise run apply"] == "ask")
  ' "{{ $agent.config }}"
  assert_success
}
