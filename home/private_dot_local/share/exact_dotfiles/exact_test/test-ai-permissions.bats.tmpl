    .permission.bash["hf auth *"] == "deny" and
    .permission.bash["hf repo delete *"] == "deny" and
    .permission.bash["hf upload *"] == "deny"
  ' "$HOME/.config/pi/agent/extensions/pi-permission-system/config.json"
