{{- /* Floor/grant inputs baked from the shared data the renderer reads
       (anti-drift): the shared file-write floors from
       ai.agents.shared.sandbox.shared_write_denies (the renderer expands
       $HOME; the rendered rules carry the expanded home), the worktree grant
       from the shared write list, the deny from the claude_auth_files
       group. */}}
{{ $blank := true }}
{{- $sharedSb := includeTemplate "base/helpers/load-section" (dict "root" . "section" "ai.agents.shared.sandbox" "required" true) | mustFromJson -}}
{{- $floors := get $sharedSb "shared_write_denies" | default list -}}
{{- $floorsExp := list -}}
{{- range $f := $floors -}}{{- $floorsExp = append $floorsExp (replace "$HOME" (trimSuffix "/" $.chezmoi.homeDir) $f) -}}{{- end -}}
{{- $gitFloor := list -}}
{{- $laFloor := list -}}
{{- range $f := $floors -}}
{{-   if contains "LaunchAgents" $f -}}{{-   $laFloor = append $laFloor $f -}}{{-   else -}}{{-   $gitFloor = append $gitFloor $f -}}{{-   end -}}
{{- end -}}
{{- $wtGrants := list -}}
{{- range $w := (index $sharedSb "filesystem" "write" | default list) -}}
{{-   if contains "/.claude/worktrees/" $w -}}{{-   $wtGrants = append $wtGrants $w -}}{{-   end -}}
{{- end -}}
{{- $authDeny := index (includeTemplate "base/helpers/load-section" (dict "root" . "section" "ai.permissions.filesystem.paths" "required" true) | mustFromJson) "claude_auth_files" | default list -}}
{{- $floorAgents := list -}}
{{- range $a := $nonoAgents -}}{{- $floorAgents = append $floorAgents $a.name -}}{{- end -}}
{{- if get .toolchains "claude" | default false -}}{{- $floorAgents = append $floorAgents "claude" -}}{{- end -}}

# bats test_tags=kind:nono
@test "the shared write floors END every agent profile and command sandbox; the narrowed claude_auth deny leaves the worktree grant live" {
  # Toolchain-independent pin (the claude-gated floor test above never runs on
  # a claude-off host): every rendered agent profile (pi, opencode, omp,
  # claude) ENDS with the expanded shared file-write floors (git-hooks +
  # LaunchAgents), and every map-shaped command edge sandbox in base.json
  # ends with them too (macOS seatbelt is last-match-wins, so a floor at the
  # tail cannot be overridden by any agent-specific/raw rule after it; the
  # renderer strips the raw axis on Linux, where the launcher refuses guarded
  # launches — no raw rules may render there).
  # Deny/allow interaction pin: the shared **/.claude/worktrees/** write grant
  # and the narrowed claude_auth_files deny (project entry = settings files,
  # mirroring claude.toml's seatbelt regex) BOTH render in the pi/opencode/omp
  # profiles; deny beats grant, so the render-shape check alone is not enough
  # — the glob probe below asserts the grant is LIVE (see the probe comment).
  local agents=( {{ range $n := $floorAgents }}"{{ $n }}" {{ end }})
  [ "${#agents[@]}" -gt 0 ] || skip "no agent nono profiles on this host"
  # Non-vacuity: the source-derived floors carry BOTH named floors — empty
  # floor data would satisfy every tail/all check below vacuously.
  run jq -e -n --argjson hooks '{{ $gitFloor | toJson }}' --argjson la '{{ $laFloor | toJson }}' '
    ($hooks | length) > 0 and ($la | length) > 0'
  assert_success
  local a f
  for a in "${agents[@]}"; do
    f="{{ $nonoProfiles }}/$a.json"
    assert_file_exists "$f"
{{- if eq .chezmoi.os "darwin" }}
    # The expanded shared floors are the LAST raw rules of the profile.
    run jq -e --argjson floors '{{ $floorsExp | toJson }}' '
      (.unsafe_macos_seatbelt_rules // []) as $u |
      ($floors | length) > 0 and
      ($u | length) >= ($floors | length) and
      ($u[($u | length) - ($floors | length):] == $floors)
    ' "$f"
    assert_success
{{- else }}
    # Linux: launcher fail-closed, so no raw seatbelt rules render.
    run jq -e '((.unsafe_macos_seatbelt_rules // []) | length) == 0' "$f"
    assert_success
{{- end }}
    if [ "$a" != claude ]; then
      run jq -e --argjson grant '{{ $wtGrants | toJson }}' --argjson deny '{{ $authDeny | toJson }}' --argjson roots "$(collapseRoots '{{ $authDeny | toJson }}')" '
        . as $r |
        # Collapse-aware deny presence (see collapseRoots): the native glob, or
        # the dir-literal that this host apply collapsed it to — the literal
        # must be the root prefix of that glob, never just any string.
        # (No apostrophes in this comment: it lives inside a single-quoted jq.)
        def kept($d): (($r.filesystem.deny | index($d)) != null) or
          (($d | startswith("~/")) and ($d | endswith("/**")) and
            (($d | rtrimstr("/**")) as $root |
              (any($roots[]; . == $root)) and (($r.filesystem.deny | index($root)) != null)));
        (all($grant[]; . as $g | ($r.filesystem.allow | index($g)) != null)) and
        (all($deny[]; kept(.)))
      ' "$f"
      assert_success
      # Glob interaction probe (doublestar semantics: ** crosses '/', * does
      # not; full-path match): the grant MATCHES a sample project worktree
      # path and NO rendered deny glob matches it (grant live, not shadowed
      # by a broad claude deny), while the narrowed claude_auth_files deny
      # still matches a sample project settings file.
      run jq -e --argjson grant '{{ $wtGrants | toJson }}' --argjson deny '{{ $authDeny | toJson }}' '
        def g2r:
          gsub("\\*\\*/"; "\u0001")
          | gsub("\\*\\*"; "\u0002")
          | gsub("\\*"; "\u0003")
          | gsub("\\?"; "\u0004")
          | gsub("(?<c>[.+\\[\\]^${}()|\\\\])"; "\u005c\(.c)")
          | gsub("\u0001"; "(.*/)?")
          | gsub("\u0002"; ".*")
          | gsub("\u0003"; "[^/]*")
          | gsub("\u0004"; "[^/]");
        def matches($p): ("^" + g2r + "$") as $re | ($p | test($re));
        .filesystem.deny as $d |
        (all($grant[]; matches("proj/.claude/worktrees/demo/app.py"))) and
        (any($d[]; matches("proj/.claude/worktrees/demo/app.py")) | not) and
        (any($deny[]; matches("proj/.claude/settings.local.json")))
      ' "$f"
      assert_success
    fi
  done
{{- if eq .chezmoi.os "darwin" }}
  # Every map-shaped command edge (from.session today, any future
  # from.<caller> map) carries a sandbox whose raw rules END with the
  # expanded shared floors; string "deny" edges (chezmoi, brew) have no
  # sandbox to check and are pinned deny-only in the control-axis test.
  run jq -e --argjson floors '{{ $floorsExp | toJson }}' '
    all(.command_policies.commands[].from[] | select(type == "object");
      (.sandbox | type) == "object" and
      ((.sandbox.unsafe_macos_seatbelt_rules // []) as $u |
        ($u | length) >= ($floors | length) and
        ($u[($u | length) - ($floors | length):] == $floors)))
  ' "{{ $nonoProfiles }}/base.json"
  assert_success
{{- else }}
  # Linux: no raw seatbelt rules in any command sandbox (launcher fail-closed).
  run jq -e '([.command_policies.commands[].from[] | select(type == "object")
    | (.sandbox.unsafe_macos_seatbelt_rules // []) | length] | add // 0) == 0' \
    "{{ $nonoProfiles }}/base.json"
  assert_success
{{- end }}
}
{{- /* Case-fold probe: grep -E is a lexical regex simulation over the rule
       extracted from the shared data, on literal synthetic paths. It proves
       the pattern shape only; SBPL flavor and host-kernel matching are NOT
       proven here — live macOS seatbelt enforcement requires host-terminal
       verification. The bracket classes avoid depending on any inline SBPL case
       flag; APFS is commonly case-insensitive. */ -}}
{{- $gitRe := "" -}}
{{- range $f := $gitFloor -}}{{- $gitRe = trimSuffix `"))` (trimPrefix `(deny file-write* (regex #"` $f) -}}{{- end -}}
{{- if eq .chezmoi.os "darwin" }}

# bats test_tags=kind:nono
@test "git-hooks floor regex case-folds .git/modules/hooks on literal paths" {
  local re='{{ $gitRe }}' want p
  case $re in
    '' | *'deny file-write'*) printf 'git-floor regex extraction failed (trimPrefix/trimSuffix marker missing)\n'; return 1 ;;
  esac
  local cases='match|repo/.git/hooks/pre-commit
match|REPO/.GIT/HOOKS/pre-commit
match|Repo/.Git/hooks/pre-commit
match|bare/foo.git/hooks/pre-commit
match|bare/FOO.GIT/Hooks/pre-commit
match|repo/.git/modules/sub/hooks/pre-commit
match|repo/.git/modules/Ext/Modules/deep/HOOks/pre-commit
nomatch|repo/hooks/pre-commit
nomatch|repo/src/git/hooks/pre-commit
nomatch|repo/.gitmodules
nomatch|repo/.gitignore/hooks/pre-commit
nomatch|repo/.git/worktrees/demo/hooks/pre-commit'
  while IFS='|' read -r want p; do
    [ -n "$p" ] || continue
    if printf '%s' "$p" | grep -Eq -- "$re"; then
      [ "$want" = match ] || { printf 'git floor OVERMATCHES %s\n' "$p"; return 1; }
    else
      [ "$want" = nomatch ] || { printf 'git floor MISSES %s\n' "$p"; return 1; }
    fi
  done <<<"$cases"
}
{{- end }}

