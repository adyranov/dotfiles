# bats test_tags=kind:greywall
@test "greywall pi profile allows managed additions" {
  assert_file_exists "{{ $greywallDir }}/learned/pi.json"
  run jsoncJq -e --slurpfile global "{{ $greywallDir }}/greywall.json" '
    .schemaVersion == 1 and
    (.credentials == $global[0].credentials) and
    (.filesystem.allowWrite | index("~/.config/pi/agent/sessions/**") != null) and
    (.filesystem.allowWrite | index("~/.config/pi/profiles/core/**") != null) and
    (.filesystem.allowWrite | index("~/.config/pi/profiles/factory/**") != null) and
    (.filesystem.allowWrite | index("~/.cache/pi/**") != null) and
    (.filesystem.allowWrite | index("/tmp/agents/pi/**") != null) and
    (.filesystem.allowRead | index("~/.config/pi/**") != null) and
    (.filesystem.allowRead | index("~/.cache/pi/**") != null) and
    (.filesystem.allowRead | index("/tmp/agents/pi/**") != null) and
    (.filesystem.denyRead | index("~/.local/share/opencode/auth.json") != null) and
    (.filesystem.denyWrite | index("~/.local/share/opencode/auth.json") != null) and
    (.filesystem.denyRead | index("~/.config/opencode/**") == null) and
    (.filesystem.denyRead | index("~/.config/omp/**") == null) and
    (.filesystem.denyRead | index("~/.local/share/opencode/**") == null) and
    (.filesystem.denyWrite | index("~/.config/opencode/**") == null) and
    (.filesystem.denyWrite | index("~/.config/omp/**") == null) and
    (.filesystem.denyWrite | index("~/.local/share/opencode/**") == null) and
    (.network.rules[] | select(.destination == "pi.dev" and (.port | tostring) == "443" and .action == "allow")) and
    ($global[0].filesystem.allowGitConfig == true)
  ' "{{ $greywallDir }}/learned/pi.json"
  assert_success
  run jsoncJq -e ".network.allowUnixSockets | index(\"~/.local/share/tmux\") != null" "{{ $greywallDir }}/learned/pi.json"
  assert_success
  run jsoncJq -e '.filesystem.denyWrite | index("~/.config/pi/**") == null' "{{ $greywallDir }}/learned/pi.json"
  assert_success
  run jsoncJq -e '.filesystem.denyWrite | index("~/.config/pi/profiles/core/**") == null' "{{ $greywallDir }}/learned/pi.json"
  assert_success
}

