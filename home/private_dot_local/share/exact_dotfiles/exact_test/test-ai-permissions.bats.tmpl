@test "claude config floor: pi/opencode/omp deny claude paths; claude owns its config; git-hooks + worktrees + bridge dirs" {
  # The claude config/auth tree (claude_auth_files) leaves the
  # unopenable base-tier deny so the claude profile can own it; every other
  # agent denies it. .git/hooks write-deny + the .claude/worktrees grant ride
  # every profile; the per-agent claude-bridge write dir rides pi alone
  # (pi-claude-bridge) — opencode's bridge grant and omp's were retracted
  # (473dddf6: no installable bridge release), so they render no bridge dir.
  local offenders="" claude_file="{{ $nonoProfiles }}/claude.json" a f
  check() { local n="$1"; shift; "$@" >/dev/null 2>&1 || offenders="$offenders $n"; }
  check "claude.json renders" test -f "$claude_file"
  for a in{{ range $na := $nonoAgents }} {{ $na.name }}{{ end }}; do
    f="{{ $nonoProfiles }}/${a}.json"
    check "$a denies claude config" denyHas "$f" '~/.config/claude/**'
    if [ "$a" = pi ]; then
      check "pi bridge config dir" jq -e '.filesystem.allow | index("~/.local/state/pi/claude-bridge") != null' "$f"
    fi
    check "$a claude worktrees grant" jq -e '.filesystem.allow | index("**/.claude/worktrees/**") != null' "$f"
{{- if eq .chezmoi.os "darwin" }}
    check "$a git-hooks write-deny" jq -e --argjson want '{{ $gitFloors | toJson }}' '(.unsafe_macos_seatbelt_rules // []) as $u | ($want | length) > 0 and (all($want[]; . as $r | ($u | index($r)) != null))' "$f"
{{- end }}
  done
  # The claude profile owns its tree: denies no claude path, writes its config,
  # carries the worktree grant (and the git-hooks seatbelt on macOS).
  check "claude denies no claude path" jq -e '.filesystem.deny | map(select(test("claude"))) | length == 0' "$claude_file"
  check "claude writes ~/.config/claude" jq -e '.filesystem.allow | index("~/.config/claude") != null' "$claude_file"
  check "claude claude worktrees grant" jq -e '.filesystem.allow | index("**/.claude/worktrees/**") != null' "$claude_file"
{{- if eq .chezmoi.os "darwin" }}
  check "claude git-hooks write-deny" jq -e --argjson want '{{ $gitFloors | toJson }}' '(.unsafe_macos_seatbelt_rules // []) as $u | ($want | length) > 0 and (all($want[]; . as $r | ($u | index($r)) != null))' "$claude_file"
{{- end }}
  [ -z "$offenders" ] || { printf 'claude floor-split (offenders):%s\n' "$offenders"; return 1; }
}
