# bats test_tags=toolchain:ai,kind:dcg
@test "dcg config and custom pack render with the user deny pack wired" {
  assert_file_exists "$HOME/.config/dcg/config.toml"
  assert_file_exists "$HOME/.config/dcg/packs/system.yaml"
  run grep -F 'custom_paths = ["~/.config/dcg/packs/*.yaml"]' "$HOME/.config/dcg/config.toml"
  assert_success
  local pack
  for pack in system package_managers github compute cloud kubernetes docker iac publish; do
    run grep -F "\"user.$pack\" = \"deny\"" "$HOME/.config/dcg/config.toml"
    assert_success
  done
  run grep -F 'kubectl-delete' "$HOME/.config/dcg/packs/kubernetes.yaml"
  assert_success
}

# bats test_tags=toolchain:ai,kind:dcg
@test "apply-time dcg checksum verifier is gone" {
  # The settled drop: the verifier wrote nothing, so it was never the
  # apply-collision source; its absence is pinned here.
  assert_file_not_exists "{{ $src }}/.chezmoiscripts/toolchains/ai/run_onchange_after_84_verify-dcg-checksum.sh.tmpl"
  local cb
  cb="$(chezmoiBin)"
  run "$cb" managed
  assert_success
  refute_output --partial "run_onchange_after_84_verify-dcg-checksum"
}

# bats test_tags=toolchain:ai,kind:dcg
@test "dcg hooks are installed at the paths nono write-denies" {
  assert_file_exists "$HOME/.config/opencode/plugins/dcg-guard.js"
  assert_file_exists "$HOME/.config/pi/agent/extensions/dcg-robot.ts"
  assert_file_exists "$HOME/.config/omp/agent/extensions/dcg-guard.ts"
  run readlink -f "$HOME/.config/pi/profiles/core/extensions/dcg-robot.ts"
  assert_success
  assert_output "$HOME/.config/pi/agent/extensions/dcg-robot.ts"
  run readlink -f "$HOME/.config/pi/profiles/factory/extensions/dcg-robot.ts"
  assert_success
  assert_output "$HOME/.config/pi/agent/extensions/dcg-robot.ts"
  run grep -F '"hook", "--robot", "--batch"' "$HOME/.config/omp/agent/extensions/dcg-guard.ts"
  assert_success
}

# bats test_tags=toolchain:ai,kind:dcg
@test "dcg hook keeps quoted-caret grep payloads on the posix dialect (0.15.3 semantics)" {
  # v0.15.3 (3a8c330, #520/#523/#524): a caret inside quotes no longer assembles
  # a cmd.exe word and windows.* packs activate only at real command positions,
  # so the hook refines this Bash payload to posix and allows it (the 0.15.2
  # deny was the pinned false positive). dcg test --dialect posix agrees.
  require_dcg
  local fixture='RUN_DIR="$SCRATCH_ROOT/ce-code-review/$RUN_ID"
git ls-files | grep -E '"'"'(^|/)(CODING_STANDARDS|CLAUDE|AGENTS)\.md$'"'"' || true'
  run dcg test --with-packs windows.filesystem --dialect posix "$fixture"
  assert_output --partial "ALLOWED"
  local payload
  payload=$(jq -nc --arg c "$fixture" '{tool_name:"Bash",tool_input:{command:$c}}')
  run bash -c 'printf "%s\n" "$1" | dcg hook --robot --batch' - "$payload"
  assert_output --partial '"decision":"allow"'
}

# bats test_tags=toolchain:ai,kind:dcg
@test "dcg hook still widens real windows shapes to deny" {
  # The pinned-negative class survives the 0.15.3 tightening: a caret at an
  # executable command position (g^it) is real cmd.exe assembly and must deny.
  require_dcg
  local payload
  payload=$(jq -nc '{tool_name:"Bash",tool_input:{command:"g^it reset --hard"}}')
  run bash -c 'printf "%s\n" "$1" | dcg hook --robot --batch' - "$payload"
  assert_output --partial '"decision":"deny"'
}

