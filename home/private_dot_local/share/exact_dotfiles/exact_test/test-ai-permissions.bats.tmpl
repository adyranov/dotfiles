{{- /* Loud-fail + resolution edges: a dotless entry in a sandbox list
      is a group reference — a typo FAILS the render naming it (net axis via
      the classify-refs classifier; fs axis via render-nono-cmd's pre-guard
      resolution), while a valid group ref resolves and its `$TMPDIR`-sentinel
      member expands before the profile sees it. The fixture templates are
      BAKED here and rendered at TEST time: each nested chezmoi boot re-runs
      the render-nono-cmd guard chain (one python spawn), so render-time
      nesting charged every routine apply extra chezmoi boots. The fixtures
      ride the shared deep-copy-set-path preamble. */ -}}
{{- $typoTpl := `{{- $r := includeTemplate "base/test/deep-copy-set-path" (dict "root" . "path" (list "ai" "base" "permissions" "apply" "sandbox" "git" "network" "allow_domain") "value" (list "git_forge_typo")) | mustFromJson -}}
{{- includeTemplate "base/ai/security/render-nono-cmd" (dict "root" $r) -}}` }}
{{- $fsTypoTpl := `{{- $r := includeTemplate "base/test/deep-copy-set-path" (dict "root" . "path" (list "ai" "base" "permissions" "apply" "sandbox" "git" "fs_read") "value" (list "no_such_fs_group_typo")) | mustFromJson -}}
{{- includeTemplate "base/ai/security/render-nono-cmd" (dict "root" $r) -}}` }}
{{- $fsGoodTpl := `{{- $r1 := includeTemplate "base/test/deep-copy-set-path" (dict "root" . "path" (list "ai" "base" "permissions" "apply" "sandbox" "git" "fs_read") "value" (list "core_unix" "agents_scratch" ".")) | mustFromJson -}}
{{- $r := includeTemplate "base/test/deep-copy-set-path" (dict "root" $r1 "path" (list "ai" "base" "permissions" "apply" "sandbox" "git" "fs_write") "value" (list "tmp_workspace" "agents_scratch" "/private/var/folders")) | mustFromJson -}}
{{- includeTemplate "base/ai/security/render-nono-cmd" (dict "root" $r) -}}` }}
{{- /* A protected path in a command-sandbox GRANT list (the guard's surviving
      job after the destination mechanism's removal) must fail the render —
      dir lists AND the file lists (fs_read_file joins the guard input). */ -}}
{{- $badGrantTpl := `{{- $r := includeTemplate "base/test/deep-copy-set-path" (dict "root" . "path" (list "ai" "base" "permissions" "apply" "sandbox" "git" "fs_read") "value" (list "~/.config/nono")) | mustFromJson -}}
{{- includeTemplate "base/ai/security/render-nono-cmd" (dict "root" $r) -}}` }}
{{- $badReadFileTpl := `{{- $r := includeTemplate "base/test/deep-copy-set-path" (dict "root" . "path" (list "ai" "base" "permissions" "apply" "sandbox" "git" "fs_read_file") "value" (list "~/.config/git/credentials")) | mustFromJson -}}
{{- includeTemplate "base/ai/security/render-nono-cmd" (dict "root" $r) -}}` }}
{{- /* Shared floors are load-bearing: an empty shared_write_denies must fail
      render-nono-cmd loudly (never silently render a floor-less sandbox).
      The fail() must be prefixed "render-nono-cmd: " (anti-echo: the fixture
      text quotes the template path WITHOUT a trailing colon) and name the key.
      Darwin-only: the Linux renderer strips the raw seatbelt axis entirely. */ -}}
{{- $noFloorsTpl := `{{- $r := includeTemplate "base/test/deep-copy-set-path" (dict "root" . "path" (list "ai" "base" "agents" "shared" "sandbox" "shared_write_denies") "value" (list)) | mustFromJson -}}
{{- includeTemplate "base/ai/security/render-nono-cmd" (dict "root" $r) -}}` }}

# bats test_tags=kind:nono
@test "sandbox resolvers loud-fail on typos, resolve fs group refs, refuse protected grants" {
  # Reason markers: the loud-fail reason must be IN the output — EXIT!=0 plus
  # the typo name alone is vacuously green on a fixture-internal crash (the
  # name sits on the echoed template line). Both typo axes route through
  # expand-path-groups, whose fail() carries this marker. The fsGood EXIT:0
  # canary proves the nested-render harness itself works (and that ordinary
  # source rendering stays usable without the destination machinery).
  # Violations→fail wiring: a protected sandbox grant — dir list and file
  # list — must die in the nested render-nono-cmd naming sandbox-grant-guard
  # and the entry (only these fixtures reach its fail line), and an empty
  # shared_write_denies must die naming the key (macOS; the floors are
  # load-bearing).
  local cb json offenders=""
  cb="$(chezmoiBin)"

  cat >"$BATS_TEST_TMPDIR/net-typo.tmpl" <<'FIXTURE'
{{ $typoTpl }}
FIXTURE
  cat >"$BATS_TEST_TMPDIR/fs-typo.tmpl" <<'FIXTURE'
{{ $fsTypoTpl }}
FIXTURE
  cat >"$BATS_TEST_TMPDIR/fs-good.tmpl" <<'FIXTURE'
{{ $fsGoodTpl }}
FIXTURE
  cat >"$BATS_TEST_TMPDIR/bad-grant.tmpl" <<'FIXTURE'
{{ $badGrantTpl }}
FIXTURE
  cat >"$BATS_TEST_TMPDIR/bad-readfile.tmpl" <<'FIXTURE'
{{ $badReadFileTpl }}
FIXTURE
{{- if eq .chezmoi.os "darwin" }}
  cat >"$BATS_TEST_TMPDIR/no-floors.tmpl" <<'FIXTURE'
{{ $noFloorsTpl }}
FIXTURE
{{- end }}

  runCapped "$cb" execute-template -f "$BATS_TEST_TMPDIR/net-typo.tmpl" || return 1
  [ "$status" -ne 0 ] || offenders="$offenders net:typo.fails-render"
  [[ "$output" == *git_forge_typo* ]] || offenders="$offenders net:typo.named"
  [[ "$output" == *"expand-path-groups: unknown path group"* ]] || offenders="$offenders net:typo.reason-marker"

  runCapped "$cb" execute-template -f "$BATS_TEST_TMPDIR/fs-typo.tmpl" || return 1
  [ "$status" -ne 0 ] || offenders="$offenders fs:typo.fails-render"
  [[ "$output" == *no_such_fs_group_typo* ]] || offenders="$offenders fs:typo.named"
  [[ "$output" == *"expand-path-groups: unknown path group"* ]] || offenders="$offenders fs:typo.reason-marker"

  runCapped "$cb" execute-template -f "$BATS_TEST_TMPDIR/fs-good.tmpl" || return 1
  [ "$status" -eq 0 ] || offenders="$offenders fs-resolve:canary.renders"
  json="$(sed -n '/^{/,$p' <<<"$output")"
  jq -e '(.commands.git.from.session.sandbox.fs_read | index("/bin") != null) and
         (.commands.git.from.session.sandbox.fs_write | index("'"${TMPDIR:-/tmp}"'" | rtrimstr("/")) != null)' <<<"$json" >/dev/null ||
    offenders="$offenders fs-resolve:group-ref+tmpdir-expanded"
  [[ "$output" != *'$TMPDIR'* ]] || offenders="$offenders fs-resolve:no.tmpdir-leak"

  runCapped "$cb" execute-template -f "$BATS_TEST_TMPDIR/bad-grant.tmpl" || return 1
  { [ "$status" -ne 0 ] && [[ "$output" == *sandbox-grant-guard* ]] && [[ "$output" == *~/.config/nono* ]]; } || offenders="$offenders grant-guard:wiring.fails-render"

  runCapped "$cb" execute-template -f "$BATS_TEST_TMPDIR/bad-readfile.tmpl" || return 1
  { [ "$status" -ne 0 ] && [[ "$output" == *sandbox-grant-guard* ]] && [[ "$output" == *~/.config/git/credentials* ]]; } || offenders="$offenders readfile-guard:wiring.fails-render"

{{- if eq .chezmoi.os "darwin" }}
  # Shared floors are load-bearing: an empty shared_write_denies (the key
  # present-but-empty is the same guard path as absent) must die in the
  # nested render-nono-cmd, naming the key.
  runCapped "$cb" execute-template -f "$BATS_TEST_TMPDIR/no-floors.tmpl" || return 1
  { [ "$status" -ne 0 ] && [[ "$output" == *"render-nono-cmd: "* ]] && [[ "$output" == *shared_write_denies* ]]; } || offenders="$offenders floors:empty.fails-render"
{{- end }}

  if [ -n "$offenders" ]; then
    printf 'loud-fail/resolve fixtures (offending checks):%s\n' "$offenders"
    return 1
  fi
}

# bats test_tags=kind:nono
@test "cross-agent grants live once in shared.toml and never in per-agent files" {
  local dir="{{ $src }}/.chezmoidata/base/ai/agents"
  run grep -l -F -e 'infer01' -e '**/.codegraph/**' -e '**/.slim/worktrees/**' -e '~/.codegraph' \
    "$dir/pi.toml" "$dir/opencode.toml" "$dir/omp.toml"
  assert_failure
  run grep -c -F 'infer01' "$dir/shared.toml"
  assert_output "1"
  run grep -c -F '**/.codegraph/**' "$dir/shared.toml"
  assert_output "1"
  run grep -c -F '~/.codegraph' "$dir/shared.toml"
  assert_output "1"
  run grep -c -F '**/.slim/worktrees/**' "$dir/shared.toml"
  assert_output "1"
  # The scratch pair is renderer-interpolated: absent from data (omp keeps its
  # /tmp/agents/omp entry only as a unix-socket grant).
  run grep -c -F '/tmp/agents/' "$dir/pi.toml"
  assert_output "0"
  run grep -c -F '/tmp/agents/' "$dir/opencode.toml"
  assert_output "0"
  run grep -c -F '/tmp/agents/omp' "$dir/omp.toml"
  assert_output "1"
}

# bats test_tags=toolchain:ai,kind:launcher
@test "launcher exports relocated gh state for pi and opencode, never omp" {
  # gh session tier: the GH_* exports point gh's state into
  # ~/.cache/gh-sandbox (granted in the pi/opencode profiles); omp stays
  # credential-free and its env block carries no gh state.
  local a env_out
  for a in pi oc; do
    launcher_probe "$a" --print-env factory
    # run grep overwrites $output: pin the probe output first.
    env_out="$output"
    run grep -F 'export GH_CONFIG_DIR="$HOME/.cache/gh-sandbox/config"' <<<"$env_out"
    assert_success
    run grep -F 'export GH_DATA_DIR="$HOME/.cache/gh-sandbox/data"' <<<"$env_out"
    assert_success
    run grep -F 'export GH_CACHE_DIR="$HOME/.cache/gh-sandbox/cache"' <<<"$env_out"
    assert_success
  done
  launcher_probe omp --print-env
  refute_output --partial 'GH_CONFIG_DIR'
  refute_output --partial 'GH_DATA_DIR'
  refute_output --partial 'GH_CACHE_DIR'
}

# bats test_tags=toolchain:ai,kind:launcher
