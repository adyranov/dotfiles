     own sandbox.network.allow key removed, the shared baseline still supplies
     the model-endpoint grant and its plain hosts survive. Render one no-LAN
     profile per agent for the folded overlay loop. */ -}}
{{- $noLan := dict -}}
{{- $noLanHosts := dict -}}
{{- range $a := $nonoAgents -}}
{{-   $noLanNet := merge (dict) (dig "sandbox" "network" dict (index $.ai.base.agents $a.name)) -}}
{{-   $_ := unset $noLanNet "allow" -}}
{{-   $noLanRoot := includeTemplate "base/test/deep-copy-set-path" (dict "root" $ "path" (list "ai" "base" "agents" $a.name "sandbox" "network") "value" $noLanNet) | mustFromJson -}}
{{-   $_ := set $noLan $a.name (includeTemplate "base/ai/security/render-nono-profile" (dict "root" $noLanRoot "agent" $a.name) | mustFromJson) -}}
{{-   $_ := set $noLanHosts $a.name (dig "sandbox" "network" "allow_domain" list (index $.ai.base.agents $a.name)) -}}
{{- end }}

# bats test_tags=kind:nono
@test "nono per-agent overlay set extends base with managed additions" {
  # Folded per-agent overlay tests: one runtime loop over $nonoAgents; each
  # case arm runs ONE labeled-array jq over the profile (the program labels
  # every conjunct and prints only failing labels) plus the non-jq probes,
  # offenders collected and every offending agent+assertion named in a single
  # failure.
  local offenders="" agent file
  checkOverlay() {
    local name="$1"
    shift
    if ! "$@" >/dev/null 2>&1; then
      offenders="$offenders $agent:$name"
    fi
  }
  checkLabels() {
    # One jq pass per profile; empty output = all conjuncts green.
    local out l
    if ! out=$(jq -r "$1" "$2" 2>/dev/null); then
      offenders="$offenders $agent:profile-unreadable-by-jq"
      return
    fi
    while IFS= read -r l; do
      if [ -n "$l" ]; then offenders="$offenders $agent:$l"; fi
    done <<<"$out"
  }
  # The provider-domain overlay is gone: the base catalog grants them.
  agent="base"
  checkOverlay "base grants provider domains" jq -e '
    (.network.allow_domain) as $a |
    all(["*.openai.com", "opencode.ai"][];
        . as $h | ($a | index($h)) != null)
  ' "{{ $nonoProfiles }}/base.json"
  for agent in{{- range $a := $nonoAgents }} {{ $a.name }}{{- end }}; do
    file="{{ $nonoProfiles }}/${agent}.json"
    checkOverlay "profile file exists" test -f "$file"
    checkOverlay "nono profile validate" nono profile validate "$file"
    case "$agent" in
{{- if .toolchains.pi }}
      pi)
        # Hook write-denials ride the top-level seatbelt denies (macOS only;
        # the renderer strips the field on Linux).
        checkLabels '
          [
            (select(.extends != "base") | "extends == base")
            ,(select((.filesystem.allow | index("~/.config/pi/agent")) == null) | "allow ~/.config/pi/agent")
            ,(select((.filesystem.allow | index("~/.config/pi/agent/sessions")) == null) | "allow ~/.config/pi/agent/sessions")
            ,(select((.filesystem.allow | index("~/.config/pi/profiles/core")) == null) | "allow ~/.config/pi/profiles/core")
            ,(select((.filesystem.allow | index("~/.config/pi/profiles/factory")) == null) | "allow ~/.config/pi/profiles/factory")
            ,(select((.filesystem.allow | index("~/.cache/pi")) == null) | "allow ~/.cache/pi")
            ,(select((.filesystem.read | index("~/.pi")) == null) | "read ~/.pi (footer legacy scan)")
            ,(select((.filesystem.allow | index("~/.codegraph")) == null) | "allow ~/.codegraph (codegraph MCP state)")
            ,(select((.filesystem.allow | index("/tmp/agents/pi")) == null) | "allow /tmp/agents/pi")
            ,(select((.filesystem.allow | index("**/.codegraph/**")) == null) | "allow **/.codegraph/**")
            ,(select((.filesystem.allow | index("**/.slim/worktrees/**")) == null) | "allow **/.slim/worktrees/**")
            ,(select((.filesystem.read | index("**/node_modules/@earendil-works/pi-coding-agent/**")) == null) | "read pi-coding-agent package")
            ,(select((.filesystem.read | index("~/.config/gh/config.yml")) == null) | "read gh config.yml (gh session tier)")
            ,(select((.filesystem.allow | index("~/.cache/gh-sandbox")) == null) | "allow relocated gh state (gh session tier)")
{{- if eq .chezmoi.os "darwin" }}
            ,(select((.unsafe_macos_seatbelt_rules | index("(deny file-write* (subpath \"{{ trimSuffix "/" .chezmoi.homeDir }}/.config/pi/agent/extensions\"))")) == null) | "seatbelt deny agent extensions writes")
            ,(select((.unsafe_macos_seatbelt_rules | index("(deny file-write* (subpath \"{{ trimSuffix "/" .chezmoi.homeDir }}/.config/pi/profiles/core/extensions\"))")) == null) | "seatbelt deny core extensions writes")
            ,(select((.unsafe_macos_seatbelt_rules | index("(deny file-write* (subpath \"{{ trimSuffix "/" .chezmoi.homeDir }}/.config/pi/profiles/factory/extensions\"))")) == null) | "seatbelt deny factory extensions writes")
            ,(select((.unsafe_macos_seatbelt_rules | index("(allow ipc-sysv-sem)")) == null) | "seatbelt ipc-sysv-sem (fff LMDB)")
            ,(select((.unsafe_macos_seatbelt_rules | index("(allow user-preference-read)")) == null) | "seatbelt user-preference-read")
{{- end }}
            ,(select((.filesystem.deny | index("~/.config/pi/agent/auth.json")) != null) | "own auth store not denied")
            ,(select((.filesystem.allow | index("~/.config/pi/agent/auth.json")) == null) | "allow own auth store")
            ,(select((.filesystem.deny | index("~/.local/share/opencode/auth.json")) == null) | "denies opencode auth store")
            ,(select((.filesystem.deny | index("~/.config/omp/agent/auth.json")) == null) | "denies omp auth store")
            ,(select((.network.allow_domain | index("infer01")) == null) | "network infer01")
          ] | .[]
        ' "$file"
{{ $piNl := index $noLan "pi" -}}
        checkOverlay "no-LAN render keeps shared model endpoint" test present = "{{ if contains "infer01" ($piNl | toJson) }}present{{ else }}missing{{ end }}"
{{- range $h := (index $noLanHosts "pi") }}
        checkOverlay "no-LAN render keeps plain host {{ $h }}" test present = "{{ if has $h (dig "network" "allow_domain" list $piNl) }}present{{ else }}missing{{ end }}"
{{- end }}
        ;;
{{- end }}
{{- if .toolchains.opencode }}
      opencode)
        checkLabels '
          [
            (select(.extends != "base") | "extends == base")
            ,(select((.filesystem.allow | index("~/.local/share/opencode")) == null) | "allow ~/.local/share/opencode")
            ,(select((.filesystem.allow | index("~/.local/state/opencode")) == null) | "allow ~/.local/state/opencode")
            ,(select((.filesystem.allow | index("/tmp/agents/opencode")) == null) | "allow /tmp/agents/opencode")
            ,(select((.filesystem.allow | index("~/.cache/opencode")) == null) | "allow ~/.cache/opencode")
            ,(select((.filesystem.allow | index("~/.local/share/engram")) == null) | "allow ~/.local/share/engram (group-ref expansion)")
            ,(select((.filesystem.allow | index("**/.codegraph/**")) == null) | "allow **/.codegraph/**")
            ,(select((.filesystem.allow | index("**/.slim/worktrees/**")) == null) | "allow **/.slim/worktrees/**")
            ,(select((.filesystem.read | index("~/.config/opencode/plugins/dcg-guard.js")) == null) | "read dcg-guard plugin")
            ,(select((.filesystem.read | index("~/.config/gh/config.yml")) == null) | "read gh config.yml (gh session tier)")
            ,(select((.filesystem.allow | index("~/.cache/gh-sandbox")) == null) | "allow relocated gh state (gh session tier)")
            ,(select((.filesystem.deny | index("~/.config/pi/agent/auth.json")) == null) | "denies pi agent auth store")
            ,(select((.filesystem.deny | index("~/.config/pi/profiles/core/auth.json")) == null) | "denies pi core auth store")
            ,(select((.filesystem.deny | index("~/.config/pi/profiles/factory/auth.json")) == null) | "denies pi factory auth store")
            ,(select((.filesystem.deny | index("~/.config/omp/agent/auth.json")) == null) | "denies omp auth store")
            ,(select((.filesystem.deny | index("~/.local/share/opencode/auth.json")) != null) | "own auth store not denied")
            ,(select((.filesystem.read_file // [] | index("~/Library/Keychains/login.keychain-db")) != null) | "keychain read grant present")
            ,(select((.filesystem.bypass_protection // [] | index("~/Library/Keychains/login.keychain-db")) != null) | "keychain bypass grant present")
{{- if eq .chezmoi.os "darwin" }}
            ,(select((.unsafe_macos_seatbelt_rules | index("(allow user-preference-read)")) == null) | "seatbelt user-preference-read")
{{- end }}
          ] | .[]
        ' "$file"
{{ $ocNl := index $noLan "opencode" -}}
        checkOverlay "no-LAN render keeps shared model endpoint" test present = "{{ if contains "infer01" ($ocNl | toJson) }}present{{ else }}missing{{ end }}"
{{- range $h := (index $noLanHosts "opencode") }}
        checkOverlay "no-LAN render keeps plain host {{ $h }}" test present = "{{ if has $h (dig "network" "allow_domain" list $ocNl) }}present{{ else }}missing{{ end }}"
{{- end }}
        ;;
{{- end }}
{{- if (get .toolchains "omp" | default false) }}
      omp)
        # XDG relocation: whole data/state/cache roots, no agent.db leaf
        # literals (WAL sidecars appear dynamically).
        checkLabels '
          [
            (select(.extends != "base") | "extends == base")
            ,(select((.filesystem.allow | index("~/.local/share/omp")) == null) | "allow ~/.local/share/omp")
            ,(select((.filesystem.allow | index("~/.local/share/engram")) == null) | "allow ~/.local/share/engram (group-ref expansion)")
            ,(select((.filesystem.allow | index("~/.local/state/omp")) == null) | "allow ~/.local/state/omp")
            ,(select((.filesystem.allow | index("/tmp/agents/omp")) == null) | "allow /tmp/agents/omp")
            ,(select((.filesystem.allow | index("**/.codegraph/**")) == null) | "allow **/.codegraph/**")
            ,(select((.filesystem.allow | index("~/.codegraph")) == null) | "allow ~/.codegraph (codegraph MCP state)")
            ,(select((.filesystem.allow | index("**/.slim/worktrees/**")) == null) | "allow **/.slim/worktrees/**")
            ,(select((.filesystem.allow | index("~/.config/omp/agent")) == null) | "allow agent root")
            ,(select((.filesystem.allow | index("~/.config/omp/profiles")) == null) | "allow named-profile roots")
            ,(select((.filesystem.deny | index("~/.config/omp/security.yml")) != null) | "own security.yml not denied")
            ,(select((.filesystem.deny | index("~/.config/agents")) != null) | "shared agents config denied (blocks omp skills)")
            ,(select((.filesystem.deny | index("~/.config/pi/agent/auth.json")) == null) | "denies pi agent auth store")
            ,(select((.filesystem.unix_socket_subtree | index("~/.local/state/omp/run")) == null) | "unix socket subtree omp run")
            ,(select((.unsafe_macos_seatbelt_rules | index("(deny file-write* (subpath \"{{ trimSuffix "/" .chezmoi.homeDir }}/.config/omp/agent/extensions\"))")) == null) | "seatbelt deny agent extensions writes")
            ,(select((.unsafe_macos_seatbelt_rules | index("(deny file-write* (regex #\"{{ trimSuffix "/" .chezmoi.homeDir }}/.\\.config/omp/profiles/[^/]+/agent/extensions\"))")) == null) | "seatbelt regex deny profile extensions writes")
            ,(select((.environment.deny_vars | index("GITHUB_TOKEN")) == null) | "denies GITHUB_TOKEN")
            ,(select((.environment.deny_vars | index("GH_TOKEN")) == null) | "denies GH_TOKEN")
            ,(select((.filesystem.read | index("~/.config/gh/config.yml")) != null) | "no gh config read (credential-free)")
            ,(select((.filesystem.allow | index("~/.cache/gh-sandbox")) != null) | "no relocated gh state write (credential-free)")
            ,(select((.network.allow_domain | index("infer01")) == null) | "network infer01")
          ] | .[]
        ' "$file"
{{ $ompNl := index $noLan "omp" -}}
        checkOverlay "no-LAN render keeps shared model endpoint" test present = "{{ if contains "infer01" ($ompNl | toJson) }}present{{ else }}missing{{ end }}"
{{- range $h := (index $noLanHosts "omp") }}
        checkOverlay "no-LAN render keeps plain host {{ $h }}" test present = "{{ if has $h (dig "network" "allow_domain" list $ompNl) }}present{{ else }}missing{{ end }}"
{{- end }}
        ;;
{{- end }}
      *) offenders="$offenders $agent:no-overlay-case" ;;
    esac
  done
  if [ -n "$offenders" ]; then
    printf 'per-agent overlay violations (offending agents):%s\n' "$offenders"
    return 1
  fi
}

