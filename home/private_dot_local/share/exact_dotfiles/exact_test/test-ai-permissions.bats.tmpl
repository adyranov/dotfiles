}

# bats test_tags=toolchain:opencode,kind:config
@test "opencode.json autoupdate stays non-mutating" {
  run jq -e '.autoupdate != true' "$HOME/.config/opencode/opencode.json"
  assert_success
}

# bats test_tags=toolchain:opencode,kind:permission
@test "opencode.json bash defaults to allow" {
  run jq -e '.permission.bash["*"] == "allow"' "$HOME/.config/opencode/opencode.json"
  assert_success
}

# bats test_tags=toolchain:opencode,kind:permission
@test "opencode.json path permissions block key secrets" {
  run jq -e '
    .permission.read["**/.env"] == "deny" and
    .permission.read["**/.npmrc"] == "deny" and
    .permission.edit["**/.env"] == "deny"
  ' "$HOME/.config/opencode/opencode.json"
  assert_success
}


# bats test_tags=toolchain:opencode,kind:permission
@test "opencode.json edit denies infra config" {
  run jq -e '
