# --- Shared bash permission tests (generated for all enabled agents) ---

{{- $permAgents := list -}}
{{- if .toolchains.pi -}}
{{-   $permAgents = append $permAgents (dict "name" "pi" "config" "$HOME/.config/pi/agent/extensions/pi-permission-system/config.json" "tag" "toolchain:pi") -}}
{{- end }}
{{- if .toolchains.opencode -}}
{{-   $permAgents = append $permAgents (dict "name" "opencode" "config" "$HOME/.config/opencode/opencode.json" "tag" "toolchain:opencode") -}}
{{- end -}}

{{- range $agent := $permAgents }}

# bats test_tags={{ $agent.tag }},kind:permission
@test "{{ $agent.name }} bash: core deny rules" {
  run jq -e '
    .permission.bash["git * push --force*"] == "deny" and
    .permission.bash["rm -rf /*"] == "deny" and
    .permission.bash["sudo *"] == "deny" and
    .permission.bash["chezmoi apply"] == "deny" and
    (.permission.bash["chezmoi apply *"] | not) and
    (.permission.bash["gh auth token"] == "deny" or .permission.bash["gh auth token"] == "ask") and
    (.permission.bash["mise run apply"] == "deny" or .permission.bash["mise run apply"] == "ask")
  ' "{{ $agent.config }}"
  assert_success
}
{{- end }}

# --- Per-agent permission settings (from ai path data and package policy) ---

{{- $greywallDir := "$HOME/.config/greywall" }}
{{- if eq .host.distro.family "darwin" }}
{{- $greywallDir = "$HOME/Library/Application Support/greywall" }}
{{- end }}
{{- if ne .host.type "ephemeral" }}
{{- $agentDeny := (includeTemplate "base/helpers/load-section" (dict "root" . "section" "ai.permissions.agent" "required" true) | mustFromJson) }}
{{- $denyPaths := index $agentDeny "deny" | default list | uniq | sortAlpha }}

{{- if eq .host.distro.family "darwin" }}
# bats test_tags=kind:greywall
@test "greywall macOS config path points at managed config" {
  run readlink "$HOME/Library/Application Support/greywall"
  assert_success
  assert_output "$HOME/.config/greywall"
}
{{- end }}

# bats test_tags=kind:greywall
@test "greywall.json is deployed from ai permissions" {
  assert_file_exists "{{ $greywallDir }}/greywall.json"
  run jq -e '
    .filesystem.defaultDenyRead == true and
    (.filesystem.allowRead | index("~/.config/herdr/**") != null) and
    (.filesystem.allowRead | index("~/.local/share/herdr") == null) and
    (.filesystem.allowRead | index("~/.local/share/herdr/**") == null) and
    (.filesystem.allowWrite | index("~/.config/herdr/**") != null) and
    (.filesystem.allowWrite | index("~/.local/share/herdr") == null) and
    (.filesystem.allowWrite | index("~/.local/share/herdr/**") == null) and
    (.filesystem.denyRead | index("~/.ssh/id_*") != null) and
    (.filesystem.denyWrite | index("**/.env") != null) and
    (.command.allow | not) and
    (.command.deny | index("chezmoi apply") != null) and
    (.command.deny | index("chezmoi apply *") == null) and
    .network.proxyUrl == "socks5://localhost:43052" and
    (.network.rules[] | select(.destination == "api.anthropic.com" and (.port | tostring) == "443" and .action == "allow")) and
    .ssh.allowedHosts == ["github.com"] and
    .ssh.inheritDeny == true and
    (.network.allowUnixSockets | index("~/.config/herdr") != null)
  ' "{{ $greywallDir }}/greywall.json"
  assert_success
}

# bats test_tags=kind:greywall,toolchain:ai
@test "greywall command policy includes AI package denies" {
  assert_file_exists "{{ $greywallDir }}/greywall.json"
  run jq -e '
    (.command.allow | not) and
    (.command.deny | index("hf auth *") != null) and
    (.command.deny | index("sudo *") != null) and
    (.command.deny | index("chezmoi apply") != null)
  ' "{{ $greywallDir }}/greywall.json"
  assert_success
}

# bats test_tags=kind:greywall
@test "greywall pi profile allows managed additions" {
  assert_file_exists "{{ $greywallDir }}/learned/pi.json"
  run jq -e --slurpfile global "{{ $greywallDir }}/greywall.json" '
    .schemaVersion == 1 and
    (.credentials == $global[0].credentials) and
    (.filesystem.allowWrite | index("~/.config/pi/agent/sessions/**") != null) and
    (.filesystem.allowRead | index("~/.config/pi/**") != null) and
    (.network.rules[] | select(.destination == "pi.dev" and (.port | tostring) == "443" and .action == "allow"))
  ' "{{ $greywallDir }}/learned/pi.json"
  assert_success
  run jq -e ".network.allowUnixSockets | index(\"~/.config/herdr\") != null" "{{ $greywallDir }}/learned/pi.json"
  assert_success
}

# bats test_tags=kind:greywall
@test "greywall opencode profile allows shared and sandbox paths" {
  assert_file_exists "{{ $greywallDir }}/learned/opencode.json"
  run jq -e --slurpfile global "{{ $greywallDir }}/greywall.json" '
    .schemaVersion == 1 and
    (.credentials == $global[0].credentials) and
    (.filesystem.allowWrite | index("~/.local/share/opencode") != null) and
    (.filesystem.allowRead | index("~/.config/opencode/**") != null) and
    (.network.forwardPorts // [] | map(tostring) | index("19432") != null)
  ' "{{ $greywallDir }}/learned/opencode.json"
  assert_success
  run jq -e ".network.allowUnixSockets | index(\"~/.config/herdr\") != null" "{{ $greywallDir }}/learned/opencode.json"
  assert_success
}

# bats test_tags=kind:greywall
@test "greywall global policy includes shared network hosts" {
  assert_file_exists "{{ $greywallDir }}/greywall.json"
  run jq -e '
    (.network.rules[] | select(.destination == "api.anthropic.com" and (.port | tostring) == "443" and .action == "allow")) and
    (.network.rules[] | select(.destination == "api.github.com" and (.port | tostring) == "443" and .action == "allow")) and
    (.network.rules[] | select(.destination == "registry.npmjs.org" and (.port | tostring) == "443" and .action == "allow")) and
    ((.network.rules | map(.destination) | index("brave.com")) | not)
  ' "{{ $greywallDir }}/greywall.json"
  assert_success
}

# bats test_tags=toolchain:pi,toolchain:opencode,kind:greywall
@test "greywall base config allows engram loopback outbound" {
  run jq -e '.network.allowLocalOutbound == true' "{{ $greywallDir }}/greywall.json"
  assert_success
  run jq -e '(.network.forwardPorts // []) | index(7437) != null' "{{ $greywallDir }}/greywall.json"
  assert_success
}

# bats test_tags=kind:greywall
@test "greywall pi learned profile is valid JSON" {
  assert_file_exists "{{ $greywallDir }}/learned/pi.json"
  run jq -e '.schemaVersion == 1' "{{ $greywallDir }}/learned/pi.json"
  assert_success
}

{{ $enabledAuth := includeTemplate "base/ai/resolve-enabled-auth-providers" (dict "root" .) | mustFromJson }}
# bats test_tags=kind:greywall
@test "greywall credentials inject enabled API keys" {
  assert_file_exists "{{ $greywallDir }}/greywall.json"
  run jq -e --argjson expected '{{ $enabledAuth.enabled_api_key_envs | sortAlpha | toJson }}' '
    . as $root |
    all($expected[]; . as $k | ($root.credentials.inject | index($k) != null)) and
    all($expected[]; . as $k | ($root.credentials.secrets | index($k) | not))
  ' "{{ $greywallDir }}/greywall.json"
  assert_success
}

{{- end }}
