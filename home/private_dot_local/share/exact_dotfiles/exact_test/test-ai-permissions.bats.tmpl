#!/usr/bin/env bats

# bats file_tags=suite:ai

load 'common-helper'

setup() {
  common_setup
}

# --- OpenCode config shape: no interactive permission layer; the managed
#     single-key external_directory allow is the only key agents carry; the
#     sandbox is the enforcer ---

{{- if .toolchains.opencode }}

# bats test_tags=toolchain:opencode,kind:config
@test "opencode.json autoupdate stays non-mutating" {
  run jsoncJq -e '.autoupdate != true' "$HOME/.config/opencode/opencode.jsonc"
  assert_success
}

# bats test_tags=toolchain:opencode,kind:permission
@test "opencode configs carry no in-agent permission map beyond the managed external_directory allow" {
  for file in \
    "$HOME/.config/opencode/opencode.jsonc" \
    "$HOME/.config/opencode/profiles/core/opencode.jsonc" \
    "$HOME/.config/opencode/profiles/factory/opencode.jsonc"; do
    run jsoncJq -e '
      ((.permission == null) or (.permission == {"external_directory": "allow"})) and
      (.agent.plan | has("permission") | not)' "$file"
    assert_success
  done
}
{{- end }}

# --- Nono sandbox profiles ---

{{- if ne .host.type "ephemeral" }}
{{- $nonoProfiles := "$HOME/.config/nono/profiles" }}
{{- $src := .chezmoi.sourceDir }}
{{- $creds := includeTemplate "base/ai/auth/render-credentials" (dict "root" .) | mustFromJson }}
{{- /* Routed names and the gap set, derived from the data the renderer reads. */ -}}
{{- $routedNames := list -}}
{{- range $r := ($creds.routes | default list) -}}{{- $routedNames = append $routedNames $r.name -}}{{- end -}}
{{- $routedNames = $routedNames | uniq | sortAlpha -}}
{{- $sessionRouteNames := list -}}
{{- if $creds.routes_enabled -}}
{{-   range $r := ($creds.routes | default list) -}}{{-   $sessionRouteNames = append $sessionRouteNames (index $r "custom_name" | default (index $r "preset") | default (index $r "name" | lower)) -}}{{-   end -}}
{{- end -}}
{{- $sessionRouteNames = $sessionRouteNames | uniq | sortAlpha -}}
{{- $allRouteNames := $sessionRouteNames -}}
{{- $netCredsRender := includeTemplate "base/ai/security/render-nono-net" (dict "root" . "credentials" $creds) | mustFromJson -}}
{{- $applyData := (includeTemplate "base/helpers/load-section" (dict "root" . "section" "ai.permissions.apply" "required" false) | mustFromJson) }}
{{- $applyDests := includeTemplate "base/ai/security/uniq-sort" (index $applyData "destinations" | default list) | mustFromJson }}
{{- /* Presence pins are derived at render time from the data: concat every
   [network.allow_domain] category value (base categories carry literals
   only — group refs are sandbox-side by design). */ -}}
{{- $netData := (includeTemplate "base/helpers/load-section" (dict "root" . "section" "ai.permissions.network" "required" false) | mustFromJson) -}}
{{- $wantHosts := list -}}
{{- range $hosts := (index $netData "allow_domain" | default dict) -}}
{{-   $wantHosts = concat $wantHosts ($hosts | default list) -}}
{{- end -}}
{{- $wantHosts = includeTemplate "base/ai/security/uniq-sort" $wantHosts | mustFromJson }}
{{- /* Destination parents computed template-side (parent-dir template is the
   single source of the parent idiom; the jq `def parent` copy is gone). */ -}}
{{- $applyPairs := list -}}
{{- range $d := $applyDests -}}
{{-   $applyPairs = append $applyPairs (dict "dest" $d "parent" (includeTemplate "base/ai/security/parent-dir" $d)) -}}
{{- end }}

# bats test_tags=kind:nono
@test "nono base profile is deployed and valid" {
  assert_file_exists "{{ $nonoProfiles }}/base.json"
  run nono profile validate "{{ $nonoProfiles }}/base.json"
  assert_success
}

# bats test_tags=kind:nono
@test "filesystem rules render as native globs verbatim" {
  # Glob shapes survive to the rendered profile untouched; the concretizer is gone.
  assert_file_not_exists "{{ $src }}/.chezmoitemplates/base/ai/security/concretize-paths"
  assert_file_not_exists "{{ $src }}/.chezmoitemplates/base/ai/security/cached-run"
  run jq -e '
    (.filesystem.deny | index("**/.env") != null) and
    (.filesystem.deny | index("**/.aws/**") != null) and
    ((.filesystem.deny + .filesystem.read + .filesystem.allow)
      | all(test("[?[\\]{}]") | not))
  ' "{{ $nonoProfiles }}/base.json"
  assert_success
}

# bats test_tags=kind:nono
@test "base profile has no tilde-anchored /** glob whose root exists (SIGILL strip)" {
  # nono walks existing-root `~/X/**` at sandbox start (SIGILL at scale); the
  # renderer must collapse those to the literal root prefix. Missing roots stay native.
  local root
  while IFS= read -r root; do
    if [ -d "${root/#\~/$HOME}" ]; then
      echo "unstripped tilde-tail glob: $root"
      false
    fi
  done < <(jq -r '[.filesystem.allow[], .filesystem.read[], .filesystem.deny[]]
    | .[] | select(startswith("~/") and (rtrimstr("/") | endswith("/**")))
    | rtrimstr("/") | rtrimstr("/**")' "{{ $nonoProfiles }}/base.json")
}

# bats test_tags=kind:nono
@test "base profile denies custom secret groups and self-protects" {
  run jq -e '
    (.filesystem.deny | index("~/.config/nono") != null) and
    # engram is agent-granted (MCP children); base must neither deny nor grant it
    ((.filesystem.deny + .filesystem.read + .filesystem.allow)
      | map(select(. == "~/.local/share/engram")) | length) == 0 and
    # ~/.pi symlinks into ~/.config/pi: never a base grant (cross-agent pi-tree write)
    (.filesystem.allow | index("~/.pi") == null) and
    # pi-specific state is pi-only (demoted from base: settings.json/models.json/
    # pi-lens writes from other agents = config-tampering surface)
    ((.filesystem.read + .filesystem.allow)
      | map(select(startswith("~/.config/pi/") or startswith("~/.pi-lens")))
      | length) == 0 and
    (.filesystem.deny | index("~/.config/gh/hosts.yml") != null) and
    (.filesystem.deny | index("~/.pgpass") != null) and
    (.filesystem.deny | index("~/.config/ssh") != null) and
    (.filesystem.deny | index("**/.secrets/**") != null) and
    # No custom grants survive for built-in-floor paths; ~/.ssh is
    # renderer-denied because the 0.79.0 deny_credentials group lacks it
    ((.filesystem.read + .filesystem.allow)
      | map(select(startswith("~/.ssh") or startswith("~/Library/Keychains") or startswith("~/.zshenv")))
      | length) == 0 and
    (.filesystem.deny | index("~/.ssh") != null)
  ' "{{ $nonoProfiles }}/base.json"
  assert_success
}

# bats test_tags=kind:nono
@test "DCG stores are read-tier carve-outs, never denied" {
  run jq -e '
    (.filesystem.read | index("~/Library/Application Support/dcg") != null) and
    (.filesystem.read | index("~/.config/dcg") != null) and
    ((.filesystem.deny + .filesystem.allow)
      | map(select(contains("/dcg") or endswith("/dcg")))
      | length) == 0
  ' "{{ $nonoProfiles }}/base.json"
  assert_success
}

# bats test_tags=kind:nono
@test "base profile grants agent tooling state dirs (chezmoi, mise)" {
  # Without dir-level grants, agents hit EPERM on chezmoi state open and
  # mise's trusted-configs symlink inside the sandbox.
  run jq -e '
    (.filesystem.allow | index("~/.config/chezmoi") != null) and
    (.filesystem.allow | index("~/.local/state/mise") != null)
  ' "{{ $nonoProfiles }}/base.json"
  assert_success
}

# bats test_tags=kind:nono
@test "apply grants: file-granular session tier, parent-dir chezmoi sandbox, git/mise/gh overrides" {
  # Grants are the allowlist: the same data renders the session write tier (file
  # granular) and the chezmoi command sandbox that replaces it for chezmoi — and
  # nono takes DIRECTORIES only in the sandbox lists, so chezmoi's tier carries the
  # destination PARENTS and never the destination files (a file entry policy-denies
  # every chezmoi invocation). fs_read also carries the source dir, and never a
  # broad config parent: `~/.config`/`~/.local/share` reads would re-open the
  # credential deny groups living under them — gh hosts.yml, git credentials,
  # configstore, pgpass, amazon/azure/engram state (user-terminal probe: `nono run
  # --profile base -- cat ~/.config/gh/hosts.yml` must EPERM). The git/mise/gh keys
  # are the overrides (live A/B tested, nono 0.79.0): the ["."] default is
  # fatal for both; git reads `~/.config/git` as a DIR — the `@git:config-files`
  # token is fatal on hosts with a system gitconfig (file entries in dirs-only
  # lists) — writes `/dev/dtracehelper` like every macOS binary, and reaches
  # git-core/hooks via `unsafe_macos_seatbelt_rules` (macOS exec gate: literals,
  # no globs; `exec_paths` is Linux-only); mise's symlinked binary rides
  # `fs_read_file`.
  run jq -e --argjson d '{{ $applyDests | toJson }}' --argjson pairs '{{ $applyPairs | toJson }}' '
    . as $r |
    ($r.command_policies.commands.chezmoi.from.session.sandbox) as $cz |
    ($r.command_policies.commands.git.from.session.sandbox) as $git |
    ($r.command_policies.commands.mise.from.session.sandbox) as $mise |
    ($r.command_policies.commands.gh.from.session.sandbox) as $gh |
    ($d | length) > 0 and
    all($d[]; . as $p | ($r.filesystem.allow | index($p)) != null) and
    all($pairs[]; . as $pr | ($cz.fs_write | index($pr.parent)) != null) and
    all($pairs[]; . as $pr | ($cz.fs_read | index($pr.parent)) != null) and
    all($d[]; . as $p | ($cz.fs_write | index($p)) == null) and
    ($cz.fs_write | index("~/.config/chezmoi") != null) and
    ($cz.fs_read | index("~/.config/chezmoi") != null) and
    ($cz.fs_read | index("~/.local/share/chezmoi") != null) and
    ($cz.fs_read | index("~/.config") | not) and
    ($cz.fs_read | index("~/.local/share") | not) and
    ($cz.exec_paths | index("/usr/bin") != null) and
    ($cz.exec_paths | index("{{ trimSuffix "/" .chezmoi.homeDir }}/.local/share/mise/shims") != null) and
{{- if eq .chezmoi.os "darwin" }}
    ($cz.unsafe_macos_seatbelt_rules | index("(allow process-exec* (subpath \"/usr/bin\"))") != null) and
{{- end }}
    ($git.fs_read | index("@git:config-files") | not) and
    ($git.fs_read | index("~/.config/git") != null) and
    ($git.fs_read | index("/opt/local") != null) and
    ($git.fs_write_file | index("/dev/dtracehelper") != null) and
    # the session exports GIT_SSL_CAINFO at the house bundle; ungranted in the
    # command sandbox every HTTPS op fails at certificate loading (measured)
    ($git.fs_read_file | index("~/.config/certificates/ca-bundle.pem") != null) and
    ($git.exec_paths | index("/opt/local/libexec/git-core") != null) and
{{- if eq .chezmoi.os "darwin" }}
    ($git.unsafe_macos_seatbelt_rules | index("(allow process-exec* (literal \"/opt/local/libexec/git-core/git\"))") != null) and
{{- end }}
    ($git.fs_read | index("~/.local/share/chezmoi") != null) and
    ($git.fs_write | index("{{ trimSuffix "/" (env "TMPDIR" | default "/tmp") }}") != null) and
    # fs group members (tmp_workspace) expand at render: the expanded TMPDIR
    # is present and the raw $TMPDIR sentinel never survives into the profile
    ($git.fs_write | index("$TMPDIR") | not) and
    ($mise.fs_read | index("~/.config/mise") != null) and
    ($mise.fs_write | index("{{ trimSuffix "/" (env "TMPDIR" | default "/tmp") }}") != null) and
    ($mise.fs_write | index("$TMPDIR") | not) and
    ($mise.fs_read | index("~/.local/bin") | not) and
    ($mise.fs_read_file | index("~/.local/bin/mise") != null) and
    ($mise.fs_write | index("~/.local/state/mise") != null) and
    ($mise.fs_read | index("~/Library/Caches/mise") != null) and
    ($mise.fs_write | index("~/Library/Caches/mise") != null) and
    # gh dies at boot without the config read (measured: `gh --version` EPERMs on
    # ~/.config/gh/config.yml); the dir grant over it is refused by the guard
    # because it contains the hosts.yml deny entry, so only the file rides
    ($gh.fs_read_file | index("~/.config/gh/config.yml") != null) and
    ($gh.fs_read | index("~/.config/gh") | not) and
    # Sandbox network lists resolve through the [network.groups] catalog; the
    # pins are EXACT sets (group refs are narrow by design — a base-category
    # reference would widen the mediated sandbox and must never render).
    ($git.network.allow_domain | sort) == ["*.githubusercontent.com", "codeload.github.com", "github.com"] and
    ($mise.network.allow_domain | sort) == ["*.crates.io", "*.golang.org", "*.jdx.dev", "*.nodejs.org", "*.npmjs.org", "*.pythonhosted.org", "api.github.com", "cdn.jsdelivr.net", "nodejs.org", "pypi.org", "static.rust-lang.org"] and
    # gh's API host is not in the git_forge group; mediation grants no session egress
    ($gh.network.allow_domain | sort) == ["api.github.com"]
  ' "{{ $nonoProfiles }}/base.json"
  assert_success
}

# Render-time guard fixtures: the seed passes, every poisoned entry is
# refused by name — the same fixture pattern as the cmd converter below (the
# guard reports and exits 0; render-apply-dests turns a report into a loud `fail`).
{{- $guardScript := includeTemplate "base/ai/security/apply-dest-guard" dict }}
{{- $guardProtected := includeTemplate "base/ai/security/expand-path-groups" (dict "root" . "groups" (index (includeTemplate "base/helpers/load-section" (dict "root" . "section" "ai.permissions.filesystem" "required" true) | mustFromJson) "deny" | default list)) | mustFromJson }}
{{- $guardCases := list }}
{{- range $d := $applyDests }}
{{-   $guardCases = append $guardCases (dict "dest" $d "expect" "ok") }}
{{- end }}
{{- range $c := list "~/.config/nono" "~/.config/nono/profiles/base.json" "~/.config/opencode/opencode.jsonc" "~/.config" "~/.config/tmux/**" "relative/config.json" "/" "~/../.." "~@evil" }}
{{-   $guardCases = append $guardCases (dict "dest" $c "expect" "refused") }}
{{- end }}
{{- /* Provider tokens are the guard's blind spot BY DESIGN (the provider enforces
     its own trust), and a file grant rides the dir floor untouched: both pass.
     exec_paths dirs pass the floor too; a seatbelt S-expression is refused as a
     non-path (render-apply-dests never feeds it to the guard; defense in depth). */}}
{{- $guardCases = append $guardCases (dict "dest" "@git:config-files" "expect" "ok") }}
{{- $guardCases = append $guardCases (dict "dest" "~/.local/bin/mise" "expect" "ok") }}
{{- $guardCases = append $guardCases (dict "dest" "/opt/local/libexec/git-core" "expect" "ok") }}
{{- $guardCases = append $guardCases (dict "dest" "(allow process-exec* (literal \"/bin/sh\"))" "expect" "refused") }}
{{- /* The symlink case needs the managed ~/.pi symlink present to resolve into
     the protected ~/.config/pi root (fresh installs render before it exists). */}}
{{- $piRoot := stat (joinPath .chezmoi.homeDir ".pi") }}
{{- if and $piRoot $piRoot.isDir }}
{{-   $guardCases = append $guardCases (dict "dest" "~/.pi/agent/settings.json" "expect" "refused") }}
{{- end }}
{{- /* Case-alias fixture: the ~/.CONFIG stat only resolves on a case-insensitive
     volume, which is exactly when the guard must fold case to refuse the alias
     of the protected ~/.config root. */}}
{{- if stat (joinPath .chezmoi.homeDir ".CONFIG") }}
{{-   $guardCases = append $guardCases (dict "dest" "~/.CONFIG/nono" "expect" "refused") }}
{{- end }}
{{- /* Batched: the guard validates every entry independently against the
     protected floor, so one call per expectation group proves the whole
     matrix (empty output = every ok entry passes; refused entries are
     asserted by name, per-entry attribution preserved). */}}
{{- $guardOk := list }}
{{- $guardRefused := list }}
{{- range $c := $guardCases }}
{{-   if eq $c.expect "ok" }}{{- $guardOk = append $guardOk $c.dest }}{{- else }}{{- $guardRefused = append $guardRefused $c.dest }}{{- end }}
{{- end }}
{{- $guardViolOk := output "python3" "-c" $guardScript (dict "destinations" $guardOk "protected" $guardProtected | toJson) | mustFromJson }}
{{- $guardViolRefused := output "python3" "-c" $guardScript (dict "destinations" $guardRefused "protected" $guardProtected | toJson) | mustFromJson }}
{{- /* allow_globs mode (sandbox grant lists): globs pass, and protected roots
     stay refused through the glob (anchor the pattern, compare protected). */}}
{{- $globOk := list "~/.local/share/mise/installs/**" "~/.local/share/mise/installs/x/**/y" "~/.config/tmux/**" }}
{{- $globRefused := list "~/.config/nono/**" "~/.config/**" }}
{{- $globViolations := output "python3" "-c" $guardScript (dict "destinations" (concat $globOk $globRefused) "protected" $guardProtected "allow_globs" true | toJson) | mustFromJson }}

# bats test_tags=kind:nono
@test "apply-dest-guard refuses protected, ancestor, descendant, glob, root, case-alias and symlinked entries" {
  run jq -e --argjson ok '{{ $guardOk | toJson }}' --argjson refused '{{ $guardRefused | toJson }}' --argjson vOk '{{ $guardViolOk | toJson }}' --argjson vRefused '{{ $guardViolRefused | toJson }}' --argjson gok '{{ $globOk | toJson }}' --argjson grefused '{{ $globRefused | toJson }}' --argjson vGlob '{{ $globViolations | toJson }}' -n '
    ($refused | length) >= 7 and
    ($ok | length) > 0 and
    ($vOk | length) == 0 and
    all($refused[]; . as $d | any($vRefused[]; startswith($d + ":"))) and
    all($gok[]; . as $d | (any($vGlob[]; startswith($d + ":"))) | not) and
    all($grefused[]; . as $d | any($vGlob[]; startswith($d + ":")))
  '
  assert_success
}

# Render-time filter fixture: direct invocation of filter-shadowed-allow (the
# shared python-anchor with casefold OFF): a strict-ancestor allow entry is
# dropped; non-anchorable entries (`.`, rootless globs), exact matches and
# siblings are kept; the host ~/.pi symlink resolves through realpath.
{{- $filterScript := includeTemplate "base/ai/security/filter-shadowed-allow" dict }}
{{- $filterCases := list }}
{{- $filterCases = append $filterCases (dict "allow" (list "~/.config/pi") "read" (list "~/.config/pi/hooks") "keep" (list)) }}
{{- $filterCases = append $filterCases (dict "allow" (list "." "profiles/*/extensions/hook") "read" (list "/private/etc/pi/hooks" "profiles/core/hooks") "keep" (list "." "profiles/*/extensions/hook")) }}
{{- $filterCases = append $filterCases (dict "allow" (list "~/.config/pi") "read" (list "~/.config/pi") "keep" (list "~/.config/pi")) }}
{{- $filterCases = append $filterCases (dict "allow" (list "~/.config/omp") "read" (list "~/.config/pi/hooks") "keep" (list "~/.config/omp")) }}
{{- /* The symlink case mirrors the guard fixture: ~/.pi resolves into the
     protected pi tree, so its covering allow grant must drop. */}}
{{- $filterPi := stat (joinPath .chezmoi.homeDir ".pi") }}
{{- if and $filterPi $filterPi.isDir }}
{{-   $filterCases = append $filterCases (dict "allow" (list "~/.pi") "read" (list "~/.config/pi/agent/hooks") "keep" (list)) }}
{{- end }}
{{- $filterResults := list }}
{{- range $c := $filterCases }}
{{-   $filterResults = append $filterResults (dict "allow" $c.allow "keep" $c.keep "kept" (output "python3" "-c" $filterScript (dict "allow" $c.allow "read" $c.read | toJson) | mustFromJson)) }}
{{- end }}

# bats test_tags=kind:nono
@test "filter-shadowed-allow drops covering ancestors and keeps non-anchorable, exact and sibling entries" {
  run jq -e --argjson f '{{ $filterResults | toJson }}' -n '
    ([$f[] | select(.keep == [])] | length) >= 1 and
    all($f[]; . as $e | ($e.kept | sort) == ($e.keep | sort))
  '
  assert_success
}

# Command-policy matrix: asserts the hard-core deny intent under nono 0.79
# matcher semantics (matchers compare argv after the command name; prefix is a
# literal token prefix; contains is a contiguous token window).
# bats test_tags=kind:nono
@test "nono base profile enforces command control-axis invariants" {
  run jq -e '
    def amatch($a):
      if .exact then .exact == $a
      elif .prefix then (($a | length) >= (.prefix | length)) and ($a[0:(.prefix | length)] == .prefix)
      elif .contains then ((.contains) as $c | (($a | length) >= ($c | length)) and any(range(0; (($a | length) - ($c | length) + 1)); . as $i | $a[$i:($i + ($c | length))] == $c))
      else false end;
    def rules($cmd): (.command_policies.commands[$cmd].from.session.invocation_policy.deny // []) | map(.argv);
    def hit($cmd; $a): rules($cmd) | any(amatch($a));
    def denied_only($cmd): (.command_policies.commands[$cmd].from.session) == "deny";
    # bare-command denies, and eval/exec builtins absent (not PATH-shim mediable)
    (denied_only("pfctl")) and (denied_only("mkfs")) and (denied_only("fdisk")) and
    (denied_only("parted")) and (denied_only("mkcert")) and
    # privesc / system-admin / raw-socket floor: hard kernel denies, not DCG's
    # (prompt layer, hooks-only; direct-path exec bypasses DCG text analysis)
    (denied_only("sudo")) and (denied_only("su")) and (denied_only("doas")) and
    (denied_only("mount")) and (denied_only("umount")) and
    (denied_only("swapon")) and (denied_only("swapoff")) and
    (denied_only("iptables")) and (denied_only("ip6tables")) and
    (denied_only("nft")) and (denied_only("ufw")) and
    (denied_only("useradd")) and (denied_only("userdel")) and (denied_only("usermod")) and
    (denied_only("groupadd")) and (denied_only("groupdel")) and
    (denied_only("nc")) and (denied_only("ncat")) and
    (denied_only("netcat")) and (denied_only("socat")) and
    (.command_policies.commands | (has("eval") or has("exec")) | not) and
    # keychain mutators: token-prefix glob tokens (add-*, delete-*) collapse the
    # whole command to session-deny (converter has no glob matcher; the data pins
    # this shape deliberately — mutator-heavy tool, conservative floor)
    (denied_only("security")) and
    (.command_policies.commands.git.from.session.invocation_policy.default == "allow") and
    # destructive-but-normal commands left nono for DCG ownership
    (.command_policies.commands | (has("kubectl") or has("helm") or has("docker") or has("tofu") or has("rm") or has("sed")) | not) and
    # chezmoi: global applies denied (exact variants + --remove prefix); targeted apply unblocked
    (rules("chezmoi") | any(.exact == ["apply"])) and
    (rules("chezmoi") | any(.prefix == ["--remove"])) and
    (hit("chezmoi"; ["apply"])) and (hit("chezmoi"; ["--remove","apply"])) and
    (hit("chezmoi"; ["apply","--remove"])) and (hit("chezmoi"; ["apply","--force"])) and (hit("chezmoi"; ["--force","apply"])) and
    (hit("chezmoi"; ["apply","~/.zshrc"]) | not) and (hit("chezmoi"; ["diff","~/.zshrc"]) | not) and
    # global-flag-leading forms are literal prefix variants (no --global flag in
    # chezmoi: a global apply is the bare form above)
    (rules("chezmoi") | any(.prefix == ["--force"])) and (rules("chezmoi") | any(.prefix == ["--include"])) and
    (rules("chezmoi") | any(.prefix == ["--exclude"])) and (rules("chezmoi") | any(.prefix == ["--destination"])) and
    (rules("chezmoi") | any(.prefix == ["--source"])) and (rules("chezmoi") | any(.prefix == ["-i"])) and
    (rules("chezmoi") | any(.prefix == ["-x"])) and (rules("chezmoi") | any(.prefix == ["-D"])) and
    (rules("chezmoi") | any(.prefix == ["-S"])) and (rules("chezmoi") | any(.prefix == ["apply","--force"])) and
    (hit("chezmoi"; ["--force","apply","~/.zshrc"])) and (hit("chezmoi"; ["--include","files","apply"])) and
    (hit("chezmoi"; ["--exclude","files","apply","~/.zshrc"])) and (hit("chezmoi"; ["--destination","/tmp","apply"])) and
    (hit("chezmoi"; ["--source","/tmp","apply"])) and (hit("chezmoi"; ["-D","/tmp","apply"])) and
    (hit("chezmoi"; ["-S","/tmp","apply"])) and (hit("chezmoi"; ["-i","files","apply"])) and (hit("chezmoi"; ["-x","files","apply"])) and
    (hit("chezmoi"; ["apply","--force","~/.zshrc"])) and (hit("chezmoi"; ["apply","--include","files","~/.zshrc"])) and
    (hit("chezmoi"; ["apply","-D","/tmp","~/.zshrc"])) and
    # clone-and-apply / update forms apply globally: no allowlist bounds them
    (rules("chezmoi") | any(.prefix == ["init","--apply"])) and (rules("chezmoi") | any(.prefix == ["init","-a"])) and
    (rules("chezmoi") | any(.prefix == ["up"])) and (rules("chezmoi") | any(.prefix == ["update"])) and
    (hit("chezmoi"; ["init","--apply"])) and (hit("chezmoi"; ["init","--apply","https://example.com/dotfiles"])) and
    (hit("chezmoi"; ["init","-a","https://example.com/dotfiles"])) and (hit("chezmoi"; ["update"])) and
    (hit("chezmoi"; ["update","--force"])) and (hit("chezmoi"; ["up"])) and
    # Boundary: a positional apply — with or without a trailing flag — matches
    # no deny rule; the command-sandbox write list confines it (the command-policy matrix pins it).
    # The =-valued equals form is the same boundary on the flag-leading side.
    (hit("chezmoi"; ["apply","~/.config/git/config","--force"]) | not) and
    (hit("chezmoi"; ["apply","~/.config/git/config","-i","files"]) | not) and
    (hit("chezmoi"; ["--force=true","apply"]) | not) and
    (hit("chezmoi"; ["--force=true","apply","~/.config/git/config"]) | not) and
    # force-push family denied; ordinary pushes allowed
    (hit("git"; ["push","--force"])) and (hit("git"; ["push","--force","origin","main"])) and
    (hit("git"; ["push","-f","origin","main"])) and
    (hit("git"; ["push","--force-with-lease"])) and (hit("git"; ["push","--force-with-lease","origin","main"])) and
    (hit("git"; ["-c","pull.rebase=false","push","--force"])) and (hit("git"; ["-c","x.y=z","push","--force-with-lease"])) and
    (hit("git"; ["push","origin","main"]) | not) and (hit("git"; ["push"]) | not) and (hit("git"; ["push","--tags","origin","v1"]) | not) and
    # secret egress denied; ordinary verbs outside the families allowed
    (hit("gpg"; ["--export-secret-keys"])) and (hit("gpg"; ["--export-secret-subkeys"])) and
    (hit("gpg"; ["--export","me@example.com"]) | not) and (hit("gpg"; ["--export-ssh-key","me"]) | not) and
    (hit("gh"; ["auth","token"])) and (hit("gh"; ["secret","list","-R","a/b"])) and
    (hit("gh"; ["repo","view","r"]) | not) and
    (hit("aws"; ["secretsmanager","get-secret-value","--secret-id","x"])) and (hit("aws"; ["s3","ls"]) | not) and
    (hit("sky"; ["launch","--secret","k=v"])) and (hit("sky"; ["status"]) | not) and
    # disk erase/partition families denied; other verbs allowed
    (hit("diskutil"; ["eraseDisk","APFS","New","disk4"])) and (hit("diskutil"; ["partitionDisk","disk4"])) and
    (hit("diskutil"; ["list"]) | not) and (hit("diskutil"; ["mountDisk","eject","disk4"]) | not) and
    # mise global apply denied; ordinary runs allowed
    (hit("mise"; ["run","apply"])) and (hit("mise"; ["run"]) | not) and
    (hit("hf"; ["auth","login"])) and
    # hf repo mutations are DCG-owned (custom pack hf-write), not nono denies
    (hit("hf"; ["repo","delete","r"]) | not) and (hit("hf"; ["upload","f"]) | not) and
    (hit("hf"; ["repo","view","r"]) | not)
  ' "{{ $nonoProfiles }}/base.json"
  assert_success
}

