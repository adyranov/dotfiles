#!/usr/bin/env bats

# bats file_tags=suite:ai

load 'common-helper'

setup() {
  common_setup
}

# --- OpenCode config shape: no interactive permission layer; the managed
#     single-key external_directory allow is the only key agents carry; the
#     sandbox is the enforcer ---

{{- if .toolchains.opencode }}

# bats test_tags=toolchain:opencode,kind:config
@test "opencode update setting stays non-mutating" {
  run jsoncJq -e '.update != "auto"' "$HOME/.config/opencode/opencode.jsonc"
  assert_success
}

# bats test_tags=toolchain:opencode,kind:permission
@test "opencode configs carry no in-agent permission keys" {
  for file in \
    "$HOME/.config/opencode/opencode.jsonc" \
    "$HOME/.config/opencode/profiles/core/opencode.jsonc"; do
    run jsoncJq -e '
      (.permission == null) and (.permissions == null) and
      (.agents.plan | has("permissions") | not)' "$file"
    assert_success
  done
  # Factory exception (unattended policy): the managed external_directory
  # allow set is the only in-agent key the factory profile may carry.
  run jsoncJq -e '
    (.permission == null) and
    (.agents.plan | has("permissions") | not) and
    (.permissions | type == "array") and
    (.permissions | length > 0) and
    (.permissions | all(.action == "external_directory" and .effect == "allow"))' \
    "$HOME/.config/opencode/profiles/factory/opencode.jsonc"
  assert_success
}
{{- end }}

# --- Nono sandbox profiles ---

{{- if ne .host.type "ephemeral" }}
{{- $nonoProfiles := "$HOME/.config/nono/profiles" }}
{{- $src := .chezmoi.sourceDir }}
{{- $creds := includeTemplate "base/ai/auth/render-credentials" (dict "root" .) | mustFromJson }}
{{- /* Routed names and the gap set, derived from the data the renderer reads. */ -}}
{{- $routedNames := list -}}
{{- range $r := ($creds.routes | default list) -}}{{- $routedNames = append $routedNames $r.name -}}{{- end -}}
{{- $routedNames = $routedNames | uniq | sortAlpha -}}
{{- $sessionRouteNames := list -}}
{{- if $creds.routes_enabled -}}
{{-   range $r := ($creds.routes | default list) -}}{{-   $sessionRouteNames = append $sessionRouteNames (includeTemplate "base/ai/auth/route-key" (dict "row" $r)) -}}{{-   end -}}
{{- end -}}
{{- $sessionRouteNames = $sessionRouteNames | uniq | sortAlpha -}}
{{- $allRouteNames := $sessionRouteNames -}}
{{- /* Per-agent route expectations, derived from the same agents-scoped
   render the profiles use: opencode drops anthropic (no bridge wired),
   omp has no bridge lane at all (473dddf6), so it renders no routes. */ -}}
{{- $ocCreds := includeTemplate "base/ai/auth/render-credentials" (dict "root" . "agent" "opencode") | mustFromJson -}}
{{- $ocRouteNames := list -}}
{{- range $r := ($ocCreds.routes | default list) -}}{{- $ocRouteNames = append $ocRouteNames (includeTemplate "base/ai/auth/route-key" (dict "row" $r)) -}}{{- end -}}
{{- $ocRouteNames = $ocRouteNames | uniq | sortAlpha -}}
{{- $netCredsRender := includeTemplate "base/ai/security/render-nono-net" (dict "root" . "credentials" $creds) | mustFromJson -}}
{{- /* Presence pins are derived at render time from the data: concat every
   [network.allow_domain] category value (base categories carry literals
   only — group refs are sandbox-side by design). */ -}}
{{- $netData := (includeTemplate "base/helpers/load-section" (dict "root" . "section" "ai.permissions.network" "required" false) | mustFromJson) -}}
{{- $wantHosts := list -}}
{{- range $hosts := (index $netData "allow_domain" | default dict) -}}
{{-   $wantHosts = concat $wantHosts ($hosts | default list) -}}
{{- end -}}
{{- $wantHosts = includeTemplate "base/ai/security/uniq-sort" $wantHosts | mustFromJson }}

# bats test_tags=kind:nono
@test "nono base profile is deployed and valid" {
  assert_file_exists "{{ $nonoProfiles }}/base.json"
  run nono profile validate "{{ $nonoProfiles }}/base.json"
  assert_success
}

# bats test_tags=kind:nono
@test "filesystem rules render as native globs verbatim" {
  # Glob shapes survive to the rendered profile untouched; the concretizer is gone.
  assert_file_not_exists "{{ $src }}/.chezmoitemplates/base/ai/security/concretize-paths"
  assert_file_not_exists "{{ $src }}/.chezmoitemplates/base/ai/security/cached-run"
  run jq -e '
    (.filesystem.deny | index("**/.env") != null) and
    (.filesystem.deny | index("**/.aws/**") != null) and
    ((.filesystem.deny + .filesystem.read + .filesystem.allow)
      | all(test("[?[\\]{}]") | not))
  ' "{{ $nonoProfiles }}/base.json"
  assert_success
}

# bats test_tags=kind:nono
@test "base profile has no tilde-anchored /** glob whose root exists (SIGILL strip)" {
  # nono walks existing-root `~/X/**` at sandbox start (SIGILL at scale); the
  # renderer must collapse those to the literal root prefix. Missing roots stay native.
  local root
  while IFS= read -r root; do
    if [ -d "${root/#\~/$HOME}" ]; then
      echo "unstripped tilde-tail glob: $root"
      false
    fi
  done < <(jq -r '[.filesystem.allow[], .filesystem.read[], .filesystem.deny[]]
    | .[] | select(startswith("~/") and (rtrimstr("/") | endswith("/**")))
    | rtrimstr("/") | rtrimstr("/**")' "{{ $nonoProfiles }}/base.json")
}

# bats test_tags=kind:nono
@test "base profile denies custom secret groups and self-protects" {
  run jq -e '
    (.filesystem.deny | index("~/.config/nono") != null) and
    # The dir-literal deny covers the dir only, so the profiles children
    # ride their own keys — overwriting the EXISTING profiles/<agent>.json
    # (agent-authored profile on next launch) is denied.
    (.filesystem.deny | index("~/.config/nono/profiles") != null) and
    (.filesystem.deny | index("~/.config/nono/profiles/*") != null) and
    # engram is agent-granted (MCP children); base must neither deny nor grant it
    ((.filesystem.deny + .filesystem.read + .filesystem.allow)
      | map(select(. == "~/.local/share/engram")) | length) == 0 and
    # ~/.pi symlinks into ~/.config/pi: never a base grant (cross-agent pi-tree write)
    (.filesystem.allow | index("~/.pi") == null) and
    # pi-specific state is pi-only (settings.json/models.json/
    # pi-lens writes from other agents = config-tampering surface)
    ((.filesystem.read + .filesystem.allow)
      | map(select(startswith("~/.config/pi/") or startswith("~/.pi-lens")))
      | length) == 0 and
    (.filesystem.deny | index("~/.config/gh/hosts.yml") != null) and
    (.filesystem.deny | index("~/.pgpass") != null) and
    (.filesystem.deny | index("~/.config/ssh") != null) and
    (.filesystem.deny | index("**/.secrets/**") != null) and
    # No custom grants survive for built-in-floor paths; ~/.ssh is
    # renderer-denied because the 0.79.0 deny_credentials group lacks it
    ((.filesystem.read + .filesystem.allow)
      | map(select(startswith("~/.ssh") or startswith("~/Library/Keychains") or startswith("~/.zshenv")))
      | length) == 0 and
    (.filesystem.deny | index("~/.ssh") != null)
  ' "{{ $nonoProfiles }}/base.json"
  assert_success
}

# bats test_tags=kind:nono
@test "base denies the host tmux socket: no grants, no write lane" {
  # Rendered base: no socket grants, tmux paths out of every grant tier, the
  # deny carries dir+child keys. Unopenability mechanics: the shared.toml SSH
  # deny block and the tmux_state path definition in permissions.toml.
  run jq -e '
    ((.filesystem.unix_socket_subtree // []) | length) == 0 and
    ((.filesystem.allow + .filesystem.read + .filesystem.write)
      | map(select(startswith("~/.local/share/tmux"))) | length) == 0 and
    (.filesystem.deny | index("~/.local/share/tmux") != null) and
    (.filesystem.deny | index("~/.local/share/tmux/*") != null)
  ' "{{ $nonoProfiles }}/base.json"
  assert_success
}

# bats test_tags=kind:nono
@test "~/Library stays write-closed at the root: read-only root, LaunchAgents denied" {
  # Bare `~/Library` in the write tier = recursive write over the macOS user
  # tree (LaunchAgents = launchd persistence loaded OUTSIDE the sandbox).
  # Shape: no bare ~/Library in write, ~/Library in READ (tools probe
  # app-support layouts at boot), launch_agents deny keys present, and no
  # BROAD write grant may cover the denied persistence root (deny-over-grant
  # is what closes it).
  run jq -e '
    (.filesystem.allow | index("~/Library") | not) and
    (.filesystem.read | index("~/Library") != null) and
    (.filesystem.deny | index("~/Library/LaunchAgents") != null) and
    (.filesystem.deny | index("~/Library/LaunchAgents/*") != null) and
    (.filesystem.allow
      | map(select(. as $a | "~/Library/LaunchAgents" | startswith($a))
        | select(. != "~/Library/LaunchAgents"))
      | length) == 0
  ' "{{ $nonoProfiles }}/base.json"
  assert_success
}

# bats test_tags=kind:nono
@test "DCG stores are read-tier carve-outs, never denied" {
  run jq -e '
    (.filesystem.read | index("~/Library/Application Support/dcg") != null) and
    (.filesystem.read | index("~/.config/dcg") != null) and
    ((.filesystem.deny + .filesystem.allow)
      | map(select(contains("/dcg") or endswith("/dcg")))
      | length) == 0
  ' "{{ $nonoProfiles }}/base.json"
  assert_success
}

# bats test_tags=kind:nono
@test "base profile grants agent tooling state dirs; chezmoi state is session-read-only" {
  # Without dir-level grants, agents hit EPERM on chezmoi state open and
  # mise's trusted-configs symlink inside the sandbox. U2: ~/.config/chezmoi
  # is SESSION-READ (read tier) — chezmoi's config AND persistent-state boltdb
  # live there, and a session write grant lets an agent poison apply
  # bookkeeping (silently-skipped changed files), bypassing the user's apply
  # boundary. There is no command-sandbox write companion: the chezmoi command
  # edge renders deny-only (the security-first fallback), so no in-sandbox
  # chezmoi invocation touches the state at all.
  run jq -e '
    def overlaps($p): . as $g | $g == $p or ($p | startswith($g + "/")) or ($g | startswith($p + "/"));
    (.filesystem.read | index("~/.config/chezmoi") != null) and
    (.filesystem.allow | index("~/.config/chezmoi") == null) and
    (.filesystem.allow | index("~/.local/state/mise") != null) and
    # Shared stores are session READ-only: agents run the user-prewarmed hook
    # envs; store installs/bootstrap stay user-terminal. No ALLOW entry may
    # equal or ancestor-cover the mise install store (the store itself, its
    # parents and subpaths) nor the pre-commit caches (an ancestor grant like
    # ~/.cache counts); the mise install store rides the ~/.local/share READ
    # parent.
    (.filesystem.read | index("~/.local/share") != null) and
    ([.filesystem.allow[] | select(overlaps("~/.local/share/mise")
        or overlaps("~/.cache/pre-commit") or overlaps("~/.cache/pre-commit-zipapp"))] | length) == 0 and
    (.filesystem.read | index("~/.cache/pre-commit") != null) and
    (.filesystem.read | index("~/.cache/pre-commit-zipapp") != null) and
    # The trust store leaf is denied INSIDE that grant (deny beats grants):
    # a direct write is self-trust — repo [tasks] execute on the next mise run.
    (.filesystem.deny | index("~/.local/state/mise/trusted-configs") != null) and
    # macOS: nono canonicalizes the `*` glob matches, denying the trust
    # link TARGETS — the `Users-adyranov -> $HOME` record once denied all
    # of home; the seatbelt dir deny is already recursive. Landlock dir
    # denies cover the dir only, so Linux keeps the `*` key.
{{- if eq .chezmoi.os "darwin" }}
    (.filesystem.deny | index("~/.local/state/mise/trusted-configs/*") == null)
{{- else }}
    (.filesystem.deny | index("~/.local/state/mise/trusted-configs/*") != null)
{{- end }}
  ' "{{ $nonoProfiles }}/base.json"
  assert_success
}

# bats test_tags=kind:nono
@test "managed home config is read-only: editor settings, setenv, ~/.agents, ~/.editorconfig" {
  # U2 apply-boundary closure (R5, R21, AE3/AE4). The chezmoi-MANAGED editor
  # settings/keybindings, the login setenv.sh (shell-exec surface run by the
  # LaunchAgents plist), the managed ~/.agents symlink (writes land in the
  # protected ~/.config/agents tree) and the managed ~/.editorconfig ride the
  # READ tier only. The app-support write lane is closed wholesale (no runtime
  # consumer; the broad parent rides the dcg read carve-out); the pinned KEPT
  # writes are the runtime build caches.
  # No dir grant may cover a managed leaf (a dir write re-opens it through
  # unlink+create), so no allow entry starts with any of these paths.
  run jq -e '
    . as $r |
    all(["~/Library/Application Support/Code/User/settings.json",
         "~/Library/Application Support/Code/User/keybindings.json",
         "~/Library/Application Support/Cursor/User/settings.json",
         "~/Library/Application Support/Cursor/User/keybindings.json",
         "~/Library/Scripts/setenv.sh", "~/.agents", "~/.editorconfig"][];
        . as $p |
        ((($r.filesystem.read | index($p)) != null) and
         (($r.filesystem.allow | index($p)) == null) and
         (([$r.filesystem.allow[] | select(. as $a | ($p | startswith($a + "/")))] | length) == 0)))
    and (($r.filesystem.allow | map(select(startswith("~/Library/Application Support"))) | length) == 0)
    and (($r.filesystem.deny | map(select(contains("/dcg") or endswith("/dcg"))) | length) == 0)
    and (($r.filesystem.allow | index("~/Library/Caches/go-build")) != null)
    and (($r.filesystem.allow | index("~/Library/Caches/node-gyp")) != null)
  ' "{{ $nonoProfiles }}/base.json"
  assert_success
}

# bats test_tags=kind:nono
@test "git/mise command sandboxes: credential floors, read-only stores, exec gates" {
  # The git/mise keys are the command-sandbox overrides (nono 0.79.0): the
  # ["."] default is fatal for both; git reads its config CHAIN per file
  # (`fs_read_file`: no `~/.config/git` dir grant — it would re-open the
  # credential store — and the `@git:config-files` token is fatal on hosts
  # with a system gitconfig, file entries in dirs-only lists) — writes
  # `/dev/dtracehelper` like every macOS binary, and reaches git-core/hooks
  # via `unsafe_macos_seatbelt_rules` (macOS exec gate: literals, no globs;
  # `exec_paths` is Linux-only); mise's symlinked binary rides `fs_read_file`.
  # chezmoi and brew render deny-only edges (no sandbox at all): pinned in
  # the control-axis test.
  run jq -e '
    def sands: [.command_policies.commands[].from[] | (if type == "object" then .sandbox // {} else {} end)];
    def covers($p): . as $g | . == $p or ($p | startswith($g + "/"));
    . as $r |
    ($r.command_policies.commands.git.from.session.sandbox) as $git |
    ($r.command_policies.commands.mise.from.session.sandbox) as $mise |
    ($git.fs_read | index("@git:config-files") | not) and
    # Credential floor INSIDE the command sandbox: no fs entry may be a
    # path-ancestor of ~/.config/git/credentials (this catches every
    # dir-shaped cover). The config chain rides fs_read_file per-file; the
    # APFS firmlink root (/System/Volumes/Data) stays out of every command
    # sandbox — as a dir grant it makes every home path readable through the
    # firmlink view, re-opening this same floor.
    ($git.fs_read + $git.fs_read_file
      | all(. as $p | ("~/.config/git/credentials" | startswith($p + "/")) | not)) and
    ($git.fs_read_file | index("~/.config/git/config") != null) and
    ($git.fs_read_file | index("~/.config/git/ignore") != null) and
    ($git.fs_read_file | index("~/.gitconfig") != null) and
    # Include closure: an ungranted include is fatal for git, not a skip.
    ($git.fs_read_file | index("~/.config/git/base") != null) and
    ($git.fs_read_file | index("~/.config/git/user") != null) and
    ($git.fs_read_file | index("~/.config/git/work-user") != null) and
    ($git.fs_read_file | index("~/.config/git/catppuccin.gitconfig") != null) and
    ([sands[] | (.fs_read // [])[]] | map(select(. == "/System/Volumes/Data")) | length) == 0 and
    ($git.fs_read | index("/opt/local") != null) and
    ($git.fs_write_file | index("/dev/dtracehelper") != null) and
    # the session exports GIT_SSL_CAINFO at the house bundle; ungranted in the
    # command sandbox every HTTPS op fails at certificate loading (measured)
    ($git.fs_read_file | index("~/.config/certificates/ca-bundle.pem") != null) and
    ($git.exec_paths | index("/opt/local/libexec/git-core") != null) and
{{- if eq .chezmoi.os "darwin" }}
    ($git.unsafe_macos_seatbelt_rules | index("(allow process-exec* (literal \"/opt/local/libexec/git-core/git\"))") != null) and
{{- end }}
    ($git.fs_read | index("~/.local/share/chezmoi") != null) and
    ($git.fs_read | index("~/.local/share/opencode/snapshot") != null) and
    ($git.fs_write | index("~/.local/share/opencode/snapshot") != null) and
    ($git.fs_write | index("{{ trimSuffix "/" (env "TMPDIR" | default "/tmp") }}") != null) and
    ($git.fs_write | index("$TMPDIR") | not) and
    ($mise.fs_read | index("~/.config/mise") != null) and
    ($mise.fs_write | index("{{ trimSuffix "/" (env "TMPDIR" | default "/tmp") }}") != null) and
    ($mise.fs_write | index("$TMPDIR") | not) and
    ($mise.fs_read | index("~/.local/bin") | not) and
    ($mise.fs_read_file | index("~/.local/bin/mise") != null) and
    # Mise install/state stores and the shared pre-commit caches are READ-only
    # in every command sandbox: no fs_write/fs_write_file entry may equal,
    # ancestor-cover, or sit inside them (the command tier replaces session
    # grants and inherits no trusted-configs deny, so a write grant here is a
    # trust-planting / install hole; warm stores run, never install).
    ($mise.fs_write | index("~/.local/state/mise") | not) and
    ($mise.fs_read | index("~/.local/state/mise") != null) and
    ($mise.fs_read | index("~/Library/Caches/mise") != null) and
    ($mise.fs_write | index("~/Library/Caches/mise") != null) and
    ($mise.fs_read | index("~/.local/share/mise") != null) and
    ($mise.fs_write | index("~/.local/share/mise") | not) and
    ([sands[] | ((.fs_write // []) + (.fs_write_file // []))[]]
      | map(select(. as $e | ["~/.cache/pre-commit", "~/.cache/pre-commit-zipapp",
                             "~/.local/share/mise", "~/.local/state/mise"]
                   | any(. as $p | $e == $p or ($e | startswith($p + "/")) or ($p | startswith($e + "/")))))
      | length) == 0 and
    ($git.fs_write | any(covers("~/.cache/pre-commit")) | not) and
    ($git.fs_read | index("~/.cache/pre-commit") != null) and
    # Sandbox network lists resolve through the [network.groups] catalog; the
    # pins are EXACT sets (group refs are narrow by design — a base-category
    # reference would widen the mediated sandbox and must never render).
    ($git.network.allow_domain | sort) == ["*.githubusercontent.com", "codeload.github.com", "github.com"] and
    ($mise.network.allow_domain | sort) == ["*.crates.io", "*.golang.org", "*.jdx.dev", "*.nodejs.org", "*.npmjs.org", "*.pythonhosted.org", "api.github.com", "cdn.jsdelivr.net", "nodejs.org", "pypi.org", "static.rust-lang.org"]
  ' "{{ $nonoProfiles }}/base.json"
  assert_success
  run grep -E '^[[:space:]]*destinations[[:space:]]*=' "{{ $src }}/.chezmoidata/base/ai/permissions.toml"
  assert_failure
  assert_file_not_exists "{{ $src }}/.chezmoitemplates/base/ai/security/render-apply-dests"
  assert_file_not_exists "{{ $src }}/.chezmoitemplates/base/ai/security/parent-dir"
  # The ca_bundle group path is the bundle the session export ships as
  # GIT_SSL_CAINFO: grep the data path's tail in ca-bundle.sh.tmpl.
  local ca_leaf
  ca_leaf="$(sed -n 's|^ca_bundle = \["~/.config/\(.*\)"\]|\1|p' "{{ $src }}/.chezmoidata/base/ai/permissions.toml")"
  run grep -F "/$ca_leaf\"" "{{ $src }}/private_dot_config/exact_shell/exact_exports.d/ca-bundle.sh.tmpl"
  assert_success
}

# Render-time guard fixtures: every poisoned entry is refused by name — the
# same fixture pattern as the cmd converter below (the guard reports and
# exits 0; render-nono-cmd turns a report into a loud `fail`).
{{- $guardScript := includeTemplate "base/ai/security/sandbox-grant-guard" dict }}
{{- $guardProtected := includeTemplate "base/ai/security/expand-path-groups" (dict "root" . "groups" (index (includeTemplate "base/helpers/load-section" (dict "root" . "section" "ai.permissions.filesystem" "required" true) | mustFromJson) "deny" | default list)) | mustFromJson }}
{{- $guardCases := list }}
{{- range $c := list "~/.config/nono" "~/.config/nono/profiles/base.json" "~/.config/opencode/opencode.jsonc" "~/.config/chezmoi" "~/.config" "~/.config/tmux/**" "relative/config.json" "/" "~/../.." "~@evil" }}
{{-   $guardCases = append $guardCases (dict "dest" $c "expect" "refused") }}
{{- end }}
{{- /* Provider tokens are the guard's blind spot BY DESIGN (the provider enforces
     its own trust), and a file grant rides the dir floor untouched: both pass.
     exec_paths dirs pass the floor too; a seatbelt S-expression is refused as a
     non-path (render-nono-cmd never feeds it to the guard; defense in depth). */}}
{{- $guardCases = append $guardCases (dict "dest" "@git:config-files" "expect" "ok") }}
{{- $guardCases = append $guardCases (dict "dest" "~/.local/bin/mise" "expect" "ok") }}
{{- $guardCases = append $guardCases (dict "dest" "/opt/local/libexec/git-core" "expect" "ok") }}
{{- $guardCases = append $guardCases (dict "dest" "(allow process-exec* (literal \"/bin/sh\"))" "expect" "refused") }}
{{- /* The symlink case needs the managed ~/.pi symlink present to resolve into
     the protected ~/.config/pi root (fresh installs render before it exists). */}}
{{- $piRoot := stat (joinPath .chezmoi.homeDir ".pi") }}
{{- if and $piRoot $piRoot.isDir }}
{{-   $guardCases = append $guardCases (dict "dest" "~/.pi/agent/settings.json" "expect" "refused") }}
{{- end }}
{{- /* Case-alias fixture: the ~/.CONFIG stat only resolves on a case-insensitive
     volume, which is exactly when the guard must fold case to refuse the alias
     of the protected ~/.config root. */}}
{{- if stat (joinPath .chezmoi.homeDir ".CONFIG") }}
{{-   $guardCases = append $guardCases (dict "dest" "~/.CONFIG/nono" "expect" "refused") }}
{{- end }}
{{- /* Batched: the guard validates every entry independently against the
     protected floor, so one call per expectation group proves the whole
     matrix (empty output = every ok entry passes; refused entries are
     asserted by name, per-entry attribution preserved). */}}
{{- $guardOk := list }}
{{- $guardRefused := list }}
{{- range $c := $guardCases }}
{{-   if eq $c.expect "ok" }}{{- $guardOk = append $guardOk $c.dest }}{{- else }}{{- $guardRefused = append $guardRefused $c.dest }}{{- end }}
{{- end }}
{{- $guardViolOk := output "python3" "-c" $guardScript (dict "grants" $guardOk "protected" $guardProtected | toJson) | mustFromJson }}
{{- $guardViolRefused := output "python3" "-c" $guardScript (dict "grants" $guardRefused "protected" $guardProtected | toJson) | mustFromJson }}
{{- /* allow_globs mode (sandbox grant lists): globs pass, and protected roots
     stay refused through the glob (anchor the pattern, compare protected). */}}
{{- $globOk := list "~/.local/share/mise/installs/**" "~/.local/share/mise/installs/x/**/y" "~/.config/tmux/**" }}
{{- $globRefused := list "~/.config/nono/**" "~/.config/**" }}
{{- $globViolations := output "python3" "-c" $guardScript (dict "grants" (concat $globOk $globRefused) "protected" $guardProtected "allow_globs" true | toJson) | mustFromJson }}
{{- $ghStateViolations := output "python3" "-c" $guardScript (dict "grants" (list "~/.cache/gh-sandbox") "protected" $guardProtected "allow_globs" true | toJson) | mustFromJson }}

