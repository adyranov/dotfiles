# bats test_tags=kind:greywall
@test "greywall.json is deployed from ai permissions" {
  assert_file_exists "{{ $greywallDir }}/greywall.json"
  run jq -e '
    .filesystem.defaultDenyRead == true and
    .filesystem.allowRead == [".", "~/.config/agents/**", "~/.config/certificates/ca-bundle.pem", "~/.config/greywall/**", "~/.config/npm/npmrc", "~/.local/share/engram", "~/.local/share/engram/**"] and
    (.filesystem.allowWrite | index("~/.cache/npm") != null) and
    (.filesystem.allowWrite | index("~/.cache/node-gyp") != null) and
    (.filesystem.allowWrite | index("~/.local/state/npm") != null) and
    (.filesystem.denyRead | index("~/.ssh/id_*") != null) and
    (.filesystem.denyRead | index("~/.gnupg/**") != null) and
    (.filesystem.denyRead | index(".env") != null) and
    (.filesystem.denyRead | index("**/.env") != null) and
    (.filesystem.denyWrite | index("~/.ssh") != null) and
    (.filesystem.denyWrite | index("~/.gnupg") != null) and
    (.filesystem.denyWrite | index(".env") != null) and
    (.filesystem.denyWrite | index("**/.env") != null) and
    (.filesystem.denyRead | index("**/.npmrc") == null) and
    (.filesystem.denyRead | index("**/*.tfstate") == null) and
    (.filesystem.denyWrite | index("**/.npmrc") == null) and
    (.filesystem.denyWrite | index("**/*.tfstate") == null) and
    (.filesystem.denyRead | index("~/.config/pi/agent/auth.json") == null) and
    (.filesystem.denyRead | index("~/.local/share/opencode/auth.json") == null) and
    (.filesystem.denyWrite | index("~/.config/pi/agent/auth.json") == null) and
    (.filesystem.denyWrite | index("~/.local/share/opencode/auth.json") == null) and
    (.command.allow | not) and
    (.command.deny | index("git * reset --hard *") != null) and
    (.command.deny | index("docker * system prune *") != null) and
    (.command.deny | index("chezmoi apply") != null) and
    (.command.deny | index("chezmoi apply *") == null) and
    .network.proxyUrl == "socks5://localhost:43052" and
    .network.httpProxyUrl == "http://localhost:43051" and
    .network.dnsAddr == "localhost:43053" and
    ((.network.rules // []) | length) > 0 and
    (.network.rules[] | select(.destination == "api.anthropic.com" and (.port | tostring) == "443" and .action == "allow")) and
    .ssh.allowedHosts == ["github.com"] and
    .ssh.allowedCommands == ["git-upload-pack"] and
    (.ssh.deniedCommands | index("git-receive-pack") != null) and
    (.ssh.deniedCommands | index("scp") != null) and
    .ssh.inheritDeny == true
  ' "{{ $greywallDir }}/greywall.json"
  assert_success
}

