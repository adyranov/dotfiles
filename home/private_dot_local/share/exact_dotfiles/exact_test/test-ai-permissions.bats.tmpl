# bats test_tags=kind:greywall
@test "greywall.json is deployed from ai permissions" {
  assert_file_exists "{{ $greywallDir }}/greywall.json"
  run jsoncJq -e '
    .filesystem.defaultDenyRead == true and
    .filesystem.allowGitConfig == true and
    (.filesystem.allowWrite | index("**") == null) and
    (.filesystem.allowWrite | index(".*/**") == null) and
    (.filesystem.denyRead | index("~/.ssh/id_*") != null) and
    (.filesystem.denyRead | index("~/.config/colima/**") == null) and
    (.filesystem.denyRead | index("~/.config/colima/**/id_*") != null) and
    (.filesystem.denyRead | index("**/.env.*") != null) and
    (.filesystem.denyWrite | index("**/.env") != null) and
    (.filesystem.denyWrite | index("**/.env.*") != null) and
    (.filesystem.denyWrite | index("~/.config/greywall/**") != null) and
    (.filesystem.allowWrite | index("~/.config/greywall/**") != null) and
    (.filesystem.allowRead | index("~/.cache/pre-commit/**") != null) and
    (.filesystem.allowWrite | index("~/.cache/pre-commit/**") != null) and
    (.filesystem.denyWrite | index("~/Library/Application Support/greywall") != null) and
    (.filesystem.allowWrite | index("~/Library/Application Support/greywall") != null) and
    (.filesystem.denyWrite | index("~/.config/agents/**") == null) and
    (.filesystem.allowWrite | index("~/.config/agents/**") != null) and
    (.filesystem.denyWrite | index("~/.config/docker/config.json") != null) and
    (.filesystem.denyWrite | index("~/.config/git/credentials") != null) and
    (.filesystem.denyWrite | index("~/.local/share/mkcert/rootCA-key.pem") != null) and
    (.command.allow | not) and
    (.command.deny | index("chezmoi apply") != null) and
    (.command.deny | index("chezmoi apply *") == null) and
    .network.proxyUrl == "socks5://localhost:43052" and
    (.network.rules[] | select(.destination == "api.anthropic.com" and (.port | tostring) == "443" and .action == "allow")) and
    .ssh.allowedHosts == ["github.com"] and
    .ssh.inheritDeny == true and
    (.network.allowUnixSockets | index("~/.local/share/tmux") != null) and
    (.filesystem.denyWrite | index("~/.config/pi/**") == null) and
    (.filesystem.denyWrite | index("~/.config/pi/profiles/core/**") == null) and
    (.filesystem.allowWrite | index("~/.config/pi/agent/.models.json*") != null) and
    (.filesystem.allowWrite | index("~/.config/pi/agent/.settings.json*") != null) and
    (.filesystem.allowWrite | index("~/.config/pi/agent/models.json") != null) and
    (.filesystem.allowWrite | index("~/.config/pi/agent/settings.json") != null) and
    (.filesystem.allowWrite | index("~/.config/rpiv-pi") != null) and
    (.filesystem.allowWrite | index("~/.config/opencode/**") != null) and
    (.filesystem.allowWrite | index("~/.config/rpiv-pi/**") != null) and
    (.filesystem.allowWrite | index("~/.local/share/dotfiles/test") != null) and
    (.filesystem.allowWrite | index("~/.local/share/dotfiles/test/**") != null) and
    # Shared scratch parent only: base profile must not allow other agent scratch dirs
    (.filesystem.allowRead | index("/tmp/agents") != null) and
    (.filesystem.allowRead | index("/tmp/agents/**") == null) and
    (.filesystem.allowWrite | index("/tmp/agents") != null) and
    (.filesystem.allowWrite | index("/tmp/agents/**") == null) and
    (.filesystem.denyWrite | index("~/.config/pi/agent/auth.json") == null) and
    (.filesystem.denyWrite | index("~/.config/pi/profiles/core/auth.json") == null) and
    (.filesystem.denyWrite | index("~/.config/pi/profiles/factory/auth.json") == null)
  ' "{{ $greywallDir }}/greywall.json"
  assert_success
}

