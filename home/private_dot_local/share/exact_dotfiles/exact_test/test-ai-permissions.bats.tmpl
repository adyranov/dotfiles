{{- /* Route validation fixtures: every bad row must FAIL the render, naming the
     row and the reason. Each pins routes_enabled=true: the gate lives in the
     os overlay (base is false, darwin true, Linux hosts stay false), and every
     row check sits inside it, so an overlay-derived value would silently
     no-op the fixtures on a non-enforcing host. A poisoned row name must be a
     REAL base routes row (the gap-dup check compares routes against
     env_injected; a name with no route row has nothing to collide with). */}}
# runCapped ARGS... — nested-render chezmoi boots can hang on sandbox init
# churn (git config EPERM → curl to a dead proxy port); cap each render so
# one hang fails its own test, not the whole suite cap.
runCapped() {
  local tout="${TIMEOUT_BIN:-}"
  [ -n "$tout" ] || tout="$(command -v gtimeout || command -v timeout || true)"
  if [ -z "$tout" ]; then
    printf 'gtimeout/timeout not found; refusing uncapped chezmoi render\n'
    return 1
  fi
  run "$tout" 20 "$@"
  if [ "$status" -eq 124 ]; then
    printf 'chezmoi render timed out — likely sandbox init churn\n'
    return 1
  fi
}
# collapseRoots JSON_PATHS — print the JSON array of the tilde-anchored `~/X/**`
# roots (`~/X`) that exist as directories on this machine. A host apply collapses
# exactly those to the dir-literal (strip-tilde-tails SIGILL guard), so a pin
# written against the native glob must accept that prefix too. A sandboxed render
# cannot stat, keeps native globs, and gets an empty list here.
# shortcut: roots are probed at TEST time, so deleting a collapsed root after
# apply turns this red (re-apply renders it native again).
collapseRoots() {
  local path root out=()
  while IFS= read -r path; do
    case $path in
      '~'*/\*\*) root="${path%/\*\*}" ;;
      *) continue ;;
    esac
    if [ -d "${root/#\~/$HOME}" ]; then
      out+=("$root")
    fi
  done < <(printf '%s\n' "$1" | jq -r '.[] | select(type == "string")')
  if [ ${#out[@]} -eq 0 ]; then
    printf '[]'
  else
    printf '%s\n' "${out[@]}" | jq -R . | jq -sc .
  fi
}
# denyHas PROFILE GLOB — deny-tier pin that survives that collapse: the native
# glob, or the collapsed dir-literal, accepting ONLY the glob's own root prefix
# (verified to exist) — never an arbitrary string. macOS seatbelt dir denies
# recurse, so the literal is semantically equal-or-stronger than the glob.
denyHas() {
  jq -e --arg g "$2" --argjson roots "$(collapseRoots "[\"$2\"]")" '
    .filesystem.deny as $d |
    (($d | index($g)) != null) or
    (($g | startswith("~/")) and ($g | endswith("/**")) and
      (($g | rtrimstr("/**")) as $root |
        (any($roots[]; . == $root)) and (($d | index($root)) != null)))
  ' "$1"
}
