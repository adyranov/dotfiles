{{- /* Loud-fail + resolution edges: a dotless entry in a sandbox list
      is a group reference — a typo FAILS the render naming it (net axis via
      the classify-refs classifier; fs axis via render-apply-dests' pre-guard
      resolution), while a valid group ref resolves and its `$TMPDIR`-sentinel
      member expands before the profile sees it. The fixture templates are
      BAKED here and rendered at TEST time: each nested chezmoi boot re-runs
      the render-apply-dests guard chain (two python spawns), so render-time
      nesting charged every routine apply four extra chezmoi boots. The
      fixtures ride the shared deep-copy-set-path preamble. */ -}}
{{- $typoTpl := `{{- $r := includeTemplate "base/test/deep-copy-set-path" (dict "root" . "path" (list "ai" "base" "permissions" "apply" "sandbox" "git" "network" "allow_domain") "value" (list "git_forge_typo")) | mustFromJson -}}
{{- includeTemplate "base/ai/security/render-nono-cmd" (dict "root" $r "applyDests" (includeTemplate "base/ai/security/render-apply-dests" (dict "root" $r) | mustFromJson)) -}}` }}
{{- $fsTypoTpl := `{{- $r := includeTemplate "base/test/deep-copy-set-path" (dict "root" . "path" (list "ai" "base" "permissions" "apply" "sandbox" "git" "fs_read") "value" (list "no_such_fs_group_typo")) | mustFromJson -}}
{{- includeTemplate "base/ai/security/render-nono-cmd" (dict "root" $r "applyDests" (includeTemplate "base/ai/security/render-apply-dests" (dict "root" $r) | mustFromJson)) -}}` }}
