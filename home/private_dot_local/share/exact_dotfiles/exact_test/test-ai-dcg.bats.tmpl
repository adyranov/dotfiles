# bats test_tags=kind:dcg
@test "dcg denies rtk-wrapped git push --force (wrapped argv parity)" {
  requireDcgPack
  run dcg test --robot "rtk git push --force origin main"
  assert_failure
  # Wrapped lease parity: the custom rule closes what core.git leaves open
  # (upstream recommends --force-with-lease, so it denies bare, allows lease).
  run dcg test "rtk git push --force-with-lease origin main"
  assert_failure
  assert_output --partial "rtk-git-force-push"
}

# bats test_tags=kind:dcg
@test "dcg denies local git destructive commands (restored core.toml gate)" {
  requireDcgPack
  # core.git (built-in) gates clean/reset --hard; user.github rows close the
  # retired core.toml policy's gaps. Assert the rule that actually fires.
  local cases=(
    "git clean -fdx|core.git:clean-force"
    "git reset --hard HEAD~1|core.git:reset-hard"
    "git rebase main|git-rebase"
    "git stash drop|git-stash-drop-pop"
    "git tag -d v1.0|git-tag-delete"
    "git worktree remove ../wt|git-worktree-remove"
  )
  local case cmd rule
  local offenders=()
  for case in "${cases[@]}"; do
    cmd="${case%%|*}" rule="${case##*|}"
    run dcg test --robot "$cmd"
    [ "$status" -ne 0 ] || offenders+=("robot allowed: $cmd")
    run dcg test "$cmd"
    [[ "$output" == *"$rule"* && "$output" == *"BLOCKED"* ]] ||
      offenders+=("$cmd: missing '$rule' or BLOCKED")
  done
  printf '%s\n' "${offenders[@]}" >&2
  assert_equal "${#offenders[@]}" 0
}

# bats test_tags=kind:dcg
@test "dcg gates mutation shapes on the session gh tier (KTD3)" {
  requireDcgPack
  # KTD3: the session gh tier makes every agent-tree process write-capable on
  # the GitHub route hosts, so the user.github rows gate the mutation SHAPE,
  # not one binary. Reads (gh api GET, plain curl GET) must stay ungated.
  local blocks=(
    "gh api repos/x/y -X POST|gh-api-write"
    "gh api repos/x/y --method PATCH|gh-api-write"
    "gh api repos/x/y -f foo=bar|gh-api-field-write"
    "gh workflow run ci.yml|gh-workflow-run"
    "gh pr merge 1|gh-pr-merge"
    "gh release create v1|gh-release-create"
    "curl -X POST https://api.github.com/repos/x/y/issues|http-client-write"
    "wget --post-data=a=b https://api.github.com/x|http-client-write"
    "gh secret set FOO=1|gh-secret"
    # gh-delete matches "gh secret delete" first; the row named in output is the
    # first match, not gh-secret. The set case pins the gh-secret row by name.
    "gh secret delete FOO|gh-delete"
  )
  local allows=(
    "gh api /user"
    "gh api repos/x/y"
    "curl -s https://api.github.com/rate_limit"
    "curl -X GET https://github.com/x"
    "gh secret list"
    "gh auth login"
    "gh auth token"
  )
  local case cmd rule
  local offenders=()
  for case in "${blocks[@]}"; do
    cmd="${case%%|*}" rule="${case##*|}"
    run dcg test --robot "$cmd"
    [ "$status" -ne 0 ] || offenders+=("robot allowed: $cmd")
    run dcg test "$cmd"
    [[ "$output" == *"$rule"* && "$output" == *"BLOCKED"* ]] ||
      offenders+=("$cmd: missing '$rule' or BLOCKED")
  done
  for cmd in "${allows[@]}"; do
    run dcg test --robot "$cmd"
    [ "$status" -eq 0 ] || offenders+=("robot blocked read: $cmd")
  done
  printf '%s\n' "${offenders[@]}" >&2
  assert_equal "${#offenders[@]}" 0
}

