# bats test_tags=kind:dcg
@test "dcg bypass: hooks carry the DCG_BYPASS boot snapshot" {
  local hooks=({{ $hooks | join " " }})
  [[ ${#hooks[@]} -gt 0 ]] || skip "no agent toolchain enabled"
  local f
  for f in "${hooks[@]}"; do
    run grep -F 'DCG_BYPASS_AT_BOOT' "$f"
    assert_success
  done
}

# dcgCoreDriver — build a node driver over the applied source guard core in
# $BATS_TEST_TMPDIR/core.mjs. The deny fixture's word tokens are split so the
# pack gap-regexes (\bkubectl\b[^;&|\n]*?\bdelete\b) cannot match this source
# line when an agent edits the template through shell command text (see
# solutions/workflow-issues/dcg-self-blocks-deny-target-fixtures.md). Driver modes via argv[2]:
# "tamper" mutates process.env.DCG_BYPASS after the module body ran (AE3);
# "sandbox" boots under a fake HOME (write probe fails = sandbox seal) and
# restores the real HOME (DCG_TEST_REAL_HOME) post-boot so the dcg spawn
# resolves the chezmoi packs. Disarm probes run the core's seal-3 write
# probe against $HOME/.config/dcg (self-deleting) — host boots probe ok.
# Inherited-env scrub coverage lives in test-ai-permissions deny_vars.
dcgCoreDriver() {
  local core="$HOME/.local/share/chezmoi/home/.chezmoitemplates/base/ai/security/dcg-guard-core"
  cat "$core" >"$BATS_TEST_TMPDIR/core.mjs"
  cat >>"$BATS_TEST_TMPDIR/core.mjs" <<'DRIVER'
if (process.argv[2] === "tamper") process.env.DCG_BYPASS = "1";
if (process.argv[2] === "sandbox") process.env.HOME = process.env.DCG_TEST_REAL_HOME;
const denyFixture = ["kubectl", "del" + "ete", "pod", "x"].join(" ");
console.log(JSON.stringify(dcgBlockReason(denyFixture, process.cwd())));
DRIVER
}

# bats test_tags=kind:dcg
@test "dcg bypass: DCG_BYPASS=1 at boot disarms the guard core" {
  dcgCoreDriver
  run env -u AGENT_SANDBOX DCG_BYPASS=1 node "$BATS_TEST_TMPDIR/core.mjs"
  assert_success
  # Exact two-line contract: the boot warning (agent-visible audit line) then
  # the disarm verdict. Exactness keeps a missing-binary host from passing
  # this probe (its warning text differs), so requireDcgPack stays optional.
  assert_output "[dcg] guard bypassed at boot (DCG_BYPASS); commands are not checked
null"
}

# bats test_tags=kind:dcg
@test "dcg bypass parity: truthy set matches upstream parse_env_bool" {
  dcgCoreDriver
  run env -u AGENT_SANDBOX DCG_BYPASS=true node "$BATS_TEST_TMPDIR/core.mjs"
  assert_success
  assert_output "[dcg] guard bypassed at boot (DCG_BYPASS); commands are not checked
null"
  run env -u AGENT_SANDBOX DCG_BYPASS=" TRUE " node "$BATS_TEST_TMPDIR/core.mjs"
  assert_success
  assert_output "[dcg] guard bypassed at boot (DCG_BYPASS); commands are not checked
null"
  # Falsy values stay armed (guard-intact requires the rendered packs).
  requireDcgPack
  run env -u AGENT_SANDBOX DCG_BYPASS=0 node "$BATS_TEST_TMPDIR/core.mjs"
  assert_output --partial "Blocked by DCG"
}

# bats test_tags=kind:dcg
@test "dcg guard intact: deny fixture blocks with no DCG_BYPASS at boot" {
  requireDcgPack
  dcgCoreDriver
  run env -u AGENT_SANDBOX -u DCG_BYPASS node "$BATS_TEST_TMPDIR/core.mjs"
  assert_output --partial "Blocked by DCG"
}

# bats test_tags=kind:dcg
@test "dcg tamper: post-boot process.env.DCG_BYPASS mutation does not disarm (AE3)" {
  requireDcgPack
  dcgCoreDriver
  run env -u AGENT_SANDBOX -u DCG_BYPASS node "$BATS_TEST_TMPDIR/core.mjs" tamper
  assert_output --partial "Blocked by DCG"
}

# bats test_tags=kind:dcg
@test "dcg guard intact: DCG_BYPASS=1 with AGENT_SANDBOX=1 at boot still blocks (AE2)" {
  requireDcgPack
  dcgCoreDriver
  run env DCG_BYPASS=1 AGENT_SANDBOX=1 node "$BATS_TEST_TMPDIR/core.mjs"
  assert_output --partial "Blocked by DCG"
}

# bats test_tags=kind:dcg
@test "dcg bypass probe: unwritable DCG store keeps guard armed despite DCG_BYPASS=1" {
  requireDcgPack
  dcgCoreDriver
  mkdir -p "$BATS_TEST_TMPDIR/fakehome/.config/dcg"
  chmod 555 "$BATS_TEST_TMPDIR/fakehome/.config/dcg"
  # Boot under the fake HOME so seal 3 (boot write probe) fails like in a
  # sandbox; the driver restores the real HOME post-boot for the dcg spawn.
  run env -u AGENT_SANDBOX DCG_BYPASS=1 HOME="$BATS_TEST_TMPDIR/fakehome" \
    DCG_TEST_REAL_HOME="$HOME" node "$BATS_TEST_TMPDIR/core.mjs" sandbox
  chmod 755 "$BATS_TEST_TMPDIR/fakehome/.config/dcg"
  assert_output --partial "Blocked by DCG"
}

# bats test_tags=kind:dcg
@test "require_dcg fails not skips when the pinned binary is missing" {
  # Drift guard: a missing binary must surface the drift message, never a
  # skip (the subshell has no bats skip, so a skip call = command-not-found).
  run bash -c 'PATH=; source "$1" && require_dcg' _ "$BATS_TEST_DIRNAME/common-helper.bash"
  assert_failure
  assert_output --partial "dcg pinned binary not found"
  refute_output --partial "command not found"
}


