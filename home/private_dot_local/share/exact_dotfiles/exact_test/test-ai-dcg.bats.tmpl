{{- if get .toolchains "kubernetes" | default false }}
# bats test_tags=kind:dcg
@test "dcg kubernetes pack gates k3d delete and node-shell, keeps list/get" {
  # Robot probes carry the verdict; dcg evaluates the text, k3d/kubectl never
  # run. Rule names are suffix-only: the pack id prefix is the renderer's.
  requireDcgPack
  local blocks=(
    "k3d cluster delete dev|k3d-cluster-delete"
    "kubectl node-shell node-1|kubectl-node-shell"
  )
  local allows=(
    "k3d cluster list"
    "k3d cluster get dev"
    "kubectl get nodes"
  )
  local case cmd rule
  local offenders=()
  for case in "${blocks[@]}"; do
    cmd="${case%%|*}" rule="${case##*|}"
    run dcg test --robot "$cmd"
    [ "$status" -ne 0 ] || offenders+=("robot allowed: $cmd")
    run dcg test "$cmd"
    [[ "$output" == *"$rule"* && "$output" == *"BLOCKED"* ]] ||
      offenders+=("$cmd: missing '$rule' or BLOCKED")
  done
  for cmd in "${allows[@]}"; do
    run dcg test --robot "$cmd"
    [ "$status" -eq 0 ] || offenders+=("robot blocked: $cmd")
  done
  printf '%s\n' "${offenders[@]}" >&2
  assert_equal "${#offenders[@]}" 0
}
{{- end }}

