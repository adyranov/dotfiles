# bats test_tags=kind:dcg
@test "dcg denies git push --force (belt over the nono hard core)" {
  requireDcgPack
  run dcg test --robot "git push --force origin main"
  assert_failure
  run dcg test "git push --force origin main"
  assert_failure
  assert_output --partial "core.git:push-force-long"
