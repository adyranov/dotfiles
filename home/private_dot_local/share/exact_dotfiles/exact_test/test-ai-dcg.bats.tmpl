# bats test_tags=kind:dcg
@test "dcg bypass: hooks carry the DCG_BYPASS boot snapshot" {
  local hooks=({{ $hooks | join " " }})
  [[ ${#hooks[@]} -gt 0 ]] || skip "no agent toolchain enabled"
  local f
  for f in "${hooks[@]}"; do
    run grep -F 'DCG_BYPASS_AT_BOOT' "$f"
    assert_success
    # The AGENT_SANDBOX_HOME seal ships with the boot snapshot.
    run grep -F 'AGENT_SANDBOX_HOME' "$f"
    assert_success
    # Custom-pack rules carry the allowlist guidance (dcg allow dies with
    # "Unknown pack ID" on custom pack ids).
    run grep -F 'dcg allowlist add-command' "$f"
    assert_success
    # The write-deny claim is macOS-scoped (Linux Landlock cannot express
    # deny-within-allow; the file is agent-writable there).
    run grep -F 'on Linux keep this file out of' "$f"
    assert_success
  done
}

# bats test_tags=kind:dcg
@test "dcg approval string is runnable: hooks emit the --reason form and dcg takes it" {
  # The block message is the operator's only remediation path: the emitted
  # string must run on the pinned binary (dcg 0.16.0 requires --reason).
  local hooks=({{ $hooks | join " " }})
  [[ ${#hooks[@]} -gt 0 ]] || skip "no agent toolchain enabled"
  local f
  for f in "${hooks[@]}"; do
    # The single-source shape, verbatim: the core's template literal inlines
    # into every hook, so one fixed-string grep pins all three at once.
    run grep -F -e 'dcg allow ${rule} --reason' "$f"
    assert_success
  done
  require_dcg
  # The binary accepts the emitted form. Rule ids are pack_id:name shaped
  # (bare names die with "Invalid rule ID"); the store is isolated under
  # HOME/XDG roots, so the probe never writes the user store.
  local store="$BATS_TEST_TMPDIR/dcg-store"
  mkdir -p "$store/.config/dcg" "$store/.local/share"
  run env HOME="$store" XDG_CONFIG_HOME="$store/.config" XDG_DATA_HOME="$store/.local/share" \
    dcg allow core.git:dcg-suite-probe --reason "suite probe"
  assert_success
  # The no---reason form is NOT runnable (clap usage error), which is why the shape is pinned.
  run env HOME="$store" XDG_CONFIG_HOME="$store/.config" XDG_DATA_HOME="$store/.local/share" \
    dcg allow core.git:dcg-suite-probe
  assert_failure
  # Binary ceiling (0.16.0): dcg allow does not resolve the dotted CUSTOM
  # pack ids ("Unknown pack ID"), so the custom-rule route is `dcg allowlist
  # add-command`. Red here = upstream fixed id resolution; drop this pin.
  run env HOME="$store" XDG_CONFIG_HOME="$store/.config" XDG_DATA_HOME="$store/.local/share" \
    dcg allow chezmoi.custom:dcg-suite-probe --reason "suite probe"
  assert_failure
}

# dcgCoreDriver — build a node driver over the APPLIED source guard core in
# $BATS_TEST_TMPDIR/core.mjs (located via tmplFile: a hardcoded source path
# misses CI workspace clones and custom sourceDirs). The deny fixture's word
# tokens are split so the pack gap-regexes (\bkubectl\b[^;&|\n]*?\bdelete\b)
# cannot match this source line when an agent edits the template through
# shell command text.
# Driver modes via argv[2]:
# "tamper" mutates process.env.DCG_BYPASS after the module body ran;
# "sandbox" restores the real HOME (DCG_TEST_REAL_HOME) post-boot so the dcg
# spawn resolves the chezmoi packs;
# "nocandidates" replaces every candidate with a nonexistent $BATS_TEST_TMPDIR
# path (copied-fixture mutation, no production seam) so spawnSync really runs
# and ENOENTs through the unstartable branch, probing literal "echo hi". The
# seal-3 probe is uid-anchored, so the
# sandboxed floor is simulated with the core's test seam:
# DCG_TEST_REAL_HOME_OVERRIDE points the probe at $BATS_TEST_TMPDIR, and the
# "sealed" shape chmods that dir 555 pre-boot (EPERM = sandbox floor).
# Inherited-env scrub coverage lives in test-ai-permissions deny_vars.
dcgCoreDriver() {
  local core
  core="$(tmplFile .chezmoitemplates/base/ai/security/dcg-guard-core)"
  cat "$core" >"$BATS_TEST_TMPDIR/core.mjs"
  cat >>"$BATS_TEST_TMPDIR/core.mjs" <<'DRIVER'
if (process.argv[2] === "tamper") process.env.DCG_BYPASS = "1";
if (process.argv[2] === "sandbox") process.env.HOME = process.env.DCG_TEST_REAL_HOME;
if (process.argv[2] === "nocandidates")
  DCG_CANDIDATES.splice(0, DCG_CANDIDATES.length, `${process.env.BATS_TEST_TMPDIR}/no-such-dcg`);
const denyFixture = ["kubectl", "del" + "ete", "pod", "x"].join(" ");
const noCand = process.argv[2] === "nocandidates";
console.log(JSON.stringify(dcgBlockReason(noCand ? "echo hi" : denyFixture, process.cwd())));
DRIVER
}

# bats test_tags=kind:dcg
@test "dcg bypass: DCG_BYPASS=1 at boot disarms the guard core" {
  dcgCoreDriver
  # Stripped of both sandbox markers; the probe seam pins the target to a
  # WRITABLE dir, simulating the host boot whose uid-derived real-home store
  # is writable, so the bypass is admitted (the banner rides the real-home
  # probe, not AGENT_SANDBOX absence). A marker-scrubbed sandboxed suite run
  # must not seal on the live store — the sealed shape is the chmod-555
  # probe below.
  run env -u AGENT_SANDBOX -u AGENT_SANDBOX_HOME \
    DCG_TEST_REAL_HOME_OVERRIDE="$BATS_TEST_TMPDIR" \
    DCG_BYPASS=1 node "$BATS_TEST_TMPDIR/core.mjs"
  assert_success
  # Exact two-line contract: the boot warning (agent-visible audit line) then
  # the disarm verdict. Exactness keeps a missing-binary host from passing
  # this probe (its warning text differs), so requireDcgPack stays optional.
  assert_output "[dcg] guard bypassed at boot (DCG_BYPASS); commands are not checked
null"
}

# bats test_tags=kind:dcg
@test "dcg bypass parity: truthy set matches upstream parse_env_bool" {
  dcgCoreDriver
  run env -u AGENT_SANDBOX -u AGENT_SANDBOX_HOME \
    DCG_TEST_REAL_HOME_OVERRIDE="$BATS_TEST_TMPDIR" \
    DCG_BYPASS=true node "$BATS_TEST_TMPDIR/core.mjs"
  assert_success
  assert_output "[dcg] guard bypassed at boot (DCG_BYPASS); commands are not checked
null"
  run env -u AGENT_SANDBOX -u AGENT_SANDBOX_HOME \
    DCG_TEST_REAL_HOME_OVERRIDE="$BATS_TEST_TMPDIR" \
    DCG_BYPASS=" TRUE " node "$BATS_TEST_TMPDIR/core.mjs"
  assert_success
  assert_output "[dcg] guard bypassed at boot (DCG_BYPASS); commands are not checked
null"
  # Falsy values stay armed (guard-intact requires the rendered packs).
  requireDcgPack
  run env -u AGENT_SANDBOX DCG_BYPASS=0 node "$BATS_TEST_TMPDIR/core.mjs"
  assert_output --partial "Blocked by DCG"
}

