# bats test_tags=kind:dcg
@test "dcg bypass: sealed real-home probe rejects stripped markers + writable forged HOME" {
  requireDcgPack
  # Root bypasses the DAC chmod this probe uses to simulate the sandbox floor.
  [ "$(id -u)" -ne 0 ] || { echo "root bypasses DAC: shape skipped" >&3; skip "root bypasses DAC"; }
  dcgCoreDriver
  # The seal-3 probe anchors on the uid-derived real home, so the sandboxed
  # floor is simulated through the core's test seam (probe target redirected
  # to $BATS_TEST_TMPDIR, chmod 555 = EPERM). The attack shape — stripped
  # markers + WRITABLE forged HOME + DCG_BYPASS=1 — reads as host boot under
  # the gate; the sealed probe rejects it and the banner is suppressed.
  mkdir -p "$BATS_TEST_TMPDIR/fakehome"
  chmod 555 "$BATS_TEST_TMPDIR"
  run env -u AGENT_SANDBOX -u AGENT_SANDBOX_HOME DCG_BYPASS=1 \
    HOME="$BATS_TEST_TMPDIR/fakehome" DCG_TEST_REAL_HOME="$HOME" \
    DCG_TEST_REAL_HOME_OVERRIDE="$BATS_TEST_TMPDIR" \
    node "$BATS_TEST_TMPDIR/core.mjs" sandbox
  chmod 755 "$BATS_TEST_TMPDIR"
  assert_output --partial "Blocked by DCG"
  refute_output --partial "guard bypassed at boot"
}

# bats test_tags=kind:dcg
@test "dcg bypass probe: WRITABLE forged HOME stays armed under the pinned sandbox home (seal 3b)" {
  requireDcgPack
  dcgCoreDriver
  # Under AGENT_SANDBOX the HOME must EQUAL the launcher-pinned
  # AGENT_SANDBOX_HOME — exact, not descendant ($HOME/.cache/scratch is a
  # redirect target too). The driver restores the real HOME post-boot so the
  # dcg spawn resolves the chezmoi packs.
  mkdir -p "$BATS_TEST_TMPDIR/fakehome/.config/dcg"
  run env DCG_BYPASS=1 AGENT_SANDBOX=1 AGENT_SANDBOX_HOME="$HOME" \
    HOME="$BATS_TEST_TMPDIR/fakehome" DCG_TEST_REAL_HOME="$HOME" \
    node "$BATS_TEST_TMPDIR/core.mjs" sandbox
  assert_output --partial "Blocked by DCG"
  assert_output --partial "forged HOME"
  refute_output --partial "guard bypassed at boot"
  # Descendant of the pin is not the pin:
  run env DCG_BYPASS=1 AGENT_SANDBOX=1 AGENT_SANDBOX_HOME="$HOME" \
    HOME="$HOME/.cache/scratch" DCG_TEST_REAL_HOME="$HOME" \
    node "$BATS_TEST_TMPDIR/core.mjs" sandbox
  assert_output --partial "Blocked by DCG"
  assert_output --partial "forged HOME"
  refute_output --partial "guard bypassed at boot"
  # The pin is load-bearing: AGENT_SANDBOX with no AGENT_SANDBOX_HOME fails
  # closed the same way — a missing pin means the marker was forged around.
  run env DCG_BYPASS=1 AGENT_SANDBOX=1 \
    HOME="$BATS_TEST_TMPDIR/fakehome" DCG_TEST_REAL_HOME="$HOME" \
    node "$BATS_TEST_TMPDIR/core.mjs" sandbox
  assert_output --partial "Blocked by DCG"
  assert_output --partial "without the launcher-pinned AGENT_SANDBOX_HOME"
  refute_output --partial "guard bypassed at boot"
  # The mirror shape: the pin surviving a stripped AGENT_SANDBOX marker is
  # sandboxed lineage (`env -u AGENT_SANDBOX …`), not a host boot.
  run env DCG_BYPASS=1 AGENT_SANDBOX_HOME="$HOME" \
    HOME="$BATS_TEST_TMPDIR/fakehome" DCG_TEST_REAL_HOME="$HOME" \
    node "$BATS_TEST_TMPDIR/core.mjs" sandbox
  assert_output --partial "Blocked by DCG"
  assert_output --partial "AGENT_SANDBOX stripped"
  refute_output --partial "guard bypassed at boot"
}

# bats test_tags=kind:dcg
@test "require_dcg fails not skips when the pinned binary is missing" {
  # A missing binary must surface the drift message, never a skip.
  # common-helper's top-level `load` lines are bats-isms, so the subshell
  # stubs load/skip (a skip call prints SKIP_CALLED — the refute target).
  run bash -c 'load() { :; }; skip() { echo SKIP_CALLED; }; PATH=; source "$1" && require_dcg' _ "$BATS_TEST_DIRNAME/common-helper.bash"
  assert_failure
  assert_output --partial "dcg pinned binary not found"
  refute_output --partial "SKIP_CALLED"
}


