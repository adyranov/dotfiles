{{- if ne .host.type "ephemeral" }}
# bats file_tags=suite:ai

load 'common-helper'

setup() {
  common_setup
}

# DCG robot probes against the APPLIED pack config. The host run is
# authoritative: inside a sandboxed agent (AGENT_SANDBOX marker exported by
# the `agent` launcher before `exec nono run`) the whole file skips.
#
# In-sandbox agents cannot self-allow (stores are read-only); the
# allowlist-edit round-trip is out of scope for these probes.

setup_file() {
  if [ -n "${AGENT_SANDBOX:-}" ]; then
    echo "SKIP: nested sandbox — run on host" >&3
    skip "AGENT_SANDBOX is set; DCG probes are host-authoritative"
  fi
}

# The deny probes assert the chezmoi-rendered custom packs (ai toolchain).
# This suite is unapplied when the ai toolchain is off (.chezmoiignore gate),
# so an empty pack dir here is render drift: fail, never skip.
requireDcgPack() {
  require_dcg
  [ -n "$(ls -A "$HOME/.config/dcg/packs" 2>/dev/null)" ] || {
    echo "no custom DCG pack rendered on an ai-enabled host (render drift)" >&2
    return 1
  }
}

# bats test_tags=kind:dcg
@test "dcg binary on PATH is the pinned 0.16.0 every probe below evaluates" {
  # Same-suite gate: a stale binary silently changes verdicts, so the version
  # goes red at this gate before the deny probes below decide. PATH-resolved
  # (require_dcg → command -v), never a hardcoded path, so hosts probe the
  # same binary the hooks spawn. The version follows the mise package
  # (unpinned upstream) — bump with the data.
  require_dcg
  run dcg --version
  assert_output --partial "0.16.0"
}

