# --- _agent zsh completion ---

# bats test_tags=toolchain:ai,kind:config
@test "rendered _agent completes agent words, per-agent profiles, and flags" {
  local tmpl rendered block word
  tmpl="{{ .chezmoi.sourceDir }}/private_dot_config/exact_zsh/exact_completions/_agent"
  assert_file_exists "$tmpl"
  rendered="$BATS_FILE_TMPDIR/_agent"
  assert_file_exists "$rendered"
  run head -n 1 "$rendered"
  assert_success
  assert_line --index 0 "#compdef agent"
  # Level 1: agent names and aliases (binary-bearing launchers, from data).
  for word in {{ $binWords | join " " }}; do
    run grep -F -- "'$word'" "$rendered"
    assert_success
  done
  # The shared peer carries no launcher map and must not leak into the completion.
  run grep -Fw shared "$rendered"
  assert_failure
  # Level 2: selectable agents offer their own profile words (from data).
  block=$(awk '/^  pi[|)]/{f=1} f{print} f&&/;;/{exit}' "$rendered")
  for word in {{ $piProfiles | join " " }}; do
    run grep -Ew -- "$word" <<<"$block"
    assert_success
  done
  block=$(awk '/^  opencode[|)]/{f=1} f{print} f&&/;;/{exit}' "$rendered")
  for word in {{ $ocProfiles | join " " }}; do
    run grep -Ew -- "$word" <<<"$block"
    assert_success
  done
  # The non-selectable agent's arm omits every profile word of the union.
  block=$(awk '/^  omp[|)]/{f=1} f{print} f&&/;;/{exit}' "$rendered")
  run grep -Ew '{{ $profileUnion | join "|" }}' <<<"$block"
  assert_failure
  # Global flag set on the completion arms.
  for flag in -h --help --list --print-env --no-sandbox; do
    run grep -F -- "'$flag'" "$rendered"
    assert_success
  done
}

# bats test_tags=toolchain:ai,kind:launcher
@test "every launcher arg-loop flag appears in the rendered _agent" {
