      ) -}}
{{-   $_ := set $enabledServing "enabled-test" (dict
        "kind" "openai-compatible"
        "base_url" "http://enabled.test:8080/v1"
        "models" (list (dict "id" "enabled-model" "name" "Enabled" "context_window" 2000))
      ) -}}
{{-   $enabledBase := merge (dict) .ai.base -}}
{{-   $_ := set $enabledBase "serving" $enabledServing -}}
{{-   $enabledAI := merge (dict) .ai -}}
{{-   $_ := set $enabledAI "base" $enabledBase -}}
{{-   $enabledRoot := merge (dict) . -}}
{{-   $_ := set $enabledRoot "ai" $enabledAI -}}
{{-   if .toolchains.pi -}}
{{-     $enabledApplicable = append $enabledApplicable "pi" -}}
{{-     $piCfg := includeTemplate "private_dot_config/exact_pi/exact_agent/private_models.json.tmpl" $enabledRoot | fromJson -}}
{{-     $enabledChecks = concat $enabledChecks (list
          (dict "kind" "run" "tool" "pi" "label" "providers.disabled-test" "prog" "" "arg" "" "filepart" "" "run" (printf "test \"%s\" = \"excluded\"" (ternary "leaked" "excluded" (hasKey $piCfg.providers "disabled-test"))))
          (dict "kind" "run" "tool" "pi" "label" "providers.enabled-test" "prog" "" "arg" "" "filepart" "" "run" (printf "test \"%s\" = \"present\"" (ternary "present" "missing" (hasKey $piCfg.providers "enabled-test"))))) -}}
{{-   end -}}
{{-   if .toolchains.opencode -}}
{{-     $enabledApplicable = append $enabledApplicable "opencode" -}}
{{-     $ocCfg := includeTemplate "base/ai/agents/opencode/render-opencode-config" (dict "root" $enabledRoot "profile" "minimal") | fromJsonc -}}
{{-     $enabledChecks = concat $enabledChecks (list
          (dict "kind" "run" "tool" "opencode" "label" "providers.disabled-test" "prog" "" "arg" "" "filepart" "" "run" (printf "test \"%s\" = \"excluded\"" (ternary "leaked" "excluded" (hasKey $ocCfg.provider "disabled-test"))))
          (dict "kind" "run" "tool" "opencode" "label" "providers.enabled-test" "prog" "" "arg" "" "filepart" "" "run" (printf "test \"%s\" = \"present\"" (ternary "present" "missing" (hasKey $ocCfg.provider "enabled-test"))))) -}}
{{-   end -}}
{{- end -}}
{{- $enabledTools := list -}}
{{- range $c := $enabledChecks -}}
{{-   $enabledTools = append $enabledTools (get $c "tool") -}}
{{- end -}}

{{- if .toolchains.ai }}
{{ includeTemplate "base/test/shared-fact-loop" (dict
      "title" "serving providers with enabled=false are omitted by every applicable agent (shared fact loop)"
      "tags" "toolchain:ai,kind:config"
      "message" "enabled=false provider omission broken (offending tools):"
      "checks" $enabledChecks) }}
{{- end }}

# bats test_tags=toolchain:ai,kind:config
@test "shared-fact loops cover exactly this host's applicable toolchains" {
  local offenders="" fact have want
  while IFS=$'\t' read -r fact have want; do
    run test "$have" = "$want"
    [ "$status" -eq 0 ] || offenders="$offenders $fact"
  done <<'ENTRY_SET'
{{- range $e := list
      (dict "fact" "infer01" "have" ($infer01Tools | sortAlpha | uniq | join ",") "want" ($infer01Applicable | sortAlpha | uniq | join ","))
      (dict "fact" "qwen" "have" ($qwenTools | sortAlpha | uniq | join ",") "want" ($qwenApplicable | sortAlpha | uniq | join ","))
      (dict "fact" "enabled" "have" ($enabledTools | sortAlpha | uniq | join ",") "want" ($enabledApplicable | sortAlpha | uniq | join ","))
  }}
{{ $e.fact }}	{{ $e.have }}	{{ $e.want }}
{{- end }}
ENTRY_SET
  if [ -n "$offenders" ]; then
    printf 'loop entry set drift (fact):%s\n' "$offenders"
    return 1
  fi
}

# --- Shared agent launcher scratch root ---
#
# Launcher line-presence facts collapse into one aggregate offender pass via
# base/test/shared-fact-loop; ordering/behavior probes stay as their own tests.

{{- $launchLines := list
      (dict "label" "scratch-bootstrap" "line" "bootstrap_scratch")
      (dict "label" "agents-root" "line" "_agents_root=\"/tmp/agents\"")
      (dict "label" "scratch-dir-var" "line" "scratch_dir=\"$_agents_root/$AGENT_NAME\"")
      (dict "label" "tmpdir-scope" "line" "export TMPDIR=\"$scratch_dir\"")
      (dict "label" "nono-exec" "line" "exec nono run --profile \"$NONO_PROFILE\" ${open_port:+--open-port \"$open_port\"} -- \"$BINARY_NAME\" \"$@\"")
      (dict "label" "port-init" "line" "open_port=\"\"")
      (dict "label" "port-wire" "line" "open_port=\"$OPENCODE_PORT\"")
      (dict "label" "sandbox-marker" "line" "export AGENT_SANDBOX=1")
      (dict "label" "no-save-prompt" "line" "export NONO_NO_SAVE_PROMPT=1")
      (dict "label" "nono-log" "line" "export NONO_LOG_FILE=\"$TMPDIR/nono.log\"")
      (dict "label" "usr-bin-first" "line" "export PATH=\"/usr/bin:$PATH\"")
      (dict "label" "test-mode-var" "line" "AGENT_LAUNCH_TEST_MODE")
      (dict "label" "test-tmpdir-var" "line" "BATS_TEST_TMPDIR")
      (dict "label" "test-scratch-root-var" "line" "AGENT_LAUNCH_TEST_SCRATCH_ROOT")
      (dict "label" "deny-symlink-dir" "line" "Scratch dir is a symlink")
      (dict "label" "deny-symlink-root" "line" "Scratch root is a symlink")
      (dict "label" "deny-root-escape" "line" "Scratch dir resolves outside expected root")
      (dict "label" "deny-owner" "line" "Scratch dir owner mismatch")
      (dict "label" "deny-root-mode" "line" "Scratch root is not private")
      (dict "label" "deny-dir-mode" "line" "Scratch dir is not private")
      (dict "label" "exact-0700" "line" "-eq $((0700))")
      (dict "label" "pkill-anchor" "line" "__pattern=\"engram serve ${ENGRAM_PORT}( |$)\"")
      (dict "label" "supervise-lock" "line" "ENGRAM_LOCK=\"$ENGRAM_STATE/.supervise.lock\"")
      (dict "label" "identity-record" "line" "ENGRAM_ID_FILE=\"$ENGRAM_STATE/daemon.identity\"")
