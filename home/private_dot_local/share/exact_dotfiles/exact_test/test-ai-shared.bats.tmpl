  local launcher comp offenders flag
  launcher="$BATS_FILE_TMPDIR/launcher.sh"
  comp="$BATS_FILE_TMPDIR/_agent"
  assert_file_exists "$launcher"
  assert_file_exists "$comp"
  offenders=""
  while IFS= read -r flag; do
    grep -Fq -e "$flag" "$comp" || offenders="$offenders $flag"
  done < <(awk '{tok=$1; sub(/\)$/,"",tok); n=split(tok,a,"|"); for(i=1;i<=n;i++) if (a[i] ~ /^--?[a-z][a-z0-9-]*$/) print a[i]}' "$launcher" | sort -u)
  if [ -n "$offenders" ]; then
    printf 'launcher flags missing from _agent:%s\n' "$offenders"
    return 1
  fi
}

# bats test_tags=toolchain:ai,kind:config
@test "ignore gates prune _agent and .local/bin/agent with no agent toolchain" {
  # All agent toolchains off → both gates emit their entries; any one
  # agent toolchain on → neither.
  local home_ignore comp_ignore off on d
  home_ignore="{{ .chezmoi.sourceDir }}/.chezmoiignore.tmpl"
  comp_ignore="{{ .chezmoi.sourceDir }}/private_dot_config/exact_zsh/exact_completions/.chezmoiignore.tmpl"
  off='{"toolchains":{"ai":false,"pi":false,"opencode":false,"omp":false}}'
  on='{"toolchains":{"ai":true,"pi":true,"opencode":false,"omp":false}}'
  d="$BATS_TEST_TMPDIR"
  render_source "$home_ignore" "$d/off-home" "$off"
  run grep -Fx .local/bin/agent "$d/off-home"
  assert_success
  render_source "$comp_ignore" "$d/off-comp" "$off"
  run grep -Fx _agent "$d/off-comp"
  assert_success
  render_source "$home_ignore" "$d/on-home" "$on"
  run grep -Fx .local/bin/agent "$d/on-home"
  assert_failure
  render_source "$comp_ignore" "$d/on-comp" "$on"
  run grep -Fx _agent "$d/on-comp"
  assert_failure
}

