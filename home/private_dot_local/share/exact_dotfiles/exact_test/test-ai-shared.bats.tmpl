#!/usr/bin/env bats

# bats file_tags=suite:ai

load 'common-helper'

setup() {
  common_setup
  AGENTS_MD="${HOME}/.config/agents/AGENTS.md"
}

# --- Shared agents tree ---

# bats test_tags=kind:agents-tree
@test "global AGENTS.md exists and contains abstract workflow" {
  assert_file_exists "$AGENTS_MD"
  run grep -F "inspect relevant code, configuration, and callers before editing" "$AGENTS_MD"
  assert_success
  run grep -F "Treat sandbox, permission, and policy denials" "$AGENTS_MD"
  assert_success
}

# bats test_tags=kind:agents-tree
@test "global AGENTS.md stays generic" {
  run grep -ci "chezmoi" "$AGENTS_MD"
  assert_failure
}

# bats test_tags=kind:agents-tree
@test "global AGENTS.md carries concise response style" {
  run grep -F "concise, information-dense English" "$AGENTS_MD"
  assert_success
  run grep -F "Include material assumptions, risks, evidence, and requested detail" "$AGENTS_MD"
  assert_success
}


# bats test_tags=kind:agents-tree
@test "~/.agents alias points at ~/.config/agents" {
  run readlink -f "$HOME/.agents"
  assert_success
  assert_output "$HOME/.config/agents"
}

# bats test_tags=kind:agents-tree
@test "~/.agents/skills directory is reachable" {
  assert_dir_exists "$HOME/.agents/skills"
}

# bats test_tags=kind:config
@test "all rpiv configs have guidance" {
  for cfg in rpiv-advisor/advisor rpiv-ask-user-question/config rpiv-todo/config; do
    run jq -e '.guidance.promptSnippet | length > 0' "{{ .chezmoi.homeDir }}/.config/${cfg}.json"
    assert_success
    run jq -e '.guidance.promptGuidelines | length > 0' "{{ .chezmoi.homeDir }}/.config/${cfg}.json"
    assert_success
  done
  run jq -e '(.guidance.web_search.promptGuidelines | length > 0) and (.guidance.web_fetch.promptGuidelines | length > 0)' "{{ .chezmoi.homeDir }}/.config/rpiv-web-tools/config.json"
  assert_success
  run jq -e 'any(.guidance.web_search.promptGuidelines[]; contains("plan or final answer"))' "{{ .chezmoi.homeDir }}/.config/rpiv-web-tools/config.json"
  assert_success
  run jq -e 'any(.guidance.web_fetch.promptGuidelines[]; contains("plan or final answer"))' "{{ .chezmoi.homeDir }}/.config/rpiv-web-tools/config.json"
  assert_success
  run jq -e '.interceptors.github.enabled == true' "{{ .chezmoi.homeDir }}/.config/rpiv-web-tools/config.json"
  assert_success
  run jq -r '.guidance.promptGuidelines | join(" ")' "{{ .chezmoi.homeDir }}/.config/rpiv-ask-user-question/config.json"
  assert_success
  assert_output --partial "material ambiguity"
}

# bats test_tags=toolchain:ai,kind:symlink
@test "shared caveman skill directory is not linked" {
  assert_file_not_exists "$HOME/.config/agents/skills/caveman"
}

# bats test_tags=toolchain:ai,kind:symlink
@test "shared caveman commands are not installed via library" {
  assert_file_not_exists "$HOME/.config/agents/libraries/commands/caveman"
}

# bats test_tags=toolchain:ai,kind:symlink
@test "shared caveman installation instructions are not installed" {
  assert_file_not_exists "$HOME/.config/agents/libraries/commands/caveman-instructions"
}

# --- Shared agent launcher scratch root ---

# bats test_tags=kind:launcher
@test "agent-launch bootstraps per-agent scratch root and scopes TMPDIR" {
  local launch="$HOME/.local/bin/agent-launch"
  assert_file_exists "$launch"
  run grep -F 'bootstrap_scratch' "$launch"
  assert_success
  run grep -F '_agents_root="/tmp/agents"' "$launch"
  assert_success
  run grep -F 'scratch_dir="$_agents_root/$AGENT_NAME"' "$launch"
  assert_success
  # TMPDIR must be scoped to the greywall invocation, after daemon startup
  run grep -F 'export TMPDIR="$scratch_dir"' "$launch"
  assert_success
  run grep -F 'exec greywall --profile "$GREYWALL_PROFILE" -- "$BINARY_NAME" "$@"' "$launch"
  assert_success
}

# bats test_tags=kind:launcher
@test "agent-launch test scratch override requires explicit BATS markers" {
  local launch="$HOME/.local/bin/agent-launch"
  assert_file_exists "$launch"
  # Override is gated on AGENT_LAUNCH_TEST_MODE=1 AND a non-empty BATS_TEST_TMPDIR
  run grep -F 'AGENT_LAUNCH_TEST_MODE' "$launch"
  assert_success
  run grep -F 'BATS_TEST_TMPDIR' "$launch"
  assert_success
  run grep -F 'AGENT_LAUNCH_TEST_SCRATCH_ROOT' "$launch"
  assert_success
}

# bats test_tags=kind:launcher
@test "agent-launch scratch bootstrap fails closed on unsafe paths and enforces exact 0700" {
  local launch="$HOME/.local/bin/agent-launch"
  assert_file_exists "$launch"
  run grep -F 'Scratch dir is a symlink' "$launch"
  assert_success
  run grep -F 'Scratch root is a symlink' "$launch"
  assert_success
  run grep -F 'Scratch dir resolves outside expected root' "$launch"
  assert_success
  run grep -F 'Scratch dir owner mismatch' "$launch"
  assert_success
  # Private mode is enforced as an exact 0700 equality, not a loosenable mask
  run grep -F 'Scratch root is not private' "$launch"
  assert_success
  run grep -F 'Scratch dir is not private' "$launch"
  assert_success
  run grep -F '-eq $((0700))' "$launch"
  assert_success
}
