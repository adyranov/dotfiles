@test "success path releases the lock before the exec (not trap-only)" {
  # The launcher ends in `exec nono run ...` and traps never fire through
  # exec: the readiness loop must be followed by a bare lock_release call
  # (rmdir) before that exec.
  local launch="$HOME/.local/bin/agent"
  assert_file_exists "$launch"
  run awk '/^  wait_ready$/{w=NR} /^    lock_release$/{r=NR} /exec nono run --profile/{e=NR} END{exit !(w>0 && r>w && r<e)}' "$launch"
  assert_success
}

