# bats test_tags=toolchain:ai,kind:launcher
@test "launcher grammar aggregate: flag/positional/print-env forms resolve for every agent" {
  # One pass over every grammar form; reports ALL offenders at once
  # (corner-cases-only policy: single gate, bounded runtime).
  local mock offenders="" launch
  launch="$HOME/.local/bin/agent"
  mock="$(mktemp -d "$BATS_TEST_TMPDIR/mock.XXXXXX")"
  setup_mock_bins "$mock" curl nc nono
  local b
  for b in pi opencode omp; do
    cat >"$mock/$b" <<'EOF'
#!/usr/bin/env sh
echo "PROFILE=${PI_CODING_AGENT_DIR:-${OPENCODE_CONFIG_DIR:-${PI_CONFIG_DIR:-unset}}}"
echo "OMP_PROFILE=[${OMP_PROFILE:-unset}]"
echo "OPENCODE_PORT=[${OPENCODE_PORT:-unset}]"
echo "ARGS=$*"
EOF
  done
  chmod +x "$mock"/*

  probe() { # probe DESC NEEDLE AGENT ARGS...
    local desc="$1" needle="$2"
    shift 2
    local out
    out="$(env $(scratch_env) AGENT_SANDBOX="${AGENT_SANDBOX:-}" PATH="$mock:$PATH" \
      "$launch" "$@" 2>&1)" || true
    case "$out" in *"$needle"*) ;; *) offenders="$offenders [$desc]";; esac
  }
  probe_neg() { # probe_neg DESC NEEDLE AGENT ARGS... — must fail, naming NEEDLE
    local desc="$1" needle="$2"
    shift 2
    local out rc
    out="$(env $(scratch_env) PATH="$mock:$PATH" "$launch" "$@" 2>&1)" && rc=0 || rc=$?
    case "$out" in
    *"$needle"*) [ "$rc" -ne 0 ] || offenders="$offenders [$desc:exit0]" ;;
    *) offenders="$offenders [$desc]" ;;
    esac
  }

  probe "pi pre-name flag" "profiles/core" --profile core pi "Hi there"
  probe "pi prompt passthrough" "ARGS=Hi there" pi --profile core "Hi there"
  probe "pi positional compat" "profiles/factory" pi factory
  probe "oc flag factory port" "OPENCODE_PORT=[1234]" oc --profile factory --port 1234 --continue x
  probe "oc positional compat" "ARGS=--continue x" oc core --continue x
  probe "omp named profile" "OMP_PROFILE=[work]" omp --profile work -c s
  probe "omp pre-name equals" "OMP_PROFILE=[work]" --profile=work omp -c s
  probe_neg "pi unknown profile dies" "Unknown profile: bogus" pi --profile bogus
  probe_neg "omp positional dies" "--profile <name>" omp core
  probe_neg "print-env typo dies" "unknown argument --typo" pi --print-env --typo
  probe_neg "agent-less pre-name dies" "unknown agent" --profile core "Hi there"

  AGENT_SANDBOX=1
  probe "nested sandbox flag form" "Sandbox: inherited" pi --profile core --no-sandbox
  unset AGENT_SANDBOX
  unset -f probe probe_neg 2>/dev/null || true
  if [ -n "$offenders" ]; then
    printf 'failing grammar forms:%s\n' "$offenders"
    return 1
  fi
}

# --- Engram daemon supervisor ---
#
# ensure_engram supervises one shared daemon: healthy+current fast path,
# lock-guarded restart for unhealthy/binary-stale, detached spawn, identity
# record (version + resolved path + mtime). The probes below drive the
# applied launcher end-to-end with PATH-pinned stubs: a stateful mock engram
# (spawn log + health mode file), a stub curl (health = mode file), the
# passthrough nono, and a mock agent binary.
# Isolation contract: ENGRAM_PORT is pinned to a dedicated ephemeral port
# and ENGRAM_STATE/ENGRAM_DATA_DIR ride BATS_TEST_TMPDIR — no probe touches
# port 7437, the real state dir, or the real engram. The kill paths are
# anchored to the test port, so teardown can reach only mock daemons.

{{- /* Drive agent: the selectable multi-profile agent (opencode) when its
       toolchain is enabled; the supervisor is agent-agnostic, so one drive
       covers it. `agent <one> <profile>` needs a selectable agent. */ -}}
{{- $sup := dict -}}
{{- if get .toolchains "opencode" | default false -}}
{{-   $sup = dict "name" "opencode" "binary" "opencode" "profile" "factory" -}}
{{- end }}


setup_file() {
  # Dedicated ephemeral port (49152-65535): 7437 is structurally excluded,
  # and the anchored pkill/pgrep pattern scopes every kill to it. The probe
  # mirrors the launcher's pick_high_port ephemeral range: if that range
  # changes, this probe and the 49152-65535 assertion must follow.
  ENGRAM_TEST_PORT=$(awk 'BEGIN{srand();print int(rand()*16384)+49152}')
  [ "$ENGRAM_TEST_PORT" != 7437 ]
  # setup_file vars do not reach per-test processes; share via file.
  printf '%s' "$ENGRAM_TEST_PORT" >"$BATS_FILE_TMPDIR/port"
  SUP_PATTERN="engram serve ${ENGRAM_TEST_PORT}( |$)"
  # Stub bins staged once per file; sup_init copies them per test.
  mkdir -p "$BATS_FILE_TMPDIR/bin"
  setup_mock_bins "$BATS_FILE_TMPDIR/bin" curl nc nono git
  # Stub curl: asserts the real health contract (an argument equal to
  # $ENGRAM_URL/health, fail-closed when unset) and answers iff mode says up.
  cat >"$BATS_FILE_TMPDIR/bin/curl" <<'EOF'
#!/usr/bin/env sh
for __a in "$@"; do [ "$__a" = "$ENGRAM_URL/health" ] && __hit=1; done
[ "${__hit:-}" = 1 ] || exit 7
[ -f "$ENGRAM_TEST_HEALTH" ] || exit 7
[ "$(cat "$ENGRAM_TEST_HEALTH")" = up ] || exit 7
EOF
  # Mock engram: `serve` logs the spawn, flips health up (ENGRAM_TEST_
  # AUTOPUP=0 keeps the spawn unready), and keeps the exact
  # `engram serve <port>` argv so the anchored pkill pattern matches it.
  cat >"$BATS_FILE_TMPDIR/bin/engram" <<'EOF'
#!/usr/bin/env sh
case "$1" in
  version) printf 'engram 9.9.9-test\n' ;;
  serve)
    printf 'spawn\n' >> "$ENGRAM_TEST_SPAWNS"
    [ "${ENGRAM_TEST_AUTOPUP:-1}" = 1 ] && printf 'up\n' > "$ENGRAM_TEST_HEALTH"
    while :; do sleep 1; done
    ;;
  *) exit 1 ;;
esac
EOF
  printf '#!/usr/bin/env sh\nprintf "launched\\n"\n' >"$BATS_FILE_TMPDIR/bin/{{ $sup.binary }}"
  chmod +x "$BATS_FILE_TMPDIR/bin/curl" "$BATS_FILE_TMPDIR/bin/engram" "$BATS_FILE_TMPDIR/bin/{{ $sup.binary }}"
  # Shared static renders: the _agent completion and the launcher are
  # host-static; render once for the word/flag-drift/zsh-parse tests.
  render_source "{{ .chezmoi.sourceDir }}/private_dot_config/exact_zsh/exact_completions/_agent" "$BATS_FILE_TMPDIR/_agent"
  render_source "{{ .chezmoi.sourceDir }}/private_dot_local/exact_bin/executable_agent" "$BATS_FILE_TMPDIR/launcher.sh"
}

teardown_file() {
  local port
  port=$(cat "$BATS_FILE_TMPDIR/port" 2>/dev/null || true)
  [ -n "$port" ] || return 0
  pkill -f "engram serve ${port}( |\$)" 2>/dev/null || true
}

sup_init() {
  # Per-test copy: PATH pins $BATS_TEST_TMPDIR/bin and tests mutate it.
  cp -R "$BATS_FILE_TMPDIR/bin" "$BATS_TEST_TMPDIR/bin"
  mkdir -p "$BATS_TEST_TMPDIR/state" "$BATS_TEST_TMPDIR/data"
  : >"$BATS_TEST_TMPDIR/spawns"
  printf 'down\n' >"$BATS_TEST_TMPDIR/mode"
  ENGRAM_TEST_PORT=$(cat "$BATS_FILE_TMPDIR/port")
  SUP_PATTERN="engram serve ${ENGRAM_TEST_PORT}( |$)"
}

# Array, not a space-joined string: the host PATH can contain spaces
# (e.g. "VMware Fusion.app"), and unquoted $(sup_env) splits mid-value.
sup_env_args() {
  sup_args=(
    "ENGRAM_TEST_HEALTH=$BATS_TEST_TMPDIR/mode"
    "ENGRAM_TEST_SPAWNS=$BATS_TEST_TMPDIR/spawns"
    "ENGRAM_PORT=$ENGRAM_TEST_PORT"
    "ENGRAM_URL=http://127.0.0.1:$ENGRAM_TEST_PORT"
    "XDG_STATE_HOME=$BATS_TEST_TMPDIR/state"
    "ENGRAM_DATA_DIR=$BATS_TEST_TMPDIR/data"
    AGENT_LAUNCH_TEST_MODE=1
    "AGENT_LAUNCH_TEST_SCRATCH_ROOT=$BATS_TEST_TMPDIR/agents"
    # Pinned minimal PATH: the host PATH carries the real engram, which the
    # no-engram fail-closed probe must not see.
    "PATH=$BATS_TEST_TMPDIR/bin:/usr/bin:/bin:/usr/sbin:/sbin"
  )
}

sup_launch() {
  sup_env_args
  run env "${sup_args[@]}" "$HOME/.local/bin/agent" {{ $sup.name }}{{ with $sup.profile }} {{ . }}{{ end }}
}

sup_pids() { pgrep -f "$SUP_PATTERN" 2>/dev/null | sort | tr '\n' ' '; }
sup_spawns() { wc -l < "$BATS_TEST_TMPDIR/spawns" | tr -d ' '; }
sup_state() { printf '%s' "$BATS_TEST_TMPDIR/state/engram"; }

# Warmup: first supervised launch (daemon absent, health down) spawns the
# mock daemon and writes the identity record; resets the spawn log.
sup_warm() {
  sup_launch
  assert_success
  assert_output --partial "launched"
  : >"$BATS_TEST_TMPDIR/spawns"
}

