  # Default render (no approvals): neither socket key appears.
  test "{{ if hasKey ($piDefault.filesystem | default dict) "unix_socket" }}present{{ else }}absent{{ end }}" = "absent" ||
    offenders="$offenders default:unix_socket-leaked"
  test "{{ if hasKey ($piDefault.filesystem | default dict) "unix_socket_subtree" }}present{{ else }}absent{{ end }}" = "absent" ||
    offenders="$offenders default:unix_socket_subtree-leaked"

  cat >"$BATS_TEST_TMPDIR/sock.tmpl" <<'FIXTURE'
{{ $sockTpl }}
FIXTURE

  run "$cb" execute-template -f "$BATS_TEST_TMPDIR/sock.tmpl"
  [ "$status" -eq 0 ] || offenders="$offenders fixture:fails-render"
  json="$(sed -n '/^{/,$p' <<<"$output")"
  # The fixture data is written `~/...` (the user-typed form): nono drops
  # connect grants for MISSING sockets silently, so the renderer must emit the
  # canonical homeDir path, never the literal tilde form (U2).
  jq -e --arg home '{{ trimSuffix "/" .chezmoi.homeDir }}' '.approvals.filesystem |
    (.unix_socket | index($home + "/.local/share/ssh/sockets/fixture-master") != null) and
    (.unix_socket | index("~/.local/share/ssh/sockets/fixture-master") == null) and
    (.bypass_protection | index($home + "/.local/share/ssh/sockets/fixture-master") != null) and
    (.bypass_protection | index("~/.local/share/ssh/sockets/fixture-master") == null)' <<<"$json" >/dev/null ||
    offenders="$offenders approvals:grant+bypass-not-canonical"

  jq -e '
    (.linux.agent.filesystem | (has("unix_socket") | not) and (has("unix_socket_subtree") | not)) and
    (.linux.base.linux.af_unix_mediation == "pathname") and
    ([.linux.base.command_policies.commands[].from[] | select(type == "object")
      | (.sandbox.unsafe_macos_seatbelt_rules // [])[]] | length) == 0
  ' <<<"$json" >/dev/null || offenders="$offenders linux:fail-closed-shape"

  if [ -n "$offenders" ]; then
    printf 'SSH socket render checks (offending):%s\n' "$offenders"
    return 1
  fi
}
{{- end }}

