# --- Engram daemon supervisor ---
#
# ensure_engram supervises one shared daemon: healthy+current fast path,
# lock-guarded restart for unhealthy/binary-stale, detached spawn, identity
# record (version + resolved path + mtime). The probes below drive the
# applied launcher end-to-end with PATH-pinned stubs: a stateful mock engram
# (spawn log + health mode file), a stub curl (health = mode file), the
# passthrough nono, and a mock agent binary.
# Isolation contract: ENGRAM_PORT is pinned to a dedicated ephemeral port
# and ENGRAM_STATE/ENGRAM_DATA_DIR ride BATS_TEST_TMPDIR — no probe touches
# port 7437, the real state dir, or the real engram. The kill paths are
# anchored to the test port, so teardown can reach only mock daemons.

setup_file() {
  # Shared static renders: the _agent completion and the launcher are
  # host-static; render once for the word/flag-drift/zsh-parse tests.
  render_source "{{ .chezmoi.sourceDir }}/private_dot_config/exact_zsh/exact_completions/_agent" "$BATS_FILE_TMPDIR/_agent"
  render_source "{{ .chezmoi.sourceDir }}/private_dot_local/exact_bin/executable_agent" "$BATS_FILE_TMPDIR/launcher.sh"
}

