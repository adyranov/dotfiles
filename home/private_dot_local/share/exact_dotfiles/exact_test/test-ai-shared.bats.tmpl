# bats test_tags=toolchain:ai,kind:launcher
@test "every launcher arg-loop flag appears in the rendered _agent" {
  # Drift channel: a flag added to the launcher arg loop must show up in the
  # completion. Extract the case-arm flag tokens from the rendered launcher
  # and require each in the rendered _agent.
  local launcher comp offenders flag
  launcher="$BATS_FILE_TMPDIR/launcher.sh"
  comp="$BATS_FILE_TMPDIR/_agent"
  assert_file_exists "$launcher"
  assert_file_exists "$comp"
  # Case-arm shape only (`--flag ... )` lines): comment prose opening with a
  # `--word` token is not a flag. Leading whitespace is optional (the
  # exit-only arms sit at column 0).
  offenders=""
  while IFS= read -r flag; do
    grep -Fq -e "$flag" "$comp" || offenders="$offenders $flag"
  done < <(awk '/^[[:space:]]*--?[a-z][^)]*\)/{tok=$1; sub(/\)$/,"",tok); n=split(tok,a,"|"); for(i=1;i<=n;i++) if (a[i] ~ /^--?[a-z][a-z0-9-]*$/) print a[i]}' "$launcher" | sort -u)
  if [ -n "$offenders" ]; then
    printf 'launcher flags missing from _agent:%s\n' "$offenders"
    return 1
  fi
}

