# bats test_tags=kind:launcher
@test "agent refuses guarded launches on Linux, ordered before both launch paths" {
  # U2 Linux/WSL2 fail-closed: the DCG guard hooks render inside agent-writable
  # roots and Landlock cannot deny-within-allow, so a guarded session cannot be
  # enforced on Linux. Launcher SOURCE pin: the gate DIES (never warns), sits
  # AFTER argument parsing (it consumes no launcher flags) and BEFORE the
  # --no-sandbox DCG_BYPASS exec and the nono exec, honours the AGENT_SANDBOX
  # nesting marker (nested launches inherit the parent kernel sandbox), names
  # the remedy, and is gated on `uname -s` = Linux so the Darwin path is
  # untouched.
  local launch="$BATS_FILE_TMPDIR/launcher.sh"
  assert_file_exists "$launch"
  run grep -Fq -e 'Refusing a guarded agent launch on Linux' "$launch"
  assert_success
  run grep -Fq -e 'dcg allow' "$launch"
  assert_failure
  # die, not warn; ordered: after the arg loops (exit-only dispatch) and the
  # shared pwd_guard, BEFORE the DCG_BYPASS export (unsandboxed branch) and
  # the nono exec.
  run awk '/exit_only_flags "\$@" \|\| true/{p=NR} /pwd_guard$/{w=NR} /Refusing a guarded agent launch on Linux/{g=NR} /export DCG_BYPASS=1/{b=NR} /exec nono run --profile/{e=NR} END{exit !(p>0 && w>0 && g>0 && b>0 && e>0 && p<g && w<g && g<b && b<e)}' "$launch"
  assert_success
  # the Linux condition honours the nesting marker inside its own condition window.
  run awk '/\[ "\$UNAME_S" = Linux \] &&/{g=NR} g && NR>=g && NR<=g+3 && /AGENT_SANDBOX:-/ {n=NR} END{exit !(g>0 && n>0)}' "$launch"
  assert_success
}

# bats test_tags=kind:launcher
@test "agent probes credential sources ahead of both launch paths and names every remedy" {
  local launch="$HOME/.local/bin/agent"
  assert_file_exists "$launch"
  # Ordering: after the exit-only dispatch (so --print-env never reaches the
  # probe), after the Linux gate, before both the DCG_BYPASS export and the
  # nono exec — guarded and unguarded launches share it.
  run awk '/exit_only_flags "\$@" \|\| true/{o=NR} /Refusing a guarded agent launch on Linux/{g=NR} /^probe_credential_sources/{p=NR} /export DCG_BYPASS=1/{b=NR} /exec nono run --profile/{e=NR} END{exit !(o>0 && g>0 && p>0 && b>0 && e>0 && o<p && g<p && p<b && p<e)}' "$launch"
  assert_success
  # The probe owns the source reports: transitional env:// rows keep the
  # export remedy, keystore rows name the seed command, locks name the
  # unlock command, client-store refs name the client login. No value may
  # appear: reads go to scratch variables only (die/warn strings are pinned
  # here so no test ever sees a secret-shaped interpolation).
  run grep -Fq -e 'Routes without a credential source in this shell' "$launch"
  assert_success
  run grep -Fq -e 'seed-keystore' "$launch"
  assert_success
  run grep -Fq -e 'security unlock-keychain' "$launch"
  assert_success
  run grep -Fq -e 'unlock-keyring' "$launch"
  assert_success
  run grep -Fq -e 'Credential source unresolved — key' "$launch"
  assert_success
  # Value discipline: the keystore read is captured into locals only — no
  # export of a store read outside the documented runtime-only surface.
  run awk '/-w 2>\/dev\/null \|\| true/{ if (index($0, "__val=\"$(") == 0) exit 1 }' "$launch"
  assert_success
}

# bats test_tags=kind:launcher
@test "agent launcher keeps macOS keychain access strictly read-only" {
  # Re-scoped from the security-free pin: the probe needs read-only
  # Keychain invocations (find-generic-password -w, show-keychain-info).
  # Mutation subcommands and -g (private-key return) stay banned: the seed
  # command is the only writer, and it runs from the user's terminal.
  local launch="$BATS_FILE_TMPDIR/launcher.sh"
  assert_file_exists "$launch"
  local subs
  subs="$(awk '{
    line=$0
    while (match(line, /[;&|$( \t][ \t]*security[ \t]+[a-z-]+/)) {
      tok=substr(line, RSTART, RLENGTH)
      sub(/.*security[ \t]+/, "", tok)
      print tok
      line=substr(line, RSTART + RLENGTH)
    }
  }' "$launch" | sort -u)"
  [ -n "$subs" ] || { printf 'no security invocations found (probe regression?)\n'; return 1; }
  local bad
  # unlock-keychain is the F5 remedy text inside the die string, never run
  # by the launcher (naming commands is the remedy pattern).
  bad="$(printf '%s\n' "$subs" | grep -vE '^(find-generic-password|show-keychain-info|unlock-keychain)$')"
  [ -z "$bad" ] || { printf 'non-read-only security subcommands: %s\n' "$bad"; return 1; }
  run grep -E 'security [^;&|]*[[:space:]]-g([[:space:]]|$)' "$launch"
  assert_failure
  run grep -Fq -e 'find-generic-password -s nono -a' "$launch"
  assert_success
  run grep -Fq -e 'show-keychain-info' "$launch"
  assert_success
}

