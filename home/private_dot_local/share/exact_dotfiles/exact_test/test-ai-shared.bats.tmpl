# bats test_tags=kind:launcher
@test "agent refuses guarded launches on Linux, ordered before both launch paths" {
  # U2 Linux/WSL2 fail-closed: the DCG guard hooks render inside agent-writable
  # roots and Landlock cannot deny-within-allow, so a guarded session cannot be
  # enforced on Linux. Launcher SOURCE pin: the gate DIES (never warns), sits
  # AFTER argument parsing (it consumes no launcher flags) and BEFORE the
  # --no-sandbox DCG_BYPASS exec and the nono exec, honours the AGENT_SANDBOX
  # nesting marker (nested launches inherit the parent kernel sandbox), names
  # the remedy, and is gated on `uname -s` = Linux so the Darwin path is
  # untouched.
  local launch="$BATS_FILE_TMPDIR/launcher.sh"
  assert_file_exists "$launch"
  run grep -Fq -e 'Refusing a guarded agent launch on Linux' "$launch"
  assert_success
  run grep -Fq -e 'dcg allow' "$launch"
  assert_failure
  # die, not warn; ordered: after the arg loops (exit-only dispatch) and the
  # shared pwd_guard, BEFORE the DCG_BYPASS export (unsandboxed branch) and
  # the nono exec.
  run awk '/exit_only_flags "\$@" \|\| true/{p=NR} /pwd_guard$/{w=NR} /Refusing a guarded agent launch on Linux/{g=NR} /export DCG_BYPASS=1/{b=NR} /exec nono run --profile/{e=NR} END{exit !(p>0 && w>0 && g>0 && b>0 && e>0 && p<g && w<g && g<b && b<e)}' "$launch"
  assert_success
  # the Linux condition honours the nesting marker inside its own condition window.
  run awk '/\[ "\$UNAME_S" = Linux \] &&/{g=NR} g && NR>=g && NR<=g+3 && /AGENT_SANDBOX:-/ {n=NR} END{exit !(g>0 && n>0)}' "$launch"
  assert_success
}

