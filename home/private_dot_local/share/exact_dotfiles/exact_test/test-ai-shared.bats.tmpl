{{- if get .toolchains "claude" | default false }}
# bats test_tags=toolchain:claude,kind:launcher
@test "claude guarded launch probes the exact managed hook registration" {
  # Launcher claude boot probe, fake-home fixtures only (no real HOME config,
  # no live security probes). Nested --no-sandbox form: the probe runs, then
  # the mock claude execs, so no engram/nono/scratch paths are reached. One
  # aggregate pass: every drift shape must die as unprovisioned; the exact
  # managed registration (double-slash renderer form) must launch.
  local launch="$HOME/.local/bin/agent" home mock hook offenders=""
  if [ "$(uname -s)" = Linux ]; then
    skip "the launcher's U2 gate refuses guarded sandboxed launches on Linux"
  fi
  home="$BATS_TEST_TMPDIR/fakehome"
  mkdir -p "$home/.config/claude/hooks"
  : >"$home/.config/claude/hooks/dcg-guard.mjs"
  mock="$(mktemp -d "$BATS_TEST_TMPDIR/mock.XXXXXX")"
  setup_mock_bins "$mock" curl nc nono git engram pkill pgrep
  cat >"$mock/claude" <<'EOF'
#!/usr/bin/env sh
echo "launched ARGS=$*"
EOF
  chmod +x "$mock/claude"
  hook="$home/.config/claude/hooks/dcg-guard.mjs"
  local M='"matcher":"Bash|Write|Edit|MultiEdit|NotebookEdit"'
  local H='"type":"command","command":"node '"$hook"'"'
  local reg="{$M,\"hooks\":[{$H}]}"
  local gap="settings.json (DCG hook registration / fallbackModel / env)"
  probe_launch() {
    probe_status=0
    out="$(env $(scratch_env) AGENT_SANDBOX=1 PATH="$mock:$PATH" HOME="$home" \
      XDG_CONFIG_HOME="$home/.config" "$launch" claude --no-sandbox 2>&1)" || probe_status=$?
  }
  expectDie() { # $1=case name, $2=required substring in the die output
    probe_launch
    if [ "$probe_status" -eq 0 ]; then
      offenders="$offenders $1(launched)"
    elif ! grep -qF -- "$2" <<<"$out"; then
      offenders="$offenders $1(msg)"
    fi
  }
  rm -f "$home/.config/claude/settings.json"
  expectDie missing-settings "Missing: settings.json"
  printf '%s' "{\"hooks\":{\"PostToolUse\":[$reg]}}" >"$home/.config/claude/settings.json"
  expectDie unrelated-event "$gap"
  printf '%s' "{\"hooks\":{\"PreToolUse\":[{\"matcher\":\"B|W|E\",\"hooks\":[{$H}]}]}}" >"$home/.config/claude/settings.json"
  expectDie token-drift-matcher "$gap"
  printf '%s' "{\"hooks\":{\"PreToolUse\":[{$M,\"hooks\":[{\"type\":\"command\",\"command\":\"node /usr/bin/true $hook\"}]}]}}" >"$home/.config/claude/settings.json"
  expectDie altered-command "$gap"
  printf '%s' "{\"hooks\":{\"PreToolUse\":[{$M,\"hooks\":[{$H,\"if\":true}]}]}}" >"$home/.config/claude/settings.json"
  expectDie if-handler "$gap"
  printf '%s' "{\"hooks\":{\"PreToolUse\":[{$M,\"hooks\":[{$H,\"async\":true}]}]}}" >"$home/.config/claude/settings.json"
  expectDie async-handler "$gap"
  # Key-shape sanity: some schema-invalid values make Claude skip the WHOLE
  # file (dropping the hook), so a valid registration + invalid shape dies.
  # Both keys are optional; the fixtures above omit them and the double-slash
  # positive below proves absent passes. Fixtures stay valid JSON otherwise,
  # so each negative tests exactly its named property.
  printf '%s' "{\"hooks\":{\"PreToolUse\":[$reg]},\"fallbackModel\":\"claude-sonnet-5-5\"}" >"$home/.config/claude/settings.json"
  expectDie fallbackModel-scalar "$gap"
  printf '%s' "{\"hooks\":{\"PreToolUse\":[$reg]},\"fallbackModel\":[\"claude-sonnet-5\",42]}" >"$home/.config/claude/settings.json"
  expectDie fallbackModel-nonstring "$gap"
  printf '%s' "{\"hooks\":{\"PreToolUse\":[$reg]},\"env\":{\"API_TIMEOUT_MS\":600000}}" >"$home/.config/claude/settings.json"
  expectDie env-numeric-value "$gap"
  printf '%s' "{\"hooks\":{\"PreToolUse\":[$reg]},\"env\":[\"not\",\"an\",\"object\"]}" >"$home/.config/claude/settings.json"
  expectDie env-not-object "$gap"
  # Claude ignores entries beyond the first three rather than rejecting them.
  printf '%s' "{\"hooks\":{\"PreToolUse\":[$reg]},\"env\":{\"API_TIMEOUT_MS\":\"600000\"},\"fallbackModel\":[\"a\",\"b\",\"c\",\"d\"]}" >"$home/.config/claude/settings.json"
  probe_launch
  if [ "$probe_status" -ne 0 ]; then
    offenders="$offenders valid-env+fallbackModel(died)"
  fi
  case "$out" in *"launched ARGS="*) ;; *) offenders="$offenders valid-env+fallbackModel(no-exec)" ;; esac
  # Positive: the exact managed registration (double-slash renderer form),
  # env and fallbackModel absent (both optional keys accepted).
  printf '%s' "{\"hooks\":{\"PreToolUse\":[{$M,\"hooks\":[{\"type\":\"command\",\"command\":\"node $home//.config/claude/hooks/dcg-guard.mjs\"}]}]}}" >"$home/.config/claude/settings.json"
  probe_launch
  if [ "$probe_status" -ne 0 ]; then
    offenders="$offenders positive(died)"
  fi
  case "$out" in *"launched ARGS="*) ;; *) offenders="$offenders positive(no-exec)" ;; esac
  if [ -n "$offenders" ]; then
    printf 'claude probe fixture offenders:%s\n' "$offenders"
    return 1
  fi
}
{{- end }}

