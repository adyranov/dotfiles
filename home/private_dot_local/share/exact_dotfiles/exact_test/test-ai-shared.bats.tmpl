#!/usr/bin/env bats

# bats file_tags=suite:ai

load 'common-helper'

# Serialize in-file: this file's launcher/render probes share staging, so
# in-file parallelism lets them interleave on the same scratch tree and
# flake red. BATS_NO_PARALLELIZE_WITHIN_FILE keeps the runner's cross-file --jobs.
BATS_NO_PARALLELIZE_WITHIN_FILE=true

setup() {
  common_setup
  AGENTS_MD="${HOME}/.config/agents/AGENTS.md"
}

# --- Shared agents tree ---

# bats test_tags=kind:agents-tree
@test "global AGENTS.md exists and contains abstract workflow" {
  assert_file_exists "$AGENTS_MD"
  run grep -F "inspect relevant code, configuration, and callers before editing" "$AGENTS_MD"
  assert_success
  run grep -F "Treat sandbox, permission, and policy denials" "$AGENTS_MD"
  assert_success
}

# bats test_tags=kind:agents-tree
@test "global AGENTS.md stays generic" {
  run grep -ci "chezmoi" "$AGENTS_MD"
  assert_failure
}

# bats test_tags=kind:agents-tree
@test "global AGENTS.md carries concise response style" {
  run grep -F "concise, information-dense English" "$AGENTS_MD"
  assert_success
  run grep -F "Include material assumptions, risks, evidence, and requested detail" "$AGENTS_MD"
  assert_success
}


# bats test_tags=kind:agents-tree
@test "~/.agents alias points at ~/.config/agents" {
  run readlink -f "$HOME/.agents"
  assert_success
  assert_output "$HOME/.config/agents"
}

# bats test_tags=kind:agents-tree
@test "~/.agents/skills directory is reachable" {
  assert_dir_exists "$HOME/.agents/skills"
}

# bats test_tags=kind:config
@test "kept rpiv configs carry guidance" {
  for cfg in rpiv-ask-user-question/config rpiv-todo/config; do
    run jq -e '.guidance.promptSnippet | length > 0' "{{ .chezmoi.homeDir }}/.config/${cfg}.json"
    assert_success
    run jq -e '.guidance.promptGuidelines | length > 0' "{{ .chezmoi.homeDir }}/.config/${cfg}.json"
    assert_success
  done
  run jq -r '.guidance.promptGuidelines | join(" ")' "{{ .chezmoi.homeDir }}/.config/rpiv-ask-user-question/config.json"
  assert_success
  assert_output --partial "material ambiguity"
}
{{- if .toolchains.pi }}

# bats test_tags=toolchain:pi,kind:config
@test "pi-web-access config carries citation guidance and the github clone lane" {
  run jq -e '.githubClone.enabled == true' "{{ .chezmoi.homeDir }}/.config/pi/profiles/core/web-search.json"
  assert_success
  run jq -e 'any(.summaryInstructions[]; contains("plan or final answer"))' "{{ .chezmoi.homeDir }}/.config/pi/profiles/core/web-search.json"
  assert_success
  run readlink -f "{{ .chezmoi.homeDir }}/.config/pi/profiles/factory/web-search.json"
  assert_success
  assert_output "{{ .chezmoi.homeDir }}/.config/pi/profiles/core/web-search.json"
}
{{- end }}

# --- Shared rendered-fact loops ---
#
# Each shared rendered-data fact is asserted once, looping a tool→config-entry
# table collected into a single failure that names every offending tool.
# Entry conditions are render-time data flags only: a disabled toolchain drops
# the entry; an enabled tool with a missing config file is a named offender.
# Failure bodies print tool name plus the failing path/boolean only — checks
# run under `run`, so config content never reaches gate output. The @test
# bodies render from the checks dicts via base/test/shared-fact-loop.

{{- $serving := dict -}}
{{- $presets := dict -}}
{{- if .toolchains.ai -}}
{{-   $serving = includeTemplate "base/helpers/load-section" (dict "root" . "section" "ai.serving" "required" false) | mustFromJson -}}
{{-   $presets = includeTemplate "base/helpers/load-section" (dict "root" . "section" "ai.presets" "required" false) | mustFromJson -}}
{{- end -}}
{{- $ompOn := get .toolchains "omp" | default false -}}
{{- $infer01 := index $serving "infer01" | default dict -}}
{{- $hasInfer01 := gt (len $infer01) 0 -}}
{{- $qwenPreset := index $presets "qwen" | default dict -}}
{{- $hasQwen := hasKey $presets "qwen" -}}
{{- $qwenTiers := get $qwenPreset "tiers" | default dict -}}
{{- $qwenModel := index (get $infer01 "models" | default list) 0 | default dict -}}
{{- $activePreset := index $presets "default" | default "balanced" -}}
{{- $agentTiers := includeTemplate "base/helpers/load-section" (dict "root" . "section" "ai.agents.opencode.agent_tiers" "required" true) | mustFromJson -}}
{{- /* Loop entry/applicable sets are top-level so the companion test always
       renders; gated loops fill them with `=` assignments. */ -}}
{{- $infer01Applicable := list -}}
{{- $infer01Checks := list -}}
{{- $infer01Tools := list -}}
{{- $qwenApplicable := list -}}
{{- $qwenChecks := list -}}
{{- $qwenTools := list -}}

{{ if $hasInfer01 }}
{{- /* Fact 2: keyless infer01 provider, projected per agent config. */ -}}
{{-   $infer01Checks = list
        (dict "kind" "run" "tool" "serving-data" "label" "metadata.context_window" "prog" "" "arg" "" "filepart" "" "run" (printf "test \"%v\" = \"262144\"" (get $qwenModel "context_window" | default 0)))
        (dict "kind" "run" "tool" "serving-data" "label" "metadata.max_output" "prog" "" "arg" "" "filepart" "" "run" (printf "test \"%v\" = \"32768\"" (get $qwenModel "max_output" | default 0))) -}}
{{-   if .toolchains.pi -}}
{{-     $infer01Applicable = append $infer01Applicable "pi" -}}
{{-     $infer01Checks = append $infer01Checks (dict "kind" "cmd" "tool" "pi" "label" "providers.infer01" "cmd" "jq -e" "arg" "" "filepart" " \"$HOME/.config/pi/agent/models.json\""
          "prog" `
    (.providers.infer01.api == "openai-completions") and
    (.providers.infer01.baseUrl == "http://infer01:8080/v1") and
    (.providers.infer01.apiKey == "no-auth") and
    (.providers.infer01.models
      | map(select(.id == "qwen3.8-flash-next"))[0] as $m |
        ($m.contextWindow == 262144) and
        ($m.reasoning == true) and
        (($m.input | index("image")) != null) and
        (($m | has("maxTokens")) | not))
  `) -}}
{{-     $infer01Checks = append $infer01Checks (dict "kind" "cmd" "tool" "pi" "label" "no bare remote id in enabledModels" "cmd" "jq -e" "arg" "" "filepart" " \"$HOME/.config/pi/agent/settings.json\""
          "prog" `(.enabledModels | index("qwen3.8-flash-next")) == null`) -}}
{{-   end -}}
{{-   if .toolchains.opencode -}}
{{-     $infer01Applicable = append $infer01Applicable "opencode" -}}
{{-     $infer01Checks = append $infer01Checks (dict "kind" "cmd" "tool" "opencode" "label" "provider.infer01" "cmd" "jsoncJq -e" "arg" "" "filepart" " \"$HOME/.config/opencode/opencode.jsonc\""
          "prog" `
    (.providers.infer01.package == "@opencode/ai/providers/openai-compatible") and
    (.providers.infer01.settings.baseURL == "http://infer01:8080/v1") and
    ((.providers.infer01.settings | has("apiKey")) | not) and
    (.providers.infer01.models["qwen3.8-flash-next"].name == "qwen3.8-flash-next") and
    (.providers.infer01.models["qwen3.8-flash-next"].limit.context == 262144) and
    (.providers.infer01.models["qwen3.8-flash-next"].capabilities.input | index("image") != null) and
    (.providers.infer01.models["qwen3.8-flash-next"].capabilities.reasoning.supported == true)
  `) -}}
{{-   end -}}
{{-   if $ompOn -}}
{{-     $infer01Applicable = append $infer01Applicable "omp" -}}
{{-     $infer01Checks = append $infer01Checks (dict "kind" "cmd" "tool" "omp" "label" "providers.infer01+no-local" "cmd" "yq -e" "arg" "" "filepart" " \"$HOME/.config/omp/agent/models.yml\""
          "prog" `
    (.providers | has("local") | not) and
    (.providers | has("infer01")) and (.providers | length == 1) and
    (.providers.infer01.api == "openai-completions" and .providers.infer01.auth == "none") and
    (.providers.infer01.baseUrl == "http://infer01:8080/v1") and
    (.providers.infer01.models
      | map(select(.id == "qwen3.8-flash-next"))[0] as $m |
        (($m.contextWindow == 262144) and ($m.reasoning == true) and (($m.input | join("|")) == "text|image") and ($m.maxTokens == 32768) and ($m.compat.thinkingFormat == "qwen-chat-template") and ($m.thinking.mode == "effort") and (($m.thinking.efforts | join("|")) == "low|medium|xhigh") and ($m.thinking.requiresEffort == false) and ($m.thinking.defaultLevel == "xhigh")))
  `) -}}
{{-   end -}}
{{-   range $c := $infer01Checks -}}
{{-     if ne (get $c "tool") "serving-data" -}}
{{-       $infer01Tools = append $infer01Tools (get $c "tool") -}}
{{-     end -}}
{{-   end }}

{{ includeTemplate "base/test/shared-fact-loop" (dict
        "title" "keyless infer01 provider renders in every applicable agent config (shared fact loop)"
        "tags" "toolchain:ai,kind:config"
        "message" "infer01 provider wrong or missing (offending tools):"
        "checks" $infer01Checks) }}
{{ end }}

{{- if $hasQwen }}
{{- /* Fact 3: qwen-preset routing: data-side routes plus per-agent render. */ -}}
{{-   $qwenExpect := dict -}}
{{-   range $agent, $tier := $agentTiers -}}
{{-     $route := index $qwenTiers $tier | default dict -}}
{{-     $entry := dict "id" (printf "%s/%s" (get $route "provider" | default "") (get $route "model" | default "")) -}}
{{-     $thinking := get $route "thinking" | default "off" -}}
{{-     if ne $thinking "off" }}{{ $_ := set $entry "variant" $thinking }}{{ end -}}
{{-     $_ := set $qwenExpect $agent (list $entry) -}}
{{-   end -}}
{{-   range $tier := list "small" "medium" "big" "visual" -}}
{{-     $route := index $qwenTiers $tier | default dict -}}
{{-     $qwenChecks = concat $qwenChecks (list
          (dict "kind" "run" "tool" "presets-data" "label" (printf "tiers.%s.route" $tier) "prog" "" "arg" "" "filepart" "" "run" (printf "test \"%s/%s\" = \"infer01/%s\"" (get $route "provider" | default "") (get $route "model" | default "") (get $qwenModel "id" | default "")))
          (dict "kind" "run" "tool" "presets-data" "label" (printf "tiers.%s.no-fallbacks" $tier) "prog" "" "arg" "" "filepart" "" "run" (printf "test \"%s\" = \"ok\"" (ternary "bad" "ok" (hasKey $route "fallbacks"))))) -}}
{{-   end -}}
{{-   $oracleRoute := get $qwenTiers "oracle" | default dict -}}
{{-   $qwenChecks = concat $qwenChecks (list
        (dict "kind" "run" "tool" "presets-data" "label" "tiers.oracle.route" "prog" "" "arg" "" "filepart" "" "run" (printf "test \"%s/%s\" = \"infer01/%s\"" (get $oracleRoute "provider" | default "") (get $oracleRoute "model" | default "") (get $qwenModel "id" | default "")))
        (dict "kind" "run" "tool" "presets-data" "label" "tiers.oracle.thinking" "prog" "" "arg" "" "filepart" "" "run" (printf "test \"%s\" = \"xhigh\"" (get $oracleRoute "thinking" | default "")))
        (dict "kind" "run" "tool" "presets-data" "label" "preset.no-council" "prog" "" "arg" "" "filepart" "" "run" (printf "jq -e 'has(\"council\") | not' <<< '%s'" ($qwenPreset | toJson)))) -}}
{{-   if .toolchains.opencode -}}
{{-     $qwenApplicable = append $qwenApplicable "opencode" -}}
{{-     $qwenChecks = append $qwenChecks (dict "kind" "cmd" "tool" "opencode" "label" "presets.qwen.routes+no-council" "cmd" "jq -e" "filepart" " \"$HOME/.config/opencode/profiles/factory/oh-my-opencode-slim.json\""
          "arg" (printf "--argjson expected '%s' " ($qwenExpect | toJson))
          "prog" `
    ([.presets.qwen | to_entries[]
      | select(.value.model | type == "array")
      | {key, value: .value.model}] | from_entries) == $expected
      and ((.council.presets // {}) | has("qwen") | not)
  `) -}}
{{-   end -}}
{{-   if $ompOn -}}
{{-     $qwenApplicable = append $qwenApplicable "omp" -}}
{{-     $qwenChecks = append $qwenChecks (dict "kind" "cmd" "tool" "omp" "label" "tiers.local-infer01+no-council" "cmd" "jq -e -n" "filepart" ""
          "arg" (printf "--argjson qtiers '%s' --argjson qpreset '%s' " ($qwenTiers | toJson) ($qwenPreset | toJson))
          "prog" `
    ([$qtiers[] | has("fallbacks") | not] | all) and
    ($qtiers.oracle.provider == "infer01" and $qtiers.oracle.model == "qwen3.8-flash-next" and $qtiers.oracle.thinking == "xhigh") and
    ($qpreset | has("council") | not)
  `) -}}
{{-     if eq $activePreset "qwen" -}}
{{-       $qwenChecks = append $qwenChecks (dict "kind" "cmd" "tool" "omp" "label" "modelRoles+empty-fallbacks" "cmd" "yq -e" "arg" "" "filepart" " \"$HOME/.config/omp/agent/config.yml\"" "prog" `.modelRoles.oracle == "infer01/qwen3.8-flash-next:xhigh" and .modelRoles.slow == "infer01/qwen3.8-flash-next:xhigh" and (.modelRoles | to_entries | map(.value | test("^infer01/qwen3.8-flash-next")) | all) and (.retry.fallbackChains | to_entries | map(.value | length == 0) | all)`) -}}
{{-     end -}}
{{-   end -}}
{{-   range $c := $qwenChecks -}}
{{-     if ne (get $c "tool") "presets-data" -}}
{{-       $qwenTools = append $qwenTools (get $c "tool") -}}
{{-     end -}}
{{-   end }}

{{ includeTemplate "base/test/shared-fact-loop" (dict
      "title" "qwen preset routes every applicable agent config to local infer01 (shared fact loop)"
      "tags" "toolchain:ai,kind:config"
      "message" "qwen routing wrong (offending tools):"
      "checks" $qwenChecks) }}
{{- end -}}

{{- /* Fact 4: enabled=false serving-provider omission (render-time injection). */ -}}
{{- $enabledApplicable := list -}}
{{- $enabledChecks := list -}}
{{- if .toolchains.ai -}}
{{-   $enabledServing := merge (dict) .ai.base.serving -}}
{{-   $_ := set $enabledServing "disabled-test" (dict
        "kind" "openai-compatible"
        "base_url" "http://disabled.test:8080/v1"
        "enabled" false
        "models" (list (dict "id" "disabled-model" "name" "Disabled" "context_window" 1000))
      ) -}}
{{-   $_ := set $enabledServing "enabled-test" (dict
        "kind" "openai-compatible"
        "base_url" "http://enabled.test:8080/v1"
        "models" (list (dict "id" "enabled-model" "name" "Enabled" "context_window" 2000))
      ) -}}
{{-   $enabledBase := merge (dict) .ai.base -}}
{{-   $_ := set $enabledBase "serving" $enabledServing -}}
{{-   $enabledAI := merge (dict) .ai -}}
{{-   $_ := set $enabledAI "base" $enabledBase -}}
{{-   $enabledRoot := merge (dict) . -}}
{{-   $_ := set $enabledRoot "ai" $enabledAI -}}
{{-   if .toolchains.pi -}}
{{-     $enabledApplicable = append $enabledApplicable "pi" -}}
{{-     $piCfg := includeTemplate "private_dot_config/exact_pi/exact_agent/private_models.json.tmpl" $enabledRoot | fromJson -}}
{{-     $enabledChecks = concat $enabledChecks (list
          (dict "kind" "run" "tool" "pi" "label" "providers.disabled-test" "prog" "" "arg" "" "filepart" "" "run" (printf "test \"%s\" = \"excluded\"" (ternary "leaked" "excluded" (hasKey $piCfg.providers "disabled-test"))))
          (dict "kind" "run" "tool" "pi" "label" "providers.enabled-test" "prog" "" "arg" "" "filepart" "" "run" (printf "test \"%s\" = \"present\"" (ternary "present" "missing" (hasKey $piCfg.providers "enabled-test"))))) -}}
{{-   end -}}
{{-   if .toolchains.opencode -}}
{{-     $enabledApplicable = append $enabledApplicable "opencode" -}}
{{-     $ocCfg := includeTemplate "base/ai/agents/opencode/render-opencode-config" (dict "root" $enabledRoot "profile" "minimal") | fromJsonc -}}
{{-     $enabledChecks = concat $enabledChecks (list
          (dict "kind" "run" "tool" "opencode" "label" "providers.disabled-test" "prog" "" "arg" "" "filepart" "" "run" (printf "test \"%s\" = \"excluded\"" (ternary "leaked" "excluded" (hasKey $ocCfg.providers "disabled-test"))))
          (dict "kind" "run" "tool" "opencode" "label" "providers.enabled-test" "prog" "" "arg" "" "filepart" "" "run" (printf "test \"%s\" = \"present\"" (ternary "present" "missing" (hasKey $ocCfg.providers "enabled-test"))))) -}}
{{-   end -}}
{{- end -}}
{{- $enabledTools := list -}}
{{- range $c := $enabledChecks -}}
{{-   $enabledTools = append $enabledTools (get $c "tool") -}}
{{- end -}}

{{- if .toolchains.ai }}
{{ includeTemplate "base/test/shared-fact-loop" (dict
      "title" "serving providers with enabled=false are omitted by every applicable agent (shared fact loop)"
      "tags" "toolchain:ai,kind:config"
      "message" "enabled=false provider omission broken (offending tools):"
      "checks" $enabledChecks) }}
{{- end }}

# bats test_tags=toolchain:ai,kind:config
@test "shared-fact loops cover exactly this host's applicable toolchains" {
  local offenders="" fact have want
  while IFS=$'\t' read -r fact have want; do
    run test "$have" = "$want"
    [ "$status" -eq 0 ] || offenders="$offenders $fact"
  done <<'ENTRY_SET'
{{- range $e := list
      (dict "fact" "infer01" "have" ($infer01Tools | sortAlpha | uniq | join ",") "want" ($infer01Applicable | sortAlpha | uniq | join ","))
      (dict "fact" "qwen" "have" ($qwenTools | sortAlpha | uniq | join ",") "want" ($qwenApplicable | sortAlpha | uniq | join ","))
      (dict "fact" "enabled" "have" ($enabledTools | sortAlpha | uniq | join ",") "want" ($enabledApplicable | sortAlpha | uniq | join ","))
  }}
{{ $e.fact }}	{{ $e.have }}	{{ $e.want }}
{{- end }}
ENTRY_SET
  if [ -n "$offenders" ]; then
    printf 'loop entry set drift (fact):%s\n' "$offenders"
    return 1
  fi
}

# --- Shared agent launcher scratch root ---
#
# Launcher line-presence facts collapse into one aggregate offender pass via
# base/test/shared-fact-loop; ordering/behavior probes stay as their own tests.

{{- $launchLines := list
      (dict "label" "scratch-bootstrap" "line" "bootstrap_scratch")
      (dict "label" "agents-root" "line" "_agents_root=\"/tmp/agents\"")
      (dict "label" "scratch-dir-var" "line" "scratch_dir=\"$_agents_root/$AGENT_NAME\"")
      (dict "label" "tmpdir-scope" "line" "export TMPDIR=\"$scratch_dir\"")
      (dict "label" "nono-exec" "line" "exec nono run --profile \"$NONO_PROFILE\" -- \"$BINARY_NAME\" \"$@\"")
      (dict "label" "sandbox-marker" "line" "export AGENT_SANDBOX=1")
      (dict "label" "sandbox-home-marker" "line" "export AGENT_SANDBOX_HOME=")
      (dict "label" "no-save-prompt" "line" "export NONO_NO_SAVE_PROMPT=1")
      (dict "label" "nono-log" "line" "export NONO_LOG_FILE=\"$TMPDIR/nono.log\"")
      (dict "label" "usr-bin-first" "line" "export PATH=\"/usr/bin:$PATH\"")
      (dict "label" "test-mode-var" "line" "AGENT_LAUNCH_TEST_MODE")
      (dict "label" "test-tmpdir-var" "line" "BATS_TEST_TMPDIR")
      (dict "label" "test-scratch-root-var" "line" "AGENT_LAUNCH_TEST_SCRATCH_ROOT")
      (dict "label" "deny-symlink-dir" "line" "Scratch dir is a symlink")
      (dict "label" "deny-symlink-root" "line" "Scratch root is a symlink")
      (dict "label" "deny-root-escape" "line" "Scratch dir resolves outside expected root")
      (dict "label" "deny-owner" "line" "requireOwner \"$scratch_dir\" \"scratch dir\" \"Scratch dir\"")
      (dict "label" "deny-root-mode" "line" "requireMode0700 \"$_agents_root\" \"scratch root\" \"Scratch root\"")
      (dict "label" "deny-dir-mode" "line" "requireMode0700 \"$scratch_dir\" \"scratch dir\" \"Scratch dir\"")
      (dict "label" "exact-0700" "line" "-eq $((0700))")
      (dict "label" "pkill-anchor" "line" "__pattern=\"engram serve ${ENGRAM_PORT}( |$)\"")
      (dict "label" "supervise-lock" "line" "ENGRAM_LOCK=\"$ENGRAM_STATE/.supervise.lock\"")
      (dict "label" "identity-record" "line" "ENGRAM_ID_FILE=\"$ENGRAM_STATE/daemon.identity\"")
      (dict "label" "lock-rmdir" "line" "rmdir \"$ENGRAM_LOCK\"")
      (dict "label" "lock-takeover-probe" "line" "kill -0 \"$__holder\"") -}}
{{- $launchChecks := list -}}
{{- range $c := $launchLines -}}
{{-   $launchChecks = append $launchChecks (dict "kind" "cmd" "tool" "launcher" "label" $c.label "cmd" "grep -Fq -e" "arg" "" "prog" $c.line "filepart" " \"$HOME/.local/bin/agent\"") -}}
{{- end -}}
{{- /* Identity triple carries single quotes: run-kind check (the cmd form
       single-quotes prog). */ -}}
{{- $launchChecks = append $launchChecks (dict "kind" "run" "tool" "launcher" "label" "identity-triple" "run" "grep -Fq '$__ver\" \"$__bin\" \"$__mtime' \"$HOME/.local/bin/agent\"") }}

{{ includeTemplate "base/test/shared-fact-loop" (dict
      "title" "launcher carries the scratch, port, marker, PATH, fail-closed and supervisor lines (shared fact loop)"
      "tags" "kind:launcher"
      "message" "launcher line(s) missing (offenders):"
      "checks" $launchChecks) }}

# bats test_tags=kind:launcher
@test "agent exports the AGENT_SANDBOX marker before exec nono run" {
  local launch="$HOME/.local/bin/agent"
  assert_file_exists "$launch"
  # The marker must precede the sandbox exec so nested test runs see it.
  run awk '/export AGENT_SANDBOX=1/{m=NR} /exec nono run --profile/{e=NR} END{exit !(m>0 && e>0 && m<e)}' "$launch"
  assert_success
}

# bats test_tags=kind:launcher
@test "agent puts /usr/bin first on PATH inside the sandbox only" {
  local launch="$HOME/.local/bin/agent"
  assert_file_exists "$launch"
  # Sandbox branch only: the export lands after the --no-sandbox exec and before
  # `exec nono run`, so unsandboxed launches keep the inherited PATH.
  run awk '/exec "\$BINARY_NAME" "\$@"/{n=NR} /export PATH="\/usr\/bin:\$PATH"/{p=NR} /exec nono run --profile/{e=NR} END{exit !(n>0 && p>n && p<e)}' "$launch"
  assert_success
}

# bats test_tags=kind:launcher
@test "agent prepends /usr/bin to the sandbox PATH on Darwin only" {
  # The MacPorts-git workaround is Darwin-specific: Linux keeps its inherited
  # PATH (the prepend shadows mise shims by name). uname is stubbed, so both
  # platforms are probed on any host. The Linux arm now dies at the U2
  # guarded-launch gate (before the PATH block): the die IS the Linux
  # sandboxed-launch behavior.
  local launch="$HOME/.local/bin/agent" mock offenders="" os out
  mock="$(mktemp -d "$BATS_TEST_TMPDIR/mock.XXXXXX")"
  setup_mock_bins "$mock"
  cat >"$mock/omp" <<'EOF'
#!/usr/bin/env sh
echo "PATH_FIRST=${PATH%%:*}"
EOF
  chmod +x "$mock/omp"
  for os in Darwin Linux; do
    printf '#!/usr/bin/env sh\nprintf "%%s\\n" "%s"\n' "$os" >"$mock/uname"
    chmod +x "$mock/uname"
    out="$(env $(scratch_env) PATH="$mock:$PATH" HOME=/fixture-home XDG_CONFIG_HOME=/fixture-home/.config \
      "$launch" omp -c session-p 2>&1)" || true
    case "$os:$out" in
    "Darwin:"*PATH_FIRST=/usr/bin*) ;;
    "Linux:"*"Refusing a guarded agent launch on Linux"*) ;;
    *) offenders="$offenders [$os: $(printf '%s' "$out" | grep -F 'PATH_FIRST=' | head -n 1)]" ;;
    esac
  done
  if [ -n "$offenders" ]; then
