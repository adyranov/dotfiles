# bats test_tags=toolchain:ai,kind:config
@test "template comments use the single-space form (Go lexer breaks on wider gaps)" {
  # The single-space form after the trim marker parses; wider gaps make the
  # Go parser treat "/" as a command, and the whole template library fails
  # to render at apply time.
  run grep -RnE '\{\{-[[:space:]]{2,}/\*|\{\{[[:space:]]{2,}/\*' "{{ .chezmoi.sourceDir }}/.chezmoitemplates"
  assert_failure
}
