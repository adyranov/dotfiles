  assert_success
  assert_output --partial 'sources resolved'
  # Guarded launch: the routed keystore value stays proxy-side (phantom
  # surface), the gap name rides the agent env as a real value; the test's
  # own environment was scrubbed of both names before the run and the child
  # is the only place the value appears.
  assert_output --partial 'CHILD_OPENAI=[unset]'
  assert_output --partial 'CHILD_GAP=[stub-value-PROBE_GAP_KEY]'
  refute_output --partial 'CHILD_GAP=[unset]'
  test -z "${PROBE_GAP_KEY:-}"
}

# bats test_tags=toolchain:ai,kind:launcher
@test "unguarded launch exports keystore values to the agent env; print-env stays value-free" {
  local fh mock
  fh="$(probe_fixture "$BATS_TEST_TMPDIR")"
  mock="$(probe_mocks)"
  run env -u OPENAI_API_KEY -u PROBE_GAP_KEY $(scratch_env) PATH="$mock:$PATH" HOME="$fh" \
    XDG_CONFIG_HOME="$fh/.config" AGENT_SANDBOX= KEYCHAIN_STATE=unlocked \
    KEYCHAIN_SEEDED=openai_probe_key,PROBE_GAP_KEY \
    "$HOME/.local/bin/agent" pi --no-sandbox
  assert_success
  assert_output --partial 'CHILD_OPENAI=[stub-value-openai_probe_key]'
  assert_output --partial 'CHILD_GAP=[stub-value-PROBE_GAP_KEY]'
  test -z "${OPENAI_API_KEY:-}"

  # --print-env never runs the probe (it exits before the shared region):
  # no keystore-derived value, no probe banner.
  run env PATH="$mock:$PATH" HOME="$fh" XDG_CONFIG_HOME="$fh/.config" \
    KEYCHAIN_STATE=unlocked KEYCHAIN_SEEDED=openai_probe_key,PROBE_GAP_KEY \
    "$HOME/.local/bin/agent" pi --print-env
  assert_success
  refute_output --partial 'stub-value'
  refute_output --partial 'sources resolved'
}
