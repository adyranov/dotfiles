# --- Credential source probe (live launcher, stubbed store) ---
#
# One fixture profile (a keystore row plus a gap name) drives the KTD4
# outcome matrix: die-on-missing and die-on-locked under the guarded path,
# warn-and-export under --no-sandbox, exports in the agent process only, and
# a print-env surface free of keystore values. Darwin is stubbed so every
# host exercises the Keychain paths.

{{- /* Probe fixture: written by each test via probe_fixture. */ -}}
probe_fixture() { # writes the fixture HOME under $1, echoes its path
  local fh="$1/home"
  mkdir -p "$fh/.config/nono/profiles"
  cat >"$fh/.config/nono/profiles/pi.json" <<'FIX'
{"meta":{"name":"pi"},"network":{"credentials":["probe","gap"],"custom_credentials":{"probe":{"upstream":"https://api.openai.com","credential_key":"openai_probe_key","env_var":"OPENAI_API_KEY"}}}}
FIX
  cat >"$fh/.config/nono/profiles/base.json" <<'FIX'
{"meta":{"name":"base"},"diagnostics":{"redaction":{"extra_env_vars":["DCG_*","PROBE_GAP_KEY"]}}}
FIX
  printf '%s\n' "$fh"
}

probe_mocks() { # mock bin dir for launcher launches (agent binary echoes env)
  local mock
  mock="$(mktemp -d "$BATS_TEST_TMPDIR/mock.XXXXXX")"
  setup_mock_bins "$mock" curl nc nono git engram pkill pgrep security
  printf '#!/usr/bin/env sh\nprintf "Darwin\\n"\n' >"$mock/uname"
  cat >"$mock/pi" <<'CHILDEOF'
#!/usr/bin/env sh
printf 'CHILD_OPENAI=[%s] CHILD_GAP=[%s]\n' "${OPENAI_API_KEY:-unset}" "${PROBE_GAP_KEY:-unset}"
CHILDEOF
  chmod +x "$mock/uname" "$mock/pi"
  printf '%s\n' "$mock"
}

