# bats test_tags=toolchain:ai,kind:launcher
@test "engram supervisor daemon inherits no coordination fds (bats EOF hang)" {
{{- if eq (len $sup) 0 }}
  skip "no launcher agent toolchain is enabled on this host"
{{- else }}
  command -v lsof >/dev/null || skip "lsof not available"
  sup_init
  sup_warm
  local pid
  pid=$(sup_pids | awk '{print $1}')
  [ -n "$pid" ]
  # fd 0 is /dev/null, 1/2 go to the log. The daemon may own regular files
  # (bash's script fd 255), but no inherited pipe/socket (bats coordination
  # lives at fd 3 and high fds) may survive, or the suite hangs at EOF.
  run sh -c 'lsof -a -p "$1" -d 3-255 2>/dev/null | grep -Eq "PIPE|unix|FIFO"; [ "$?" -eq 1 ]' _ "$pid"
  assert_success
{{- end }}
}

