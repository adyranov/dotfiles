# bats test_tags=toolchain:ai,kind:config
@test "seed render matches the entry-rule, gates non-store hosts, keeps tokens out (aggregate)" {
  local offenders="" add_line
  while IFS=$'\t' read -r fact have want; do
    [ "$have" = "$want" ] || offenders="$offenders $fact"
  done <<ENTRY
want-list	{{ regexFind "seed_entries=\"[^\"]*\"" $seedApply }}	seed_entries="{{ $seedWant }}"
delegated-rows-absent	{{ if regexFind "CLAUDE_CODE_OAUTH_TOKEN|GITHUB_TOKEN|OPENAI_API_KEY" (regexFind "seed_entries=\"[^\"]*\"" $seedApply) }}present{{ else }}absent{{ end }}	absent
no-credential-literals	{{ if contains "sk-ant-" $seedApply }}present{{ else }}absent{{ end }}	absent
prompt-is-tty-not-argv	{{ if contains "add-generic-password -s nono -a \"$1\" -T \"$nono_bin\" -U -w" $seedApply }}yes{{ else }}no{{ end }}	yes
grant-narrows-to-nono	{{ if contains "-A" (regexFind "security add-generic-password.*" $seedApply) }}widened{{ else }}narrow{{ end }}	narrow
apply-form-has-no-arg-surface	{{ if contains "usage: seed-keystore" $seedApply }}present{{ else }}absent{{ end }}	absent
command-form-validates-names	{{ if contains "known entries:" $seedCmd }}present{{ else }}absent{{ end }}	present
non-interactive-is-noop	{{ if contains "seed_entries" $seedIdle }}renders{{ else }}noop{{ end }}	noop
store-less-host-is-noop	{{ if contains "seed_entries" $seedLin }}renders{{ else }}noop{{ end }}	noop
ENTRY
  [ -n "$offenders" ] && { printf 'seed render facts (offenders):%s\n' "$offenders"; return 1; }
  # The add line is exactly the prompt shape: -T grant, -U overwrite, and -w
  # last with no value argument (the value never crosses argv).
  add_line="$(printf '%s\n' "$seedApply" | grep 'security add-generic-password')"
  [[ "$add_line" == *" -U -w" ]] || { printf 'add line is not prompt-shaped: %s\n' "$add_line"; return 1; }
}

# bats test_tags=toolchain:ai,kind:config
@test "seed body never prompts a present or locked store and keeps values out of argv" {
  local script mock log out rc
  script="$BATS_TEST_TMPDIR/seed.sh"
  cat >"$script" <<'SEEDEOF'
#!/usr/bin/env bash
set -euo pipefail
{{ $seedApply }}
SEEDEOF
  mock="$(mktemp -d "$BATS_TEST_TMPDIR/mock.XXXXXX")"
  cat >"$mock/security" <<'SECSTUB'
#!/usr/bin/env sh
case "$1" in
show-keychain-info) exit "${SEED_TEST_LOCKED:-0}" ;;
find-generic-password) exit "${SEED_TEST_MISSING:-0}" ;;
add-generic-password) printf '%s\n' "$*" >>"$SEED_TEST_ARGV_LOG/add.log"; exit 0 ;;
esac
exit 0
SECSTUB
  printf '#!/usr/bin/env sh\ntest "$1" = which && printf "%%s\\n" /bin/false\nexit 1\n' >"$mock/mise"
  chmod +x "$mock/security" "$mock/mise"
  log="$mock/argv"; mkdir -p "$log"

  # Locked store: names the unlock remedy, adds nothing, exits 0 (apply does
  # not fail here — the launcher probe enforces at launch).
  out="$(env PATH="$mock:$PATH" SEED_TEST_LOCKED=1 SEED_TEST_ARGV_LOG="$log" bash "$script" 2>&1 </dev/null)" && rc=0 || rc=$?
  [ "$rc" -eq 0 ] || { printf 'apply form failed on a locked store (rc %d): %s\n' "$rc" "$out"; return 1; }
  grep -qF "security unlock-keychain" <<<"$out" || { printf 'locked remedy missing: %s\n' "$out"; return 1; }
  [ ! -e "$log/add.log" ] || { printf 'add happened on a locked store\n'; return 1; }

  # Everything present: silent, zero adds, no prompt text anywhere.
  out="$(env PATH="$mock:$PATH" SEED_TEST_MISSING=0 SEED_TEST_ARGV_LOG="$log" bash "$script" 2>&1 </dev/null)" || return 1
  [ ! -e "$log/add.log" ] || { printf 'add happened for a present entry\n'; return 1; }
  grep -qF "Seeding" <<<"$out" && { printf 'prompt fired for present entries: %s\n' "$out"; return 1; }

  # Missing entries: each is prompted by name and added with no value argv —
  # every add line ends at the bare -w prompt flag.
  rm -f "$log"/*.log
  out="$(env PATH="$mock:$PATH" SEED_TEST_MISSING=44 SEED_TEST_ARGV_LOG="$log" bash "$script" 2>&1 </dev/null)" || return 1
  local name n=0
  for name in {{ (keys .ai.base.credentials.env_injected) | sortAlpha | join " " }}; do
    grep -qF "Seeding $name" <<<"$out" && n=$((n + 1))
  done
  [ "$n" -eq {{ len (keys .ai.base.credentials.env_injected) }} ] || { printf 'prompted %d of the gap set: %s\n' "$n" "$out"; return 1; }
  [ "$(wc -l <"$log/add.log" | tr -d ' ')" -eq "$n" ] || { printf 'add count mismatch:\n%s\n' "$(cat "$log/add.log")"; return 1; }
  grep -qE -- '-w .+' "$log/add.log" && { printf 'value leaked into argv:\n%s\n' "$(cat "$log/add.log")"; return 1; }
  grep -qE -- ' -A( |$)' "$log/add.log" && { printf 'keychain-wide -A grant emitted:\n%s\n' "$(cat "$log/add.log")"; return 1; }
}

