# bats test_tags=toolchain:ai,kind:config
@test "rendered _agent completes agent words, per-agent profiles, and flags" {
  local tmpl rendered block word
  tmpl="{{ .chezmoi.sourceDir }}/private_dot_config/exact_zsh/exact_completions/_agent"
  assert_file_exists "$tmpl"
  rendered="$BATS_FILE_TMPDIR/_agent"
  assert_file_exists "$rendered"
  run head -n 1 "$rendered"
  assert_success
  assert_line --index 0 "#compdef agent"
  # Level 1: agent names and aliases (binary-bearing launchers, from data).
  for word in {{ $binWords | join " " }}; do
    run grep -F -- "'$word'" "$rendered"
    assert_success
  done
  # The shared peer carries no launcher map and must not leak into the completion.
  run grep -Fw shared "$rendered"
  assert_failure
  # Level 2: selectable agents offer their own profile words (from data).
  block=$(awk '/^  pi[|)]/{f=1} f{print} f&&/;;/{exit}' "$rendered")
  for word in {{ $piProfiles | join " " }}; do
    run grep -Ew -- "$word" <<<"$block"
    assert_success
  done
  block=$(awk '/^  opencode[|)]/{f=1} f{print} f&&/;;/{exit}' "$rendered")
  for word in {{ $ocProfiles | join " " }}; do
    run grep -Ew -- "$word" <<<"$block"
    assert_success
  done
  # The non-selectable agent's arm omits every profile word of the union.
  block=$(awk '/^  omp[|)]/{f=1} f{print} f&&/;;/{exit}' "$rendered")
  run grep -Ew '{{ $profileUnion | join "|" }}' <<<"$block"
  assert_failure
  # Global flag set on the completion arms.
  for flag in -h --help --list --print-env --no-sandbox; do
    run grep -F -- "'$flag'" "$rendered"
    assert_success
  done
}

# bats test_tags=toolchain:ai,kind:launcher
@test "every launcher arg-loop flag appears in the rendered _agent" {
  # Drift channel: a flag added to the launcher arg loop must show up in the
  # completion. Extract the case-arm flag tokens from the rendered launcher
  # and require each in the rendered _agent.
  local launcher comp offenders flag
  launcher="$BATS_FILE_TMPDIR/launcher.sh"
  comp="$BATS_FILE_TMPDIR/_agent"
  assert_file_exists "$launcher"
  assert_file_exists "$comp"
  # Case-arm shape only (`--flag ... )` lines): comment prose opening with a
  # `--word` token is not a flag. Leading whitespace is optional (the
  # exit-only arms sit at column 0).
  offenders=""
  while IFS= read -r flag; do
    grep -Fq -e "$flag" "$comp" || offenders="$offenders $flag"
  done < <(awk '/^[[:space:]]*--?[a-z][^)]*\)/{tok=$1; sub(/\)$/,"",tok); n=split(tok,a,"|"); for(i=1;i<=n;i++) if (a[i] ~ /^--?[a-z][a-z0-9-]*$/) print a[i]}' "$launcher" | sort -u)
  if [ -n "$offenders" ]; then
    printf 'launcher flags missing from _agent:%s\n' "$offenders"
    return 1
  fi
}

# bats test_tags=toolchain:ai,kind:launcher
@test "every _agent completion flag is handled by the launcher arg loops" {
  # Reverse parity (the forward test above is launcher→_agent): a flag the
  # completion offers must be consumed by the launcher (pre-name loop,
  # post-name loop, or exit_only_flags) — set difference over the flag-
  # shaped quoted literals in the rendered completion.
  local comp launcher offenders flag
  comp="$BATS_FILE_TMPDIR/_agent"
  launcher="$BATS_FILE_TMPDIR/launcher.sh"
  assert_file_exists "$comp"
  assert_file_exists "$launcher"
  offenders=""
  while IFS= read -r flag; do
    grep -Fq -e "$flag" "$launcher" || offenders="$offenders $flag"
  done < <(grep -oE "'--?[a-z][a-z0-9-]*'" "$comp" | tr -d "'" | sort -u)
  if [ -n "$offenders" ]; then
    printf '_agent flags unhandled by launcher:%s\n' "$offenders"
    return 1
  fi
}

