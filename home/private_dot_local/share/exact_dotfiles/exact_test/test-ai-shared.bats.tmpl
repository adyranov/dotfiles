{{- $launchChecks := list -}}
{{- range $c := $launchLines -}}
{{-   $launchChecks = append $launchChecks (dict "kind" "cmd" "tool" "launcher" "label" $c.label "cmd" "grep -Fq -e" "arg" "" "prog" $c.line "filepart" " \"$HOME/.local/bin/agent\"") -}}
{{- end -}}
{{- /* Identity triple carries single quotes: run-kind check (the cmd form
       single-quotes prog). */ -}}
{{- $launchChecks = append $launchChecks (dict "kind" "run" "tool" "launcher" "label" "identity-triple" "run" "grep -Fq '$__ver\" \"$__bin\" \"$__mtime' \"$HOME/.local/bin/agent\"") }}

{{ includeTemplate "base/test/shared-fact-loop" (dict
      "title" "launcher carries the scratch, port, marker, PATH, fail-closed and supervisor lines (shared fact loop)"
      "tags" "kind:launcher"
      "message" "launcher line(s) missing (offenders):"
      "checks" $launchChecks) }}

# bats test_tags=kind:launcher
@test "agent exports the AGENT_SANDBOX marker before exec nono run" {
  local launch="$HOME/.local/bin/agent"
  assert_file_exists "$launch"
  # The marker must precede the sandbox exec so nested test runs see it.
  run awk '/export AGENT_SANDBOX=1/{m=NR} /exec nono run --profile/{e=NR} END{exit !(m>0 && e>0 && m<e)}' "$launch"
  assert_success
}

# bats test_tags=kind:launcher
@test "agent puts /usr/bin first on PATH inside the sandbox only" {
  local launch="$HOME/.local/bin/agent"
  assert_file_exists "$launch"
  # Sandbox branch only: the export lands after the --no-sandbox exec and before
  # `exec nono run`, so unsandboxed launches keep the inherited PATH.
  run awk '/exec "\$BINARY_NAME" "\$@"/{n=NR} /export PATH="\/usr\/bin:\$PATH"/{p=NR} /exec nono run --profile/{e=NR} END{exit !(n>0 && p>n && p<e)}' "$launch"
  assert_success
}

# bats test_tags=kind:launcher
@test "agent exports DCG_BYPASS only inside the unsandboxed branch" {
  local launch="$HOME/.local/bin/agent"
  assert_file_exists "$launch"
  # Exactly one export, after the --no-sandbox) case arm and before the
  # unsandboxed exec, so sandboxed launches and --print-env never carry it.
  run awk '/export DCG_BYPASS=1/{c++;e=NR} /--no-sandbox\)/{b=NR} /exec "\$BINARY_NAME" "\$@"/{n=NR} END{exit !(c==1 && b>0 && b<e && e<n)}' "$launch"
  assert_success
}

# bats test_tags=kind:launcher
@test "agent warns when an activated route has no credential source in the shell" {
  local launch="$HOME/.local/bin/agent"
  assert_file_exists "$launch"
  # "routes on" must not overstate: after the mode line the profile's env:// sources are
  # checked against this shell and the missing names are printed (nono only warns per
  # route, deep in its own output). warn() must exist for that call to survive set -u.
  run awk '/^warn\(\)/{d=NR} /Credentials: routes on/{m=NR} /credential_key/{c=NR} /Routes without a credential source/{w=NR} END{exit !(d>0 && m>0 && c>m && w>c)}' "$launch"
  assert_success
}

# --- Launcher word and route invariants ---

{{- /* Routes ride the enabled agent toolchains so partial-toolchain hosts
       stay green; the word/profile sets are static literals matching the
       static launcher and _agent completion files. */ -}}
{{- $routes := list -}}
