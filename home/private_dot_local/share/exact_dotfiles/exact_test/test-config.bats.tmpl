# bats test_tags=kind:ghostty
@test "ghostty common config has no global keybinding" {
  run grep -q 'global:' "$XDG_CONFIG_HOME/ghostty/config.ghostty"
  assert_failure
}

# bats test_tags=kind:ghostty
@test "ghostty common config has no macOS-only keys" {
