#!/usr/bin/env bats

# bats file_tags=suite:config

load 'common-helper'

setup() {
  common_setup
}

# --- Shell environment ---

# bats test_tags=kind:shell
@test "XDG base directories are set" {
  assert [ -n "$XDG_CONFIG_HOME" ]
  assert [ -n "$XDG_DATA_HOME" ]
  assert [ -n "$XDG_CACHE_HOME" ]
  assert [ -n "$XDG_STATE_HOME" ]
}

# bats test_tags=kind:env
@test "ENGRAM_DATA_DIR is set to XDG data home" {
  assert [ -n "$ENGRAM_DATA_DIR" ]
  assert [ "$ENGRAM_DATA_DIR" = "$XDG_DATA_HOME/engram" ]
}

# bats test_tags=kind:env
@test "ENGRAM_PORT defaults to 7437" {
  assert [ -n "$ENGRAM_PORT" ]
  assert [ "$ENGRAM_PORT" = "7437" ]
}

# bats test_tags=kind:env
@test "ENGRAM_URL uses ENGRAM_PORT" {
  assert [ -n "$ENGRAM_URL" ]
  assert [ "$ENGRAM_URL" = "http://127.0.0.1:${ENGRAM_PORT:-7437}" ]
}

# bats test_tags=kind:shell
@test "LANG is en_US.UTF-8" {
  assert_equal "$LANG" "en_US.UTF-8"
}

# bats test_tags=kind:env
@test "TMUX_TMPDIR is set to XDG data home" {
  assert [ -n "$TMUX_TMPDIR" ]
  assert [ "$TMUX_TMPDIR" = "$XDG_DATA_HOME/tmux" ]
}

{{- if eq .host.distro.family "darwin" }}
# bats test_tags=kind:certificates
@test "macOS CA bundle is generated" {
  assert_file_exists "$HOME/.config/certificates/ca-bundle.pem"
  run grep -q -- '-----BEGIN CERTIFICATE-----' "$HOME/.config/certificates/ca-bundle.pem"
  assert_success
}

{{- end }}
# bats test_tags=kind:shell
@test "~/.local/bin is in PATH" {
  run bash -c 'echo "$PATH" | tr ":" "\n" | grep -qx "$HOME/.local/bin"'
  assert_success
}

# --- Git ---

# bats test_tags=kind:git
# Probes target the applied dotfiles directly: macOS CI runners pre-seed an
# unmanaged ~/.config/git/config that git's effective-config view reads first,
# and chezmoi init-apply deliberately skips unmanaged targets (see suite's
# file-based ghostty/tmux/ssh convention).
@test "git config user.name is set" {
  run git config --file "$HOME/.config/git/user" user.name
  assert_success
  refute_output ""
}

# bats test_tags=kind:git
@test "git config user.email is set" {
  run git config --file "$HOME/.config/git/user" user.email
  assert_success
  refute_output ""
}

# bats test_tags=kind:git
@test "git config core.autocrlf is input" {
  run git config --file "$HOME/.config/git/base" core.autocrlf
  assert_output "input"
}

# bats test_tags=kind:git
@test "git config pull.rebase is true" {
  run git config --file "$HOME/.config/git/base" pull.rebase
  assert_output "true"
}


# --- Ghostty ---

# bats test_tags=kind:ghostty
