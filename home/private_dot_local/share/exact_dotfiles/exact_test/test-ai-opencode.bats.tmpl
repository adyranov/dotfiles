@test "opencode agent launcher exposes profiles and forwards args" {
  assert_file_executable "$HOME/.local/bin/agent"
  run "$HOME/.local/bin/agent" oc --help
  assert_success
  assert_output --partial "--no-sandbox"
  assert_output --partial "factory"

  mkdir -p "$BATS_TEST_TMPDIR/bin"
  cat >"$BATS_TEST_TMPDIR/bin/opencode" <<'EOF'
#!/usr/bin/env sh
printf '%s\n' "$@"
EOF
  chmod +x "$BATS_TEST_TMPDIR/bin/opencode"
  run env PATH="$BATS_TEST_TMPDIR/bin:$PATH" "$HOME/.local/bin/agent" oc --no-sandbox --continue session-123
  assert_success
  assert_output --partial "--continue"
  assert_output --partial "session-123"
}

# bats test_tags=toolchain:opencode,kind:launcher
@test "agent oc rejects the legacy --no-greywall token with the rename hint" {
  local mock="$BATS_TEST_TMPDIR/bin"
  setup_oc_launch_mocks "$mock"
  run env $(scratch_env) PATH="$mock:$PATH" "$HOME/.local/bin/agent" oc --no-greywall foo
  assert_failure
  assert_output --partial "renamed --no-sandbox"
}

# bats test_tags=toolchain:opencode,kind:launcher
@test "agent oc --print-env maps profiles to their config paths" {
  launcher_probe oc --print-env
  assert_output --partial 'OPENCODE_CONFIG="/fixture-home/.config/opencode/profiles/factory/opencode.jsonc"'
  launcher_probe oc --print-env default
  assert_output --partial 'OPENCODE_CONFIG="/fixture-home/.config/opencode/profiles/core/opencode.jsonc"'
  launcher_probe oc --print-env factory
  assert_output --partial 'OPENCODE_CONFIG="/fixture-home/.config/opencode/profiles/factory/opencode.jsonc"'
  launcher_probe oc --print-env minimal
  assert_output --partial 'OPENCODE_CONFIG="/fixture-home/.config/opencode/opencode.jsonc"'
  assert_output --partial 'ENGRAM_URL="http://127.0.0.1:43123"'
}

# Mock bins for sandbox-path launcher probes (nono prints its argv, then
# execs the binary; engram stub keeps the engram health check offline; the
# shared curl stub covers the health probe).
setup_oc_launch_mocks() {
  local mock="$1"
  mkdir -p "$mock"
  setup_mock_bins "$mock" curl
  cat >"$mock/opencode" <<'EOF'
#!/usr/bin/env sh
echo "OC_ARGS=$*"
echo "OPENCODE_PORT=${OPENCODE_PORT:-unset}"
EOF
  cat >"$mock/nono" <<'EOF'
#!/usr/bin/env sh
echo "NONO_ARGS=$*"
while [ "${1:-}" != "--" ]; do shift; done; shift
exec "$@"
EOF
  cat >"$mock/engram" <<'EOF'
#!/usr/bin/env sh
exit 0
EOF
  chmod +x "$mock/opencode" "$mock/nono" "$mock/engram"
}

# bats test_tags=toolchain:opencode,kind:launcher
@test "agent oc factory keeps --port and OPENCODE_PORT aligned inside nono" {
  local mock="$BATS_TEST_TMPDIR/bin"
  setup_oc_launch_mocks "$mock"
  run env $(scratch_env) PATH="$mock:$PATH" "$HOME/.local/bin/agent" oc factory --port 1234 --continue x
  assert_success
  assert_output --partial "--open-port 1234"
  assert_output --partial "OPENCODE_PORT=1234"
  assert_output --partial "OC_ARGS=--port 1234 --continue x"

  run env $(scratch_env) PATH="$mock:$PATH" "$HOME/.local/bin/agent" oc factory --continue x
  assert_success
  assert_output --partial "--open-port"
  assert_output --partial "OC_ARGS=--port"
  assert_output --partial "OPENCODE_PORT="

  run env $(scratch_env) PATH="$mock:$PATH" "$HOME/.local/bin/agent" oc factory --port abc
  assert_failure
  assert_output --partial "--port must be a positive integer"
}

# bats test_tags=toolchain:opencode,kind:launcher
@test "agent oc non-factory profiles are port-inert" {
  local mock="$BATS_TEST_TMPDIR/bin"
  setup_oc_launch_mocks "$mock"
  run env $(scratch_env) PATH="$mock:$PATH" "$HOME/.local/bin/agent" oc core --continue x
  assert_success
  refute_output --partial "--open-port"
  refute_output --partial "OC_ARGS=--port"
  assert_output --partial "OC_ARGS=--continue x"
}

# bats test_tags=toolchain:opencode,kind:launcher
@test "agent oc --profile selects in both positions, keeps port compat" {
  local mock="$BATS_TEST_TMPDIR/bin"
  setup_oc_launch_mocks "$mock"

  # Pre-name flag form: config display shows the core tree, args untouched.
  run env $(scratch_env) PATH="$mock:$PATH" "$HOME/.local/bin/agent" --profile core oc --continue x
  assert_success
  assert_output --partial "profiles/core"
  assert_output --partial "OC_ARGS=--continue x"

  # Flag form + factory keeps the port pairing (positional form above is the
  # compat proof).
  run env $(scratch_env) PATH="$mock:$PATH" "$HOME/.local/bin/agent" oc --profile factory --port 1234 --continue x
  assert_success
  assert_output --partial "profiles/factory"
  assert_output --partial "--open-port 1234"
  assert_output --partial "OPENCODE_PORT=1234"
  assert_output --partial "OC_ARGS=--port 1234 --continue x"

  run env $(scratch_env) PATH="$mock:$PATH" "$HOME/.local/bin/agent" oc --profile bogus
  assert_failure
  assert_output --partial "Unknown profile: bogus"

  launcher_probe oc --print-env --profile core
  assert_output --partial 'OPENCODE_CONFIG="/fixture-home/.config/opencode/profiles/core/opencode.jsonc"'
}

@test "opencode AGENTS.md fans out to global instructions" {
  run readlink -f "$HOME/.config/opencode/AGENTS.md"
  assert_success
  assert_output "$AGENTS_MD"
}

{{- if $hasLocalModels }}
@test "opencode preserves the loopback local provider" {
  run jsoncJq -e --arg url "http://127.0.0.1:{{ $localPort }}/v1" '
    (.provider.local.options.baseURL == $url) and
    (.provider.local.models | length > 0)
  ' "$HOME/.config/opencode/opencode.jsonc"
  assert_success
}
{{- end }}

{{- /* Regression: local limits must project load-local-models' normalized
       context_output, not the raw max_output field (which normalization drops,
       silently falling back to 8192). The work profile declares 4096, so this
       fails if the renderer reads the wrong field. */ -}}
{{- if index .ai.profile "work" }}
{{- $workHost := merge (dict) .host }}
{{- $_ := set $workHost "profile" "work" }}
{{- $workRoot := merge (dict) . }}
{{- $_ := set $workRoot "host" $workHost }}
{{- $workCfg := includeTemplate "base/ai/agents/opencode/render-opencode-config" (dict "root" $workRoot "profile" "minimal") | fromJsonc }}
{{- $workModels := index (index (index (index .ai.profile "work").serving.local) "models") }}
{{- $expectedOutputs := list }}
{{- $actualOutputs := list }}
{{- range $m := $workModels }}
{{-   $id := get $m "id" }}
{{-   $expectedOutputs = append $expectedOutputs (printf "%s=%v" $id (get $m "max_output" | default 8192)) }}
{{-   $actualOutputs = append $actualOutputs (printf "%s=%v" $id (index (index (index $workCfg.provider.local.models $id) "limit") "output")) }}
{{- end }}
@test "opencode local output limits use normalized context_output (work profile)" {
  run test "{{ $actualOutputs | join "," }}" = "{{ $expectedOutputs | join "," }}"
  assert_success
}
{{- end }}

