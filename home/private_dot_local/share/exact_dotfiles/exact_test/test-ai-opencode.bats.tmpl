# bats test_tags=toolchain:opencode,kind:config
@test "opencode-agent forwards agent options" {
  mkdir -p "$BATS_TEST_TMPDIR/bin"
  cat >"$BATS_TEST_TMPDIR/bin/opencode" <<'EOF'
#!/usr/bin/env sh
printf '%s\n' "$@"
EOF
  chmod +x "$BATS_TEST_TMPDIR/bin/opencode"

  run env PATH="$BATS_TEST_TMPDIR/bin:$PATH" "$HOME/.local/bin/opencode-agent" --no-greywall --no-update --continue session-123
  assert_success
  assert_output --partial "--continue"
  assert_output --partial "session-123"
}

