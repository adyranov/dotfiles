@test "opencode core and factory profiles resolve the managed dcg-guard plugin" {
  # The guard loads via plugins/ auto-discovery, not a plugin array entry.
  for profile in core factory; do
    assert_symlink_to "$HOME/.config/opencode/plugins/dcg-guard.js" "$HOME/.config/opencode/profiles/$profile/plugins/dcg-guard.js"
  done
  # Dual contract: v1 loaders call the object's `server` half, v2 decodes
  # { id, setup } — the default export must carry both.
  run grep -F 'server: DcgGuard' "$HOME/.config/opencode/plugins/dcg-guard.js"
  assert_success
  run grep -F 'setup: DcgGuardV2Setup' "$HOME/.config/opencode/plugins/dcg-guard.js"
  assert_success
}

