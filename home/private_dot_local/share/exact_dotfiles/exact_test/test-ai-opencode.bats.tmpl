@test "opencode configs declare providers in native v2 shape" {
  # v2.2.5 normalizers skip v1-shaped provider blocks whole, silently
  # stripping limits/reasoning: guard the native keys.
  for file in \
    "$HOME/.config/opencode/opencode.jsonc" \
    "$HOME/.config/opencode/profiles/core/opencode.jsonc" \
    "$HOME/.config/opencode/profiles/factory/opencode.jsonc"; do
    run jsoncJq -e '
      ((.providers // {}) as $p |
        (($p | has("local") | not) or ($p.local.package == "@opencode/ai/providers/openai-compatible")) and
        ($p | to_entries | all(
          .value.package == "@opencode/ai/providers/openai-compatible" and
          (.value.settings.baseURL | length > 0) and
          ((.key == "local") or (.value.headers.Connection == "close")) and
          (.value.models | to_entries | all(
            (.value.limit.context > 0) and
            (.value.capabilities | has("input")) and
            (.value | has("npm") | not) and
            (.value | has("options") | not) and
            ((.value.capabilities.reasoning | type) != "boolean")
          )))))' "$file"
    assert_success
  done
}

