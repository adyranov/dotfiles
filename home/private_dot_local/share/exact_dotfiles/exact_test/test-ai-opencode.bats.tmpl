#!/usr/bin/env bats

# bats file_tags=suite:ai

load 'common-helper'

setup() {
  common_setup
  AGENTS_MD="${HOME}/.config/agents/AGENTS.md"
}

{{ if .toolchains.opencode }}
{{- $serving := includeTemplate "base/helpers/load-section" (dict "root" . "section" "ai.serving" "required" false) | mustFromJson -}}
{{- $localServing := index $serving "local" | default dict -}}
{{- $localPort := get $localServing "port" | default 8321 -}}
{{- $hasLocalModels := gt (len (get $localServing "models" | default list)) 0 -}}
{{- $presets := includeTemplate "base/helpers/load-section" (dict "root" . "section" "ai.presets" "required" false) | mustFromJson -}}
{{- $agentTiers := includeTemplate "base/helpers/load-section" (dict "root" . "section" "ai.agents.opencode.agent_tiers" "required" true) | mustFromJson -}}
{{- $slim := "$HOME/.config/opencode/profiles/factory/oh-my-opencode-slim.json" -}}
{{- $activePreset := index $presets "default" | default "balanced" -}}
{{- $subagentLimit := includeTemplate "base/ai/agents/resolve-subagent-limit" (dict "root" .) | int -}}
{{- $hasActiveCouncil := gt (len (index (index $presets $activePreset | default dict) "council" | default dict)) 0 -}}
@test "opencode core config has routing and schema" {
  local file="$HOME/.config/opencode/opencode.jsonc"
  assert_file_exists "$file"
  run jsoncJq -e '(."$schema" == "https://opencode.ai/config.json") and (.model | length > 0) and (.agents.title.model | length > 0)' "$file"
  assert_success
}

@test "opencode core config has safe defaults and agent routes" {
  run jsoncJq -e '
    (.snapshots == true) and
    (.default_agent == "build") and
    (.agents.plan.model | length > 0) and (.agents.build.model | length > 0)' "$HOME/.config/opencode/opencode.jsonc"
  assert_success
}

@test "opencode core config keeps instruction paths and no in-agent permissions" {
  run jsoncJq -e '
    (.permissions | not) and (.permission | not) and
    ((.plugins // []) | length == 0) and
    (.skills | index("~/.config/agents/skills") != null) and
    (.instructions | index("AGENTS.md") != null)' "$HOME/.config/opencode/opencode.jsonc"
  assert_success
  # The guard rides plugins/ auto-discovery; v2 skips file paths in plugin arrays.
  assert_file_exists "$HOME/.config/opencode/plugins/dcg-guard.js"
}

@test "opencode profiles are valid JSONC and factory slim config is present" {
  for file in \
    "$HOME/.config/opencode/profiles/core/opencode.jsonc" \
    "$HOME/.config/opencode/profiles/factory/opencode.jsonc"; do
    assert_file_exists "$file"
    run jsoncJq -e '."$schema" == "https://opencode.ai/config.json"' "$file"
    assert_success
    run jsoncJq -e '.permission | not' "$file"
    assert_success
  done
  assert_file_exists "$HOME/.config/opencode/profiles/factory/oh-my-opencode-slim.json"
  run jq -e '
    .autoUpdate == true and
    (."$schema" | index("oh-my-opencode-slim@latest") != null) and
    (has("multiplexer") | not) and
    (.presets.balanced | length > 0) and
    (.presets.balanced.orchestrator.skills | index("*") != null) and
    .backgroundJobs.wallClockTimeoutMs == 3600000 and
    .backgroundJobs.abortGraceMs == 10000 and
    .backgroundJobs.concurrency.defaultConcurrency == {{ $subagentLimit }} and
    (.backgroundJobs.concurrency | has("providerConcurrency") | not) and
    .fallback.enabled == true and
    .fallback.maxRetries == 3
{{- if $hasActiveCouncil }}
    and (.council.default_preset == "{{ $activePreset }}") and
    (.council.presets["{{ $activePreset }}"] | length > 0)
{{- else }}
    and (.council | not)
{{- end }}
  ' "$HOME/.config/opencode/profiles/factory/oh-my-opencode-slim.json"
  assert_success
}

@test "opencode slim subagents are askless and oracle stays read-capable" {
  # Path axis stays out of the agent layer: no preset agent declares
  # external_directory, so all inherit the factory allow (nono + DCG gate).
  run jq -e '
    ([.presets[][] | (.permission // {}) | has("external_directory")] | any | not) and
    (.presets.balanced.explorer.permission.edit == "deny") and
    (.presets.balanced.explorer.permission.shell == "deny") and
    (.presets.balanced.explorer.permission.subagent == "deny") and
    (.presets.balanced.explorer.permission.read != "deny") and
    (.presets.balanced.explorer.permission.question == "deny") and
    (.presets.balanced.oracle.permission.question == "deny") and
    (.presets.balanced.designer.permission.question == "deny") and
    (.presets.balanced.fixer.permission.question == "deny") and
    (.presets.balanced.oracle.permission.edit != "deny") and
    (.presets.balanced.oracle.permission.shell != "deny") and
    (.presets.balanced.oracle.permission.subagent != "deny")
  ' "$HOME/.config/opencode/profiles/factory/oh-my-opencode-slim.json"
  assert_success
}

@test "opencode factory opens external_directory and trusts the sandbox" {
  # Unattended policy: the axis is wildcard-allowed; nono + DCG are the
  # boundary. Subagents inherit it — they declare no external_directory key.
  run jsoncJq -e '
    (.permissions | type == "array") and
    (.permissions | length == 1) and
    (.permissions[0].action == "external_directory") and
    (.permissions[0].effect == "allow") and
    (.permissions[0].resource == "*")' \
    "$HOME/.config/opencode/profiles/factory/opencode.jsonc"
  assert_success
}

@test "opencode factory registers the slim TUI half via cli.json" {
