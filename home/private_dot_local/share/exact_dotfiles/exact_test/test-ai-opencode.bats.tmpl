#!/usr/bin/env bats

# bats file_tags=suite:ai

load 'common-helper'

setup() {
  common_setup
  AGENTS_MD="${HOME}/.config/agents/AGENTS.md"
}

{{- if .toolchains.opencode }}
@test "opencode core config has routing and schema" {
  local file="$HOME/.config/opencode/opencode.jsonc"
  assert_file_exists "$file"
  run jsoncJq -e '(."$schema" == "https://opencode.ai/config.json") and (.model | length > 0) and (.small_model | length > 0)' "$file"
  assert_success
}

@test "opencode core config has safe defaults and agent routes" {
  run jsoncJq -e '
    (.share == "disabled") and (.snapshot == true) and
    (.default_agent == "build") and
    (.agent.plan.model | length > 0) and (.agent.build.model | length > 0)' "$HOME/.config/opencode/opencode.jsonc"
  assert_success
}

@test "opencode core config keeps policy and instruction paths" {
  run jsoncJq -e '
    (.permission | type == "object") and
    (.skills.paths | index("~/.config/agents/skills") != null) and
    (.instructions | index("AGENTS.md") != null)' "$HOME/.config/opencode/opencode.jsonc"
  assert_success
}

@test "opencode profiles are valid JSONC and factory slim config is present" {
  for file in \
    "$HOME/.config/opencode/profiles/core/opencode.jsonc" \
    "$HOME/.config/opencode/profiles/factory/opencode.jsonc"; do
    assert_file_exists "$file"
    run jsoncJq -e '."$schema" == "https://opencode.ai/config.json"' "$file"
    assert_success
  done
  assert_file_exists "$HOME/.config/opencode/profiles/factory/oh-my-opencode-slim.json"
  run jq -e '
    .multiplexer.type == "auto" and
    (.presets.balanced | length > 0) and
    (.presets.balanced.orchestrator.skills | index("*") != null) and
    .backgroundJobs.wallClockTimeoutMs == 3600000 and
    .backgroundJobs.abortGraceMs == 10000 and
    .fallback.enabled == true and
    .fallback.maxRetries == 3
  ' "$HOME/.config/opencode/profiles/factory/oh-my-opencode-slim.json"
  assert_success
}

@test "opencode slim research agents are read-only and oracle is unrestricted" {
  run jq -e '
    (.presets.balanced.explorer.permission.edit == "deny") and
    (.presets.balanced.explorer.permission.bash == "deny") and
    (.presets.balanced.explorer.permission.task == "deny") and
    (.presets.balanced.explorer.permission.read != "deny") and
    (.presets.balanced.librarian.permission.edit == "deny") and
    (.presets.balanced.librarian.permission.bash == "deny") and
    (.presets.balanced.librarian.permission.task == "deny") and
    (.presets.balanced.librarian.permission.read != "deny") and
    (.presets.balanced.oracle.permission.edit != "deny") and
    (.presets.balanced.oracle.permission.bash != "deny") and
    (.presets.balanced.oracle.permission.task != "deny")
  ' "$HOME/.config/opencode/profiles/factory/oh-my-opencode-slim.json"
  assert_success
}

@test "opencode factory config defaults to orchestrator and disables plan" {
  run jsoncJq -e '
    (.default_agent == "orchestrator") and
    (.agent.plan.disable == true)' "$HOME/.config/opencode/profiles/factory/opencode.jsonc"
  assert_success
}

@test "opencode factory plannotator is manual and does not configure plan" {
  run jsoncJq -e '
    (.plugin | map(select(type == "array" and .[0] == "@plannotator/opencode@latest")) | .[0][1].workflow == "manual") and
    (.plugin | map(select(type == "array" and .[0] == "@plannotator/opencode@latest")) | .[0][1] | has("planningAgents") | not) and
    (.agent.plan | has("prompt") | not)' "$HOME/.config/opencode/profiles/factory/opencode.jsonc"
  assert_success
}

@test "opencode configs render auto-pruning compaction settings" {
  for file in \
    "$HOME/.config/opencode/opencode.jsonc" \
    "$HOME/.config/opencode/profiles/core/opencode.jsonc" \
    "$HOME/.config/opencode/profiles/factory/opencode.jsonc"; do
    run jsoncJq -e '
      (.compaction.auto == true) and
      (.compaction.prune == true) and
      (.compaction.reserved == 10000) and
      (.compaction.tail_turns == 6)' "$file"
    assert_success
  done
}

@test "opencode configs do not render the DCP plugin" {
  for file in \
    "$HOME/.config/opencode/opencode.jsonc" \
    "$HOME/.config/opencode/profiles/core/opencode.jsonc" \
    "$HOME/.config/opencode/profiles/factory/opencode.jsonc"; do
    run jsoncJq -e '(.plugin // [] | index("@tarquinen/opencode-dcp") == null)' "$file"
    assert_success
  done
}

@test "opencode configs drop the notify plugin and its log" {
  for file in \
    "$HOME/.config/opencode/opencode.jsonc" \
    "$HOME/.config/opencode/profiles/core/opencode.jsonc" \
    "$HOME/.config/opencode/profiles/factory/opencode.jsonc"; do
    run jsoncJq -e '(.plugin // [] | index("opencode-notify") == null)' "$file"
    assert_success
  done
  assert_file_not_exists "$HOME/.opencode-notify.log"
}

@test "opencode ponytail plugin in core and factory, absent from minimal" {
  run jsoncJq -e '.plugin | index("@dietrichgebert/ponytail") != null' "$HOME/.config/opencode/profiles/core/opencode.jsonc"
  assert_success
  run jsoncJq -e '.plugin | index("@dietrichgebert/ponytail") != null' "$HOME/.config/opencode/profiles/factory/opencode.jsonc"
  assert_success
  run jsoncJq -e '(.plugin // [] | index("@dietrichgebert/ponytail") == null)' "$HOME/.config/opencode/opencode.jsonc"
  assert_success
}

@test "opencode core and factory configs drop the caveman plugin" {
  for file in \
    "$HOME/.config/opencode/profiles/core/opencode.jsonc" \
    "$HOME/.config/opencode/profiles/factory/opencode.jsonc"; do
    run jsoncJq -e '(.plugin // [] | index("./plugins/caveman/plugin.js") == null)' "$file"
    assert_success
    run jsoncJq -e '(.instructions // [] | index("CAVEMAN.md") == null)' "$file"
    assert_success
  done
}

@test "opencode factory config registers managed compound-engineering plugin" {
  run jsoncJq -e '.plugin | index("./plugins/compound-engineering.js") != null' "$HOME/.config/opencode/profiles/factory/opencode.jsonc"
  assert_success
  assert_symlink_to "$HOME/.config/agents/libraries/extensions/compound-engineering/.opencode/plugins/compound-engineering.js" "$HOME/.config/opencode/profiles/factory/plugins/compound-engineering.js"
  assert_symlink_to "$HOME/.config/agents/libraries/skills/compound-engineering" "$HOME/.config/agents/libraries/extensions/compound-engineering/skills"
}

@test "opencode core and factory configs enable codegraph MCP, minimal does not" {
  for file in \
    "$HOME/.config/opencode/profiles/core/opencode.jsonc" \
    "$HOME/.config/opencode/profiles/factory/opencode.jsonc"; do
    run jsoncJq -e '
      (.mcp.codegraph.type == "local") and
      (.mcp.codegraph.command == ["codegraph", "serve", "--mcp"]) and
      (.mcp.codegraph.enabled == true)' "$file"
    assert_success
  done
  run jsoncJq -e '(.mcp // {} | has("codegraph") | not)' "$HOME/.config/opencode/opencode.jsonc"
  assert_success
}

@test "opencode slim research roles allow codegraph and keep read-only denials" {
  run jq -e '
    (.presets.balanced.explorer.mcps | index("codegraph") != null) and
    (.presets.balanced.librarian.mcps | index("codegraph") != null) and
    (.presets.balanced.explorer.permission.edit == "deny") and
    (.presets.balanced.explorer.permission.bash == "deny") and
    (.presets.balanced.explorer.permission.task == "deny") and
    (.presets.balanced.explorer.permission.read != "deny") and
    (.presets.balanced.librarian.permission.edit == "deny") and
    (.presets.balanced.librarian.permission.bash == "deny") and
    (.presets.balanced.librarian.permission.task == "deny") and
    (.presets.balanced.librarian.permission.read != "deny") and
    (.presets.balanced.orchestrator.mcps | index("engram") != null) and
    (.presets.balanced.orchestrator.permission | not)
  ' "$HOME/.config/opencode/profiles/factory/oh-my-opencode-slim.json"
  assert_success
}

@test "opencode slim balanced preset maps agent skills exactly" {
  run jq -e '
    (.presets.balanced.orchestrator.skills == ["*"]) and
    (.presets.balanced.oracle.skills | index("ce-pov") != null) and
    (.presets.balanced.oracle.skills | index("ce-code-review") != null) and
    (.presets.balanced.oracle.skills | index("simplify") == null) and
    (.presets.balanced.oracle.skills | index("ce-doc-review") == null) and
    (.presets.balanced.librarian.skills | length == 0) and
    (.presets.balanced.explorer.skills | length == 0) and
    (.presets.balanced.designer.skills | index("ce-polish") != null) and
    (.presets.balanced.designer.skills | index("ce-test-browser") != null) and
    (.presets.balanced.fixer.skills | index("ce-work") != null) and
    (.presets.balanced.fixer.skills | index("ce-debug") != null) and
    (.presets.balanced.fixer.skills | index("ce-simplify-code") != null) and
    (.presets.balanced.fixer.skills | index("ce-resolve-pr-feedback") == null)
  ' "$HOME/.config/opencode/profiles/factory/oh-my-opencode-slim.json"
  assert_success
}

@test "opencode agent launcher exposes profiles and forwards args" {
  assert_file_executable "$HOME/.local/bin/opencode-agent"
  run "$HOME/.local/bin/opencode-agent" --help
  assert_success
  assert_output --partial "--no-greywall"
  assert_output --partial "--no-update"
  assert_output --partial "factory"

  mkdir -p "$BATS_TEST_TMPDIR/bin"
  cat >"$BATS_TEST_TMPDIR/bin/opencode" <<'EOF'
#!/usr/bin/env sh
printf '%s\n' "$@"
EOF
  chmod +x "$BATS_TEST_TMPDIR/bin/opencode"
  run env PATH="$BATS_TEST_TMPDIR/bin:$PATH" "$HOME/.local/bin/opencode-agent" --no-greywall --no-update --continue session-123
  assert_success
  assert_output --partial "--continue"
  assert_output --partial "session-123"
}

@test "opencode AGENTS.md fans out to global instructions" {
  run readlink -f "$HOME/.config/opencode/AGENTS.md"
  assert_success
  assert_output "$AGENTS_MD"
}

{{- if (get . "localModels" | default false) }}
@test "opencode local provider exposes catalog default" {
  run jsoncJq -e '.provider.local.models | length > 0' "$HOME/.config/opencode/opencode.jsonc"
  assert_success
}
{{- end }}
{{- end }}
