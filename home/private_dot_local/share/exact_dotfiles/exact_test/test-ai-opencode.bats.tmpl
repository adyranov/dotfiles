  local cli="$HOME/.config/opencode/profiles/factory/cli.json"
  assert_file_exists "$cli"
  run jsoncJq -e '
    (."$schema" == "https://opencode.ai/v2/cli.json") and
    (.plugins | index("oh-my-opencode-slim") != null) and
    (.theme.name == "catppuccin") and
    (has("mini") | not)' "$cli"
  assert_success
  assert_file_not_exists "$HOME/.config/opencode/profiles/factory/tui.jsonc"
}

@test "chezmoiignore keeps v2-provisioned runtime files out of exact_ pruning" {
