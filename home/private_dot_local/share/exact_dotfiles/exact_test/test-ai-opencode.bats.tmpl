# bats test_tags=toolchain:opencode,kind:symlink
@test "opencode profiles expose shared caveman plugin and commands" {
  library="$HOME/.config/agents/libraries"
  for profile in core factory; do
    plugin="$HOME/.config/opencode/profiles/${profile}/plugins/caveman"
    assert_symlink_to "$library/extensions/opencode-caveman" "$plugin"
    assert_file_exists "${plugin}/plugin.js"
    assert_file_exists "${plugin}/package.json"
    assert_file_exists "${plugin}/caveman-config.cjs"

    for command in caveman caveman-commit caveman-review caveman-compress caveman-stats caveman-help; do
      assert_symlink_to "$library/commands/caveman/${command}.md" \
        "$HOME/.config/opencode/profiles/${profile}/commands/${command}.md"
    done
  done
}
