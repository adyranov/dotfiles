# Mock bins for sandbox-path launcher probes (nono prints its argv, then
# execs the binary; engram stub keeps the engram health check offline; the
# full-launch shared stubs cover the health probe, pwd_guard, and Engram
# supervision — stub pkill/pgrep keep probes from signaling real processes).
setup_oc_launch_mocks() {
  local mock="$1"
  mkdir -p "$mock"
  setup_mock_bins "$mock" curl pkill pgrep git
  cat >"$mock/opencode" <<'EOF'
#!/usr/bin/env sh
echo "OC_ARGS=$*"
echo "OPENCODE_PORT=${OPENCODE_PORT:-unset}"
EOF
  cat >"$mock/nono" <<'EOF'
#!/usr/bin/env sh
echo "NONO_ARGS=$*"
while [ "${1:-}" != "--" ]; do shift; done; shift
exec "$@"
EOF
  cat >"$mock/engram" <<'EOF'
#!/usr/bin/env sh
exit 0
EOF
  chmod +x "$mock/opencode" "$mock/nono" "$mock/engram"
}

# bats test_tags=toolchain:opencode,kind:launcher
@test "agent oc v2 launches port-free: no --port injection, no --open-port" {
  local mock="$BATS_TEST_TMPDIR/bin"
  setup_oc_launch_mocks "$mock"
  # On Linux the launcher's U2 gate refuses sandboxed launches; arg-surface
  # coverage rides the debug path (--no-sandbox execs the stub directly).
  local linux=()
  [ "$(uname -s)" = Linux ] || linux=(--no-sandbox)
  run env $(scratch_env) PATH="$mock:$PATH" "$HOME/.local/bin/agent" oc factory "${linux[@]}" --continue x
  assert_success
  # v2: no port injection; the TUI dials the fixed service port.
  refute_output --partial "--open-port"
  refute_output --partial "OC_ARGS=--port"
  assert_output --partial "OC_ARGS=--continue x"
  assert_output --partial "OPENCODE_PORT=unset"

  # A user-passed --port is foreign v2 argv: forwarded verbatim.
  run env $(scratch_env) PATH="$mock:$PATH" "$HOME/.local/bin/agent" oc factory "${linux[@]}" --port 1234 serve
  assert_success
  assert_output --partial "OC_ARGS=--port 1234 serve"
  assert_output --partial "OPENCODE_PORT=unset"
  refute_output --partial "--open-port"
}

# bats test_tags=toolchain:opencode,kind:launcher
