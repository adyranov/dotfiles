  cat >"$tmpdir/bin/opencode" <<'SCRIPT'
#!/usr/bin/env sh
printf 'PORT=%s\n' "${OPENCODE_PORT-}"
printf 'ARGS=%s\n' "$*"
SCRIPT
  chmod +x "$tmpdir/bin/opencode"

  run env PATH="$tmpdir/bin:$PATH" "$HOME/.local/bin/opencode-agent" factory --no-greywall --no-update --port 55555
  assert_success
  assert_output --partial "PORT=55555"
  assert_output --partial "ARGS=--port 55555"
