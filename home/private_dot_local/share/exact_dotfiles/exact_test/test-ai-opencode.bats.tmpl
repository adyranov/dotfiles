# bats test_tags=toolchain:opencode,kind:port
@test "opencode-agent factory port: env + different CLI, CLI wins" {
  local tmpdir="$BATS_TEST_TMPDIR"
  mkdir -p "$tmpdir/bin"
  cat >"$tmpdir/bin/opencode" <<'SCRIPT'
#!/usr/bin/env sh
printf 'PORT=%s\n' "${OPENCODE_PORT-}"
printf 'ARGS=%s\n' "$*"
SCRIPT
  chmod +x "$tmpdir/bin/opencode"

  run env OPENCODE_PORT=50000 PATH="$tmpdir/bin:$PATH" "$HOME/.local/bin/opencode-agent" factory --no-greywall --no-update --port 55555
  assert_success
  assert_output --partial "PORT=55555"
  refute_output --partial "PORT=50000"
  assert_output --partial "ARGS=--port 55555"
}


