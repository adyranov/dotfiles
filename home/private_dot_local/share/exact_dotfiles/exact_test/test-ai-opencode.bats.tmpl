# bats test_tags=toolchain:opencode,kind:port
@test "opencode-agent factory port: no env, no CLI" {
  local tmpdir="$BATS_TEST_TMPDIR"
  mkdir -p "$tmpdir/bin"
  cat >"$tmpdir/bin/opencode" <<'SCRIPT'
#!/usr/bin/env sh
printf 'PORT=%s\n' "${OPENCODE_PORT-}"
printf 'ARGS=%s\n' "$*"
SCRIPT
  chmod +x "$tmpdir/bin/opencode"

  run env PATH="$tmpdir/bin:$PATH" "$HOME/.local/bin/opencode-agent" factory --no-greywall --no-update
  assert_success
  # Extract generated port from output
  [[ "$output" =~ PORT=([0-9]+) ]]
  local port="${BASH_REMATCH[1]}"
  # Must be in ephemeral range
  (( port >= 49152 && port <= 65535 ))
  # --port arg must match the env value
  [[ "$output" =~ ARGS=--port\ $port ]]
}

