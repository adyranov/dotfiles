# bats test_tags=toolchain:ai,kind:local-llm
@test "omlx flat model dir exists with logical-id symlinks" {
  assert_dir_exists "{{ $omlxModelDir }}"
{{- range $id, $m := $resolved.models }}
{{-   $cacheSlug := replace "/" "--" $m.backend.repo }}
  if [ -d "${HF_HUB_CACHE}/models--{{ $cacheSlug }}/snapshots" ]; then
    run test -L "{{ $omlxModelDir }}/{{ $id }}"
    assert_success
    run readlink "{{ $omlxModelDir }}/{{ $id }}"
    assert_success
    assert_output --partial "models--{{ $cacheSlug }}"
  else
    run test -e "{{ $omlxModelDir }}/{{ $id }}"
    assert_failure
  fi
{{- end }}
}
{{- end }}

