#!/usr/bin/env bats

# bats file_tags=suite:ai

load 'common-helper'

setup() {
  common_setup
}

# --- Local LLM ---

{{- if .toolchains.ai }}
{{- $serving := includeTemplate "base/helpers/load-section" (dict "root" . "section" "ai.serving" "required" true) | mustFromJson }}
{{- $localServing := index $serving "local" | default dict }}
{{- $localModels := get $localServing "models" | default list }}
{{- $resolved := includeTemplate "base/ai/models/load-local-models" (dict "root" .) | mustFromJson }}
{{- $presets := includeTemplate "base/helpers/load-section" (dict "root" . "section" "ai.presets" "required" true) | mustFromJson }}
{{- $enabledAuthBase := includeTemplate "base/ai/auth/resolve-enabled-auth-providers" (dict "root" .) | mustFromJson }}
{{- $validModels := get $enabledAuthBase "valid_models" | default list }}
{{- $servingRefs := list }}
{{- range $spId, $sp := $serving }}
{{-   if kindIs "map" $sp }}
{{-     range $m := get $sp "models" | default list }}
{{-       if and (kindIs "map" $m) (get $m "id") }}{{ $servingRefs = append $servingRefs (printf "%s/%s" $spId (get $m "id")) }}{{ end }}
{{-     end }}
{{-   end }}
{{- end }}
{{- $agentTiers := dict "designer" "visual" "explorer" "small" "fixer" "medium" "librarian" "small" "oracle" "oracle" "orchestrator" "big" }}
{{- $assignedTiers := values $agentTiers | uniq }}
{{- $swapConfig := "$HOME/.config/llama-swap/config.yaml" }}
{{- $llamaCppPreset := "$HOME/.config/llama.cpp/models.ini" }}
{{- $modelsJson := "$HOME/.config/pi/agent/models.json" }}
{{- $port := get $resolved "port" | default 8321 }}
{{- $omlxModelDir := "$HOME/.local/state/omlx/models" }}
{{- $llmBench := "$HOME/.local/bin/llm-bench" }}
{{- $llmPull := "$HOME/.local/bin/llm-pull" }}
{{- $llmServe := "$HOME/.local/bin/llm-serve" }}

# bats test_tags=toolchain:ai,kind:local-llm
@test "local serving provider declares kind and nested models" {
  run test "{{ get $localServing "kind" | default "" }}" = "local"
  assert_success
{{- range $m := $localModels }}
  run test -n "{{ get $m "id" | default "" }}"
  assert_success
  run test -n "{{ get $m "name" | default "" }}"
  assert_success
{{- end }}
}

# bats test_tags=toolchain:ai,kind:local-llm
@test "load-local-models preserves normalized contract from serving models" {
  run test "{{ $resolved.port | default 0 }}" != "0"
  assert_success
  run test "{{ $resolved.engine }}" = "{{ get $localServing "engine" | default "" }}"
  assert_success
  run test "{{ len (get $resolved "models" | default dict) }}" = "{{ len $localModels }}"
  assert_success
{{- range $id := keys ($resolved.models | default dict) | sortAlpha }}
  run test -n "{{ (index $resolved.models $id).backend.repo | default "" }}"
  assert_success
{{- end }}
}

# bats test_tags=toolchain:ai,kind:local-llm
@test "serving provider models join the enabled-model validation union" {
{{- range $ref := $servingRefs }}
  run test "{{ if has $ref $validModels }}yes{{ else }}no{{ end }}" = "yes"
  assert_success
{{- end }}
}

# bats test_tags=toolchain:ai,kind:local-llm
@test "serving providers inject no credentials" {
{{- range $spId, $sp := $serving }}
{{-   if kindIs "map" $sp }}
  run test "{{ if has $spId $enabledAuthBase.providers }}leaked{{ else }}clean{{ end }}" = "clean"
  assert_success
{{-   end }}
{{- end }}
}

# bats test_tags=toolchain:ai,kind:local-llm
@test "base preset default resolves to a defined preset" {
  run test "{{ if and (index $presets "default") (hasKey $presets (index $presets "default")) }}yes{{ else }}no{{ end }}" = "yes"
  assert_success
}

# bats test_tags=toolchain:ai,kind:local-llm
@test "shared agent/skill tier map applies to every preset" {
  run test "{{ len $assignedTiers }}" != "0"
  assert_success
{{- range $presetName, $preset := $presets }}
{{-   if ne $presetName "default" }}
{{-     $tiers := get $preset "tiers" | default dict }}
{{-     range $tier := $assignedTiers }}
  run test "{{ if hasKey $tiers $tier }}yes{{ else }}no{{ end }}" = "yes"
  assert_success
{{-     end }}
{{-   end }}
{{- end }}
}

{{- if index $presets "qwen" }}
{{- $qwenPreset := index $presets "qwen" }}
{{- $qwenTiers := get $qwenPreset "tiers" | default dict }}
{{- $infer01 := index $serving "infer01" | default dict }}
{{- $qwenModel := index (get $infer01 "models" | default list) 0 | default dict }}

# bats test_tags=toolchain:ai,kind:local-llm
@test "infer01 Qwen metadata uses reported context and client output defaults" {
  run test "{{ get $qwenModel "context_window" | default 0 }}" = "262144"
  assert_success
  run test "{{ if hasKey $qwenModel "max_output" }}set{{ else }}client-default{{ end }}" = "client-default"
  assert_success
}

# bats test_tags=toolchain:ai,kind:local-llm
@test "qwen preset routes work tiers to local infer01 with no fallbacks" {
{{- range $tier := list "small" "medium" "big" "visual" }}
{{-   $route := index $qwenTiers $tier }}
  run test "{{ $route.provider }}/{{ $route.model }}" = "infer01/{{ get $qwenModel "id" | default "" }}"
  assert_success
  run test "{{ if hasKey $route "fallbacks" }}bad{{ else }}ok{{ end }}" = "ok"
  assert_success
{{- end }}
}

# bats test_tags=toolchain:ai,kind:local-llm
@test "qwen preset routes oracle locally and carries no council" {
  run test "{{ $qwenTiers.oracle.provider }}/{{ $qwenTiers.oracle.model }}/{{ $qwenTiers.oracle.thinking }}" = "infer01/{{ get $qwenModel "id" | default "" }}/max"
  assert_success
  run test "{{ if hasKey $qwenPreset "council" }}present{{ else }}absent{{ end }}" = "absent"
  assert_success
}
{{- end }}

{{- if and (eq .host.distro.family "darwin") (eq .host.arch "arm64") }}
# bats test_tags=toolchain:ai,kind:local-llm
@test "macOS installs native llama.cpp AI tools from adyranov/tap" {
  assert_file_exists "$HOMEBREW_BUNDLE_FILE"
  run grep -F 'tap "adyranov/tap"' "$HOMEBREW_BUNDLE_FILE"
  assert_success
  run grep -F 'brew "adyranov/tap/llama-cpp", trusted: true' "$HOMEBREW_BUNDLE_FILE"
  assert_success
  run command -v llama-bench
  assert_success
  run command -v llama-server
  assert_success
  run command -v llama-cli
  assert_success
  run test -d "$HOME/.local/state/llama-x86-mac"
  assert_failure
}
{{- end }}

{{- if and (eq .host.distro.family "darwin") (eq .host.arch "arm64") }}
# bats test_tags=toolchain:ai,kind:local-llm
@test "Apple Silicon installs omlx alongside tap-backed llama.cpp" {
  run grep -F 'brew "jundot/omlx/omlx", trusted: true' "$HOMEBREW_BUNDLE_FILE"
  assert_success
  run grep -F 'brew "adyranov/tap/llama-cpp", trusted: true' "$HOMEBREW_BUNDLE_FILE"
  assert_success
  run brew --prefix omlx
  assert_success
  run command -v llama-server
  assert_success
}
{{- end }}

# bats test_tags=toolchain:ai,kind:local-llm
@test "shell exports use Hugging Face hub cache for local model downloads" {
  assert_file_exists "$HOME/.config/shell/exports.d/ai-agents.sh"
  run grep -F 'export HF_HOME="$XDG_DATA_HOME/huggingface"' "$HOME/.config/shell/exports.d/ai-agents.sh"
  assert_success
  run grep -F 'export HF_HUB_CACHE="$HF_HOME/hub"' "$HOME/.config/shell/exports.d/ai-agents.sh"
  assert_success
}

# bats test_tags=toolchain:ai,kind:local-llm
@test "llm-pull can download missing models" {
  assert_file_exists "{{ $llmPull }}"
  run grep -F 'Download or resume ${count} model(s)?' "{{ $llmPull }}"
  assert_success
  run grep -F 'hf_download_cmd' "{{ $llmPull }}"
  assert_success
}

{{- if eq $resolved.engine "llamacpp" }}
# bats test_tags=toolchain:ai,kind:local-llm
@test "shell exports configure llama.cpp router on llamacpp hosts" {
  assert_file_exists "$HOME/.config/shell/exports.d/ai-agents.sh"
  run grep -F 'export LLAMA_CPP_MODELS_PRESET="$XDG_CONFIG_HOME/llama.cpp/models.ini"' "$HOME/.config/shell/exports.d/ai-agents.sh"
  assert_success
}


# bats test_tags=toolchain:ai,kind:local-llm
@test "llama.cpp models.ini declares local models and autoloads default" {
  assert_file_exists "{{ $llamaCppPreset }}"
{{- if $resolved.default_model }}
  run grep -F '[{{ $resolved.default_model }}]' "{{ $llamaCppPreset }}"
  assert_success
  run awk 'BEGIN{in_section=0} $0=="[{{ $resolved.default_model }}]"{in_section=1; next} /^\[/{in_section=0} in_section && $0=="load-on-startup = true"{found=1} END{exit found ? 0 : 1}' "{{ $llamaCppPreset }}"
  assert_success
{{- end }}
}

# bats test_tags=toolchain:ai,kind:local-llm
@test "llama.cpp models.ini uses native router presets" {
  assert_file_exists "{{ $llamaCppPreset }}"
  run grep -F 'version = 1' "{{ $llamaCppPreset }}"
  assert_success
  run grep -F '[*]' "{{ $llamaCppPreset }}"
  assert_success
}


# bats test_tags=toolchain:ai,kind:local-llm
@test "llama.cpp models.ini uses HF hub cache for GGUF models" {
  assert_file_exists "{{ $llamaCppPreset }}"
  run grep -F 'hf-repo =' "{{ $llamaCppPreset }}"
  assert_success
  run grep -F 'hf-file =' "{{ $llamaCppPreset }}"
  assert_success
}

# bats test_tags=toolchain:ai,kind:local-llm
@test "llama.cpp models.ini renders core runtime flags" {
  assert_file_exists "{{ $llamaCppPreset }}"
  run grep -F -- 'jinja = true' "{{ $llamaCppPreset }}"
  assert_success
  run grep -F -- 'gpu-layers = {{ $resolved.gpu_layers }}' "{{ $llamaCppPreset }}"
  assert_success
{{- if gt ($resolved.fit_target | int) 0 }}
  run grep -F -- 'fit-target = {{ $resolved.fit_target }}' "{{ $llamaCppPreset }}"
  assert_success
{{- end }}
}

# bats test_tags=toolchain:ai,kind:local-llm
@test "Qwen 3.5+ models use froggeric chat template when present" {
  assert_file_exists "{{ $llamaCppPreset }}"
{{- if index $resolved.models "qwen3.5-9b" }}
  run awk 'BEGIN{in_section=0} $0=="[qwen3.5-9b]"{in_section=1; next} /^\[/{in_section=0} in_section && $0=="chat-template-file = '"$HOME"'/.config/llama.cpp/qwen-froggeric.jinja"{found=1} END{exit found ? 0 : 1}' "{{ $llamaCppPreset }}"
  assert_success
{{- end }}
}

# bats test_tags=toolchain:ai,kind:local-llm
@test "llm-serve manages native llama.cpp router on llamacpp hosts" {
  assert_file_exists "{{ $llmServe }}"
  run grep -F 'llama-server' "{{ $llmServe }}"
  assert_success
  run grep -F 'LLAMA_CPP_MODELS_PRESET' "{{ $llmServe }}"
  assert_success
  run grep -F '/v1/models' "{{ $llmServe }}"
  assert_success
}

# bats test_tags=toolchain:ai,kind:local-llm
@test "llm-bench benchmarks llama.cpp models directly" {
  assert_file_exists "{{ $llmBench }}"
  run grep -F 'llama-bench \' "{{ $llmBench }}"
  assert_success
  run grep -F 'resolve_gguf' "{{ $llmBench }}"
  assert_success
  run grep -F 'print_summary' "{{ $llmBench }}"
  assert_success
}
{{- end }}

{{- if eq $resolved.engine "omlx" }}
# bats test_tags=toolchain:ai,kind:local-llm
@test "shell exports configure omlx flat model dir on Apple Silicon" {
  assert_file_exists "$HOME/.config/shell/exports.d/ai-agents.sh"
  run grep -F 'export OMLX_MODEL_DIR="$XDG_STATE_HOME/omlx/models"' "$HOME/.config/shell/exports.d/ai-agents.sh"
  assert_success
  run grep -F 'LLAMA_SWAP_CONFIG' "$HOME/.config/shell/exports.d/ai-agents.sh"
  assert_failure
  run grep -F 'LLAMA_CPP_MODELS_PRESET' "$HOME/.config/shell/exports.d/ai-agents.sh"
  assert_failure
}

# bats test_tags=toolchain:ai,kind:local-llm
@test "llm-bench benchmarks mlx models directly on omlx hosts" {
  assert_file_exists "{{ $llmBench }}"
  run grep -F 'mlx_lm generate' "{{ $llmBench }}"
  assert_success
  run grep -F 'prompt=%s tok' "{{ $llmBench }}"
  assert_success
}

# bats test_tags=toolchain:ai,kind:local-llm
@test "llm-serve starts omlx directly on Apple Silicon" {
  assert_file_exists "{{ $llmServe }}"
  run grep -F 'omlx serve' "{{ $llmServe }}"
  assert_success
  run grep -F -- '--paged-ssd-cache-dir "$STATE_DIR/cache"' "{{ $llmServe }}"
  assert_success
}

{{- end }}

# bats test_tags=toolchain:ai,kind:local-llm,toolchain:pi,kind:model
@test "pi models.json includes local model limits" {
  assert_file_exists "{{ $modelsJson }}"
  run jq -e '.providers.local.models | length > 0 and all(.[]; .contextWindow > 0 and .maxTokens > 0)' "{{ $modelsJson }}"
  assert_success
}

# bats test_tags=toolchain:ai,kind:local-llm,toolchain:pi,kind:model
@test "pi settings.json uses standard compaction defaults" {
  assert_file_exists "$HOME/.config/pi/profiles/factory/settings.json"
  run jq -e '.compaction.keepRecentTokens == 20000 and .compaction.reserveTokens == 16384' "$HOME/.config/pi/profiles/factory/settings.json"
  assert_success
}
{{ if .toolchains.pi }}
{{- $tiers := includeTemplate "base/ai/models/load-default-tiers" (dict "root" . "required" true) | mustFromJson }}
{{- $hasExplicitEnabled := $enabledAuthBase.has_enabled_data -}}

# bats test_tags=toolchain:ai,toolchain:pi,kind:local-llm,kind:model
@test "pi models.json points local provider at llm-serve" {
  assert_file_exists "{{ $modelsJson }}"
  run jq -e '.providers.local.baseUrl == "http://127.0.0.1:{{ $port }}/v1"' "{{ $modelsJson }}"
  assert_success
}

# bats test_tags=toolchain:ai,toolchain:pi,kind:local-llm,kind:model
@test "pi models.json exposes local models" {
  assert_file_exists "{{ $modelsJson }}"
  run jq -e '.providers.local.models | length == {{ len $resolved.models }}' "{{ $modelsJson }}"
  assert_success
}

{{ if not $hasExplicitEnabled }}
# bats test_tags=toolchain:ai,toolchain:pi,kind:local-llm,kind:model
@test "pi settings.json enables local models" {
  assert_file_exists "$HOME/.config/pi/agent/settings.json"
  run jq -e '.enabledModels | any(startswith("local/"))' "$HOME/.config/pi/agent/settings.json"
  assert_success
}
{{ end }}

{{ $expectedProviders := list }}
{{ if $resolved.models }}{{ $expectedProviders = list "local" }}{{ end }}
{{ range $spId, $sp := $serving }}
{{   if eq (get $sp "kind" | default "") "openai-compatible" }}
{{     $expectedProviders = append $expectedProviders $spId }}
{{   end }}
{{ end }}
{{ $expectedProviders = $expectedProviders | uniq | sortAlpha }}

# bats test_tags=toolchain:pi,kind:model
@test "pi models.json has all configured serving providers" {
  assert_file_exists "{{ $modelsJson }}"
  run jq -e '.providers | keys == {{ $expectedProviders | toJson }}' "{{ $modelsJson }}"
  assert_success
}

{{- $expectedEnabledModels := list -}}
{{- $forbiddenBareModels := list -}}
{{- if $hasExplicitEnabled -}}
{{-   $expectedEnabledModels = $enabledAuthBase.valid_models | sortAlpha -}}
{{- else -}}
{{-   $expectedRemoteModels := list -}}
{{-   $forbiddenBareModels = list -}}
{{-   range $_, $route := $tiers -}}
{{-     if kindIs "map" $route -}}
{{-       if hasKey $route "model" -}}
{{-         if hasKey $route "provider" -}}
{{-           $expectedRemoteModels = append $expectedRemoteModels (printf "%s/%s" $route.provider $route.model) -}}
{{-           $forbiddenBareModels = append $forbiddenBareModels $route.model -}}
{{-         end -}}
{{-       end -}}
{{-     end -}}
{{-   end -}}
{{-   $expectedRemoteModels = $expectedRemoteModels | uniq | sortAlpha -}}
{{-   $forbiddenBareModels = $forbiddenBareModels | uniq | sortAlpha -}}
{{-   $expectedEnabledModels = $expectedRemoteModels -}}
{{- end -}}
{{- if $expectedEnabledModels }}

# bats test_tags=toolchain:pi,kind:model
@test "pi settings.json uses provider-qualified remote models" {
  assert_file_exists "$HOME/.config/pi/agent/settings.json"
  run jq -e --argjson exp '{{ $expectedEnabledModels | toJson }}' '
    . as $s | all($exp[]; . as $m | $s.enabledModels | index($m) != null)
  ' "$HOME/.config/pi/agent/settings.json"
  assert_success
}

{{- if not $hasExplicitEnabled }}
# bats test_tags=toolchain:pi,kind:model
@test "pi settings.json excludes bare remote model ids" {
  assert_file_exists "$HOME/.config/pi/agent/settings.json"
  run jq -e --argjson forbidden '{{ $forbiddenBareModels | toJson }}' '
    . as $s | all($forbidden[]; . as $m | ($s.enabledModels | index($m)) == null)
  ' "$HOME/.config/pi/agent/settings.json"
  assert_success
}
{{- end }}
{{ end }}
{{- end }}
{{- end }}
