#!/usr/bin/env bats

# bats file_tags=suite:ai

load 'common-helper'

setup() {
  common_setup
}

# --- Local LLM ---

{{- if .toolchains.ai }}
{{- $catalog := includeTemplate "base/helpers/load-section" (dict "root" . "section" "ai.models.catalog" "required" true) | mustFromJson }}
{{- $resolved := includeTemplate "base/helpers/load-local-models" (dict "root" .) | mustFromJson }}
{{- $swapConfig := "$HOME/.config/llama-swap/config.yaml" }}
{{- $llamaCppPreset := "$HOME/.config/llama.cpp/models.ini" }}
{{- $personasJson := "$HOME/.config/pi/agent/models.json" }}
{{- $port := get $resolved "port" | default 8321 }}
{{- $omlxModelDir := "$HOME/.local/state/omlx/models" }}
{{- $llmBench := "$HOME/.local/bin/llm-bench" }}
{{- $llmPull := "$HOME/.local/bin/llm-pull" }}
{{- $llmServe := "$HOME/.local/bin/llm-serve" }}

{{- if eq .host.distro.family "darwin" }}
# bats test_tags=toolchain:ai,kind:local-llm
@test "macOS installs adyranov tap native AI tools" {
  assert_file_exists "$HOMEBREW_BUNDLE_FILE"
  run grep -F 'tap "adyranov/tap", "https://github.com/adyranov/homebrew-tap"' "$HOMEBREW_BUNDLE_FILE"
  assert_success
  run grep -F 'brew "adyranov/tap/llama-cpp"' "$HOMEBREW_BUNDLE_FILE"
  assert_success
  run grep -F 'brew "llama.cpp"' "$HOMEBREW_BUNDLE_FILE"
  assert_failure
  run command -v llama-bench
  assert_success
  run command -v llama-server
  assert_success
  run command -v llama-cli
  assert_success
  run test -d "$HOME/.local/state/llama-x86-mac"
  assert_failure
}
{{- end }}

{{- if and (eq .host.distro.family "darwin") (eq .host.arch "arm64") }}
# bats test_tags=toolchain:ai,kind:local-llm
@test "Apple Silicon installs omlx alongside adyranov tap llama.cpp" {
  run brew --prefix omlx
  assert_success
  run command -v llama-server
  assert_success
}
{{- end }}

# bats test_tags=toolchain:ai,kind:local-llm
@test "shell exports use Hugging Face hub cache for local model downloads" {
  assert_file_exists "$HOME/.config/shell/exports.d/ai-agents.sh"
  run grep -F 'export HF_HOME="$XDG_DATA_HOME/huggingface"' "$HOME/.config/shell/exports.d/ai-agents.sh"
  assert_success
  run grep -F 'export HF_HUB_CACHE="$HF_HOME/hub"' "$HOME/.config/shell/exports.d/ai-agents.sh"
  assert_success
  run grep -F 'LLAMA_CACHE' "$HOME/.config/shell/exports.d/ai-agents.sh"
  assert_failure
  run grep -F 'GGUF_DIR' "$HOME/.config/shell/exports.d/ai-agents.sh"
  assert_failure
}

# bats test_tags=toolchain:ai,kind:config
@test "shell exports configure plannotator data dir and port" {
  assert_file_exists "$HOME/.config/shell/exports.d/ai-agents.sh"
  run grep -F 'export PLANNOTATOR_DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/plannotator"' "$HOME/.config/shell/exports.d/ai-agents.sh"
  assert_success
  run grep -F 'export PLANNOTATOR_PORT="${PLANNOTATOR_PORT:-19432}"' "$HOME/.config/shell/exports.d/ai-agents.sh"
  assert_success
}

# bats test_tags=toolchain:ai,kind:local-llm
@test "llm-pull downloads missing models and interactively cleans stale GGUF caches" {
  assert_file_exists "{{ $llmPull }}"
  run grep -F 'Download or resume ${count} model(s)?' "{{ $llmPull }}"
  assert_success
  run grep -F 'hf_download_cmd' "{{ $llmPull }}"
  assert_success
  run grep -F 'scan_stale' "{{ $llmPull }}"
  assert_success
  run grep -F '[y/N]' "{{ $llmPull }}"
  assert_success
  run grep -F 'rm -rf "$target"' "{{ $llmPull }}"
  assert_success
}

