  assert_success
{{-   end }}
{{-   if hasKey $sampling "top_k" }}
  run awk 'BEGIN{in_section=0} $0=="[{{ $id }}]"{in_section=1; next} /^\[/{in_section=0} in_section && $0=="top-k = {{ index $sampling "top_k" }}"{found=1} END{exit found ? 0 : 1}' "{{ $llamaCppPreset }}"
  assert_success
{{-   end }}
{{-   if hasKey $sampling "min_p" }}
  run awk 'BEGIN{in_section=0} $0=="[{{ $id }}]"{in_section=1; next} /^\[/{in_section=0} in_section && $0=="min-p = {{ index $sampling "min_p" }}"{found=1} END{exit found ? 0 : 1}' "{{ $llamaCppPreset }}"
  assert_success
{{-   end }}
{{-   if hasKey $sampling "presence_penalty" }}
  run awk 'BEGIN{in_section=0} $0=="[{{ $id }}]"{in_section=1; next} /^\[/{in_section=0} in_section && $0=="presence-penalty = {{ index $sampling "presence_penalty" }}"{found=1} END{exit found ? 0 : 1}' "{{ $llamaCppPreset }}"
  assert_success
{{-   end }}
{{-   if hasKey $sampling "repetition_penalty" }}
  run awk 'BEGIN{in_section=0} $0=="[{{ $id }}]"{in_section=1; next} /^\[/{in_section=0} in_section && $0=="repeat-penalty = {{ index $sampling "repetition_penalty" }}"{found=1} END{exit found ? 0 : 1}' "{{ $llamaCppPreset }}"
  assert_success
{{-   end }}
{{- end }}
}

