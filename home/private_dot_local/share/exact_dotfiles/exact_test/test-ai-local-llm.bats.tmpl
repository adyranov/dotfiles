# bats test_tags=toolchain:ai,kind:local-llm
@test "llama.cpp models.ini renders host performance flags" {
  assert_file_exists "{{ $llamaCppPreset }}"
  run grep -F -- 'jinja = true' "{{ $llamaCppPreset }}"
  assert_success
  run grep -F -- 'reasoning-format = {{ $resolved.reasoning_format }}' "{{ $llamaCppPreset }}"
  assert_success
  run grep -F -- 'chat-template =' "{{ $llamaCppPreset }}"
  assert_failure
{{- $hasChatTemplateFile := false }}
{{- range $id, $m := $resolved.models }}
{{-   $chatTemplateFile := index $m "chat_template_file" | default "" }}
{{-   if $chatTemplateFile }}
{{-     $hasChatTemplateFile = true }}
  run grep -F -- 'chat-template-file = {{ $chatTemplateFile }}' "{{ $llamaCppPreset }}"
  assert_success
{{-   end }}
{{- end }}
{{- if not $hasChatTemplateFile }}
  run grep -F -- 'chat-template-file' "{{ $llamaCppPreset }}"
  assert_failure
{{- end }}
  run grep -F -- 'gpu-layers = {{ $resolved.gpu_layers }}' "{{ $llamaCppPreset }}"
  assert_success
{{- if gt ($resolved.fit_target | int) 0 }}
  run grep -F -- 'fit-target = {{ $resolved.fit_target }}' "{{ $llamaCppPreset }}"
  assert_success
{{- else }}
  run grep -F -- 'fit-target' "{{ $llamaCppPreset }}"
  assert_failure
{{- end }}
{{- if gt ($resolved.parallel | int) 0 }}
  run grep -F -- 'parallel = {{ $resolved.parallel }}' "{{ $llamaCppPreset }}"
  assert_success
{{- else }}
  run grep -F -- 'parallel =' "{{ $llamaCppPreset }}"
  assert_failure
{{- end }}
{{- if gt ($resolved.batch_size | int) 0 }}
  run grep -F -- 'batch-size = {{ $resolved.batch_size }}' "{{ $llamaCppPreset }}"
  assert_success
{{- else }}
  run grep -F -- 'batch-size' "{{ $llamaCppPreset }}"
  assert_failure
{{- end }}
{{- if gt ($resolved.ubatch_size | int) 0 }}
  run grep -F -- 'ubatch-size = {{ $resolved.ubatch_size }}' "{{ $llamaCppPreset }}"
  assert_success
{{- else }}
  run grep -F -- 'ubatch-size' "{{ $llamaCppPreset }}"
  assert_failure
{{- end }}
{{- if gt ($resolved.threads | int) 0 }}
  run grep -F -- 'threads = {{ $resolved.threads }}' "{{ $llamaCppPreset }}"
  assert_success
{{- end }}
{{- if gt ($resolved.threads_batch | int) 0 }}
  run grep -F -- 'threads-batch = {{ $resolved.threads_batch }}' "{{ $llamaCppPreset }}"
  assert_success
{{- end }}
{{- if and (eq .host.distro.family "darwin") (eq .host.arch "amd64") }}
  run grep -F -- 'flash-attn = true' "{{ $llamaCppPreset }}"
  assert_failure
  run grep -F -- 'split-mode = none' "{{ $llamaCppPreset }}"
  assert_failure
  run grep -F -- 'main-gpu = 0' "{{ $llamaCppPreset }}"
  assert_failure
  run grep -F -- 'kv-device = MTL0' "{{ $llamaCppPreset }}"
  assert_failure
{{- end }}
}

