# bats test_tags=toolchain:omp,kind:launcher
@test "agent omp full dispatch: env isolation scrubs injected PI_* and OPENCODE_*" {
  local mockdir
  local test_home
  mockdir="$(mktemp -d "$BATS_TEST_TMPDIR/mock.XXXXXX")"
  test_home="$(make_test_home)"
  # Default setup_mock_bins ships the nono passthrough this test needs.
  setup_mock_bins "$mockdir"

  cat >"$mockdir/omp" <<'SCRIPT'
#!/usr/bin/env sh
echo "PI_ARBITRARY=[${PI_ARBITRARY:-unset}]"
echo "OPENCODE_CONFIG=[${OPENCODE_CONFIG:-unset}]"
echo "OPENCODE_PORT=[${OPENCODE_PORT:-unset}]"
echo "PI_CODING_AGENT_DIR=[${PI_CODING_AGENT_DIR:-unset}]"
echo "PI_CONFIG_DIR=[${PI_CONFIG_DIR:-unset}]"
SCRIPT
  chmod +x "$mockdir/nono" "$mockdir/omp"

  run env $(scratch_env) PATH="$mockdir:$PATH" PI_CODING_AGENT_DIR=/leak PI_ARBITRARY=bad \
    OPENCODE_CONFIG=/leak OPENCODE_PORT=9999 \
    XDG_CONFIG_HOME="$test_home/.config" HOME="$test_home" \
    "$HOME/.local/bin/agent" omp -c session-abc
  assert_success
  assert_output --partial "PI_ARBITRARY=[unset]"
  assert_output --partial "OPENCODE_CONFIG=[unset]"
  assert_output --partial "OPENCODE_PORT=[unset]"
  refute_output --partial "PI_CODING_AGENT_DIR=/leak"
  # The scrub loop removes PI_CODING_AGENT_DIR and it is never re-exported;
  # only the home-relative PI_CONFIG_DIR reaches the runtime (dirs.ts scheme).
  assert_output --partial "PI_CODING_AGENT_DIR=[unset]"
  assert_output --partial "PI_CONFIG_DIR=[.config/omp]"
}

# ── Managed user-level MCP (codegraph) ──

# bats test_tags=toolchain:omp,kind:config
@test "omp .mcp.json wires codegraph stdio server, retrieval-only" {
  assert_file_exists "$OMP_DIR/.mcp.json"
  # Local stdio server: command codegraph with only serve --mcp args.
  assert_jq '.mcpServers.codegraph.command == "codegraph"' "$OMP_DIR/.mcp.json"
  assert_jq '.mcpServers.codegraph.args == ["serve", "--mcp"]' "$OMP_DIR/.mcp.json"
  # Retrieval-only: no index/admin subcommands exposed to the agent.
  assert_jq '(.mcpServers.codegraph.args | index("init")) == null and
             (.mcpServers.codegraph.args | index("index")) == null and
             (.mcpServers.codegraph.args | index("sync")) == null and
             (.mcpServers.codegraph.args | length) == 2' "$OMP_DIR/.mcp.json"
  # Engram is OMP's primary memory; instructions trimmed.
  assert_jq '.mcpServers.engram.command == "engram" and
             .mcpServers.engram.args == ["mcp", "--tools=agent"] and
             .mcpServers.engram.instructions == false' "$OMP_DIR/.mcp.json"
}

# ── Isolated scratch bootstrap ──

# bats test_tags=toolchain:omp,kind:launcher
@test "agent omp bootstraps an isolated exact-0700 scratch root and scopes TMPDIR" {
  local mockdir
  local test_home
  local scratch_root="$BATS_TEST_TMPDIR/agents"
  mockdir="$(mktemp -d "$BATS_TEST_TMPDIR/mock.XXXXXX")"
  test_home="$(make_test_home)"
  setup_mock_bins "$mockdir"

  cat >"$mockdir/nono" <<'SCRIPT'
#!/usr/bin/env sh
echo "NONO_TMPDIR=${TMPDIR:-unset}"
exit 0
SCRIPT

  chmod +x "$mockdir/nono"

  run env $(scratch_env) PATH="$mockdir:$PATH" XDG_CONFIG_HOME="$test_home/.config" HOME="$test_home" \
    "$HOME/.local/bin/agent" omp -c session-abc
  assert_success
  assert_output --partial "NONO_TMPDIR=$scratch_root/omp"
  # The live /tmp/agents/omp scratch dir must not be touched.
  refute_output --partial "/tmp/agents/omp"

  # Root and per-agent child are both created with exact 0700.
  assert_scratch_mode_0700 "$scratch_root"
  assert_scratch_mode_0700 "$scratch_root/omp"
}


