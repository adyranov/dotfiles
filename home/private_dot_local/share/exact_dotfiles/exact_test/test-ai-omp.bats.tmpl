# bats test_tags=toolchain:omp,kind:model
@test "omp config modify replaces managed role and fallback maps" {
  local tmpl
  tmpl="$(chezmoi source-path "$HOME/.config/omp/config.yml")"
  assert_file_exists "$tmpl"
  run chezmoi execute-template -f "$tmpl" --with-stdin 2>/dev/null <<'YAML'
advisor:
  model: stale/advisor:high
compaction:
  strategy: auto
modelRoles:
  designer: stale/model:high
  default: stale/model:high
retry:
  baseDelayMs: 500
  enabled: false
  fallbackRevertPolicy: revert
  modelFallback: stale/model:high
  userField: keep-me
  fallbackChains:
    designer: ["stale/model:high"]
    task: ["stale/model:high"]
YAML
  assert_success
  local rendered="$output"
  run yq -e '(.modelRoles | has("designer") | not) and (.modelRoles | has("vision"))' <<< "$rendered"
  assert_success
  # Previously applied retired blocks and retry fields migrate out; user-owned
  # fields survive.
  run yq -e '(has("advisor") | not) and (has("compaction") | not) and (.retry.fallbackChains | has("designer") | not) and (.retry.fallbackChains | has("vision")) and (.retry.userField == "keep-me") and (.retry | has("enabled") | not) and (.retry | has("baseDelayMs") | not) and (.retry | has("modelFallback") | not) and (.retry | has("fallbackRevertPolicy") | not)' <<< "$rendered"
  assert_success
}

