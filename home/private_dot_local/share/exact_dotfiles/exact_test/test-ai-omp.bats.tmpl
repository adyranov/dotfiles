# bats test_tags=toolchain:omp,kind:launcher
@test "omp-agent full dispatch: greywall --profile omp passes user args through unmodified" {
  local mockdir
  local test_home
  mockdir="$(mktemp -d "$BATS_TEST_TMPDIR/mock.XXXXXX")"
  test_home="$(make_test_home)"
  setup_mock_bins "$mockdir"

  cat >"$mockdir/greywall" <<'SCRIPT'
#!/usr/bin/env sh
echo "GREYWALL_CALLED=true"
echo "GREYWALL_PROFILE=$2"
echo "GREYWALL_TMPDIR=${TMPDIR:-unset}"
shift 3
[ "${1:-}" = "--" ] && shift
echo "OMP_PATH=$1"
shift
echo "OMP_ARGS=$*"
exit 0
SCRIPT

  chmod +x "$mockdir/greywall"

  run env $(scratch_env) PATH="$mockdir:$PATH" XDG_CONFIG_HOME="$test_home/.config" HOME="$test_home" \
    "$HOME/.local/bin/omp-agent" -c session-abc
  assert_success
  assert_output --partial "GREYWALL_CALLED=true"
  assert_output --partial "GREYWALL_PROFILE=omp"
  assert_output --partial "GREYWALL_TMPDIR=$BATS_TEST_TMPDIR/agents/omp"
  assert_output --partial "OMP_ARGS=-c session-abc"
  refute_output --partial "--no-extensions"
  refute_output --partial "--config"
}

