# bats test_tags=toolchain:omp,kind:launcher
@test "agent omp --print-env scrubs injected vars and does not leak OMP_PROFILE" {
  run env PI_CODING_AGENT_DIR=/evil PI_CODING_AGENT_SESSION_DIR=/evil PI_PROFILE=evil \
    PI_ARBITRARY=should-scrub \
    OPENCODE_CONFIG=/evil OPENCODE_PORT=/evil \
    OMP_PROFILE=should-not-appear \
    "$HOME/.local/bin/agent" omp --print-env
  assert_success
  assert_output --partial "for __v in"
  assert_output --partial '$1 ~ /^(OMP_PROFILE)$/'
  # XDG-relocated roots (omp dirs.ts): PI_CONFIG_DIR is the home-relative
  # config-root name; PI_CODING_AGENT_DIR disables that scheme and is never
  # exported.
  assert_output --partial 'PI_CONFIG_DIR=".config/omp"'
  assert_output --partial 'XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"'
  assert_output --partial 'XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"'
  assert_output --partial 'XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"'
  refute_output --partial "OMP_PROFILE="
  refute_output --partial "PI_CODING_AGENT_DIR="
}

# ── Config YAML ──

# bats test_tags=toolchain:omp,kind:config
@test "omp config.yml has managed routing, resilience, and core settings" {
  assert_yq 'has("modelRoles") and has("retry") and has("memory") and (has("advisor") | not) and .memory.backend == "off" and .theme.dark == "dark-catppuccin" and .theme.light == "light-catppuccin" and .symbolPreset == "nerd" and (has("mcp") | not) and .task.maxConcurrency == {{ $subagentLimit }} and .task.completionProbe == true and .personality == "none" and .provider.appendOnlyContext == "on" and .providers.cacheWarming == "idle" and .secrets.enabled == true and .bash.gitGuard == true and (.compaction.methodOrder | join(",")) == "remote,snapcompact,handoff,shake,soft" and .tools.artifactSpillThreshold == 50 and .compaction.thresholdPercent == 92 and .telemetry.otlpExportEnabled == false' "$OMP_DIR/config.yml"
  # Skills are loaded from the managed compound-engineering and ponytail libraries.
  assert_yq '.skills.customDirectories | length == 2' "$OMP_DIR/config.yml"
  assert_yq ".skills.customDirectories[0] == \"${HOME}/.config/agents/libraries/extensions/compound-engineering/skills\"" "$OMP_DIR/config.yml"
  assert_yq ".skills.customDirectories[1] == \"${HOME}/.config/agents/libraries/skills/ponytail\"" "$OMP_DIR/config.yml"
  # retry carries only non-default values plus the explicit empty fallback
  # chains that disable OMP's built-in fallback priority.
  assert_yq '.retry.maxRetries == 3 and .retry.maxDelayMs == 30000 and (.retry | has("enabled") | not) and (.retry | has("baseDelayMs") | not) and (.retry | has("modelFallback") | not) and (.retry | has("fallbackRevertPolicy") | not)' "$OMP_DIR/config.yml"
  assert_yq '(.retry.fallbackChains | keys | length == 10)' "$OMP_DIR/config.yml"
  # Gated keys are unmanaged at default knobs: never present, even alongside
  # user-owned sections (migration unsets run unconditionally). Null-idiom
  # (`X.key == null`), not `X | has("key") | not`: yq emits an EMPTY stream
  # when X is missing, and `and` over an empty operand fails ("no matches
  # found") — the renderer prunes emptied maps, so .composer is absent.
  assert_yq '.composer.predictions == null and .retry.fallbackOn == null and .compaction.modelThresholds == null' "$OMP_DIR/config.yml"
  # Specialist subagent model pins render from tier data. The `and` rides
  # INSIDE the pipe parens: yq v4 fails (`no matches found`) when `and` sits
  # outside a piped context (`X | a and b`), even when both sides are true.
  assert_yq '.task.agentModelOverrides | ((keys | length) == 4 and (has("explorer") and has("librarian") and has("oracle") and has("fixer")))' "$OMP_DIR/config.yml"
  assert_yq '.task.agentModelOverrides.explorer == .modelRoles.smol and .task.agentModelOverrides.fixer == .modelRoles.task' "$OMP_DIR/config.yml"
}

