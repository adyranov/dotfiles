# bats test_tags=toolchain:omp,kind:model,tier:routing
@test "omp config.yml has provider-qualified modelRoles for all tiers" {
  for role in default plan slow advisor oracle smol tiny task commit vision; do
    run yq -e ".modelRoles | has(\"${role}\")" "$CONFIG_FILE"
    assert_success "missing role: $role"
    run yq -r ".modelRoles.${role}" "$CONFIG_FILE"
    assert_success
    [ -n "$output" ]
    case "$output" in
      */*:*) ;;
      *) false ;;
    esac
  done
  # OMP 18.3.5 removed the bundled designer role; visual work uses `vision`.
  assert_yq '(.modelRoles | has("designer") | not) and (.modelRoles | has("vision"))' "$CONFIG_FILE"
{{- if and (eq .host.profile "personal") (eq $activePreset "balanced") }}
  assert_yq '.modelRoles.default == "openai-codex/gpt-6-luna:high" and .modelRoles.plan == "openai-codex/gpt-6-luna:high"' "$CONFIG_FILE"
  assert_yq '.modelRoles.slow == "openai-codex/gpt-6.1-sol:max" and .modelRoles.advisor == "openai-codex/gpt-6.1-sol:max" and .modelRoles.oracle == "openai-codex/gpt-6.1-sol:max"' "$CONFIG_FILE"
  assert_yq '.modelRoles.task == "opencode-zen/deepseek-v4.1-flash:high" and .modelRoles.smol == "opencode-zen/deepseek-v4.1-flash:off"' "$CONFIG_FILE"
  assert_yq '.modelRoles.vision == "openai-codex/gpt-6-luna:medium"' "$CONFIG_FILE"
  assert_yq '((.retry.fallbackChains.default | join("|")) == "deepseek/deepseek-v4-pro:high|opencode-zen/deepseek-v4.1-flash:high")' "$CONFIG_FILE"
  assert_yq '((.retry.fallbackChains.oracle | join("|")) == "deepseek/deepseek-v4-pro:max|opencode-zen/deepseek-v4.1-flash:high")' "$CONFIG_FILE"
  assert_yq '((.retry.fallbackChains.task | join("|")) == "deepseek/deepseek-flash:high")' "$CONFIG_FILE"
  assert_yq '((.retry.fallbackChains.smol | join("|")) == "deepseek/deepseek-flash:off")' "$CONFIG_FILE"
  assert_yq '((.retry.fallbackChains.vision | join("|")) == "deepseek/deepseek-v4-pro:medium")' "$CONFIG_FILE"
  # The whole managed fallback map is emitted; no stale designer chain survives.
  assert_yq '(.retry.fallbackChains | has("designer") | not) and ((.retry.fallbackChains | keys | join("|")) == "advisor|commit|default|oracle|plan|slow|smol|task|tiny|vision")' "$CONFIG_FILE"
{{- end }}
}

# bats test_tags=toolchain:omp,kind:model
@test "omp config modify replaces managed role and fallback maps" {
  local tmpl
  tmpl="$(chezmoi source-path "$HOME/.config/omp/agent/config.yml")"
  assert_file_exists "$tmpl"
  run chezmoi execute-template -f "$tmpl" --with-stdin 2>/dev/null <<'YAML'
advisor:
  model: stale/advisor:high
bash:
  gitGuard: false
  userFlag: keep-me
composer:
  predictions: false
compaction:
  methodOrder: ["stale"]
  modelThresholds:
    stale/model: f1
  strategy: auto
modelRoles:
  designer: stale/model:high
  default: stale/model:high
retry:
  baseDelayMs: 500
  enabled: false
  fallbackRevertPolicy: revert
  fallbackOn: ["stale"]
  modelFallback: stale/model:high
  userField: keep-me
  fallbackChains:
    designer: ["stale/model:high"]
    task: ["stale/model:high"]
providers:
  userProviderKey: keep-me
tools:
  artifactSpillThreshold: 99
  userOwned: keep-me
task:
  agentModelOverrides:
    stale: stale/model:high
  userKey: keep-me
YAML
  assert_success
  local rendered="$output"
  run yq -e '(.modelRoles | has("designer") | not) and (.modelRoles | has("vision"))' <<< "$rendered"
  assert_success
  # Previously applied retired blocks and retry fields migrate out; user-owned
  # fields survive.
  # Previously applied retired blocks and retry fields migrate out.
  run yq -e '(has("advisor") | not) and (.compaction | has("strategy") | not) and (.compaction | has("modelThresholds") | not) and (.retry | has("enabled") | not) and (.retry | has("baseDelayMs") | not) and (.retry | has("modelFallback") | not) and (.retry | has("fallbackRevertPolicy") | not) and (.retry | has("fallbackOn") | not) and (.task.agentModelOverrides | has("stale") | not)' <<< "$rendered"
  assert_success
  # Managed values win; user-owned fields survive.
  run yq -e '.compaction.thresholdPercent == 92 and (.compaction.methodOrder | join(",")) == "remote,snapcompact,handoff,shake,soft" and .providers.cacheWarming == "idle" and .providers.userProviderKey == "keep-me" and .secrets.enabled == true and .bash.gitGuard == true and (.retry.fallbackChains | has("designer") | not) and (.retry.fallbackChains | has("vision")) and (.retry.userField == "keep-me") and .bash.userFlag == "keep-me" and (.task.agentModelOverrides | keys | length == 4) and .task.userKey == "keep-me" and .tools.artifactSpillThreshold == 50 and .tools.userOwned == "keep-me" and .task.maxConcurrency == {{ $subagentLimit }} and .task.completionProbe == true and .composer.predictions == null and .personality == "none" and .provider.appendOnlyContext == "on"' <<< "$rendered"
  assert_success
}

