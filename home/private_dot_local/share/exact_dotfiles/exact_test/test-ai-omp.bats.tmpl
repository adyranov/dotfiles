#!/usr/bin/env bats

# bats file_tags=suite:ai

load 'common-helper'

setup() {
  common_setup
  AGENTS_MD="${HOME}/.config/agents/AGENTS.md"
  OMP_DIR="$HOME/.config/omp"
  MODELS_FILE="$OMP_DIR/models.yml"
  CONFIG_FILE="$OMP_DIR/config.yml"
  GREYWALL_FILE="$HOME/.config/greywall/learned/omp.json"
}


{{- if (get .toolchains "omp" | default false) }}

{{- $creds := includeTemplate "base/ai/auth/render-credentials" . | mustFromJson }}
{{- $ompCreds := includeTemplate "base/ai/auth/render-credentials" (dict "root" . "agent" "omp") | mustFromJson }}
{{- $serving := includeTemplate "base/helpers/load-section" (dict "root" . "section" "ai.serving" "required" false) | mustFromJson }}
{{- $infer01 := index $serving "infer01" | default dict }}
{{- $hasInfer01 := gt (len $infer01) 0 }}
{{- $presets := includeTemplate "base/helpers/load-section" (dict "root" . "section" "ai.presets" "required" false) | mustFromJson }}
{{- $activePreset := index $presets "default" | default "balanced" }}

# ── Helpers ──

# assert_yq EXPR FILE — compact yq -e + assert_success
assert_yq() { run yq -e "$1" "$2"; assert_success; }

# assert_jq EXPR FILE — compact jq -e + assert_success for JSON artifacts
assert_jq() { run jq -e "$1" "$2"; assert_success; }

# setup_mock_bins DIR — create curl/nc/greyproxy stubs for dispatch tests
setup_mock_bins() {
  local d="$1"
  cat > "$d/curl" <<'EOF'
#!/usr/bin/env sh
exit 0
EOF
  cat > "$d/nc" <<'EOF'
#!/usr/bin/env sh
exit 0
EOF
  cat > "$d/greyproxy" <<'EOF'
#!/usr/bin/env sh
echo "greyproxy 1.0.0"
EOF
  chmod +x "$d/curl" "$d/nc" "$d/greyproxy"
}

# make_test_home — isolated empty HOME for dispatch tests
make_test_home() {
  local d
  d="$(mktemp -d "$BATS_TEST_TMPDIR/home.XXXXXX")"
  printf '%s\n' "$d"
}

# scratch_env — env args that route launcher scratch bootstrap into a Bats-owned
# root instead of the live /tmp/agents tree (see AGENT_LAUNCH_TEST_MODE).
scratch_env() {
  printf 'AGENT_LAUNCH_TEST_MODE=1 AGENT_LAUNCH_TEST_SCRATCH_ROOT=%s' "$BATS_TEST_TMPDIR/agents"
}

