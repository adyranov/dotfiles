  assert_yq ".skills.customDirectories[0] == \"${HOME}/.config/agents/libraries/extensions/compound-engineering/skills\"" "$OMP_DIR/config.yml"
  # retry carries only non-default values plus the explicit empty fallback
  # chains that disable OMP's built-in fallback priority.
  assert_yq '.retry.maxRetries == 3 and .retry.maxDelayMs == 30000 and (.retry | has("enabled") | not) and (.retry | has("baseDelayMs") | not) and (.retry | has("modelFallback") | not) and (.retry | has("fallbackRevertPolicy") | not)' "$OMP_DIR/config.yml"
