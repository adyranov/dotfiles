# bats test_tags=toolchain:omp,kind:config
@test "omp config.yml has managed routing, resilience, and core settings" {
  assert_yq 'has("modelRoles") and has("retry") and has("memory") and (has("advisor") | not) and (has("compaction") | not) and .memory.backend == "local" and .theme.dark == "dark-catppuccin" and .theme.light == "light-catppuccin" and .symbolPreset == "nerd" and (has("mcp") | not) and (has("task") | not)' "$OMP_DIR/config.yml"
