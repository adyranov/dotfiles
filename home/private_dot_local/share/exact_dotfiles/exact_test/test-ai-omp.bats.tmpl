# ── Managed user-level MCP (codegraph) ──

# bats test_tags=toolchain:omp,kind:config
@test "omp .mcp.json wires codegraph stdio server, retrieval-only, project MCP locked" {
  assert_file_exists "$OMP_DIR/.mcp.json"
  # Local stdio server: command codegraph with only serve --mcp args.
  assert_jq '.mcpServers.codegraph.command == "codegraph"' "$OMP_DIR/.mcp.json"
  assert_jq '.mcpServers.codegraph.args == ["serve", "--mcp"]' "$OMP_DIR/.mcp.json"
  # Retrieval-only: no index/admin subcommands exposed to the agent.
  assert_jq '(.mcpServers.codegraph.args | index("init")) == null and
             (.mcpServers.codegraph.args | index("index")) == null and
             (.mcpServers.codegraph.args | index("sync")) == null and
             (.mcpServers.codegraph.args | length) == 2' "$OMP_DIR/.mcp.json"
  # Project-level MCP stays disabled in the managed security overlay.
  assert_yq '.mcp.enableProjectConfig == false' "$SECURITY_FILE"
}

# ── Isolated scratch bootstrap ──

# bats test_tags=toolchain:omp,kind:launcher
@test "omp-agent bootstraps an isolated exact-0700 scratch root and scopes TMPDIR" {
  local mockdir
  local test_home
  local scratch_root="$BATS_TEST_TMPDIR/agents"
  local mode
  mockdir="$(mktemp -d "$BATS_TEST_TMPDIR/mock.XXXXXX")"
  test_home="$(make_test_home)"
  setup_mock_bins "$mockdir"

  cat >"$mockdir/greywall" <<'SCRIPT'
#!/usr/bin/env sh
echo "GREYWALL_TMPDIR=${TMPDIR:-unset}"
exit 0
SCRIPT

  cat >"$mockdir/omp" <<'SCRIPT'
#!/usr/bin/env sh
echo "OMP_OK"
SCRIPT
  chmod +x "$mockdir/greywall" "$mockdir/omp"

  run env $(scratch_env) PATH="$mockdir:$PATH" XDG_CONFIG_HOME="$test_home/.config" HOME="$test_home" \
    "$HOME/.local/bin/omp-agent" -c session-abc
  assert_success
  assert_output --partial "GREYWALL_TMPDIR=$scratch_root/omp"
  # The live /tmp/agents/omp scratch dir must not be touched.
  refute_output --partial "/tmp/agents/omp"

  # Root and per-agent child are both created with exact 0700. GNU stat
  # shadows BSD stat on some hosts, so validate then fall back (as the launcher
  # itself does).
  mode="$(stat -f %Lp "$scratch_root" 2>/dev/null || true)"
  case "$mode" in ''|*[!0-9]*) mode="$(stat -c %a "$scratch_root" 2>/dev/null || true)" ;; esac
  assert_equal "$mode" "700"
  mode="$(stat -f %Lp "$scratch_root/omp" 2>/dev/null || true)"
  case "$mode" in ''|*[!0-9]*) mode="$(stat -c %a "$scratch_root/omp" 2>/dev/null || true)" ;; esac
  assert_equal "$mode" "700"
}

{{- end }}
