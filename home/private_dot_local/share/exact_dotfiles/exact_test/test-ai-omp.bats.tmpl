# bats test_tags=toolchain:omp,kind:nono
@test "omp nono profile grants OMP paths and denies other agents' config" {
  assert_file_exists "$NONO_FILE"
  assert_jq '.extends == "base"' "$NONO_FILE"
  assert_jq '.filesystem.allow | index("~/.local/share/omp") != null' "$NONO_FILE"
  assert_jq '.filesystem.allow | index("/tmp/agents/omp") != null' "$NONO_FILE"
  # XDG state/data/cache roots carry the writes (agent.db + WAL sidecars live
  # under ~/.local/share/omp); the config write grant is the agent root, never
  # the bare config root.
  assert_jq '.filesystem.allow | index("~/.local/state/omp") != null' "$NONO_FILE"
  assert_jq '.filesystem.allow | index("~/.cache/omp") != null' "$NONO_FILE"
  assert_jq '.filesystem.allow | index("~/.config/omp/agent") != null' "$NONO_FILE"
  assert_jq '.filesystem.allow | index("~/.config/omp") == null' "$NONO_FILE"
  assert_jq '.filesystem.allow | index("~/.config/omp/agent.db") == null' "$NONO_FILE"
  assert_jq '.filesystem.unix_socket_subtree | index("~/.local/state/omp/run") != null' "$NONO_FILE"
  assert_jq '.filesystem.unix_socket_subtree | index("~/.config/omp/run") == null' "$NONO_FILE"
  assert_jq '(.filesystem.deny | index("~/.config/omp/security.yml") == null)' "$NONO_FILE"
  # Other agent config trees are not granted
  assert_jq '(.filesystem.read | index("~/.config/pi/**") == null)' "$NONO_FILE"
  assert_jq '(.filesystem.read | index("~/.config/opencode/**") == null)' "$NONO_FILE"
}

# bats test_tags=toolchain:omp,kind:nono
