# bats test_tags=toolchain:omp,kind:launcher
@test "agent omp --profile exports OMP_PROFILE and forwards args untouched" {
  local mockdir
  local test_home
  mockdir="$(mktemp -d "$BATS_TEST_TMPDIR/mock.XXXXXX")"
  test_home="$(make_test_home)"
  setup_mock_bins "$mockdir"

  cat >"$mockdir/omp" <<'SCRIPT'
#!/usr/bin/env sh
echo "OMP_PROFILE=[${OMP_PROFILE:-unset}]"
echo "OMP_ARGS=$*"
SCRIPT
  chmod +x "$mockdir/nono" "$mockdir/omp"

  run env $(scratch_env) PATH="$mockdir:$PATH" OMP_PROFILE=inherit-me \
    XDG_CONFIG_HOME="$test_home/.config" HOME="$test_home" \
    "$HOME/.local/bin/agent" omp --profile work -c session-p
  assert_success
  # The launcher exports the selected name (inherited value scrubbed first);
  # omp relocates its own agent root; user args pass through untouched.
  assert_output --partial "OMP_PROFILE=[work]"
  assert_output --partial "OMP_ARGS=-c session-p"
  refute_output --partial "OMP_PROFILE=[inherit-me]"
  # Missing value is fatal.
  run env $(scratch_env) PATH="$mockdir:$PATH" XDG_CONFIG_HOME="$test_home/.config" HOME="$test_home" \
    "$HOME/.local/bin/agent" omp --profile
  assert_failure
}

# bats test_tags=toolchain:omp,kind:launcher
@test "agent omp --profile= equals form resolves pre-name; print-env stays free-form" {
  local mockdir test_home
  mockdir="$(mktemp -d "$BATS_TEST_TMPDIR/mock.XXXXXX")"
  test_home="$(make_test_home)"
  setup_mock_bins "$mockdir"
  cat >"$mockdir/omp" <<'SCRIPT'
#!/usr/bin/env sh
echo "OMP_PROFILE=[${OMP_PROFILE:-unset}]"
echo "OMP_ARGS=$*"
SCRIPT
  chmod +x "$mockdir/nono" "$mockdir/omp"

  # Pre-name equals form feeds the same omp_profile variable as the space form.
  run env $(scratch_env) PATH="$mockdir:$PATH" \
    XDG_CONFIG_HOME="$test_home/.config" HOME="$test_home" \
    "$HOME/.local/bin/agent" --profile=work omp -c session-p
  assert_success
  assert_output --partial "OMP_PROFILE=[work]"
  assert_output --partial "OMP_ARGS=-c session-p"

  # print-env accepts free-form flag names (no validation die, no root export).
  run env HOME=/fixture-home XDG_CONFIG_HOME=/fixture-home/.config \
    "$HOME/.local/bin/agent" omp --print-env --profile work
  assert_success
  assert_output --partial 'OMP_PROFILE="work"'
  assert_output --partial 'PI_CONFIG_DIR=".config/omp"'
}

# bats test_tags=toolchain:omp,kind:launcher
@test "agent omp --no-sandbox runs omp directly without the nono sandbox" {
  mkdir -p "$BATS_TEST_TMPDIR/bin"
  setup_mock_bins "$BATS_TEST_TMPDIR/bin" echo:omp
  cat >"$BATS_TEST_TMPDIR/bin/nono" <<'EOF'
#!/usr/bin/env sh
echo "NONO_CALLED=unexpected"
exit 1
EOF
  chmod +x "$BATS_TEST_TMPDIR/bin/omp" "$BATS_TEST_TMPDIR/bin/nono"

  run env -u AGENT_SANDBOX PATH="$BATS_TEST_TMPDIR/bin:$PATH" "$HOME/.local/bin/agent" omp --no-sandbox -c session-123
  assert_success
  assert_output --partial "-c"
  assert_output --partial "session-123"
  # Machine-read stderr contract: parent agents grep the bypass status line.
  assert_output --partial "DCG guards: bypassed"
  refute_output --partial "NONO_CALLED=unexpected"
}

