# bats test_tags=toolchain:pi,kind:packages
@test "pi npm roots carry no unmanaged packages" {
  # KTD6 drift gate: pi writes direct deps into each root's npm/package.json;
  # every dependency key must map to a managed npm: settings entry. git:
  # entries clone outside the npm root and are excluded.
  local dir checked=0
  for dir in "$HOME/.config/pi/agent" "$HOME/.config/pi/profiles/core" "$HOME/.config/pi/profiles/factory"; do
    [ -f "$dir/npm/package.json" ] || continue
    checked=$((checked + 1))
    run jq -e -n --slurpfile m "$dir/npm/package.json" --slurpfile s "$dir/settings.json" '
      ($s[0].packages | map(if type == "object" then .source else . end)
        | map(select(startswith("npm:")) | sub("^npm:"; "")) | unique) as $want |
      (($m[0].dependencies // {} | keys) - $want | length) == 0
    '
    assert_success
  done
  # TAP-visible skip: a zero-root run (pi never booted) must not read green.
  [ "$checked" -gt 0 ] || skip "no npm roots in any pi root (pi has never booted)"
}

