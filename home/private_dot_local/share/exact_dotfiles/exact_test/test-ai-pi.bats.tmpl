{{- $planPlanningCat := get $plannotatorCfg "planning" | default "architect" }}
{{- $planExecutingCat := get $plannotatorCfg "executing" | default "coder" }}
{{- $planPlanningRoute := get $personas $planPlanningCat | default dict }}
