#!/usr/bin/env bats

# bats file_tags=suite:ai

load 'common-helper'

setup() {
  common_setup
  AGENTS_MD="${HOME}/.config/agents/AGENTS.md"
}

# --- Per-agent global context file fans out to the shared AGENTS.md ---

{{- if .toolchains.pi }}
# bats test_tags=toolchain:pi,kind:symlink
@test "pi AGENTS.md fans out to global AGENTS.md" {
  run readlink -f "$HOME/.config/pi/agent/AGENTS.md"
  assert_success
  assert_output "$AGENTS_MD"
}
{{- end }}

# --- Pi settings ---

{{- if .toolchains.pi }}
{{- $pi := includeTemplate "base/helpers/load-section" (dict "root" . "section" "ai.agents.pi" "required" true) | mustFromJson }}
{{- $tiers := includeTemplate "base/helpers/load-section" (dict "root" . "section" "ai.models.tiers" "required" true) | mustFromJson }}

# bats test_tags=toolchain:pi,kind:permission
@test "pi settings.json enables install telemetry" {
  run grep -F '"enableInstallTelemetry": true' "$HOME/.config/pi/agent/settings.json"
  assert_success
}

# bats test_tags=toolchain:pi,kind:packages
@test "pi settings.json contains core packages" {
  assert_file_exists "$HOME/.config/pi/profiles/core/settings.json"
  run grep -F '"npm:pi-lens"' "$HOME/.config/pi/profiles/core/settings.json"
  assert_success
  run grep -F '"npm:@juicesharp/rpiv-pi"' "$HOME/.config/pi/profiles/core/settings.json"
  assert_failure
}


# bats test_tags=toolchain:pi,kind:config
@test "pi settings.json uses lightweight compaction for core" {
  run jq -e '
    .compaction.keepRecentTokens == 8000 and
    .compaction.reserveTokens == 8192
  ' "$HOME/.config/pi/profiles/core/settings.json"
  assert_success
}

# bats test_tags=toolchain:pi,kind:config
@test "pi settings.json loads only core skills" {
  run jq -e '.skills | length == 1' "$HOME/.config/pi/profiles/core/settings.json"
  assert_success
  run jq -e '.skills | index("../../agents/skills/karpathy-guidelines") != null' "$HOME/.config/pi/profiles/core/settings.json"
  assert_success
}

# bats test_tags=toolchain:pi,kind:packages
@test "pi factory settings.json contains rpiv-pi" {
  assert_file_exists "$HOME/.config/pi/profiles/factory/settings.json"
  run grep -F '"npm:@juicesharp/rpiv-pi"' "$HOME/.config/pi/profiles/factory/settings.json"
  assert_success
  run grep -F '"npm:pi-system-prompt"' "$HOME/.config/pi/profiles/factory/settings.json"
  assert_success
}

# bats test_tags=toolchain:pi,kind:config
@test "pi SYSTEM.md has compact tool routing" {
  assert_file_exists "$HOME/.config/pi/agent/SYSTEM.md"
  run grep -F "fffind" "$HOME/.config/pi/agent/SYSTEM.md"
  assert_success
  run grep -F "module_report" "$HOME/.config/pi/agent/SYSTEM.md"
  assert_success
  run grep -F "web_search" "$HOME/.config/pi/agent/SYSTEM.md"
  assert_success
}

# bats test_tags=toolchain:pi,kind:config
@test "pi plannotator.json planning has key activeTools" {
  run jq -e '
    .phases.planning.activeTools | index("module_report") != null and
    index("lsp_navigation") != null and
    index("plannotator_submit_plan") != null and
    index("ask_user_question") != null
  ' "$HOME/.config/pi/profiles/core/plannotator.json"
  assert_success
}

# bats test_tags=toolchain:pi,kind:config
@test "pi plannotator.json phase systemPrompts are wired" {
  run jq -e '
    (.phases.planning.systemPrompt | length > 0) and
    (.phases.executing.systemPrompt | length > 0) and
    (.phases.reviewing.systemPrompt | length > 0)
  ' "$HOME/.config/pi/profiles/core/plannotator.json"
  assert_success
  run jq -r ".phases.planning.systemPrompt" "$HOME/.config/pi/profiles/core/plannotator.json"
  assert_success
  assert_output --partial "docs/plans/"
}

# bats test_tags=toolchain:pi,kind:config
@test "pi factory settings.json renders agent routes" {
  assert_file_exists "$HOME/.config/pi/profiles/factory/settings.json"
  run jq -e '(.subagents.agentOverrides | length > 0) and all(.subagents.agentOverrides[]; (.model | length > 0) and (.thinking | length > 0))' "$HOME/.config/pi/profiles/factory/settings.json"
  assert_success
}

# bats test_tags=toolchain:pi,kind:config
@test "pi caveman package in core and factory" {
  run jq -e '.packages | index("npm:pi-caveman")' "$HOME/.config/pi/profiles/core/settings.json"
  assert_success
  run jq -e '.packages | index("npm:pi-caveman")' "$HOME/.config/pi/profiles/factory/settings.json"
  assert_success
}


# bats test_tags=toolchain:pi,kind:config
@test "pi caveman default level is full" {
  run jq -e '.defaultLevel == "full"' "$HOME/.config/pi/agent/caveman.json"
  assert_success
}


# bats test_tags=toolchain:pi,kind:config
@test "pi plannotator.json has model routes" {
  run jq -e '
    (.defaults.model.id | length > 0) and
    (.phases.planning.model.id | length > 0) and
    (.phases.executing.model.id | length > 0)
  ' "$HOME/.config/pi/profiles/core/plannotator.json"
  assert_success
}

# bats test_tags=toolchain:pi,kind:config
@test "pi factory profile symlinks resolve to agent config" {
  local profile="factory"
  run readlink -f "$HOME/.config/pi/profiles/$profile/AGENTS.md"
  assert_success
  assert_output "$HOME/.config/agents/AGENTS.md"
  run readlink -f "$HOME/.config/pi/profiles/$profile/SYSTEM.md"
  assert_success
  assert_output "$HOME/.config/pi/agent/SYSTEM.md"
  # Factory plannotator.json is standalone (not a symlink to core)
  assert_file_exists "$HOME/.config/pi/profiles/$profile/plannotator.json"
  run jq -e '.phases.planning.systemPrompt | contains("Plan-only contract")' "$HOME/.config/pi/profiles/$profile/plannotator.json"
  assert_success
}

# bats test_tags=toolchain:pi,kind:config
@test "pi factory plannotator is standalone with plan-only contract" {
  assert_file_exists "$HOME/.config/pi/profiles/factory/plannotator.json"
  run jq -e '
    (.phases.planning.systemPrompt | contains("Plan-only contract")) and
    (.phases.executing.systemPrompt | contains("[PLANNOTATOR PLAN-ONLY]"))
  ' "$HOME/.config/pi/profiles/factory/plannotator.json"
  assert_success
}

# bats test_tags=toolchain:pi,kind:config
@test "pi minimal config resides in agent dir" {
  assert_file_exists "$HOME/.config/pi/agent/settings.json"
  assert_file_exists "$HOME/.config/pi/agent/auth.json"
  assert_file_exists "$HOME/.config/pi/agent/models.json"
  run readlink -f "$HOME/.config/pi/agent/AGENTS.md"
  assert_success
  assert_output "$HOME/.config/agents/AGENTS.md"
}

# bats test_tags=toolchain:pi,kind:config
@test "pi factory npm directory is independent" {
  run readlink -f "$HOME/.config/pi/profiles/factory/npm"
  assert_success
  assert_output "$HOME/.config/pi/profiles/factory/npm"
}

# bats test_tags=toolchain:pi,kind:config
@test "pi-agent is executable" {
  assert_file_executable "$HOME/.local/bin/pi-agent"
}

# bats test_tags=toolchain:pi,kind:config
@test "pi-agent --list outputs profiles" {
  run "$HOME/.local/bin/pi-agent" --list
  assert_success
  assert_output --partial "core"
  assert_output --partial "factory"
  assert_output --partial "minimal"
}

# bats test_tags=toolchain:pi,kind:config
@test "pi-agent --help mentions --no-greywall and --no-update" {
  run "$HOME/.local/bin/pi-agent" --help
  assert_success
  assert_output --partial "--no-greywall"
  assert_output --partial "--no-update"
  assert_output --partial "pi args"
}

# bats test_tags=toolchain:pi,kind:config
@test "pi-agent forwards agent options" {
  mkdir -p "$BATS_TEST_TMPDIR/bin"
  cat >"$BATS_TEST_TMPDIR/bin/pi" <<'EOF'
#!/usr/bin/env sh
printf '%s\n' "$@"
EOF
  chmod +x "$BATS_TEST_TMPDIR/bin/pi"

  run env PATH="$BATS_TEST_TMPDIR/bin:$PATH" "$HOME/.local/bin/pi-agent" --no-greywall --no-update -c session-123
  assert_success
  assert_output --partial "-c"
  assert_output --partial "session-123"
}

# bats test_tags=toolchain:pi,kind:config
@test "agent-launch script has exec and unsafe-PWD guards" {
  run grep -F 'exec greywall --profile "$GREYWALL_PROFILE" -- "$BINARY_NAME"' "$HOME/.local/bin/agent-launch"
  assert_success
  run grep -F 'exec "$BINARY_NAME" "$@"' "$HOME/.local/bin/agent-launch"
  assert_success
  run grep -F 'Refusing to launch from home directory' "$HOME/.local/bin/agent-launch"
  assert_success
  run grep -F 'Refusing to launch from root' "$HOME/.local/bin/agent-launch"
  assert_success
}

# bats test_tags=toolchain:pi,kind:config
@test "pi-agent --print-env minimal" {
  run "$HOME/.local/bin/pi-agent" --print-env minimal
  assert_success
  assert_output --partial "PI_CODING_AGENT_DIR"
  assert_output --partial "ENGRAM_URL"
}

# bats test_tags=toolchain:ai,kind:config
@test "rpiv-advisor reads oracle model route from ai.models.tiers" {
  assert_file_exists "$HOME/.config/rpiv-advisor/advisor.json"
{{- $oracle := get $tiers "oracle" }}
{{- $oracleKey := printf "%s:%s" $oracle.provider $oracle.model }}
  run jq -e '.modelKey == "{{ $oracleKey }}"' "$HOME/.config/rpiv-advisor/advisor.json"
  assert_success
}

# bats test_tags=toolchain:pi,kind:mcp
@test "pi mcp.json keeps adapter proxy-only defaults" {
  run jq -e '.settings.directTools == false and .settings.disableProxyTool == false' "$HOME/.config/pi/profiles/core/mcp.json"
  assert_success
}

# bats test_tags=toolchain:pi,kind:mcp
# Pi accesses engram via the gentle-engram package (direct daemon client),
# not via MCP — so no mcpServers entry is expected here.
@test "pi mcp.json has no engram server" {
  run jq -e '
    .mcpServers == {}
  ' "$HOME/.config/pi/profiles/core/mcp.json"
  assert_success
}

{{- $enabledAuth := includeTemplate "base/ai/resolve-enabled-auth-providers" (dict "root" .) | mustFromJson }}
{{- if or (not $enabledAuth.has_enabled_data) ($enabledAuth.providers | has "openrouter") }}
# bats test_tags=toolchain:pi,kind:config
@test "pi auth.json maps openrouter to env var" {
  assert_file_exists "$HOME/.config/pi/agent/auth.json"
  # auth.json is deny_read (security boundary); validate via resolved auth data
  {{- if eq (get $enabledAuth.api_key_map "openrouter") "OPENROUTER_API_KEY" }}
  true
  {{- else }}
  false
  {{- end }}
}
{{- else }}
# bats test_tags=toolchain:pi,kind:config
@test "pi auth.json omits disabled openrouter" {
  assert_file_exists "$HOME/.config/pi/agent/auth.json"
  # auth.json is deny_read (security boundary); validate via resolved auth data
  {{- if has "openrouter" $enabledAuth.providers }}
  false
  {{- else }}
  true
  {{- end }}
}
{{- end }}
{{- end }}
