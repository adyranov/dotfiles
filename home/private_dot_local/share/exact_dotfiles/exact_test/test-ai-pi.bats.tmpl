# bats test_tags=toolchain:pi,kind:config
@test "pi plannotator.json planning has expanded activeTools" {
  run jq -e '.phases.planning.activeTools | any(. == "module_report")' "$HOME/.config/pi/agent/plannotator.json"
  assert_success
  run jq -e '.phases.planning.activeTools | any(. == "read_symbol")' "$HOME/.config/pi/agent/plannotator.json"
  assert_success
  run jq -e '.phases.planning.activeTools | any(. == "lsp_navigation")' "$HOME/.config/pi/agent/plannotator.json"
  assert_success
  run jq -e '.phases.planning.activeTools | any(. == "lens_diagnostics")' "$HOME/.config/pi/agent/plannotator.json"
  assert_success
  run jq -e '.phases.planning.activeTools | any(. == "ast_grep_search")' "$HOME/.config/pi/agent/plannotator.json"
  assert_success
  run jq -e '.phases.planning.activeTools | any(. == "memory_search")' "$HOME/.config/pi/agent/plannotator.json"
  assert_success
  run jq -e '.phases.planning.activeTools | any(. == "context_checkpoint")' "$HOME/.config/pi/agent/plannotator.json"
  assert_success
  run jq -e '.phases.planning.activeTools | any(. == "plannotator_submit_plan")' "$HOME/.config/pi/agent/plannotator.json"
  assert_success
  run jq -e '.phases.planning.activeTools | any(. == "ask_user_question")' "$HOME/.config/pi/agent/plannotator.json"
  assert_success
  run jq -e '.phases.planning.activeTools | any(. == "advisor")' "$HOME/.config/pi/agent/plannotator.json"
  assert_success
  run jq -e '.phases.planning.activeTools | any(. == "web_search")' "$HOME/.config/pi/agent/plannotator.json"
  assert_success
}

# bats test_tags=toolchain:pi,kind:config
@test "pi plannotator.json phase systemPrompts are non-empty" {
  run jq -e '.phases.planning.systemPrompt | length > 0' "$HOME/.config/pi/agent/plannotator.json"
  assert_success
  run jq -e '.phases.executing.systemPrompt | length > 0' "$HOME/.config/pi/agent/plannotator.json"
  assert_success
  run jq -e '.phases.reviewing.systemPrompt | length > 0' "$HOME/.config/pi/agent/plannotator.json"
  assert_success
  run jq -r ".phases.planning.systemPrompt" "$HOME/.config/pi/agent/plannotator.json"
  assert_success
  assert_output --partial ".plannotator/"
  run jq -r ".phases.planning.systemPrompt" "$HOME/.config/pi/agent/plannotator.json"
  assert_success
  assert_output --partial "Question phase first"
  run jq -r ".phases.planning.systemPrompt" "$HOME/.config/pi/agent/plannotator.json"
  assert_success
  assert_output --partial "material ambiguity"
  run jq -r ".phases.planning.systemPrompt" "$HOME/.config/pi/agent/plannotator.json"
  assert_success
  assert_output --partial "Final plan: concise"
}

# bats test_tags=toolchain:pi,kind:config
@test "pi factory settings.json renders category-mapped agent routes" {
  assert_file_exists "$HOME/.config/pi/profiles/factory/settings.json"
  run jq -e --argjson expected '{{ keys $agentRoutes | sortAlpha | toJson }}' '.subagents.agentOverrides | keys | sort == $expected' "$HOME/.config/pi/profiles/factory/settings.json"
  assert_success
{{- range $agent := keys $agentRoutes | sortAlpha }}
{{-   $route := index $agentRoutes $agent }}
  run jq -e '.subagents.agentOverrides["{{ $agent }}"].model == "{{ $route.model }}" and .subagents.agentOverrides["{{ $agent }}"].thinking == "{{ $route.thinking }}"' "$HOME/.config/pi/profiles/factory/settings.json"
  assert_success
{{- end }}
}

