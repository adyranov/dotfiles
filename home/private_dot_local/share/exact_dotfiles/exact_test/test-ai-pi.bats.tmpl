# bats test_tags=toolchain:pi,kind:launcher
# Exercises bootstrap_scratch against a Bats-owned root; it never mutates the
# live agent scratch directory.
@test "agent pi rejects symlinks and normalizes scratch modes" {
  scratch_root="$BATS_TEST_TMPDIR/agents"
  mkdir -m 700 -p "$scratch_root"
  mkdir -p "$BATS_TEST_TMPDIR/bin"
  setup_mock_bins "$BATS_TEST_TMPDIR/bin"
  cat >"$BATS_TEST_TMPDIR/bin/pi" <<'EOF'
#!/usr/bin/env sh
echo "launched"
EOF
  chmod +x "$BATS_TEST_TMPDIR/bin/pi"

  # Symlinked scratch dir must fail closed.
  ln -s /tmp "$scratch_root/pi"
  run env AGENT_LAUNCH_TEST_MODE=1 AGENT_LAUNCH_TEST_SCRATCH_ROOT="$scratch_root" PATH="$BATS_TEST_TMPDIR/bin:$PATH" "$HOME/.local/bin/agent" pi minimal -c session-1
  assert_failure
  assert_output --partial "symlink"

  # Existing permissive modes are repaired for the invoking user.
  rm -f "$scratch_root/pi"
  mkdir "$scratch_root/pi"
  chmod 755 "$scratch_root" "$scratch_root/pi"
  run env AGENT_LAUNCH_TEST_MODE=1 AGENT_LAUNCH_TEST_SCRATCH_ROOT="$scratch_root" PATH="$BATS_TEST_TMPDIR/bin:$PATH" "$HOME/.local/bin/agent" pi minimal -c session-2
  assert_success
  assert_output --partial "launched"
  assert_scratch_mode_0700 "$scratch_root"
  assert_scratch_mode_0700 "$scratch_root/pi"
}

