    .defaults.model.provider == "{{ $defaults.provider }}" and
    .defaults.model.id == "{{ $defaults.model }}" and
    .defaults.thinking == "{{ $defaults.thinking }}"
  ' "$HOME/.config/pi/agent/plannotator.json"
  assert_success
}

