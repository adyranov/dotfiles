# bats test_tags=toolchain:pi,kind:config
@test "pi-agent forwards agent options" {
  mkdir -p "$BATS_TEST_TMPDIR/bin"
  cat >"$BATS_TEST_TMPDIR/bin/pi" <<'EOF'
#!/usr/bin/env sh
printf '%s\n' "$@"
EOF
  chmod +x "$BATS_TEST_TMPDIR/bin/pi"

  run env PATH="$BATS_TEST_TMPDIR/bin:$PATH" "$HOME/.local/bin/pi-agent" --no-greywall --no-update -c session-123
  assert_success
  assert_output --partial "-c"
  assert_output --partial "session-123"
}

# bats test_tags=toolchain:pi,kind:config
@test "agent-launch script validates greyproxy API and ports" {
  run grep -F 'GREYPROXY_API_PORT=43080' "$HOME/.local/bin/agent-launch"
  assert_success
  run grep -F '/api/health' "$HOME/.local/bin/agent-launch"
  assert_success
  run grep -F 'greyproxy --version' "$HOME/.local/bin/agent-launch"
  assert_success
  run grep -F 'nc -z 127.0.0.1 43051' "$HOME/.local/bin/agent-launch"
  assert_success
  run grep -F 'nc -z 127.0.0.1 43052' "$HOME/.local/bin/agent-launch"
  assert_success
  run grep -F 'nc -z 127.0.0.1 43053' "$HOME/.local/bin/agent-launch"
  assert_success
}

# bats test_tags=toolchain:pi,kind:config
@test "agent-launch script updates pi extensions on start" {
  run grep -F 'pi update --extensions' "$HOME/.local/bin/agent-launch"
