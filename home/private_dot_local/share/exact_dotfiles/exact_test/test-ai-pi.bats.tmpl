# bats test_tags=toolchain:pi,kind:launcher
@test "agent pi --profile selects in both positions, prompts reach pi verbatim" {
  local mock="$BATS_TEST_TMPDIR/bin"
  mkdir -p "$mock"
  setup_mock_bins "$mock" curl nc nono
  cat >"$mock/pi" <<'EOF'
#!/usr/bin/env sh
echo "PROFILE=${PI_CODING_AGENT_DIR:-unset}"
echo "ARGS=$*"
EOF
  chmod +x "$mock/pi"

  # Pre-name and post-name flag forms select the profile; the quoted prompt
  # is the binary's entire argv (the R6 prompt-safety headline).
  run env $(scratch_env) PATH="$mock:$PATH" "$HOME/.local/bin/agent" --profile core pi "Hi there"
  assert_success
  assert_output --partial "PROFILE=$HOME/.config/pi/profiles/core"
  assert_output --partial "ARGS=Hi there"
  run env $(scratch_env) PATH="$mock:$PATH" "$HOME/.local/bin/agent" pi --profile core "Hi there"
  assert_success
  assert_output --partial "PROFILE=$HOME/.config/pi/profiles/core"
  assert_output --partial "ARGS=Hi there"

  # Unknown names die; after `--` flags and profile words reach pi verbatim.
  run env $(scratch_env) PATH="$mock:$PATH" "$HOME/.local/bin/agent" pi --profile bogus
  assert_failure
  assert_output --partial "Unknown profile: bogus"
  run env $(scratch_env) PATH="$mock:$PATH" "$HOME/.local/bin/agent" pi --profile core -- --weird-flag x
  assert_success
  assert_output --partial "ARGS=--weird-flag x"
  run env $(scratch_env) PATH="$mock:$PATH" "$HOME/.local/bin/agent" pi -- factory
  assert_success
  assert_output --partial "ARGS=factory"
  refute_output --partial "profiles/core"
}

# bats test_tags=toolchain:pi,kind:launcher
@test "agent pi --print-env takes --profile, seeds from pre-name, dies on typos" {
  launcher_probe pi --print-env --profile minimal
  assert_output --partial 'PI_CODING_AGENT_DIR="/fixture-home/.config/pi/agent"'
  launcher_probe pi --print-env --profile=core
  assert_output --partial 'PI_CODING_AGENT_DIR="/fixture-home/.config/pi/profiles/core"'
  run env HOME=/fixture-home XDG_CONFIG_HOME=/fixture-home/.config \
    "$HOME/.local/bin/agent" --profile core pi --print-env
  assert_success
  assert_output --partial 'PI_CODING_AGENT_DIR="/fixture-home/.config/pi/profiles/core"'
  # Flag-shaped garbage fails loudly: nonzero, names the arg, no env printed.
  run "$HOME/.local/bin/agent" pi --print-env --typo
  assert_failure
  assert_output --partial "unknown argument --typo"
  refute_output --partial "ENGRAM_URL"
}

