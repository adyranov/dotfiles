#!/usr/bin/env sh
# Universal launcher for sandboxed AI coding agents.
# Invoked via symlinks: pi-agent → agent-launch, opencode-agent → agent-launch.
# Agent identity is derived from argv[0] (basename of the symlink).
set -eu

# ── Agent identity ──
SELF=$(basename "$0")
case "$SELF" in
  pi-agent)
    AGENT_NAME="pi"
    BINARY_NAME="pi"
    GREYWALL_PROFILE="pi"
    CONFIG_SUBDIR="pi"
    ;;
  opencode-agent)
    AGENT_NAME="opencode"
    BINARY_NAME="opencode"
    GREYWALL_PROFILE="opencode"
    CONFIG_SUBDIR="opencode"
    ;;
  omp-agent)
    AGENT_NAME="omp"
    BINARY_NAME="omp"
    GREYWALL_PROFILE="omp"
    CONFIG_SUBDIR="omp"
    ;;
  agent-launch)
    printf 'Error: call via a symlink (pi-agent, opencode-agent, omp-agent), not directly.\n' >&2
    exit 1
    ;;
  *)
    printf 'Error: unknown agent identity "%s".\n' "$SELF" >&2
    exit 1
    ;;
esac

# ── Common paths ──
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
GREYPROXY_STATE="${XDG_STATE_HOME:-$HOME/.local/state}/greyproxy"
GREYPROXY_LOG="$GREYPROXY_STATE/greyproxy.log"
ENGRAM_STATE="${XDG_STATE_HOME:-$HOME/.local/state}/engram"
ENGRAM_LOG="$ENGRAM_STATE/engram.log"
GREYPROXY_API_PORT={{ index .ai.base.sandbox.greyproxy "api" }}

# ── Colors ──
if [ -t 2 ] && [ -z "${NO_COLOR:-}" ] && command -v tput >/dev/null 2>&1; then
  _BO=$(tput bold)    _DI=$(tput dim)
  _RE=$(tput setaf 1) _GR=$(tput setaf 2) _YE=$(tput setaf 3)
  _BL=$(tput setaf 4) _CY=$(tput setaf 6) _NO=$(tput sgr0)
else
  _BO='' _DI='' _RE='' _GR='' _YE='' _BL='' _CY='' _NO=''
fi

info()   { printf '%s  %s\n' "${_CY}•${_NO}" "$*" >&2; }
ok()     { printf '%s  %s\n' "${_GR}✓${_NO}" "$*" >&2; }
warn()   { printf '%s  %s\n' "${_YE}⚠${_NO}" "$*" >&2; }
die()    { printf '%s  %s\n' "${_RE}✗${_NO}" "$*" >&2; exit 1; }
dim()    { printf '   %s%s%s\n' "${_DI}" "$*" "${_NO}" >&2; }

# ── Agent-specific: profile directory ──
profile_dir() {
  case "$AGENT_NAME" in
    pi)
      case "$1" in
        core|default) printf '%s\n' "$CONFIG_HOME/pi/profiles/core" ;;
        factory)      printf '%s\n' "$CONFIG_HOME/pi/profiles/factory" ;;
        minimal)      printf '%s\n' "$CONFIG_HOME/pi/agent" ;;
        *)            die "Unknown profile: $1" ;;
      esac
      ;;
    opencode)
      case "$1" in
        core|default) printf '%s\n' "$CONFIG_HOME/opencode/profiles/core" ;;
        factory)      printf '%s\n' "$CONFIG_HOME/opencode/profiles/factory" ;;
        minimal)      printf '%s\n' "$CONFIG_HOME/opencode" ;;
        *)            die "Unknown profile: $1" ;;
      esac
      ;;
    omp)
      # OMP uses PI_CODING_AGENT_DIR as the single config root (no named profile).
      # Config is canonical at $HOME/.config/omp (not XDG-relative).
      printf '%s\n' "$HOME/.config/omp"
      ;;
  esac
}

# ── Helper: pick ephemeral high port (49152-65535) ──
pick_high_port() {
  awk 'BEGIN{srand();print int(rand()*16384)+49152}'
}

# ── Agent-specific: export env for profile ──
print_env() {
  profile="${1:-core}"
  dir=$(profile_dir "$profile")
  case "$AGENT_NAME" in
    pi)
      printf 'export PI_CODING_AGENT_DIR="%s"\n' "$dir"
      printf 'export PI_CODING_AGENT_SESSION_DIR="%s/sessions"\n' "$dir"
      ;;
    opencode)
      printf 'export OPENCODE_CONFIG="%s/opencode.json"\n' "$dir"
      printf 'export OPENCODE_CONFIG_DIR="%s"\n' "$dir"
      if [ "$profile" = "factory" ]; then
        printf 'export OPENCODE_EXPERIMENTAL_BACKGROUND_SUBAGENTS=true\n'
        printf 'export OPENCODE_PORT="%s"\n' "${OPENCODE_PORT:-$(pick_high_port)}"
      fi
      ;;
    omp)
      printf "# OMP env — canonical config root, no named profile\n"
      printf "# Scrub inherited Pi, OpenCode, and OMP vars\n"
      printf "for __v in \$(env | awk -F= '/^(PI_|OPENCODE_)/ { print \$1 }'); do unset \"\$__v\"; done 2>/dev/null || :\n"
      printf "unset OMP_PROFILE\n"
      printf 'export PI_CODING_AGENT_DIR="%s"\n' "$HOME/.config/omp"
      ;;
  esac
  if [ "$AGENT_NAME" != "omp" ]; then
    printf 'export ENGRAM_DATA_DIR="%s"\n' "${ENGRAM_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/engram}"
    printf 'export ENGRAM_PORT="%s"\n' "${ENGRAM_PORT:-7437}"
    printf 'export ENGRAM_URL="http://127.0.0.1:%s"\n' "${ENGRAM_PORT:-7437}"
  fi
}

# ── Agent-specific: preflight update ──
preflight_update() {
  dir="$1"
  case "$AGENT_NAME" in
    pi)
      info "Extensions: updating..."
      if pi update --extensions; then
        ok "Extensions: updated"
      else
        warn "Extensions: update failed; continuing"
      fi
      ;;
    opencode)
      config_file="$dir/opencode.json"
      [ -f "$config_file" ] || return 0
      command -v jq >/dev/null 2>&1 || return 0
      plugins=$(jq -r '.plugin[] | (if type == "string" then . else .[0] end)' "$config_file" 2>/dev/null) || return 0
      missing=0
      for plugin in $plugins; do
        # Skip local file plugins — no npm cache
        case $plugin in
          ./*|../*|file://*) continue ;;
        esac
        case "${plugin##*/}" in
          *@*) cache_dir="$CACHE_HOME/opencode/packages/${plugin}" ;;
          *)   cache_dir="$CACHE_HOME/opencode/packages/${plugin}@latest" ;;
        esac
        if [ ! -f "$cache_dir/package.json" ]; then
          warn "Plugin cache: $plugin (not installed)"
          missing=$((missing + 1))
        fi
      done
      if [ "$missing" -gt 0 ]; then
        warn "Plugins: $missing uncached (normal; opencode-agent factory startup resolves packages)"
      else
        ok "Plugins: cached"
      fi
      ;;
    omp)
      # OMP is a standalone compiled binary; no preflight needed.
      # Extensions disabled via config and --no-extensions flag.
      ok "Binary: standalone (no preflight needed)"
      ;;
  esac
}

# ── Agent-specific: set runtime env ──
set_runtime_env() {
  dir="$1"
  profile="${2:-core}"
  case "$AGENT_NAME" in
    pi)
      sdir="${dir}/sessions"
      export PI_CODING_AGENT_DIR="$dir"
      export PI_CODING_AGENT_SESSION_DIR="$sdir"
      dim "Config dir: $dir"
      dim "Sessions:   $sdir"
      ;;
    opencode)
      export OPENCODE_CONFIG="$dir/opencode.json"
      export OPENCODE_CONFIG_DIR="$dir"
      if [ "$profile" = "factory" ]; then
        export OPENCODE_EXPERIMENTAL_BACKGROUND_SUBAGENTS=true
        export OPENCODE_PORT="${OPENCODE_PORT:-$(pick_high_port)}"
        dim "Background subagents: enabled"
        dim "OpenCode port: $OPENCODE_PORT"
      fi
      dim "Config:  $dir"
      ;;
    omp)
      # Scrub all inherited vars that could redirect OMP to Pi/OpenCode state
      for _v in $(env | awk -F= '/^(PI_|OPENCODE_)/ { print $1 }'); do
        unset "$_v"
      done
      unset OMP_PROFILE
      # Canonical OMP config root at $HOME/.config/omp
      export PI_CODING_AGENT_DIR="$dir"
      dim "Config:  $dir"
      ;;
  esac
}

# ── Agent-specific: usage ──
usage() {
  case "$AGENT_NAME" in
    pi)
      cat <<'EOF'
Usage: pi-agent [profile] [--no-greywall] [--no-update] [pi args...]
       pi-agent [profile] [--no-greywall] [--no-update] -- [pi args...]
       pi-agent --list
       pi-agent --print-env [profile]

Profiles:
  core                daily driver (Pi with Plannotator, permission system, catppuccin)
  factory             full rpiv-pi factory stack
  minimal             stripped stack (no Plannotator, no MCP servers, no subagents)

Options:
  --no-greywall       run pi directly without greywall sandbox
  --no-update         skip pi extension update before launch

Args:
  pi args             forwarded to pi, for example to continue a session

Commands:
  --list              list available profiles
  --print-env [prof]  print env vars for profile
EOF
      ;;
    opencode)
      cat <<'EOF'
Usage: opencode-agent [profile] [--no-greywall] [--no-update] [opencode args...]
       opencode-agent [profile] [--no-greywall] [--no-update] -- [opencode args...]
       opencode-agent --list
       opencode-agent --print-env [profile]

Profiles:
  core                daily driver (default OpenCode config)
  factory             slim multi-agent with background orchestration, worktrees
  minimal             lightweight stack (no plugins, no subagents)

Options:
  --no-greywall       run opencode directly without greywall sandbox
  --no-update         skip dependency preflight check

Args:
  opencode args       forwarded to opencode, for example to continue a session

Commands:
  --list              list available profiles
  --print-env [prof]  print env vars for profile
EOF
      ;;
    omp)
      cat <<'EOF'
Usage: omp-agent [omp args...]
       omp-agent --print-env [profile]
       omp-agent --help

Configuration:
  Managed config root at $HOME/.config/omp (canonical, not XDG-relative).
  PI_CODING_AGENT_DIR is set to this root; no named profile is active.
  --profile, --alias, and Pi profile names are rejected.
  Sandbox via greywall is mandatory — no --no-greywall bypass.

Safety:
  Scrubs inherited PI_*, OPENCODE_*, and OMP_PROFILE env vars.
  Sets only PI_CODING_AGENT_DIR for OMP.
  Injects managed --config <security.yml> and --no-extensions with precedence.
  Rejects extension/plugin injection flags and management subcommands.
  Fails closed: requires readable $HOME/.config/omp/security.yml.

Args:
  omp args            forwarded to omp

Commands:
  --print-env [prof]  print env vars for the config root
  --help              this message
EOF
      ;;
  esac
  exit 0
}

# ── Shared: profile list ──
list_profiles() {
  case "$AGENT_NAME" in
    omp)
      printf 'OMP uses a single configuration root (no named profiles).\n'
      ;;
    *)
      printf '%s\n' core factory minimal
      ;;
  esac
}

# ── Shared: PWD guard ──
pwd_guard() {
  case "$(pwd)" in
    "$HOME")
      die "Refusing to launch from home directory: $(pwd)
   Launch from a project directory inside a git worktree."
      ;;
    "/")
      die "Refusing to launch from root: $(pwd)
   Launch from a project directory inside a git worktree."
      ;;
  esac
  if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    die "Not inside a git worktree.
   Launch from a project directory inside a git worktree."
  fi
}

# ── Shared: greyproxy ──
greyproxy_ready() {
  command -v nc >/dev/null 2>&1 || return 1
  command -v curl >/dev/null 2>&1 || return 1
  # Check API, then all three proxy services: SOCKS, HTTP, DNS
  curl --silent --show-error --fail --max-time 1 \
    "http://127.0.0.1:${GREYPROXY_API_PORT}/api/health" >/dev/null 2>&1 || return 1
  nc -z 127.0.0.1 {{ (index .ai.base.sandbox.greyproxy "socks") }} 2>/dev/null || return 1
  nc -z 127.0.0.1 {{ (index .ai.base.sandbox.greyproxy "http") }} 2>/dev/null || return 1
  nc -z 127.0.0.1 {{ (index .ai.base.sandbox.greyproxy "dns") }} 2>/dev/null || return 1
  # Binary must report a version
  command -v greyproxy >/dev/null 2>&1 || return 1
  greyproxy --version 2>/dev/null | head -1 | grep -q 'greyproxy' || return 1
  return 0
}

ensure_greyproxy() {
  info "Sandbox: checking greyproxy..."

  if greyproxy_ready; then
    ok "Sandbox: greyproxy ready"
    return 0
  fi

  command -v greywall  >/dev/null 2>&1 || die "greywall not found on PATH"
  command -v greyproxy >/dev/null 2>&1 || die "greyproxy not found on PATH"

  info "Sandbox: starting greyproxy..."
  mkdir -p "$GREYPROXY_STATE"
  dim "Log: $GREYPROXY_LOG"
  nohup greyproxy serve >>"$GREYPROXY_LOG" 2>&1 &
  pid=$!
  dim "PID: $pid"

  attempts=0
  max_attempts=15
  while [ "$attempts" -lt "$max_attempts" ]; do
    if greyproxy_ready; then
      ok "Sandbox: greyproxy ready"
      return 0
    fi
    sleep 1
    attempts=$((attempts + 1))
  done

  die "greyproxy did not become ready (see $GREYPROXY_LOG)"
}

sync_permanent_rules() {
  # Read network rules from rendered greywall.json and push as permanent rules
  # to greyproxy. This ensures hosts survive session expiry (temporary rules
  # expire after ttl_seconds; permanent rules persist in SQLite).
  local config dest api
  config="${XDG_CONFIG_HOME:-$HOME/.config}/greywall/greywall.json"
  [ -f "$config" ] || { warn "$config not found, skipping rule sync"; return 0; }

  command -v jq >/dev/null 2>&1 || { warn "jq not found, skipping rule sync"; return 0; }

  api="http://127.0.0.1:${GREYPROXY_API_PORT}/api/rules"
  info "Greyproxy: syncing permanent rules..."

  # Use container_pattern '*' so rules apply to all agents (pi, opencode, omp)
  # rather than being scoped to a single binary name.
  jq -r '.network.rules[]?.destination // empty' "$config" 2>/dev/null \
    | sort -u \
    | while read -r dest; do
        [ -z "$dest" ] && continue
        curl -s -X POST "$api" \
          -H 'Content-Type: application/json' \
          -d "{\"destination_pattern\":\"$dest\",\"port_pattern\":\"443\",\"rule_type\":\"permanent\",\"container_pattern\":\"*\"}" \
          >/dev/null 2>&1
      done

  ok "Greyproxy: permanent rules synced"
}

# ── Shared: engram daemon ──
engram_ready() {
  curl --silent --fail --max-time 1 \
    "${ENGRAM_URL}/health" >/dev/null 2>&1
}

ensure_engram() {
  [ "$profile" = "minimal" ] && return 0

  command -v engram >/dev/null 2>&1 || die "engram not found on PATH"
  command -v curl >/dev/null 2>&1 || die "curl not found (needed for engram health check)"

  info "Engram: checking..."

  if engram_ready; then
    ok "Engram: daemon ready"
    return 0
  fi

  info "Engram: starting daemon..."
  mkdir -p "$ENGRAM_STATE"
  dim "Log: $ENGRAM_LOG"
  mkdir -p "$ENGRAM_DATA_DIR"
  nohup engram serve "$ENGRAM_PORT" >>"$ENGRAM_LOG" 2>&1 &
  pid=$!
  dim "PID: $pid"

  attempts=0
  max_attempts=10
  while [ "$attempts" -lt "$max_attempts" ]; do
    if engram_ready; then
      ok "Engram: daemon ready"
      return 0
    fi
    sleep 1
    attempts=$((attempts + 1))
  done

  die "Engram daemon did not become ready (see $ENGRAM_LOG)"
}

# ── Dispatch: subcommands ──
case "${1:-}" in
  --help|-h)
    usage
    ;;
  --list)
    list_profiles
    exit 0
    ;;
  --print-env)
    profile="${2:-}"
    case "$profile" in ""|-*) profile="core" ;; esac
    print_env "$profile"
    exit 0
    ;;
esac

# ── Dispatch: option parsing ──
no_greywall=false
no_update=false
if [ "$AGENT_NAME" = "omp" ]; then
  profile="default"
else
  profile="core"
fi

while [ $# -gt 0 ]; do
  case "$1" in
    --) shift; break ;;
    --no-greywall)
      if [ "$AGENT_NAME" = "omp" ]; then
        die "OMP: --no-greywall rejected (sandbox is mandatory)"
      fi
      no_greywall=true; shift ;;
    --no-update) no_update=true; shift ;;
    core|default|factory|minimal)
      if [ "$AGENT_NAME" = "omp" ]; then
        die "OMP: profile '$1' rejected (single config root, no named profiles)"
      fi
      profile="$1"
      shift
      ;;
    *) break ;;
  esac
done

# OMP: reject unsafe overrides, management subcommands, enforce single config root
if [ "$AGENT_NAME" = "omp" ]; then
  # Reject CLI overrides in remaining args
  for _arg do
    case "$_arg" in
      --profile|--profile=*)
        die "OMP: --profile rejected (single config root, no named profiles)" ;;
      --yolo|--auto-approve|--plan-yolo)
        die "OMP: unsafe approval flag '$_arg' rejected" ;;
      --config|--config=*)
        die "OMP: --config overlay rejected (config is managed)" ;;
      --approval-mode|--approval-mode=*)
        die "OMP: --approval-mode override rejected" ;;
      --api-key|--api-key=*)
        die "OMP: --api-key rejected (use interactive authentication)" ;;
      --alias|--alias=*)
        die "OMP: --alias requires --profile; both rejected" ;;
      -e|--extension|--extension=*)
        die "OMP: extension injection flag '$_arg' rejected (extensions managed via security.yml)" ;;
      --hook|--hook=*)
        die "OMP: hook injection flag '$_arg' rejected (hooks managed via security.yml)" ;;
      --plugin-dir|--plugin-dir=*)
        die "OMP: plugin dir flag '$_arg' rejected (plugins managed via security.yml)" ;;
    esac
  done
  unset _arg

  # Reject management subcommands that cannot safely receive injected --config/--no-extensions
  for _cmd do
    case "$_cmd" in
      init|setup|install|completion|doctor|update|manage|system|migrate|reset|uninstall)
        die "OMP: management subcommand '$_cmd' rejected (use binary directly, not omp-agent)" ;;
    esac
    break  # only check first positional arg
  done
  unset _cmd

  profile="default"
fi

# Factory OpenCode: keep --port and OPENCODE_PORT aligned for oh-my-opencode-slim
if [ "$AGENT_NAME" = "opencode" ] && [ "$profile" = "factory" ]; then
  _port=""
  _next_is_port=false
  for _arg; do
    if [ "$_next_is_port" = true ]; then
      _port="$_arg"
      _next_is_port=false
      break
    fi
    case "$_arg" in
      --port=*) _port="${_arg#--port=}"; break ;;
      --port) _next_is_port=true ;;
    esac
  done
  [ "$_next_is_port" = false ] || die "--port requires a value"
  if [ -n "$_port" ]; then
    case "$_port" in
      *[!0-9]*|'') die "--port must be a positive integer" ;;
      0) die "--port must be greater than 0" ;;
    esac
    export OPENCODE_PORT="$_port"
  else
    export OPENCODE_PORT="${OPENCODE_PORT:-$(pick_high_port)}"
    set -- --port "$OPENCODE_PORT" "$@"
  fi
  unset _port _next_is_port _arg
fi

# OMP: inject managed flags with precedence; fail closed on missing security
if [ "$AGENT_NAME" = "omp" ]; then
  _omp_security="$HOME/.config/omp/security.yml"
  if [ ! -r "$_omp_security" ]; then
    die "OMP: required security config not found or not readable: $_omp_security"
  fi
  # Inject managed flags after remaining user args so they take precedence
  set -- "$@" --no-extensions --config "$_omp_security"
  unset _omp_security
fi

# ── Launch ──
pwd_guard

dir=$(profile_dir "$profile")
set_runtime_env "$dir" "$profile"

info "Profile: ${_BO}${profile}${_NO}"

if [ "$no_update" = false ]; then
  preflight_update "$dir"
fi

if [ "$no_greywall" = true ]; then
  ok "Sandbox: disabled (--no-greywall)"
  exec "$BINARY_NAME" "$@"
fi

# Engram daemon must start before proxy env is set — its curl health-check
# must reach localhost directly, not through the (not-yet-running) greyproxy.
# OMP uses its own hindsight memory; skip shared Engram.
if [ "$AGENT_NAME" != "omp" ]; then
  ensure_engram
fi

# ── Proxy / CA env (force all agent traffic through Greyproxy) ──
export HTTP_PROXY="http://127.0.0.1:43051"
export HTTPS_PROXY="http://127.0.0.1:43051"
export ALL_PROXY="socks5://127.0.0.1:43052"
export NO_PROXY="127.0.0.1,localhost"
export NODE_USE_ENV_PROXY="1"
_CA="$HOME/.config/certificates/ca-bundle.pem"
if [ -f "$_CA" ]; then
  export SSL_CERT_FILE="$_CA"
  export REQUESTS_CA_BUNDLE="$_CA"
  export CURL_CA_BUNDLE="$_CA"
  export NODE_EXTRA_CA_CERTS="$_CA"
fi
unset _CA

ensure_greyproxy
sync_permanent_rules

dim "Launch: greywall --profile $GREYWALL_PROFILE -- $BINARY_NAME ..."
exec greywall --profile "$GREYWALL_PROFILE" -- "$BINARY_NAME" "$@"
