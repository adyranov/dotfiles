#!/usr/bin/env sh
# llm-bench — Benchmark local LLMs using native engine tools (no server required).
set -eu

CONFIG_FILE="${LOCAL_LLM_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/local-llm/config.json}"
command -v jq >/dev/null 2>&1 || {
  echo "llm-bench: jq not found on PATH" >&2
  exit 1
}
[ -f "$CONFIG_FILE" ] || {
  echo "llm-bench: config not found: $CONFIG_FILE (run chezmoi apply)" >&2
  exit 1
}

ENGINE="$(jq -r '.engine // "llamacpp"' "$CONFIG_FILE")"
RUNS="${LLM_BENCH_RUNS:-3}"
MAX_TOKENS="${LLM_BENCH_MAX_TOKENS:-512}"
INPUT_TOKENS="${LLM_BENCH_INPUT_TOKENS:-512}"
SEED="${LLM_BENCH_SEED:-12345}"
OMLX_BENCH_WARMUP_RUNS="${LLM_BENCH_OMLX_WARMUP_RUNS:-$(jq -r '.omlx_bench_warmup_runs // 1' "$CONFIG_FILE")}"
OMLX_BENCH_EXTRA_ARGS="${LLM_BENCH_OMLX_EXTRA_ARGS:-$(jq -r '.omlx_bench_extra_args // ""' "$CONFIG_FILE")}"
MODEL_DIR="${OMLX_MODEL_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/omlx/models}"
HF_CACHE="${HF_HUB_CACHE:-${HF_HOME:+$HF_HOME/hub}}"
HF_CACHE="${HF_CACHE:-${XDG_DATA_HOME:-$HOME/.local/share}/huggingface/hub}"
export HF_HUB_CACHE="$HF_CACHE"
SUMMARY_FILE="$(mktemp "${TMPDIR:-/tmp}/llm-bench-summary.XXXXXX")"
BENCH_ERR_FILE=""

cleanup() { rm -f "$SUMMARY_FILE" ${BENCH_ERR_FILE:+"$BENCH_ERR_FILE"}; }
trap cleanup EXIT
trap 'cleanup; exit 130' HUP INT TERM

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  B=$(printf '\033[1m')
  D=$(printf '\033[2m')
  R=$(printf '\033[0m')
  G=$(printf '\033[32m')
  Y=$(printf '\033[33m')
  C=$(printf '\033[36m')
  E=$(printf '\033[31m')
else
  B=''
  D=''
  R=''
  G=''
  Y=''
  C=''
  E=''
fi

usage() {
  sample_model="$(jq -r '.models[0].id // "model-id"' "$CONFIG_FILE")"
  cat <<EOF
${B}Usage:${R} llm-bench [model ...]

Benchmark local LLMs using native engine tools (no server required).
Backend: ${ENGINE} (configured in ${CONFIG_FILE})
Metrics: prompt-processing (pp) and text-generation (tg) tokens per second.

With no model args, benchmarks every configured local model.

${B}Environment:${R}
  LLM_BENCH_RUNS             repetitions per model (default: 3)
  LLM_BENCH_INPUT_TOKENS     prompt token target (default: 512)
  LLM_BENCH_MAX_TOKENS       output tokens (default: 512)
  LLM_BENCH_SEED             PRNG seed for repeatable mlx_lm runs (default: 12345)
  LLM_BENCH_OMLX_WARMUP_RUNS warmup passes before timed runs (default: ${OMLX_BENCH_WARMUP_RUNS})
  LLM_BENCH_OMLX_EXTRA_ARGS  extra flags appended to mlx_lm generate

${B}Examples:${R}
  llm-bench
  llm-bench ${sample_model}
EOF
}

log() { printf '%s%s%s\n' "$B$C" "$*" "$R"; }
info() { printf '  %s%s%s\n' "$D" "$*" "$R"; }
warn() { printf '%s⚠ %s%s\n' "$Y" "$*" "$R" >&2; }
die() {
  printf '%s✗ %s%s\n' "$E" "$*" "$R" >&2
  exit 1
}
need() { command -v "$1" >/dev/null 2>&1 || die "$1 not found on PATH"; }

elapsed() {
  _dur=$(($(date +%s) - $1))
  if [ "$_dur" -ge 60 ]; then
    printf '%dm%ds' $((_dur / 60)) $((_dur % 60))
  else
    printf '%ds' "$_dur"
  fi
}

find_omlx_py() (
  _prefix="$(brew --prefix omlx 2>/dev/null || true)"
  if [ -n "$_prefix" ] && [ -d "$_prefix" ]; then
    _py="${_prefix}/libexec/bin/python3"
    if [ -x "$_py" ] && "$_py" -c 'import mlx_lm' >/dev/null 2>&1; then
      printf '%s' "$_py"
      return 0
    fi
    for _py in "${_prefix}/libexec/bin"/python3*; do
      case "$_py" in
      *-config) continue ;;
      esac
      if [ -x "$_py" ] && "$_py" -c 'import mlx_lm' >/dev/null 2>&1; then
        printf '%s' "$_py"
        return 0
      fi
    done
  fi
  for _py in python3 python; do
    if command -v "$_py" >/dev/null 2>&1 && "$_py" -c 'import mlx_lm' >/dev/null 2>&1; then
      printf '%s' "$_py"
      return 0
    fi
  done
  return 1
)

run_mlx() {
  # shellcheck disable=SC2086
  "$OMLX_PY" -m mlx_lm generate \
    --model "$1" \
    --prompt "$2" \
    --max-tokens "$3" \
    --temp 0 \
    --seed "$SEED" \
    --verbose "$4" \
    $OMLX_BENCH_EXTRA_ARGS 2>&1
}

bench_model_omlx() {
  model="$1"
  model_path="${MODEL_DIR}/${model}"
  [ -e "$model_path" ] || {
    warn "not found: ${model_path} (run llm-pull?)"
    return 1
  }

  log "Benchmarking ${model}"
  info "model: ${model_path}"
  info "output: ${MAX_TOKENS} tokens · runs: ${RUNS}"

  warm_i=0
  printf '  %swarming up (%s pass) ...%s ' "$D" "$OMLX_BENCH_WARMUP_RUNS" "$R"
  while [ "$warm_i" -lt "$OMLX_BENCH_WARMUP_RUNS" ]; do
    warm_i=$((warm_i + 1))
    if ! run_mlx "$model_path" "$BENCH_PROMPT" 8 false >/dev/null 2>&1; then
      printf '%s✗ failed — skipping%s\n' "$E" "$R"
      return 1
    fi
  done
  printf '%s✓%s\n' "$G" "$R"

  pp_sum=0
  pp_sq_sum=0
  tg_sum=0
  tg_sq_sum=0
  n=0
  i=0
  prompt_tokens_ref=""
  while [ "$i" -lt "$RUNS" ]; do
    i=$((i + 1))
    if [ "$RUNS" -gt 1 ]; then printf '  run %s/%s ... ' "$i" "$RUNS"; else printf '  running ... '; fi
    bench_out=""
    bench_exit=0
    bench_out="$(run_mlx "$model_path" "$BENCH_PROMPT" "$MAX_TOKENS" true)" || bench_exit=$?
    if [ "$bench_exit" -ne 0 ]; then
      printf '%s✗ exit %s%s\n' "$E" "$bench_exit" "$R"
      printf '%s\n' "$bench_out" >&2
      continue
    fi
    run_pp="$(printf '%s' "$bench_out" | awk '/^Prompt:/ && /tokens-per-sec/ {print $(NF-1); exit}')"
    run_tg="$(printf '%s' "$bench_out" | awk '/^Generation:/ && /tokens-per-sec/ {print $(NF-1); exit}')"
    run_prompt_tokens="$(printf '%s' "$bench_out" | awk '/^Prompt:/ {for (i = 1; i <= NF; i++) if ($i ~ /^[0-9]+$/) {print $i; exit}}')"
    if [ -z "$run_pp" ] || [ -z "$run_tg" ]; then
      printf '%s✗ no metrics in output%s\n' "$E" "$R"
      printf '%s\n' "$bench_out" >&2
      continue
    fi
    if [ -z "$run_prompt_tokens" ]; then
      printf '%s%s pp  %s tg  (t/s)%s\n' "$G" "$run_pp" "$run_tg" "$R"
    else
      printf '%s%s pp  %s tg  (t/s, prompt=%s tok)%s\n' "$G" "$run_pp" "$run_tg" "$run_prompt_tokens" "$R"
      if [ -z "$prompt_tokens_ref" ]; then
        prompt_tokens_ref="$run_prompt_tokens"
      elif [ "$prompt_tokens_ref" != "$run_prompt_tokens" ]; then
        warn "prompt token count changed across runs: ${prompt_tokens_ref} -> ${run_prompt_tokens}"
      fi
    fi
    pp_sum="$(awk "BEGIN{printf \"%.2f\", $pp_sum + $run_pp}")"
    pp_sq_sum="$(awk "BEGIN{printf \"%.4f\", $pp_sq_sum + ($run_pp * $run_pp)}")"
    tg_sum="$(awk "BEGIN{printf \"%.2f\", $tg_sum + $run_tg}")"
    tg_sq_sum="$(awk "BEGIN{printf \"%.4f\", $tg_sq_sum + ($run_tg * $run_tg)}")"
    n=$((n + 1))
  done

  if [ "$n" -eq 0 ]; then
    warn "all runs failed for ${model}"
    return 1
  fi
  pp_avg="$(awk "BEGIN{printf \"%.1f\", $pp_sum / $n}")"
  pp_std="$(awk "BEGIN{if ($n <= 1) { printf \"%.1f\", 0; } else { mean = $pp_sum / $n; var = ($pp_sq_sum - $n * mean * mean) / ($n - 1); if (var < 0) var = 0; printf \"%.1f\", sqrt(var); }}")"
  tg_avg="$(awk "BEGIN{printf \"%.1f\", $tg_sum / $n}")"
  tg_std="$(awk "BEGIN{if ($n <= 1) { printf \"%.1f\", 0; } else { mean = $tg_sum / $n; var = ($tg_sq_sum - $n * mean * mean) / ($n - 1); if (var < 0) var = 0; printf \"%.1f\", sqrt(var); }}")"
  printf '%s\t%s\t%s\t%s\t%s\n' "$model" "$pp_avg" "$pp_std" "$tg_avg" "$tg_std" >>"$SUMMARY_FILE"
}

resolve_gguf() {
  repo="$(jq -r --arg id "$1" '.models[] | select(.id == $id) | .gguf.repo // empty' "$CONFIG_FILE")"
  file="$(jq -r --arg id "$1" '.models[] | select(.id == $id) | .gguf.file // ""' "$CONFIG_FILE")"
  if [ -z "$repo" ]; then
    warn "model '${1}' has no gguf backend in ${CONFIG_FILE}"
    return 1
  fi
  if [ -n "$file" ]; then
    HF_HUB_OFFLINE=1 hf download --quiet "$repo" "$file"
  else
    HF_HUB_OFFLINE=1 hf download --quiet "$repo"
  fi
}

bench_model_llamacpp() {
  model="$1"
  log "Benchmarking ${model}"
  model_path="$(resolve_gguf "$model")" || return 1
  info "model: ${model_path}"
  info "pp=${INPUT_TOKENS} tg=${MAX_TOKENS} reps=${RUNS}"

  BENCH_ERR_FILE="$(mktemp "${TMPDIR:-/tmp}/llm-bench-err.XXXXXX")"
  bench_out="$(llama-bench \
    -m "$model_path" \
    -ctk q8_0 -ctv q8_0 \
    -p "$INPUT_TOKENS" \
    -n "$MAX_TOKENS" \
    -r "$RUNS" \
    -o json 2>"$BENCH_ERR_FILE")" || {
    warn "llama-bench failed for ${model}"
    [ -s "$BENCH_ERR_FILE" ] && cat "$BENCH_ERR_FILE" >&2
    rm -f "$BENCH_ERR_FILE"
    BENCH_ERR_FILE=""
    return 1
  }
  rm -f "$BENCH_ERR_FILE"
  BENCH_ERR_FILE=""

  pp_tps="$(printf '%s' "$bench_out" | jq -r 'map(select(.n_prompt > 0)) | first | .avg_ts    // 0')"
  pp_std="$(printf '%s' "$bench_out" | jq -r 'map(select(.n_prompt > 0)) | first | .stddev_ts // 0')"
  tg_tps="$(printf '%s' "$bench_out" | jq -r 'map(select(.n_gen   > 0)) | first | .avg_ts    // 0')"
  tg_std="$(printf '%s' "$bench_out" | jq -r 'map(select(.n_gen   > 0)) | first | .stddev_ts // 0')"

  if [ "$(awk "BEGIN{print ($pp_tps > 0 || $tg_tps > 0)}")" = "1" ]; then
    printf '%s\t%s\t%s\t%s\t%s\n' "$model" "$pp_tps" "$pp_std" "$tg_tps" "$tg_std" >>"$SUMMARY_FILE"
    printf '  %spp: %s ± %s t/s  │  tg: %s ± %s t/s%s\n' \
      "$G" "$pp_tps" "$pp_std" "$tg_tps" "$tg_std" "$R"
  else
    warn "llama-bench returned no metrics for ${model}"
    return 1
  fi
}

print_summary() {
  [ -s "$SUMMARY_FILE" ] || return 0
  printf '\n'
  log "Summary (sorted by tg t/s)"
  printf '%s' "$D"
  sort -t "$(printf '\t')" -k4,4nr "$SUMMARY_FILE" |
    awk -F '\t' '
      BEGIN {
        printf "  %-24s  %9s  %8s  %9s  %8s\n", "MODEL", "PP t/s", "PP +/-", "TG t/s", "TG +/-"
        printf "  ------------------------  ---------  --------  ---------  --------\n"
      }
      {
        printf "  %-24s  %9.1f  %8.1f  %9.1f  %8.1f\n", $1, $2, $3, $4, $5
      }
    '
  printf '%s' "$R"
}

case "${1:-}" in
-h | --help)
  usage
  exit 0
  ;;
esac

if [ "$ENGINE" = "omlx" ]; then
  OMLX_PY="$(find_omlx_py)" || die "mlx_lm not found (no omlx libexec or system Python with mlx_lm)"
  BENCH_SENTENCE="The quick brown fox jumps over the lazy dog near the riverbank. "
  BENCH_REPEATS="$(awk "BEGIN{r = int($INPUT_TOKENS / 13) + 4; print r}")"
  BENCH_PROMPT="$(awk -v s="$BENCH_SENTENCE" -v n="$BENCH_REPEATS" 'BEGIN{for(i=0;i<n;i++) printf "%s", s}')"
else
  need hf
  need llama-bench
fi

if [ "$#" -gt 0 ]; then
  MODELS="$*"
else
  MODELS="$(jq -r '.models[].id' "$CONFIG_FILE" | sort)"
fi

log "Local LLM benchmark"
if [ "$ENGINE" = "omlx" ]; then
  info "backend:   omlx (mlx_lm generate --verbose)"
  info "python:    ${OMLX_PY}"
  info "model-dir: ${MODEL_DIR}"
  info "seed:      ${SEED}"
  info "warmup:    ${OMLX_BENCH_WARMUP_RUNS} pass"
  [ -n "$OMLX_BENCH_EXTRA_ARGS" ] && info "mlx args:  ${OMLX_BENCH_EXTRA_ARGS}"
else
  info "backend:   llamacpp (llama-bench)"
fi
info "runs:      ${RUNS}"
info "pp tokens: ${INPUT_TOKENS}"
info "tg tokens: ${MAX_TOKENS}"
printf '\n'

failures=0
for model in $MODELS; do
  [ -n "$model" ] || continue
  t_start="$(date +%s)"
  if [ "$ENGINE" = "omlx" ]; then
    bench_ok=0
    bench_model_omlx "$model" || bench_ok=$?
  else
    bench_ok=0
    bench_model_llamacpp "$model" || bench_ok=$?
  fi
  if [ "$bench_ok" -eq 0 ]; then
    printf '  %s✓ done in %s%s\n' "$D" "$(elapsed "$t_start")" "$R"
  else
    failures=$((failures + 1))
  fi
  printf '\n'
done

print_summary
if [ "$failures" -gt 0 ]; then
  warn "${failures} model benchmark(s) failed"
  exit 1
fi
