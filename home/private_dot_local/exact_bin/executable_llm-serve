#!/usr/bin/env sh
# llm-serve — Manage the local LLM server (omlx or llama.cpp) configured in ~/.config/local-llm/config.json.
set -eu

CONFIG_FILE="${LOCAL_LLM_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/local-llm/config.json}"
if ! command -v jq >/dev/null 2>&1; then
  printf 'llm-serve: jq not found on PATH\n' >&2
  exit 1
fi
if [ ! -f "$CONFIG_FILE" ]; then
  printf 'llm-serve: config not found: %s (run chezmoi apply)\n' "$CONFIG_FILE" >&2
  exit 1
fi

ENGINE="$(jq -r '.engine // "llamacpp"' "$CONFIG_FILE")"
CFG_PORT="$(jq -r '.port // 8321' "$CONFIG_FILE")"
OMLX_MAX_CONCURRENT="$(jq -r '.omlx_max_concurrent_requests // 1' "$CONFIG_FILE")"
OMLX_MEMORY_GUARD_GB="$(jq -r '.omlx_memory_guard_gb // 0' "$CONFIG_FILE")"

HOST="127.0.0.1"
PORT="${LLM_SERVE_PORT:-$CFG_PORT}"
LISTEN="${HOST}:${PORT}"
BASE_URL="http://${HOST}:${PORT}"
STATUS_PATH="/v1/models"

case "$ENGINE" in
omlx)
  ENGINE_LABEL="omlx"
  MODEL_DIR="${OMLX_MODEL_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/omlx/models}"
  CACHE_DIR="${OMLX_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/omlx}"
  STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omlx"
  PID_FILE="$STATE_DIR/omlx.pid"
  LOG_FILE="$STATE_DIR/omlx.log"
  MAX_WAIT=60
  ;;
llamacpp)
  ENGINE_LABEL="llama.cpp"
  PRESET="${LLAMA_CPP_MODELS_PRESET:-${XDG_CONFIG_HOME:-$HOME/.config}/llama.cpp/models.ini}"
  SLOT_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/llama.cpp/slots"
  STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/llama.cpp"
  PID_FILE="$STATE_DIR/llama-server.pid"
  LOG_FILE="$STATE_DIR/llama-server.log"
  MAX_WAIT=30
  ;;
*)
  printf 'llm-serve: unsupported engine %s (expected omlx or llamacpp)\n' "$ENGINE" >&2
  exit 1
  ;;
esac

usage() {
  cat <<EOF
Usage: llm-serve [command]

Run with no command to start ${ENGINE_LABEL} in the foreground (Ctrl-C to stop).

Commands:
  start    Start ${ENGINE_LABEL} in the background
  stop     Stop the background instance
  restart  Stop then start in the background
  status   Show server status (running models / health)
  list     List models from /v1/models
  logs     Tail background log output
  help     Show this help

Environment:
  LOCAL_LLM_CONFIG     Config file (default: ~/.config/local-llm/config.json)
  LLM_SERVE_PORT       Listen port (default: ${CFG_PORT})
  OMLX_MODEL_DIR       Flat model directory for omlx (default: ~/.local/state/omlx/models)
  LLAMA_CPP_MODELS_PRESET  Router preset file path for llama.cpp
  XDG_STATE_HOME       State dir for pid/log files
EOF
}

require_engine() {
  if [ "$ENGINE" = "omlx" ]; then
    command -v omlx >/dev/null 2>&1 || {
      printf 'llm-serve: omlx not found on PATH\n' >&2
      exit 1
    }
  else
    command -v llama-server >/dev/null 2>&1 || {
      printf 'llm-serve: llama-server not found on PATH\n' >&2
      exit 1
    }
  fi
}

require_config() {
  if [ "$ENGINE" = "omlx" ]; then
    if [ ! -d "$MODEL_DIR" ]; then
      printf 'llm-serve: model dir not found: %s\n' "$MODEL_DIR" >&2
      printf 'Run chezmoi apply to sync omlx model links\n' >&2
      exit 1
    fi
  else
    if [ ! -f "$PRESET" ]; then
      printf 'llm-serve: router preset not found: %s\n' "$PRESET" >&2
      printf 'Run chezmoi apply to render ~/.config/llama.cpp/models.ini\n' >&2
      exit 1
    fi
  fi
}

prepare_state() {
  mkdir -p "$STATE_DIR"
  if [ "$ENGINE" = "omlx" ]; then
    mkdir -p "$CACHE_DIR"
  else
    mkdir -p "$SLOT_DIR"
  fi
}

curl_get() {
  curl -sf --connect-timeout 2 --max-time 5 "${BASE_URL}${1}" 2>/dev/null
}

is_server_up() {
  curl_get "$STATUS_PATH" >/dev/null 2>&1
}

port_listener() {
  if command -v lsof >/dev/null 2>&1; then
    lsof -nP -iTCP:"$PORT" -sTCP:LISTEN 2>/dev/null | awk 'NR == 2 { print $1, $2 }'
    return 0
  fi
  if command -v ss >/dev/null 2>&1; then
    ss -ltnp "sport = :$PORT" 2>/dev/null | awk 'NR == 2 { print $NF }'
    return 0
  fi
  return 1
}

ensure_port_available() {
  is_server_up && return 0
  listener=$(port_listener || true)
  if [ -n "${listener:-}" ]; then
    printf 'llm-serve: port %s in use by %s (not %s)\n' "$LISTEN" "$listener" "$ENGINE_LABEL" >&2
    printf 'llm-serve: stop the other process or run: llm-serve restart\n' >&2
    exit 1
  fi
}

cleanup_stale_pid() {
  [ -f "$PID_FILE" ] || return 0
  pid=$(cat "$PID_FILE" 2>/dev/null || true)
  if [ -z "${pid:-}" ] || ! kill -0 "$pid" 2>/dev/null; then
    rm -f "$PID_FILE"
  fi
}

wait_for_ready() {
  pid="$1"
  attempts=0
  while ! is_server_up; do
    if ! kill -0 "$pid" 2>/dev/null; then
      printf 'llm-serve: process exited before ready (see %s)\n' "$LOG_FILE" >&2
      rm -f "$PID_FILE"
      exit 1
    fi
    attempts=$((attempts + 1))
    if [ "$attempts" -ge "$MAX_WAIT" ]; then
      printf 'llm-serve: failed to start within %ss (stopping pid %s; see %s)\n' "$MAX_WAIT" "$pid" "$LOG_FILE" >&2
      stop_pid "$pid"
      rm -f "$PID_FILE"
      exit 1
    fi
    sleep 1
  done
}

run_server_exec() {
  if [ "$ENGINE" = "omlx" ]; then
    set -- omlx serve --model-dir "$MODEL_DIR" --host "$HOST" --port "$PORT" \
      --max-concurrent-requests "$OMLX_MAX_CONCURRENT" \
      --paged-ssd-cache-dir "$CACHE_DIR"
    if [ "$OMLX_MEMORY_GUARD_GB" -gt 0 ] 2>/dev/null; then
      set -- "$@" --memory-guard-gb "$OMLX_MEMORY_GUARD_GB"
    fi
    exec "$@"
  else
    exec llama-server --slot-save-path "$SLOT_DIR" --models-preset "$PRESET" \
      --models-max 1 --models-autoload --host "$HOST" --port "$PORT"
  fi
}

run_server_bg() {
  if [ "$ENGINE" = "omlx" ]; then
    set -- omlx serve --model-dir "$MODEL_DIR" --host "$HOST" --port "$PORT" \
      --max-concurrent-requests "$OMLX_MAX_CONCURRENT" \
      --paged-ssd-cache-dir "$CACHE_DIR"
    if [ "$OMLX_MEMORY_GUARD_GB" -gt 0 ] 2>/dev/null; then
      set -- "$@" --memory-guard-gb "$OMLX_MEMORY_GUARD_GB"
    fi
    nohup "$@" </dev/null >>"$LOG_FILE" 2>&1 &
  else
    nohup llama-server --slot-save-path "$SLOT_DIR" --models-preset "$PRESET" \
      --models-max 1 --models-autoload --host "$HOST" --port "$PORT" </dev/null >>"$LOG_FILE" 2>&1 &
  fi
}

cmd_foreground() {
  require_engine
  require_config
  prepare_state
  if is_server_up; then
    printf 'llm-serve: already running on %s\n' "$LISTEN"
    return 0
  fi
  ensure_port_available
  printf 'llm-serve: starting %s on %s\n' "$ENGINE_LABEL" "$LISTEN"
  run_server_exec
}

cmd_start() {
  require_engine
  require_config
  prepare_state
  cleanup_stale_pid
  if is_server_up; then
    printf 'llm-serve: already running on %s\n' "$LISTEN"
    return 0
  fi
  ensure_port_available
  printf 'llm-serve: starting %s in background on %s\n' "$ENGINE_LABEL" "$LISTEN"
  run_server_bg
  pid=$!
  echo "$pid" >"$PID_FILE"
  wait_for_ready "$pid"
  printf 'llm-serve: ready at %s/v1\n' "$BASE_URL"
}

stop_pid() {
  pid="$1"
  kill "$pid" 2>/dev/null || true
  attempts=0
  while kill -0 "$pid" 2>/dev/null; do
    attempts=$((attempts + 1))
    if [ "$attempts" -ge 10 ]; then
      kill -9 "$pid" 2>/dev/null || true
      break
    fi
    sleep 1
  done
}

pkill_engine() {
  sig="${1:-TERM}"
  command -v pkill >/dev/null 2>&1 || return 0
  if [ "$ENGINE" = "omlx" ]; then
    pkill -"$sig" -f "omlx serve.*--port ${PORT}( |$)" 2>/dev/null || true
  else
    pkill -"$sig" -f "llama-server.*--port ${PORT}( |$)" 2>/dev/null || true
  fi
}

cmd_stop() {
  stopped=false
  if [ -f "$PID_FILE" ]; then
    pid=$(cat "$PID_FILE" 2>/dev/null || true)
    if [ -n "${pid:-}" ] && kill -0 "$pid" 2>/dev/null; then
      stop_pid "$pid"
      stopped=true
    fi
    rm -f "$PID_FILE"
  fi
  if is_server_up; then
    pkill_engine TERM
    attempts=0
    while is_server_up; do
      attempts=$((attempts + 1))
      if [ "$attempts" -eq 5 ]; then
        pkill_engine KILL
      elif [ "$attempts" -ge 10 ]; then
        printf 'llm-serve: %s still responding on %s\n' "$ENGINE_LABEL" "$LISTEN" >&2
        exit 1
      fi
      sleep 1
    done
    stopped=true
  fi
  if [ "$stopped" = true ]; then
    printf 'llm-serve: stopped\n'
  else
    printf 'llm-serve: not running\n'
  fi
}

cmd_restart() {
  cmd_stop
  cmd_start
}

cmd_status() {
  response=$(curl_get "$STATUS_PATH") || {
    printf 'llm-serve: not running (%s)\n' "$LISTEN"
    exit 1
  }
  count=$(printf '%s' "$response" | jq -r '(.data // []) | length' 2>/dev/null || echo "?")
  printf 'llm-serve: running %s on %s (%s model(s))\n' "$ENGINE_LABEL" "$LISTEN" "$count"
}

cmd_list() {
  response=$(curl_get "/v1/models") || {
    printf 'llm-serve: not running (%s)\n' "$LISTEN" >&2
    exit 1
  }
  printf '%s\n' "$response"
}

cmd_logs() {
  mkdir -p "$STATE_DIR"
  if [ ! -f "$LOG_FILE" ]; then
    printf 'llm-serve: no log file at %s\n' "$LOG_FILE" >&2
    exit 1
  fi
  tail -f "$LOG_FILE"
}

CMD="${1:-}"
shift 2>/dev/null || true

case "$CMD" in
"") cmd_foreground ;;
start) cmd_start ;;
stop) cmd_stop ;;
restart) cmd_restart ;;
status) cmd_status ;;
list) cmd_list ;;
logs) cmd_logs ;;
help | -h | --help) usage ;;
*)
  printf 'llm-serve: unknown command %s (try help)\n' "$CMD" >&2
  exit 2
  ;;
esac
