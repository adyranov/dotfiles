#!/usr/bin/env sh
# Universal launcher for sandboxed AI coding agents.
# Invoked as: agent [--profile NAME] <pi|oc|opencode|omp|claude|cc> [profile]
# [flags...]  (claude only: -w [name] opts into a native git worktree).
# Agent identity is the first argument; every per-agent fact is a plain
# literal below (dispatch case, profile_dir, print_profile_env, print_env,
# set_runtime_env, list_profiles) — no templates, no data files.
set -eu

# Single uname spawn for the Linux gate and PATH parity.
UNAME_S=$(uname -s)

CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
ENGRAM_STATE="${XDG_STATE_HOME:-$HOME/.local/state}/engram"
ENGRAM_LOG="$ENGRAM_STATE/engram.log"
ENGRAM_LOCK="$ENGRAM_STATE/.supervise.lock"
ENGRAM_ID_FILE="$ENGRAM_STATE/daemon.identity"

# Defaults so the daemon path is self-contained without the shell exports.d
# layer (CI, cron, sh -c); print_env emits the same fallbacks.
ENGRAM_PORT="${ENGRAM_PORT:-7437}"
ENGRAM_URL="${ENGRAM_URL:-http://127.0.0.1:$ENGRAM_PORT}"
ENGRAM_DATA_DIR="${ENGRAM_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/engram}"

usage_hint() {
  printf 'usage: agent [--profile NAME] <pi|oc|opencode|omp|claude|cc> [profile] [-w [name]] [--no-sandbox] [--list] [--print-env [profile]] [--help]\n' >&2
  printf '       (-w is claude only: native --worktree)\n' >&2
}

# Pre-name flag position: `agent --profile NAME <agent> ...` selects the
# profile before the agent word resolves (validation is agent-scoped and
# happens after dispatch). The agent word stays required: there is no
# default-agent concept, so an agent-less launch keeps the loud die below.
pre_profile=""
while [ $# -gt 0 ]; do
  case "$1" in
  --profile)
    [ $# -ge 2 ] || {
      usage_hint
      printf 'agent --profile requires a name\n' >&2
      exit 1
    }
    pre_profile="$2"
    shift 2
    ;;
  --profile=*)
    pre_profile="${1#--profile=}"
    shift
    ;;
  *) break ;;
  esac
done

AGENT_ARG="${1:-}"

# --profile NAME consumption (pre-name init and post-name loop): pi and
# opencode validate against their own profile set and die on a miss; omp
# keeps free-form names (settled: omp relocates its agent root to
# <config-root>/profiles/<name>/agent via OMP_PROFILE on its own).
select_profile() {
  case "$AGENT_NAME" in
  omp)
    omp_profile="$1"
    ;;
  *)
    _gateProfile "$1"
    profile="$1"
    ;;
  esac
}

# --print-env --profile NAME: same consumption contract as select_profile.
# omp free-form names bypass profile_dir (no map entry exists; the runtime
# evaluates the omp:default lines plus OMP_PROFILE, set separately).
print_env_selected() {
  case "$AGENT_NAME" in
  omp)
    print_env default
    # Runtime parity: the launcher exports the name after set_runtime_env's
    # scrub; named-root relocation is omp's own job via OMP_PROFILE.
    printf 'export OMP_PROFILE="%s"\n' "$1"
    ;;
  *)
    _gateProfile "$1"
    print_env "$1"
    ;;
  esac
}
case "$AGENT_ARG" in
pi)
  shift
  AGENT_NAME=pi
  BINARY_NAME=pi
  NONO_PROFILE=pi
  AGENT_CONFIG_DIR="$CONFIG_HOME/pi"
  AGENT_DEFAULT_PROFILE=factory
  AGENT_PROFILES=" core default factory minimal "
  AGENT_SELECTABLE=true
  AGENT_PROFILE_DESC="core factory minimal"
  AGENT_SCRUB_DESC=''
  ;;
opencode | oc)
  shift
  AGENT_NAME=opencode
  BINARY_NAME=opencode
  NONO_PROFILE=opencode
  AGENT_CONFIG_DIR="$CONFIG_HOME/opencode"
  AGENT_DEFAULT_PROFILE=factory
  AGENT_PROFILES=" core default factory minimal "
  AGENT_SELECTABLE=true
  AGENT_PROFILE_DESC="core factory minimal"
  # RTK_TELEMETRY_DISABLED and friends live in the shell exports.d layer
  # (exact_shell/exports.d/ai-agents.sh) and survive the scrub below; the
  # OPENCODE_* profile flags must stay launcher-exported because the scrub
  # clears inherited OPENCODE_* values.
  AGENT_SCRUB_DESC='OPENCODE_*'
  ;;
omp)
  shift
  AGENT_NAME=omp
  BINARY_NAME=omp
  NONO_PROFILE=omp
  AGENT_CONFIG_DIR="$CONFIG_HOME/omp/agent"
  AGENT_DEFAULT_PROFILE=default
  AGENT_PROFILES=" default "
  AGENT_SELECTABLE=false
  AGENT_PROFILE_DESC='single configuration root (no named profiles)'
  AGENT_SCRUB_DESC='OPENCODE_* OMP_PROFILE PI_*'
  ;;
claude | cc)
  shift
  AGENT_NAME=claude
  BINARY_NAME=claude
  NONO_PROFILE=claude
  AGENT_CONFIG_DIR="$CONFIG_HOME/claude"
  AGENT_DEFAULT_PROFILE=default
  AGENT_PROFILES=" default "
  AGENT_SELECTABLE=false
  AGENT_PROFILE_DESC='single configuration root (no named profiles)'
  # CLAUDE_CONFIG_DIR from the shell exports.d layer is overridden by
  # print_env; nothing else needs a launcher-side scrub.
  AGENT_SCRUB_DESC=''
  ;;
"")
  usage_hint
  exit 1
  ;;
*)
  usage_hint
  printf 'unknown agent "%s"\n' "$AGENT_ARG" >&2
  exit 1
  ;;
esac

# Color vars default empty: helpers printing before the tput init below
# (e.g. die on an unknown profile) emit clean messages under set -u.
_BO='' _DI='' _RE='' _GR='' _CY='' _NO=''

info() { printf '%s  %s\n' "${_CY}•${_NO}" "$*" >&2; }
ok() { printf '%s  %s\n' "${_GR}✓${_NO}" "$*" >&2; }
warn() { printf '%s  %s\n' "${_BO}!${_NO}" "$*" >&2; }
die() {
  printf '%s  %s\n' "${_RE}✗${_NO}" "$*" >&2
  exit 1
}
dim() { printf '   %s%s%s\n' "${_DI}" "$*" "${_NO}" >&2; }

# Shared profile gate: a profile word is accepted only from the agent's own
# AGENT_PROFILES (--profile <name> passes through the same gate; omp's
# free-form names bypass it: its root relocates via OMP_PROFILE). The
# post-name positional arm keeps its own test: a miss must forward to the
# binary, not die.
_gateProfile() {
  case "$AGENT_PROFILES" in
  *" $1 "*) ;;
  *) die "Unknown profile: $1" ;;
  esac
}

# Profile directory: one explicit map per agent.
profile_dir() {
  case "$AGENT_NAME:$1" in
  pi:core | pi:default) printf '%s\n' "$CONFIG_HOME/pi/profiles/core" ;;
  pi:factory) printf '%s\n' "$CONFIG_HOME/pi/profiles/factory" ;;
  pi:minimal) printf '%s\n' "$CONFIG_HOME/pi/agent" ;;
  opencode:core | opencode:default) printf '%s\n' "$CONFIG_HOME/opencode/profiles/core" ;;
  opencode:factory) printf '%s\n' "$CONFIG_HOME/opencode/profiles/factory" ;;
  opencode:minimal) printf '%s\n' "$CONFIG_HOME/opencode" ;;
  omp:default) printf '%s\n' "$AGENT_CONFIG_DIR" ;;
  claude:default) printf '%s\n' "$AGENT_CONFIG_DIR" ;;
  *) die "Unmapped profile: $1" ;;
  esac
}

# Profile-scoped env: print_env prints these export lines, set_runtime_env
# evals them. ${...} braces expand at use time.
print_profile_env() {
  case "$AGENT_NAME:$1" in
  omp:default)
    # omp 18.18.x (dirs.ts): PI_CONFIG_DIR is the home-relative config-root
    # name; the agent root is <root>/agent (config.yml, auth.json, lock
    # dirs, extensions). State/data/cache relocate under
    # $XDG_{STATE,DATA,CACHE}_HOME/omp, each per-category root gated on
    # that directory existing (isDefault check), and the whole scheme
    # disabled by a PI_CODING_AGENT_DIR override.
    # ponytail: env-relocated roots lean on this version-pinned dirs.ts
    # behavior; never export PI_CODING_AGENT_DIR. Pin the omp version if dir
    # resolution churns.
    printf 'export PI_CONFIG_DIR=".config/omp"\n'
    # Single quotes are deliberate: the emitted lines must expand at eval time.
    # shellcheck disable=SC2016  # emitted for eval by the consumer
    printf 'export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"\n'
    # shellcheck disable=SC2016  # emitted for eval by the consumer
    printf 'export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"\n'
    # shellcheck disable=SC2016  # emitted for eval by the consumer
    printf 'export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"\n'
    ;;
  esac
}

# Relocate gh's state into the sandbox-write dir so gh creates missing state
# instead of reading the floor-denied ~/.config/gh/hosts.yml. Credential-bearing
# agents only. Single quotes: the emitted lines expand $HOME at eval time.
# shellcheck disable=SC2016  # emitted for eval by the consumer
print_gh_state_env() {
  printf 'export GH_CONFIG_DIR="$HOME/.cache/gh-sandbox/config"\n'
  printf 'export GH_DATA_DIR="$HOME/.cache/gh-sandbox/data"\n'
  printf 'export GH_CACHE_DIR="$HOME/.cache/gh-sandbox/cache"\n'
}

# Agent SDK bridges: pi loads pi-claude-bridge, which spawns the real claude
# with the user's login — give it a private config dir, never the user's
# ~/.config/claude. omp/opencode have no bridge lane (see README), so they get
# no CLAUDE_CONFIG_DIR: a bridge-dir export would imply a bridge that exists.
print_claude_bridge_env() {
  # Single quotes: the emitted line expands XDG_STATE_HOME at eval time.
  # shellcheck disable=SC2016  # emitted for eval by the consumer
  printf 'export CLAUDE_CONFIG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/%s/claude-bridge"\n' "$AGENT_NAME"
}

print_env() {
  profile="$1"
  dir=$(profile_dir "$profile")
  case "$AGENT_NAME" in
  pi)
    printf 'export PI_CODING_AGENT_DIR="%s"\n' "$dir"
    printf 'export PI_CODING_AGENT_SESSION_DIR="%s/sessions"\n' "$dir"
    print_gh_state_env
    print_claude_bridge_env
    ;;
  opencode)
    # Scrub first: an eval consumer must not have its exports unset after.
    printf "for __v in \$(env | awk -F= '/^(OPENCODE_.*)/ { print \$1 }'); do unset \"\$__v\"; done 2>/dev/null || :\n"
    printf 'export OPENCODE_CONFIG="%s/opencode.jsonc"\n' "$dir"
    printf 'export OPENCODE_CONFIG_DIR="%s"\n' "$dir"
    # NO_PROXY is NOT exported: the sandbox deny_vars scrub strips it from
    # the child, so printing it contradicts the eval-the-printed-env use.
    print_gh_state_env
    ;;
  omp)
    printf "for __v in \$(env | awk -F= '/^(OPENCODE_.*|PI_.*)/ || \$1 ~ /^(OMP_PROFILE)$/ { print \$1 }'); do unset \"\$__v\"; done 2>/dev/null || :\n"
    ;;
  claude)
    printf 'export CLAUDE_CONFIG_DIR="%s"\n' "$AGENT_CONFIG_DIR"
    print_gh_state_env
    # Claude's own temp root: the same dir bootstrap_scratch creates and
    # exports as TMPDIR (CLAUDE_CODE_TMPDIR keeps its writes in the sandbox).
    printf 'export CLAUDE_CODE_TMPDIR="%s/%s"\n' "${AGENT_LAUNCH_TEST_SCRATCH_ROOT:-/tmp/agents}" "$AGENT_NAME"
    ;;
  esac
  print_profile_env "$profile"
  printf 'export ENGRAM_DATA_DIR="%s"\n' "$ENGRAM_DATA_DIR"
  printf 'export ENGRAM_PORT="%s"\n' "$ENGRAM_PORT"
  printf 'export ENGRAM_URL="http://127.0.0.1:%s"\n' "$ENGRAM_PORT"
}

# stat_field <bsd-flag> <bsd-format> <gnu-flag> <gnu-format> <path>:
# BSD stat first, GNU fallback; prints '' when neither yields a value
# (callers validate).
stat_field() {
  __v=$(stat "$1" "$2" "$5" 2>/dev/null || true)
  case "$__v" in
  '' | *[!0-9]*) __v=$(stat "$3" "$4" "$5" 2>/dev/null || true) ;;
  esac
  printf '%s\n' "$__v"
}

# requireOwner PATH LABEL LABEL_CAP UID / requireMode0700 PATH LABEL LABEL_CAP:
# die strings are byte-pinned by the suites; LABEL is the lowercase mid-sentence
# form, LABEL_CAP the sentence-initial form.
requireOwner() {
  __o=$(stat_field -f %u -c %u "$1")
  case "$__o" in
  '' | *[!0-9]*) die "Cannot determine $2 owner: $1" ;;
  esac
  [ "$__o" = "$4" ] || die "$3 owner mismatch: $1 (owner $__o)"
}

requireMode0700() {
  __m=$(stat_field -f %Lp -c %a "$1")
  case "$__m" in
  '' | *[!0-9]*) die "Cannot determine $2 mode: $1" ;;
  esac
  [ "$((0$__m))" -eq $((0700)) ] || die "$3 is not private: $1 (mode $__m)"
}

# mkdirPrivate DIR LABEL LABEL_CAP: private root, symlink refused.
mkdirPrivate() {
  [ -L "$1" ] && die "$3 is a symlink: $1"
  # shellcheck disable=SC2015  # die if either step fails (A && B || C intended)
  mkdir -p "$1" 2>/dev/null && chmod 700 "$1" 2>/dev/null ||
    die "Cannot create $2: $1"
}

# One env source for both paths: the runtime evals exactly what --print-env
# prints (scrub loops, exports, profile env, ENGRAM trio) — plus, at runtime
# only, the probe's keystore-derived exports: printing those would put secret
# values into a user-evalable surface, so parity holds for everything the
# launcher knows statically and stops there.
set_runtime_env() {
  profile="$1"
  dir=$(profile_dir "$profile")
  eval "$(print_env "$profile")"
  dim "Config:  $dir"
}

# One generic help for every agent: all facts ride the dispatch vars above.
usage() {
  printf 'Usage: agent [--profile NAME] %s [profile] [--no-sandbox] [--list] [--print-env [profile]]\n' \
    "$AGENT_NAME"
  printf '       then agent args are forwarded to %s\n' "$BINARY_NAME"
  printf '\n'
  printf 'Config root: %s\n' "$AGENT_CONFIG_DIR"
  printf 'Profiles: %s\n' "$AGENT_PROFILE_DESC"
  [ -n "$AGENT_SCRUB_DESC" ] && printf 'Scrub: %s\n' "$AGENT_SCRUB_DESC"
  printf '\n'
  printf 'Flags:\n'
  printf '  --list              list available profiles\n'
  printf '  --print-env [prof]  print env vars for profile\n'
  printf '                      (for launcher-internal use; eval-ing it in your\n'
  printf '                      shell relocates your own gh state: GH_CONFIG_DIR)\n'
  printf '  --help              this message\n'
  printf '  --no-sandbox        launch without the nono sandbox and DCG guards\n'
  printf '  --profile NAME      named profile (accepted before or after the agent word;\n'
  printf '                      pi/opencode: core|default|factory|minimal, positional words\n'
  printf '                      stay compat aliases; omp: free-form, agent root\n'
  printf '                      <config-root>/profiles/NAME/agent)\n'
  [ "$AGENT_NAME" = claude ] && printf '  -w [NAME]           native git worktree: launches claude --worktree [NAME]\n'
  [ "$AGENT_NAME" = claude ] && printf '                      (project-local .claude/worktrees/; a bare -w lets claude name it)\n'
  printf '  Args after -- reach %s verbatim (profile words and flags not consumed).\n' "$BINARY_NAME"
  printf '  Note: this --profile selects the agent config profile; the sandbox\n'
  printf '  profile (nono run --profile) is a separate namespace, chosen per agent.\n'
  exit 0
}

list_profiles() {
  case "$AGENT_NAME" in
  pi | opencode)
    # shellcheck disable=SC2086  # profile words split by design
    printf '%s\n' $AGENT_PROFILE_DESC
    printf 'Flag form: --profile <name> (before or after the agent word); the\n'
    printf '  positional word above is a compat alias.\n'
    ;;
  omp)
    printf 'agent %s uses a single configuration root (no positional profiles).\n' "$AGENT_NAME"
    printf 'Named profiles: --profile <name> relocates the agent root to\n'
    printf '  %s/profiles/<name>/agent (omp 18.18.x); the config root stays shared.\n' "${HOME%/}/.config/omp"
    printf '  A named root must carry the managed set (config.yml, models.yml,\n'
    printf '  extensions/dcg-guard.ts); the launcher refuses an unprovisioned root.\n'
    ;;
  claude)
    printf 'agent %s uses a single configuration root (no profiles): %s\n' "$AGENT_NAME" "$AGENT_CONFIG_DIR"
    printf 'Worktrees: -w [name] launches claude --worktree [name] (project-local\n'
    printf '  .claude/worktrees/); a bare -w lets claude name the worktree.\n'
    ;;
  esac
}

pwd_guard() {
  case "$(pwd)" in
  "$HOME")
    die "Refusing to launch from home directory: $(pwd)
   Launch from a project directory inside a git worktree."
    ;;
  "/")
    die "Refusing to launch from root: $(pwd)
   Launch from a project directory inside a git worktree."
    ;;
  esac
  if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    die "Not inside a git worktree.
   Launch from a project directory inside a git worktree."
  fi
}

# Secure per-agent scratch root: the nono sandbox allow-lists writes under
# /tmp/agents/<agent>; TMPDIR is scoped to it so agent temp APIs land inside
# the sandbox. Fail closed on symlinks, foreign ownership, non-private modes.
bootstrap_scratch() {
  if [ "${AGENT_LAUNCH_TEST_MODE:-}" = 1 ] && [ -n "${BATS_TEST_TMPDIR:-}" ]; then
    _agents_root="${AGENT_LAUNCH_TEST_SCRATCH_ROOT:-}"
    [ -n "$_agents_root" ] || die "Test scratch root is not configured"
  else
    _agents_root="/tmp/agents"
  fi
  scratch_dir="$_agents_root/$AGENT_NAME"

  if [ -e "$scratch_dir" ] || [ -L "$scratch_dir" ]; then
    [ -L "$scratch_dir" ] && die "Scratch dir is a symlink: $scratch_dir"
    [ -d "$scratch_dir" ] || die "Scratch dir is not a directory: $scratch_dir"
  else
    # die if either step fails (intended A && B || C semantics here).
    # shellcheck disable=SC2015
    mkdir -p "$_agents_root" 2>/dev/null && chmod 700 "$_agents_root" 2>/dev/null ||
      die "Cannot create scratch root: $_agents_root"
    [ -L "$_agents_root" ] && die "Scratch root is a symlink: $_agents_root"
    mkdir -m 700 "$scratch_dir" 2>/dev/null || die "Cannot create scratch dir: $scratch_dir"
  fi

  [ -L "$_agents_root" ] && die "Scratch root is a symlink: $_agents_root"
  [ -d "$_agents_root" ] || die "Scratch root is not a directory: $_agents_root"

  # Reject symlinked parents: the resolved path must remain under the root.
  _root_resolved=$(cd -P -- "$_agents_root" 2>/dev/null && pwd -P) ||
    die "Cannot resolve scratch root: $_agents_root"
  _resolved=$(cd -P -- "$scratch_dir" 2>/dev/null && pwd -P) ||
    die "Cannot resolve scratch dir: $scratch_dir"
  [ "$_resolved" = "$_root_resolved/$AGENT_NAME" ] ||
    die "Scratch dir resolves outside expected root: $_resolved"

  _uid=$(id -u)
  requireOwner "$_agents_root" "scratch root" "Scratch root" "$_uid"
  requireOwner "$scratch_dir" "scratch dir" "Scratch dir" "$_uid"

  # Normalize inherited permissive modes before the exact-0700 check.
  chmod 700 "$_agents_root" "$scratch_dir" 2>/dev/null ||
    die "Cannot secure scratch directories"

  requireMode0700 "$_agents_root" "scratch root" "Scratch root"
  requireMode0700 "$scratch_dir" "scratch dir" "Scratch dir"

  unset _agents_root _root_resolved _resolved _uid _owner _mode
}

engram_ready() {
  curl --silent --fail --max-time 1 \
    "${ENGRAM_URL}/health" >/dev/null 2>&1
}

# Daemon binary identity: version string + resolved binary path + binary
# mtime, recorded on spawn and compared every launch. The version string
# alone is not a skew signal (a ref=main rebuild can change the binary with
# the string constant); a missing record counts as a mismatch.
daemon_identity() {
  __bin=$(command -v engram 2>/dev/null) || return 1
  __ver=$(engram version 2>/dev/null) || return 1
  __mtime=$(stat_field -f %m -c %Y "$__bin")
  printf '%s\n%s\n%s\n' "$__ver" "$__bin" "$__mtime"
}

identity_current() {
  [ -f "$ENGRAM_ID_FILE" ] || return 1
  [ "$(cat "$ENGRAM_ID_FILE")" = "$(daemon_identity)" ]
}

# A crash between spawn and record costs one extra restart on the next
# launch; self-converges, so a write failure is not fatal.
write_identity() {
  if ! daemon_identity >"$ENGRAM_ID_FILE"; then
    rm -f "$ENGRAM_ID_FILE"
  fi
}

# Supervisor lock: atomic mkdir carrying the holder PID. The success path
# rmdir's it explicitly — the launcher ends in `exec nono run ...` and EXIT
# traps do not fire through exec, so traps are the crash backstop only.
lock_acquire() {
  mkdir "$ENGRAM_LOCK" 2>/dev/null || return 1
  printf '%s\n' "$$" >"$ENGRAM_LOCK/pid"
}

lock_release() {
  rm -f "$ENGRAM_LOCK/pid" 2>/dev/null || true
  rmdir "$ENGRAM_LOCK" 2>/dev/null || true
}

# A leaked lock (holder SIGKILL'd, empty pid file included) must never
# wedge the supervisor: probe the holder PID and take over when dead.
lock_takeover() {
  __holder=$(cat "$ENGRAM_LOCK/pid" 2>/dev/null || true)
  if kill -0 "$__holder" 2>/dev/null; then
    return 1
  fi
  # A fresh holder mkdir's the lock before writing its pid file: an empty
  # read is not proof of death. One bounded re-check after a grace sleep; a
  # pid that lands late (live holder) keeps the lock.
  sleep 1
  __holder=$(cat "$ENGRAM_LOCK/pid" 2>/dev/null || true)
  if kill -0 "$__holder" 2>/dev/null; then
    return 1
  fi
  lock_release
  lock_acquire
}

# Right-anchored port-scoped kill: the anchor is what scopes the pattern —
# unanchored, pkill -f substring-matches dev daemons on ports that extend
# the supervised port (7437 vs 74371).
restart_daemon() {
  __pattern="engram serve ${ENGRAM_PORT}( |$)"
  pkill -f "$__pattern" 2>/dev/null || true
  __waits=0
  while [ "$__waits" -lt 5 ]; do
    pgrep -f "$__pattern" >/dev/null 2>&1 || break
    sleep 1
    __waits=$((__waits + 1))
  done
  pkill -9 -f "$__pattern" 2>/dev/null || true
}

# argv stays exactly `engram serve <port>` — the anchored pattern above
# matches this spawn form and nothing else.
spawn_daemon() {
  mkdir -p "$ENGRAM_DATA_DIR"
  # Fully detach: a daemon spawned from a bats test inherits the worker's
  # coordination fds (bats uses 3 and high fds, e.g. 10) and keeps the
  # formatter pipe open, hanging the suite at EOF (bats-core FAQ). Close
  # every fd >= 3 in the spawn child.
  # Single quotes are deliberate: fds are closed and engram exec'd in the child.
  # shellcheck disable=SC2016
  nohup sh -c 'for __fd in $(seq 3 255); do eval "exec $__fd>&-" 2>/dev/null; done; exec engram serve "$1"' \
    _ "$ENGRAM_PORT" >>"$ENGRAM_LOG" 2>&1 </dev/null &
  __pid=$!
  dim "PID: $__pid"
  write_identity
}

wait_ready() {
  __attempts=0
  while [ "$__attempts" -lt 10 ]; do
    if engram_ready; then
      return 0
    fi
    sleep 1
    __attempts=$((__attempts + 1))
  done
  die "Engram daemon did not become ready (see $ENGRAM_LOG)"
}

# Readiness = health probe plus binary-current identity; report on success.
ready_and_report() {
  engram_ready && identity_current && {
    ok "Engram: daemon ready"
    return 0
  }
  return 1
}

ensure_engram() {
  command -v engram >/dev/null 2>&1 || die "engram not found on PATH"
  command -v curl >/dev/null 2>&1 || die "curl not found (needed for engram health check)"

  info "Engram: checking..."

  # Fast path: one curl plus one cheap identity compare; a healthy,
  # binary-current daemon is started by no one and killed by no one.
  if ready_and_report; then
    return 0
  fi

  mkdir -p "$ENGRAM_STATE"
  dim "Log: $ENGRAM_LOG"

  supervised=false
  if lock_acquire; then
    supervised=true
  else
    # Lost the race: the winner may already be ready.
    if ready_and_report; then
      return 0
    fi
    # Dead holder → taking the lock over makes this launch the supervisor.
    if lock_takeover; then
      supervised=true
    fi
  fi

  if [ "$supervised" = true ]; then
    trap 'lock_release' INT TERM
    info "Engram: (re)starting daemon..."
    restart_daemon
    spawn_daemon
  else
    # Live holder: join its readiness pass; a loser never spawns.
    info "Engram: waiting for daemon..."
  fi

  wait_ready

  # Explicit release before the exec below erases the trap backstop.
  if [ "$supervised" = true ]; then
    lock_release
    trap - INT TERM
  fi
  ok "Engram: daemon ready"
}

# Exit-only flags (--help/--list/--print-env) are consumed only after the
# agent word, so they never bypass agent-name validation. Callers pass the
# full remaining argv; matching arms exit, a miss returns 1 (caller forwards).
exit_only_flags() {
  case "${1:-}" in
  --help | -h)
    usage
    ;;
  --list)
    list_profiles
    exit 0
    ;;
  --print-env)
    # Seed order: --profile flag, positional word, pre-name selection, agent
    # default. Flag-shaped args other than --profile die: never silently
    # print the default env. __pe avoids clobbering the global profile slot.
    __pe="${2:-}"
    case "$__pe" in
    --profile)
      [ $# -ge 3 ] || die "--profile requires a name"
      print_env_selected "$3"
      ;;
    --profile=*)
      print_env_selected "${__pe#--profile=}"
      ;;
    "")
      # Bare probe seed: profile slot, pre-name selection, agent default.
      # omp without a selection exports no OMP_PROFILE (the name is exported
      # only when --profile was given).
      if [ "$AGENT_NAME" = omp ] && [ -z "$pre_profile" ] && [ -z "${omp_profile:-}" ]; then
        print_env "$AGENT_DEFAULT_PROFILE"
      elif [ "$AGENT_NAME" = omp ]; then
        print_env_selected "${omp_profile:-${pre_profile:-$AGENT_DEFAULT_PROFILE}}"
      else
        print_env_selected "${profile:-${pre_profile:-$AGENT_DEFAULT_PROFILE}}"
      fi
      ;;
    -*)
      die "--print-env: unknown argument $__pe (use a profile word or --profile NAME)"
      ;;
    *)
      _gateProfile "$__pe"
      print_env "$__pe"
      ;;
    esac
    exit 0
    ;;
  esac
  return 1
}

exit_only_flags "$@" || true

# Color init after the exit-only dispatch: tput costs 9 subprocesses and the
# exit-only paths (--help/--list/--print-env) never consume color vars.
if [ -t 2 ] && [ -z "${NO_COLOR:-}" ] && command -v tput >/dev/null 2>&1; then
  _BO=$(tput bold) _DI=$(tput dim)
  _RE=$(tput setaf 1) _GR=$(tput setaf 2)
  _CY=$(tput setaf 6) _NO=$(tput sgr0)
else
  _BO='' _DI='' _RE='' _GR='' _CY='' _NO=''
fi

no_sandbox=false
profile="$AGENT_DEFAULT_PROFILE"
claude_wt=false
claude_wt_name=""
# omp named profile (omp 18.18.x): name passed via --profile, exported as
# OMP_PROFILE after set_runtime_env (its scrub clears inherited values).
omp_profile=""
# Pre-name --profile selection is the starting point; the post-name loop may
# override it (last occurrence wins, matching multi-word consumption).
if [ -n "$pre_profile" ]; then
  if [ "$AGENT_NAME" = omp ]; then omp_profile="$pre_profile"; else profile="$pre_profile"; fi
fi

while [ $# -gt 0 ]; do
  case "$1" in
  --)
    shift
    break
    ;;
  --no-sandbox)
    no_sandbox=true
    shift
    ;;
  --profile | --profile=*)
    # Named profile selection for every agent (was omp-only, forwarded to
    # the others): consumption shadows no binary flag (no repo evidence
    # pi/opencode consume a native --profile); `--` stays the escape hatch.
    if [ "$1" = --profile ]; then
      [ $# -ge 2 ] || die "--profile requires a name"
      select_profile "$2"
      shift 2
    else
      select_profile "${1#--profile=}"
      shift
    fi
    ;;
  -w)
    # claude-only opt-in: maps to the binary's --worktree [name]. The name is
    # optional (a bare -w lets claude name the worktree), so a following
    # flag-shaped arg is not consumed as a name.
    [ "$AGENT_NAME" = claude ] ||
      die "-w is a claude-only flag (native git worktree)"
    claude_wt=true
    case "${2:-}" in
    '' | -*) shift ;;
    *)
      claude_wt_name="$2"
      shift 2
      ;;
    esac
    ;;
  core | default | factory | minimal)
    # Acceptance is per-agent: the word sets the profile only when it is in
    # this agent's own profile set. Non-selectable agents (omp, the
    # single-root agent) reject any word in the cross-agent profile union
    # (the pattern above) with the generic single-root message.
    if [ "$AGENT_SELECTABLE" = false ]; then
      # claude has no named-profile mechanism at all (its gate accepts
      # "default" only), so the omp remedy would die with "Unknown profile".
      if [ "$AGENT_NAME" = claude ]; then
        die "agent $AGENT_NAME uses a single configuration root at $AGENT_CONFIG_DIR (no named profiles)"
      fi
      die "agent $AGENT_NAME uses a single configuration root; pass a named profile with --profile <name>"
    fi
    case "$AGENT_PROFILES" in
    *" $1 "*)
      profile="$1"
      shift
      ;;
    *) break ;;
    esac
    ;;
  *)
    # Compatibility shim: the shipped greywall-era flag dies with a hint,
    # not forwarded.
    if [ "$1" = "--no-greywall" ]; then
      die "--no-greywall was renamed --no-sandbox"
    fi
    # Consume exit-only flags after a profile word so they never leak into
    # the binary argv.
    exit_only_flags "$@" || true
    break
    ;;
  esac
done

# Shared launch-path guard: covers both exec paths (--no-sandbox below and
# the sandboxed exec at the end) and runs before any state mutation.
pwd_guard

# Linux/WSL2 fail-closed gate: the DCG guard hooks render inside agent-writable
# roots (the pi/omp agent-dir lockfile contract) and Landlock cannot express
# deny-within-allow, so hook protection is unenforceable on this host. A plain
# host --no-sandbox launch (zero enforcement) is the explicit debug remedy; a
# nested one inherits the parent kernel sandbox.
if [ "$UNAME_S" = Linux ] &&
  { [ "$no_sandbox" != true ] || [ -n "${AGENT_SANDBOX:-}" ]; }; then
  die "Refusing a guarded agent launch on Linux: the DCG guard hooks render inside agent-writable roots and Landlock cannot deny-within-allow, so hook protection cannot be enforced on this host.
   Run guarded agents on macOS, or launch with an explicit --no-sandbox (debug only: no sandbox, no guards, REAL credentials in the agent env).
    A nested launch inherits the parent kernel sandbox, so --no-sandbox stays refused there."
fi

set_runtime_env "$profile"

# Named profile: export rides AFTER set_runtime_env (its scrub clears
# inherited OMP_PROFILE); the sandbox scrub (omp.toml deny_vars) keeps any
# inherited value out of the agent env too. omp relocates the agent root to
# <config-root>/profiles/<name>/agent on its own.
if [ "$AGENT_NAME" = omp ] && [ -n "$omp_profile" ]; then
  export OMP_PROFILE="$omp_profile"
fi

# opencode v2 has no --port flag (the TUI dials the fixed service port,
# granted through base's forward_ports), so the launcher injects no port.

if [ "$AGENT_NAME" = omp ] && [ -n "$omp_profile" ]; then
  info "Profile: ${_BO}${omp_profile}${_NO} (named root: ${HOME%/}/${PI_CONFIG_DIR:-.config/omp}/profiles/${omp_profile}/agent)"
else
  info "Profile: ${_BO}${profile}${_NO}"
fi

# Chezmoi provisions only the default omp root. Refuse an unseeded named root
# before starting services; the guard marker distinguishes it from a namesake.
# omp resolves its root from HOME plus the exported PI_CONFIG_DIR (dirs.ts), so
# the gate reads that root, not XDG_CONFIG_HOME. A nested --no-sandbox inherits
# the parent sandbox, so only a host debug run (no AGENT_SANDBOX) is ungated.
if [ "$AGENT_NAME" = omp ] && [ -n "$omp_profile" ] &&
  { [ "$no_sandbox" != true ] || [ -n "${AGENT_SANDBOX:-}" ]; }; then
  __root="${HOME%/}/${PI_CONFIG_DIR:-.config/omp}/profiles/$omp_profile/agent"
  __missing=''
  for __f in config.yml models.yml; do
    [ -f "$__root/$__f" ] || __missing="$__missing $__f"
  done
  grep -qF 'DCG_FAIL_CLOSED: "1"' "$__root/extensions/dcg-guard.ts" 2>/dev/null ||
    __missing="$__missing extensions/dcg-guard.ts"
  [ -z "$__missing" ] || die "Named omp profile \"$omp_profile\" is not provisioned: $__root
   Missing:$__missing
    Provision the missing managed files without overwriting existing data.
    Plain 'agent omp' runs the managed root."
  unset __root __f __missing
fi

# Claude's DCG PreToolUse hook plus settings render are chezmoi-managed: a
# guarded launch without them would run unguarded, so refuse before exec. A
# nested --no-sandbox inherits the parent sandbox, so only a host debug run
# (no AGENT_SANDBOX) skips the probe.
if [ "$AGENT_NAME" = claude ] &&
  { [ "$no_sandbox" != true ] || [ -n "${AGENT_SANDBOX:-}" ]; }; then
  # XDG pin: the seatbelt grants (claude.toml literals) and the registered hook
  # command (render-claude-pre-tool-use-hooks) are $HOME/.config/claude-
  # anchored; a relocated root is a launch the sandbox cannot cover, not a
  # supported configuration. The hook path missing from the sandbox kills node
  # with exit 127, which Claude Code does not treat as a block.
  [ "$CONFIG_HOME" = "$HOME/.config" ] ||
    die "Claude Code needs the default config root: XDG_CONFIG_HOME=$CONFIG_HOME relocates it outside the \$HOME/.config/claude-anchored sandbox grants.
    Unset XDG_CONFIG_HOME, or run 'agent claude --no-sandbox' (the accepted-risk debug path)."
  __missing=''
  [ -f "$AGENT_CONFIG_DIR/hooks/dcg-guard.mjs" ] ||
    __missing="$__missing hooks/dcg-guard.mjs"
  # settings.json is a modify render Claude Code also writes, so existence is
  # not enough: the exact managed DCG registration must be present. Claude
  # parses a matcher as exact tool-name tokens (a drift like "B|W|E" matches
  # nothing), so pin the exact managed matcher token set — never emulate the
  # matcher with jq regex. Require hooks.PreToolUse and every entry's hooks
  # to be arrays, a handler of type command with no if/async, and the exact
  # 'node <managed hook>' command after collapsing only the harmless
  # homeDir double slash the renderer emits (homeDir carries a trailing
  # separator). Strict JSON fails closed: invalid JSON, the hook string
  # under an unrelated event/key, a drifted matcher/command, if/async
  # handlers, non-array hooks, or disableAllHooks all refuse. Some
  # schema-invalid values make Claude skip the WHOLE settings file (Settings
  # Error; the docs distinguish per-entry Settings Warnings), unregistering
  # the hook, so sanity-check the model/env keys Claude validates strictly:
  # a present fallbackModel must be an array of model strings; a present env
  # must be an object of string values
  # (absent passes: both keys are optional). Registration sanity check, not a
  # full schema validator — other malformed values can skip the file too.
  # This pins the managed registration only; runtime settings precedence over
  # this file cannot be proven here.
  if [ ! -f "$AGENT_CONFIG_DIR/settings.json" ]; then
    __missing="$__missing settings.json"
  elif ! command -v jq >/dev/null 2>&1; then
    die "Cannot verify the Claude DCG hook registration in $AGENT_CONFIG_DIR/settings.json: jq is missing.
     jq is a core dependency here; apply the chezmoi-managed packages, then relaunch.
     'agent claude --no-sandbox' is the accepted-risk debug path."
  elif ! jq -e --arg hook "$AGENT_CONFIG_DIR/hooks/dcg-guard.mjs" \
    --arg matcher 'Bash|Write|Edit|MultiEdit|NotebookEdit' '
      (.disableAllHooks // false) == false and
      (.hooks | type) == "object" and
      (.hooks.PreToolUse | type) == "array" and
      all(.hooks.PreToolUse[]; (.hooks | type) == "array") and
      any(.hooks.PreToolUse[];
        .matcher == $matcher and
        any(.hooks[];
          .type == "command" and (has("if") | not) and (has("async") | not) and
          ((.command // "") | gsub("//+"; "/")) == ("node " + $hook))) and
       ((has("fallbackModel") | not) or
        ((.fallbackModel | type) == "array" and all(.fallbackModel[]; type == "string"))) and
       ((has("env") | not) or
        ((.env | type) == "object" and all(.env[]; type == "string")))
    ' "$AGENT_CONFIG_DIR/settings.json" >/dev/null 2>&1; then
    __missing="$__missing settings.json (DCG hook registration / fallbackModel / env)"
  fi
  # The hook runs as 'node <hook>', so no node means exit 127: Claude Code
  # blocks only on exit 2, so every Bash call would run unguarded.
  command -v node >/dev/null || __missing="$__missing node (hook runtime)"
  [ -z "$__missing" ] || die "Claude Code config is not provisioned: $AGENT_CONFIG_DIR
   Missing:$__missing
     Apply the chezmoi-managed Claude config (the DCG hook and its node runtime
     must exist to guard the launch; a hook that cannot run fails open).
     Some schema-invalid values make Claude Code skip the whole settings.json,
     dropping the hook registration: a fallbackModel that is not an array of
     strings, or an env value that is not a string, is a possible cause.
     'agent claude --no-sandbox' is the accepted-risk debug path."
  unset __missing
fi

# claude -w: the worktree args lead the forwarded argv (args after -- follow),
# so both exec paths below run claude --worktree [name] …
if [ "$claude_wt" = true ]; then
  if [ -n "$claude_wt_name" ]; then
    set -- --worktree "$claude_wt_name" "$@"
  else
    set -- --worktree "$@"
  fi
fi

# --- Credential source probe (shared: guarded and --no-sandbox paths) ---
# Verifies every credential source the APPLIED profile actually reads before
# exec, replacing the env://-only warning. Values are read into shell
# variables and dropped or exported to the agent process only: no secret
# reaches a banner, the log, or a die string (die strings are byte-pinned).
# Outcomes: store LOCKED → die + the unlock command. Keystore entry missing →
# die + seed command (guarded) or warn + seed command (--no-sandbox). Client-
# store reference, cmd:// reader, or gap name missing, and unset env://
# transitional rows → warn with the per-source remedy, launch anyway. The
# export surface is keystore-derived values only (gap names always; routed
# keystore rows under --no-sandbox), and --print-env — which exits long
# before this point — never carries them.
probe_credential_sources() {
  NONO_PROFILE_FILE="$HOME/.config/nono/profiles/$NONO_PROFILE.json"
  NONO_BASE_PROFILE="$HOME/.config/nono/profiles/base.json"
  # Nested launches: the outer launch probed already, and an in-sandbox store
  # read is denied by design, so results here could not be trusted.
  if [ -n "${AGENT_SANDBOX:-}" ]; then return 0; fi
  # Applied state is the probe's data; an unprovisioned host surfaces through
  # the credential-mode line below, not a false "missing keystore".
  if [ ! -f "$NONO_PROFILE_FILE" ]; then return 0; fi
  if ! command -v jq >/dev/null 2>&1; then
    warn "Cannot verify credential sources before launch: jq is missing (core dependency; apply the managed packages)"
    return 0
  fi

  __p_keystore='' __p_client='' __p_cmd='' __p_env='' __p_unresolved=0
  while IFS='	' read -r __p_ck __p_ev; do
    [ -n "$__p_ck" ] || continue
    case "$__p_ck" in
    'env://'*) __p_env="$__p_env ${__p_ck#env://}" ;;
    'apple-password://'* | 'keyring://'*) __p_client="$__p_client $__p_ev|${__p_ck#*://}" ;;
    'cmd://'*) __p_cmd="$__p_cmd ${__p_ck#cmd://}" ;;
    *) __p_keystore="$__p_keystore $__p_ev|${__p_ck}" ;;
    esac
  done <<PROWS
$(jq -r '(.network.custom_credentials // {}) | to_entries[]
  | [(.value.credential_key // ""), (.value.env_var // .key)] | @tsv' "$NONO_PROFILE_FILE" 2>/dev/null)
PROWS

  # env:// rows (pre-flip and transitional): the exported source stays the
  # launching shell, so an unset name is a warn-and-launch, never a die.
  __p_envmiss=''
  for __n in $__p_env; do
    [ -n "$(printenv "$__n" 2>/dev/null)" ] || __p_envmiss="$__p_envmiss $__n"
  done
  [ -z "$__p_envmiss" ] ||
    warn "Routes without a credential source in this shell:${__p_envmiss} — the proxy denies them (export the var, e.g. via direnv)"

  # No keystore row means the store path is not live on this host (pre-flip
  # or pass-through): the shell env is the source and the gap names ride it
  # exactly as before.
  if [ -z "$__p_keystore" ]; then return 0; fi

  # Lock state (both platforms, promptless; a bare store read conflates
  # locked with missing and may prompt, so it is never the lock probe).
  if [ "$UNAME_S" = Darwin ]; then
    security show-keychain-info >/dev/null 2>&1 ||
      die "Login keychain is locked: keystore-backed credentials cannot be read from this session.
   Unlock it, then relaunch:
     security unlock-keychain"
  else
    __p_locked="$(busctl --user get-property org.freedesktop.secrets \
      /org/freedesktop/secrets/aliases/default org.freedesktop.Secret.Collection Locked 2>/dev/null)" ||
      __p_locked='unreachable'
    case "$__p_locked" in
    'boolean false') ;;
    'boolean true')
      die "Login keyring is locked: keystore-backed credentials cannot be read from this session.
   Unlock it, then relaunch:
     unlock-keyring"
      ;;
    *)
      die "The Secret Service is not reachable on the session bus: keystore-backed credentials cannot be resolved from this session (unattended context before an interactive login).
   Log in interactively (or unlock the keyring), then relaunch:
     unlock-keyring"
      ;;
    esac
  fi

  # Keystore rows: live read per entry; values feed only the --no-sandbox
  # export (the guarded path gets phantoms and proxy injection).
  __p_miss=''
  for __row in $__p_keystore; do
    __ev="${__row%%|*}"
    __key="${__row#*|}"
    if [ "$UNAME_S" = Darwin ]; then
      __val="$(security find-generic-password -s nono -a "$__key" -w 2>/dev/null || true)"
    else
      __val="$(secret-tool lookup service nono username "$__key" 2>/dev/null || true)"
    fi
    if [ -z "$__val" ]; then
      __p_miss="$__p_miss $__key"
    elif [ "$no_sandbox" = true ]; then
      export "$__ev=$__val"
    fi
    __val=''
  done
  if [ -n "$__p_miss" ]; then
    if [ "$no_sandbox" = true ]; then
      warn "Keystore entries missing, launching without them:${__p_miss} — seed them: seed-keystore"
    else
      die "Keystore entries are missing on this host:${__p_miss} — the applied profile reads them at egress.
   Seed them, then relaunch:
     seed-keystore"
    fi
  fi

  # Client-store references (apple-password/keyring): a failed read only warns
  # — the remedy is the provider client's own login, and the read path's real
  # item semantics are spike-verified data, not probe assumptions.
  for __row in $__p_client; do
    __ev="${__row%%|*}"
    __ref="${__row#*|}"
    __ok=false
    case "$__ref" in
    'apple-password://'*)
      __acct="${__ref#apple-password://}"
      __svc="${__acct##*/}"
      __acct="${__acct%/*}"
      security find-generic-password -a "$__acct" -s "$__svc" >/dev/null 2>&1 && __ok=true
      ;;
    'keyring://'*)
      __svc="${__ref#keyring://}"
      __svc="${__svc%/*}"
      if [ "$UNAME_S" = Darwin ]; then
        security find-generic-password -s "$__svc" >/dev/null 2>&1 && __ok=true
      else
        secret-tool lookup service "$__svc" >/dev/null 2>&1 && __ok=true
      fi
      ;;
    esac
    if [ "$__ok" != true ]; then
      case "$__ev" in
      CLAUDE_CODE_OAUTH_TOKEN | ANTHROPIC_API_KEY) __remedy='run the provider client login: claude login' ;;
      GH_TOKEN | GITHUB_TOKEN) __remedy='run the provider client login: gh auth login' ;;
      *) __remedy="log in to the provider client that owns this credential" ;;
      esac
      warn "Credential source unresolved — key $__ev: $__remedy"
      __p_unresolved=$((__p_unresolved + 1))
    fi
  done

  # cmd:// readers: run the profile's capture command; empty output warns
  # (same client-login remedy; the proxy would 503 the route at use).
  for __cap in $__p_cmd; do
    __cmd="$(jq -r --arg n "$__cap" '(.credential_capture[$n].command // null)
      | if . == null then "" else @sh end' "$NONO_PROFILE_FILE" 2>/dev/null || true)"
    __val=''
    if [ -n "$__cmd" ]; then
      # eval over jq @sh quoting: capture commands are simple argv readers.
      __val="$(eval "$__cmd" 2>/dev/null || true)"
    fi
    [ -n "$__val" ] || {
      warn "Credential source unresolved — key $__cap: the capture command returned nothing; run the provider client login for it"
      __p_unresolved=$((__p_unresolved + 1))
    }
    __val=''
  done

  # Gap names: the names are exactly the redaction extra_env_vars minus the
  # wildcard deny_vars entries — the same derivation the base profile renders
  # from env_injected. Present values reach the agent process env only.
  __gmiss=''
  __gap_names="$(jq -r '(.diagnostics.redaction.extra_env_vars // [])[]
    | select(contains("*") | not)' "$NONO_BASE_PROFILE" 2>/dev/null)"
  for __n in $__gap_names; do
    if [ "$UNAME_S" = Darwin ]; then
      __val="$(security find-generic-password -s nono -a "$__n" -w 2>/dev/null || true)"
    else
      __val="$(secret-tool lookup service nono username "$__n" 2>/dev/null || true)"
    fi
    if [ -n "$__val" ]; then
      export "$__n=$__val"
    else
      __gmiss="$__gmiss $__n"
    fi
    __val=''
  done
  [ -z "$__gmiss" ] || {
    warn "Gap-name credentials missing, tools will fail at use:${__gmiss} — seed them: seed-keystore"
    __p_unresolved=$((__p_unresolved + 1))
  }

  # The clean-launch report only prints when nothing above warned: the per-row
  # remedy lines are the report otherwise.
  if [ "$__p_unresolved" -eq 0 ] && [ -z "$__p_envmiss" ]; then
    ok "Credentials: sources resolved (keystore$(printf '%s\n' "$__p_keystore" | wc -w | tr -d ' ') client$(printf '%s\n' "$__p_client" | wc -w | tr -d ' ') gap$(printf '%s\n' "$__gap_names" | wc -w | tr -d ' '))"
  fi
}
probe_credential_sources || :

# The v2 service outlives the TUI; once its nono proxy dies its egress fails
# forever (a surviving host-side TUI/CLI attaches to it and sees "cannot
# connect" for every provider, infer01 included). ppid 1 = guaranteed-dead
# proxy: kill at launch, the consumer spawns a fresh one (in the sandbox for
# the guarded path, on the host for --no-sandbox). Nested kills hit EPERM
# silently. Bats: skip.
kill_orphan_service() {
  # shellcheck disable=SC2046  # pgrep prints one pid per line; splitting is the point
  for __pid in $(pgrep -f 'opencode[^ ]* serve --service' 2>/dev/null); do
    [ "$(ps -o ppid= -p "$__pid" 2>/dev/null | tr -d '[:space:]')" = 1 ] || continue
    kill "$__pid" 2>/dev/null &&
      warn "Stopped orphaned opencode service (pid $__pid): fresh service will start for this launch"
  done
}

if [ "$no_sandbox" = true ]; then
  if [ -n "${AGENT_SANDBOX:-}" ]; then
    # Guards stay active in the inherited sandbox: strip any inherited
    # DCG_BYPASS so a nested --no-sandbox child's env carries no bypass
    # marker (guard-core honoring of the marker is version-dependent).
    unset DCG_BYPASS
    ok "Sandbox: inherited (nested launch); DCG guards: active"
  else
    ok "Sandbox: disabled (--no-sandbox); DCG guards: bypassed; the agent env carries REAL credential values"
    # Honored at boot by the shared DCG guard-core hooks; only meaningful here because the nono profiles scrub DCG_* from sandboxed agent env.
    export DCG_BYPASS=1
  fi
  # Host debug launch: clear a dead-egress v2 orphan before the TUI attaches
  # to it. A nested --no-sandbox inherits the parent sandbox, where the kill
  # EPERMs and the parent proxy still serves egress, so it stays skipped.
  if [ "$AGENT_NAME" = opencode ] && [ -z "${AGENT_SANDBOX:-}" ] &&
    [ "${AGENT_LAUNCH_TEST_MODE:-}" != 1 ]; then
    kill_orphan_service
  fi
  exec "$BINARY_NAME" "$@"
fi

# Engram must start before the sandboxed launch: its curl health-check must
# reach localhost directly, not through the nono proxy.
ensure_engram

bootstrap_scratch
dim "Scratch: $scratch_dir (TMPDIR scoped to nono)"
export TMPDIR="$scratch_dir"
# rtk state rides the same per-agent scratch root, so test scratch overrides
# and the sandbox write grant cover it.
export RTK_RECALL_DB="$scratch_dir/rtk/recall.db"
export RTK_TEE_DIR="$scratch_dir/rtk/tee"
unset scratch_dir

# Agents never get a tmux server: host tmux is base-denied and no sandbox-local
# socket dir is provisioned, so no tmux interaction is possible in any direction.
# The TMUX scrub keeps an inherited host-session marker out of the agent env.
unset TMUX

# Sandbox PATH parity: the MacPorts `git` dies on a blocked dylib inside nono,
# so /usr/bin first gives a working binary (the enforcement suite pins the
# same PATH). This shadows mise shims by name; narrow to a git-only dir if a
# hook needs a mise interpreter by bare name. Linux distros ship the system
# binaries on the inherited PATH already, so the prepend is Darwin-only.
# Host runs keep PATH.
if [ "$UNAME_S" = Darwin ]; then
  export PATH="/usr/bin:$PATH"
fi

# Runner-context marker: suites gate live/DCG probes on it (loud skips
# in-sandbox); host shells stay marker-free and run for real. Not in the
# deny_vars scrub set (name-based); the DCG_* wildcard cannot match AGENT_*.
export AGENT_SANDBOX=1
# Launcher-pinned home: the DCG guard-core seal validates HOME against this
# pin, so a forged in-sandbox HOME cannot self-arm a bypass.
export AGENT_SANDBOX_HOME="$HOME"

# Denials stay silent EPERM (agents report them): nono's post-run "Review
# denied paths" selector is the only prompt UI; also blocks saved-grant drift.
export NONO_NO_SAVE_PROMPT=1

# Full event log (incl. denials) to the scratch dir, which the sandbox grants
# r+w — durable, agent-readable triage trail; the in-band denial summary stays.
export NONO_LOG_FILE="$TMPDIR/nono.log"

# Credential mode of the applied profile: routes on, pass-through, or
# scrub-only. The scrub lives in the base profile; agent profiles inherit it.
# The mode reads base.json, where omp's full deny_vars set is absent, so the
# explicit omp exclusion above is load-bearing. The source probe above already
# verified (or warned about) every source; nothing here repeats that read.
if grep -q '"custom_credentials"' "$NONO_PROFILE_FILE" 2>/dev/null; then
  cred_mode=routes
  dim "Credentials: routes on — the proxy injects values at egress"
elif [ "$NONO_PROFILE" != omp ] && command -v jq >/dev/null 2>&1 &&
  jq -e '.environment.deny_vars | (index("CLAUDE_CODE_OAUTH_TOKEN") == null and
    index("OPENAI_API_KEY") == null)' "$NONO_BASE_PROFILE" >/dev/null 2>&1; then
  cred_mode=pass-through
  dim "Credentials: pass-through — exported provider keys are in the agent env (names redacted in the audit trail); GitHub is not delegated: gh/git work stays in your terminal"
else
  cred_mode=scrub-only
  dim "Credentials: scrub-only — no credential values, provider calls unavailable"
fi
# The mode rides the event log, not just the TUI dim line.
printf 'credential-mode: %s\n' "$cred_mode" >>"$NONO_LOG_FILE" 2>/dev/null || :
# Landlock binds only paths existing at sandbox start (Linux): seed gh's
# relocated state root so the first sandboxed gh write lands.
case "$AGENT_NAME" in
pi | opencode) mkdir -p "$HOME/.cache/gh-sandbox" 2>/dev/null || : ;;
esac
# v2 seeds its service password file at <config-dir>/service.json; Landlock
# binds only files existing at sandbox start, so seed the global-dir case
# (minimal profile), whose grant is file-granular.
if [ "$AGENT_NAME" = opencode ] && [ "${OPENCODE_CONFIG_DIR:-}" = "$AGENT_CONFIG_DIR" ]; then
  touch "$AGENT_CONFIG_DIR/service.json" 2>/dev/null || :
fi
# ppid 1 = guaranteed-dead proxy: kill at launch (function defined above the
# --no-sandbox branch); the TUI spawns a fresh one in this sandbox.
if [ "$AGENT_NAME" = opencode ] && [ "${AGENT_LAUNCH_TEST_MODE:-}" != 1 ]; then
  kill_orphan_service
fi
dim "Launch: nono run --profile $NONO_PROFILE -- $BINARY_NAME ..."
exec nono run --profile "$NONO_PROFILE" -- "$BINARY_NAME" "$@"
