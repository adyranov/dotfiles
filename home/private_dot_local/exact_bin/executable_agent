#!/usr/bin/env sh
# Universal launcher for sandboxed AI coding agents: each agent runs under
# `nono run --profile <agent>`. Usage:
#   agent <pi|oc|opencode|omp|claude|cc> [flags...]
#   (claude only: -w [name] opts into a native git worktree)
# Each agent has exactly one config root; agent words are the only launcher
# syntax besides the flags below, every other word or flag is forwarded to
# the agent binary. Where nono is not installed (ephemeral container hosts)
# the agent runs directly: the container is the boundary.
set -eu

# Single uname spawn for the Darwin PATH parity prepend.
UNAME_S=$(uname -s)

CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
ENGRAM_STATE="${XDG_STATE_HOME:-$HOME/.local/state}/engram"
ENGRAM_LOG="$ENGRAM_STATE/engram.log"
ENGRAM_LOCK="$ENGRAM_STATE/.supervise.lock"
ENGRAM_ID_FILE="$ENGRAM_STATE/daemon.identity"
# Defaults keep the daemon path self-contained outside the shell exports.d layer.
ENGRAM_PORT="${ENGRAM_PORT:-7437}"
ENGRAM_URL="${ENGRAM_URL:-http://127.0.0.1:$ENGRAM_PORT}"
ENGRAM_DATA_DIR="${ENGRAM_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/engram}"

usage_hint() {
  printf 'usage: agent <pi|oc|opencode|omp|claude|cc> [--no-sandbox] [--print-env] [--help]\n' >&2
  printf '       (-w is claude only: native --worktree)\n' >&2
}

# Agent identity is the first argument; every per-agent fact is a plain
# literal in the dispatch case below. AGENT_CONFIG_DIR is the single config
# root print_env points the agent at.
AGENT_ARG="${1:-}"
case "$AGENT_ARG" in
pi)
  shift
  AGENT_NAME=pi BINARY_NAME=pi NONO_PROFILE=pi
  # pi's default dir: ~/.config/pi/agent (reached via the ~/.pi symlink).
  AGENT_CONFIG_DIR="$CONFIG_HOME/pi/agent"
  AGENT_SCRUB_DESC=''
  ;;
opencode | oc)
  shift
  AGENT_NAME=opencode BINARY_NAME=opencode NONO_PROFILE=opencode
  AGENT_CONFIG_DIR="$CONFIG_HOME/opencode"
  # The OPENCODE_* vars must stay launcher-exported: print_env's
  # unset loop clears inherited OPENCODE_* values at eval time.
  AGENT_SCRUB_DESC='OPENCODE_*'
  ;;
omp)
  shift
  AGENT_NAME=omp BINARY_NAME=omp NONO_PROFILE=omp
  AGENT_CONFIG_DIR="$CONFIG_HOME/omp/agent"
  AGENT_SCRUB_DESC='OPENCODE_* PI_*'
  ;;
claude | cc)
  shift
  AGENT_NAME=claude BINARY_NAME=claude NONO_PROFILE=claude
  AGENT_CONFIG_DIR="$CONFIG_HOME/claude"
  # CLAUDE_CONFIG_DIR from the shell exports.d layer is overridden by print_env.
  AGENT_SCRUB_DESC=''
  ;;
"")
  usage_hint
  exit 1
  ;;
*)
  usage_hint
  printf 'unknown agent "%s"\n' "$AGENT_ARG" >&2
  exit 1
  ;;
esac

# Color vars default empty: helpers printing before the tput init below
# (e.g. die on an unknown agent) emit clean messages under set -u.
_BO='' _DI='' _RE='' _GR='' _CY='' _NO=''

info() { printf '%s  %s\n' "${_CY}•${_NO}" "$*" >&2; }
ok() { printf '%s  %s\n' "${_GR}✓${_NO}" "$*" >&2; }
die() {
  printf '%s  %s\n' "${_RE}✗${_NO}" "$*" >&2
  exit 1
}
dim() { printf '   %s%s%s\n' "${_DI}" "$*" "${_NO}" >&2; }

# Per-agent env: print_env prints these export lines, set_runtime_env evals
# them. Single quotes are deliberate: the emitted lines expand at eval time.
print_env() {
  # nono basic_auth injects a fixed user:password; GitHub git wants this form.
  # shellcheck disable=SC2016  # emitted for eval by the consumer
  printf '%s\n' '[ -z "${GITHUB_TOKEN:-}" ] || export GITHUB_GIT_CREDENTIAL="x-access-token:$GITHUB_TOKEN"'
  case "$AGENT_NAME" in
  pi)
    # Sessions live inside the config root: one directory to manage.
    printf 'export PI_CODING_AGENT_DIR="%s"\n' "$AGENT_CONFIG_DIR"
    printf 'export PI_CODING_AGENT_SESSION_DIR="%s/sessions"\n' "$AGENT_CONFIG_DIR"
    ;;
  opencode)
    # Unset first: an eval consumer must not have its exports unset after.
    # Preserve OPENCODE_API_KEY (passthrough credential for opencode-zen/go).
    printf "for __v in \$(env | awk -F= '/^OPENCODE_/ && \$1 != \"OPENCODE_API_KEY\" { print \$1 }'); do unset \"\$__v\"; done 2>/dev/null || :\n"
    printf 'export OPENCODE_CONFIG="%s/opencode.jsonc"\n' "$AGENT_CONFIG_DIR"
    printf 'export OPENCODE_CONFIG_DIR="%s"\n' "$AGENT_CONFIG_DIR"
    # NO_PROXY is not exported: nono's proxy owns egress routing.
    ;;
  omp)
    # Unset first: PI_CONFIG_DIR below matches the PI_* pattern and must
    # survive its own unset line; preserve OPENCODE_API_KEY for opencode-zen/go.
    printf "for __v in \$(env | awk -F= '/^(OPENCODE_|PI_)/ && \$1 != \"OPENCODE_API_KEY\" { print \$1 }'); do unset \"\$__v\"; done 2>/dev/null || :\n"
    # omp 18.18.x (dirs.ts): PI_CONFIG_DIR is the home-relative config-root
    # name, the agent root is <root>/agent, and state/data/cache relocate
    # under the omp XDG roots.
    # ponytail: leans on this version-pinned dirs.ts behavior; never export
    # PI_CODING_AGENT_DIR (it disables the scheme). Pin omp if it churns.
    printf 'export PI_CONFIG_DIR=".config/omp"\n'
    # shellcheck disable=SC2016  # emitted for eval by the consumer
    printf 'export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"\n'
    # shellcheck disable=SC2016  # emitted for eval by the consumer
    printf 'export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"\n'
    # shellcheck disable=SC2016  # emitted for eval by the consumer
    printf 'export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"\n'
    ;;
  claude)
    printf 'export CLAUDE_CONFIG_DIR="%s"\n' "$AGENT_CONFIG_DIR"
    # The orchestrator prompt and duer commands stage files under this path.
    # TMPDIR is always sandbox-writable; claude creates its own subdirs.
    # shellcheck disable=SC2016  # emitted for eval by the consumer
    printf 'export CLAUDE_CODE_TMPDIR="${CLAUDE_CODE_TMPDIR:-${TMPDIR:-/tmp}}"\n'
    ;;
  esac
  printf 'export ENGRAM_DATA_DIR="%s"\n' "$ENGRAM_DATA_DIR"
  printf 'export ENGRAM_PORT="%s"\n' "$ENGRAM_PORT"
  printf 'export ENGRAM_URL="http://127.0.0.1:%s"\n' "$ENGRAM_PORT"
}

# One env source for both paths: the runtime evals exactly what --print-env
# prints (unset loops, exports, ENGRAM trio).
set_runtime_env() {
  eval "$(print_env)"
  dim "Config:  $AGENT_CONFIG_DIR"
}

# One generic help for every agent: all facts ride the dispatch vars above.
usage() {
  printf 'Usage: agent %s [--no-sandbox] [--print-env] [--help]\n' "$AGENT_NAME"
  printf '       then agent args are forwarded to %s\n' "$BINARY_NAME"
  printf '\n'
  printf 'Config root: %s\n' "$AGENT_CONFIG_DIR"
  [ -n "$AGENT_SCRUB_DESC" ] && printf 'Scrub: %s\n' "$AGENT_SCRUB_DESC"
  printf '\n'
  printf 'Flags:\n'
  printf '  --print-env         print env vars for the config root (safe to eval)\n'
  printf '  --help              this message\n'
  printf '  --no-sandbox        launch without the nono sandbox (DCG guards stay active)\n'
  [ "$AGENT_NAME" = claude ] && printf '  -w [NAME]           native git worktree: launches claude --worktree [NAME]\n'
  [ "$AGENT_NAME" = claude ] && printf '                      (project-local .claude/worktrees/; a bare -w lets claude name it)\n'
  printf '  Args after -- reach %s verbatim.\n' "$BINARY_NAME"
  printf '  --help/-h/--print-env are consumed anywhere before --; every other word\n'
  printf '  or flag is forwarded to %s like any other argument (named profiles were\n' "$BINARY_NAME"
  printf '  removed: each agent has one config root).\n'
  printf '  Note: the nono sandbox profile (nono run --profile) is a separate\n'
  printf '  namespace, chosen per agent above.\n'
  exit 0
}

# Don't launch agents from $HOME, /, or anywhere without a git worktree.
pwd_guard() {
  case "$(pwd)" in
  "$HOME")
    die "Refusing to launch from home directory: $(pwd)
  Launch from a project directory inside a git worktree."
    ;;
  "/")
    die "Refusing to launch from root: $(pwd)
  Launch from a project directory inside a git worktree."
    ;;
  esac
  if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    die "Not inside a git worktree.
  Launch from a project directory inside a git worktree."
  fi
}

engram_ready() {
  curl --silent --fail --max-time 1 \
    "${ENGRAM_URL}/health" >/dev/null 2>&1
}

# Daemon binary identity: version string + resolved binary path + binary
# mtime, recorded on spawn and compared every launch. The version string
# alone is not a skew signal (a ref=main rebuild can change the binary with
# the string constant); a missing record counts as a mismatch. The mtime is
# GNU stat first (BSD stat -c exits 1 silently, whereas GNU stat -f prints
# fluctuating filesystem stats to stdout before failing on %m).
daemon_identity() {
  __bin=$(command -v engram 2>/dev/null) || return 1
  __ver=$(engram version 2>/dev/null) || return 1
  __mtime=$(stat -c %Y "$__bin" 2>/dev/null || stat -f %m "$__bin" 2>/dev/null || true)
  printf '%s\n%s\n%s\n' "$__ver" "$__bin" "$__mtime"
}

identity_current() {
  [ -f "$ENGRAM_ID_FILE" ] || return 1
  [ "$(cat "$ENGRAM_ID_FILE")" = "$(daemon_identity)" ]
}

# A crash between spawn and record costs one extra restart on the next
# launch; self-converges, so a write failure is not fatal.
write_identity() {
  if ! daemon_identity >"$ENGRAM_ID_FILE"; then
    rm -f "$ENGRAM_ID_FILE"
  fi
}

# Supervisor lock: atomic mkdir carrying the holder PID. The success path
# rmdir's it explicitly — the launcher ends in `exec nono run ...` and EXIT
# traps do not fire through exec, so traps are the crash backstop only.
lock_acquire() {
  mkdir "$ENGRAM_LOCK" 2>/dev/null || return 1
  printf '%s\n' "$$" >"$ENGRAM_LOCK/pid"
}

lock_release() {
  rm -f "$ENGRAM_LOCK/pid" 2>/dev/null || true
  rmdir "$ENGRAM_LOCK" 2>/dev/null || true
}

# A leaked lock (holder SIGKILL'd, empty pid file included) must never
# wedge the supervisor: probe the holder PID and take over when dead.
lock_takeover() {
  __holder=$(cat "$ENGRAM_LOCK/pid" 2>/dev/null || true)
  if kill -0 "$__holder" 2>/dev/null; then
    return 1
  fi
  # A fresh holder mkdir's the lock before writing its pid file: an empty
  # read is not proof of death. One bounded re-check after a grace sleep; a
  # pid that lands late (live holder) keeps the lock.
  sleep 1
  __holder=$(cat "$ENGRAM_LOCK/pid" 2>/dev/null || true)
  if kill -0 "$__holder" 2>/dev/null; then
    return 1
  fi
  lock_release
  lock_acquire
}

# Right-anchored port-scoped kill: the anchor is what scopes the pattern —
# unanchored, pkill -f substring-matches dev daemons on ports that extend
# the supervised port (7437 vs 74371).
restart_daemon() {
  __pattern="engram serve ${ENGRAM_PORT}( |$)"
  pkill -f "$__pattern" 2>/dev/null || true
  __waits=0
  while [ "$__waits" -lt 5 ]; do
    pgrep -f "$__pattern" >/dev/null 2>&1 || break
    sleep 1
    __waits=$((__waits + 1))
  done
  pkill -9 -f "$__pattern" 2>/dev/null || true
}

# argv stays exactly `engram serve <port>` — the anchored pattern above
# matches this spawn form and nothing else. Close every fd >= 3 in the spawn
# child: a daemon spawned from a bats test would otherwise inherit the
# worker's coordination fds and hang the formatter pipe at EOF.
spawn_daemon() {
  mkdir -p "$ENGRAM_DATA_DIR"
  # Single quotes are deliberate: fds are closed and engram exec'd in the child.
  # shellcheck disable=SC2016
  nohup sh -c 'for __fd in $(seq 3 255); do eval "exec $__fd>&-" 2>/dev/null; done; exec engram serve "$1"' \
    _ "$ENGRAM_PORT" >>"$ENGRAM_LOG" 2>&1 </dev/null &
  __pid=$!
  dim "PID: $__pid"
  write_identity
}

wait_ready() {
  __attempts=0
  while [ "$__attempts" -lt 10 ]; do
    if engram_ready; then
      return 0
    fi
    sleep 1
    __attempts=$((__attempts + 1))
  done
  die "Engram daemon did not become ready (see $ENGRAM_LOG)"
}

# Readiness = health probe plus binary-current identity; report on success.
ready_and_report() {
  engram_ready && identity_current && {
    ok "Engram: daemon ready"
    return 0
  }
  return 1
}

ensure_engram() {
  command -v engram >/dev/null 2>&1 || die "engram not found on PATH"
  command -v curl >/dev/null 2>&1 || die "curl not found (needed for engram health check)"

  info "Engram: checking..."

  # Fast path: one curl plus one cheap identity compare; a healthy,
  # binary-current daemon is started by no one and killed by no one.
  if ready_and_report; then
    return 0
  fi

  mkdir -p "$ENGRAM_STATE"
  dim "Log: $ENGRAM_LOG"

  supervised=false
  if lock_acquire; then
    supervised=true
  else
    # Lost the race: the winner may already be ready.
    if ready_and_report; then
      return 0
    fi
    # Dead holder → taking the lock over makes this launch the supervisor.
    if lock_takeover; then
      supervised=true
    fi
  fi

  if [ "$supervised" = true ]; then
    trap 'lock_release' INT TERM
    info "Engram: (re)starting daemon..."
    restart_daemon
    spawn_daemon
  else
    # Live holder: join its readiness pass; a loser never spawns.
    info "Engram: waiting for daemon..."
  fi

  wait_ready

  # Explicit release before the exec below erases the trap backstop.
  if [ "$supervised" = true ]; then
    lock_release
    trap - INT TERM
  fi
  ok "Engram: daemon ready"
}

# Exit-only flags (--help/--print-env) are consumed after the agent word at
# any position up to the first --: former profile words are plain arguments
# now, so a word must not hide the flag from `agent <name> <word> --print-env`
# (which exits before any launch, so the word reaches no binary). Args after
# -- are forwarded verbatim and never scanned. Callers pass the full
# remaining argv; a match exits, a miss returns 1 (caller forwards).
exit_only_flags() {
  while [ $# -gt 0 ]; do
    case "$1" in
    --) return 1 ;;
    --help | -h)
      usage
      ;;
    --print-env)
      print_env
      exit 0
      ;;
    esac
    shift
  done
  return 1
}

exit_only_flags "$@" || true

# Color init after the exit-only dispatch: tput costs 9 subprocesses and the
# exit-only paths never consume color vars.
if [ -t 2 ] && [ -z "${NO_COLOR:-}" ] && command -v tput >/dev/null 2>&1; then
  _BO=$(tput bold) _DI=$(tput dim)
  _RE=$(tput setaf 1) _GR=$(tput setaf 2)
  _CY=$(tput setaf 6) _NO=$(tput sgr0)
else
  _BO='' _DI='' _RE='' _GR='' _CY='' _NO=''
fi

no_sandbox=false
claude_wt=false
claude_wt_name=""
claude_wt_sep=false

# Only launcher flags are consumed here; the first other word starts the
# forwarded argv and everything from it on reaches the binary untouched.
while [ $# -gt 0 ]; do
  case "$1" in
  --)
    shift
    break
    ;;
  --no-sandbox)
    no_sandbox=true
    shift
    ;;
  -w)
    # claude-only opt-in: maps to the binary's --worktree [name]; a following
    # flag-shaped arg is not consumed as a name.
    [ "$AGENT_NAME" = claude ] ||
      die "-w is a claude-only flag (native git worktree)"
    claude_wt=true
    # `-w --` means "no name": forward a `--` so claude cannot bind the first
    # pass-through argument as the worktree name.
    [ "${2:-}" = -- ] && claude_wt_sep=true
    case "${2:-}" in
    '' | -*) shift ;;
    *)
      claude_wt_name="$2"
      shift 2
      ;;
    esac
    ;;
  *)
    # Compatibility shim: the shipped greywall-era flag dies with a hint.
    [ "$1" != --no-greywall ] || die "--no-greywall was renamed --no-sandbox"
    break
    ;;
  esac
done

pwd_guard

set_runtime_env

# Startup guardrail integrity check: all guard scripts and Claude's override
# settings live in read-only ~/.config/dcg/. Verify they are intact and that
# writable agent config files were not tampered with in a prior session.
verify_guardrails() {
  __dcg_dir="$CONFIG_HOME/dcg"
  [ -r "$__dcg_dir/guard-core.mjs" ] ||
    die "Guardrail missing: $__dcg_dir/guard-core.mjs (run chezmoi apply)"

  case "$AGENT_NAME" in
  claude)
    __node_dir="${XDG_DATA_HOME:-$HOME/.local/share}/mise/installs/node"
    __node="$__node_dir/lts/bin/node"
    [ -x "$__node" ] || __node="$__node_dir/latest/bin/node"
    [ -x "$__node" ] || __node=$(command -v node 2>/dev/null || true)
    [ -x "$__node" ] ||
      die "Guardrail runtime missing: node not found on PATH (required for claude-guard.mjs)"
    [ -r "$__dcg_dir/claude-guard.mjs" ] ||
      die "Guardrail missing: $__dcg_dir/claude-guard.mjs (run chezmoi apply)"
    [ -r "$__dcg_dir/claude-settings.json" ] ||
      die "Guardrail missing: $__dcg_dir/claude-settings.json (run chezmoi apply)"
    # Guard self-test: refuse to start if the hook cannot run a benign payload.
    if ! printf '%s\n' '{"tool_name":"Write","tool_input":{"file_path":"/tmp/dcg-selftest"},"cwd":"/tmp"}' | env -u NODE_OPTIONS "$__node" "$__dcg_dir/claude-guard.mjs" >/dev/null 2>&1; then
      die "Guardrail self-test failed: $__dcg_dir/claude-guard.mjs errored on a benign payload"
    fi
    __cfg="$AGENT_CONFIG_DIR/settings.json"
    [ -f "$__cfg" ] ||
      die "Guardrail config missing: $__cfg (run chezmoi apply ~/.config/claude/settings.json)"
    command -v jq >/dev/null 2>&1 ||
      die "Guardrail check requires jq to inspect $__cfg (install jq or ensure it is on PATH)"
    __manifest="$__dcg_dir/claude-managed.json"
    if [ -r "$__manifest" ]; then
      __drift=$(jq -rn --slurpfile m "$__manifest" --slurpfile c "$__cfg" '
        ($m[0]) as $man | ($c[0]) as $cfg |
        [
          ($man.forbiddenKeys[] as $k | select($cfg | has($k)) | $k),
          (if $cfg.disableAllHooks == true then "disableAllHooks" else empty end),
          (if (($cfg.permissions // {}) | if (.deny | type) == "array" then .deny |= sort else . end) != (($man.permissions // {}) | if (.deny | type) == "array" then .deny |= sort else . end) then "permissions" else empty end),
          (if ($cfg.sandbox // {}) != ($man.sandbox // {}) then "sandbox" else empty end),
          (if ($cfg.statusLine.command // "") != $man.statusLineCommand then "statusLine" else empty end),
          (if (($cfg.extraKnownMarketplaces // {}) | keys | sort) != $man.marketplaces then "extraKnownMarketplaces" else empty end),
          (if ($cfg.autoMode // {}) != $man.autoMode then "autoMode" else empty end),
          (if ($cfg.enabledPlugins // {}) != $man.enabledPlugins then "enabledPlugins" else empty end),
          (if ($cfg.env // {}) != $man.env then "env" else empty end),
          (if ($cfg.hooks // {}) != $man.hooks then "hooks" else empty end),
          (if ($cfg | has("mcpServers")) then "mcpServers" else empty end)
        ] | join(", ")
      ' 2>/dev/null || echo "parse-error")
      [ -z "$__drift" ] ||
        die "Guardrail drift on $__cfg (keys: $__drift). Restore with: chezmoi apply ~/.config/claude/settings.json"
      __dot_claude="$AGENT_CONFIG_DIR/.claude.json"
      if [ -f "$__dot_claude" ]; then
        __mcp_drift=$(jq -rn --slurpfile m "$__manifest" --slurpfile d "$__dot_claude" '
          ($m[0]) as $man | ($d[0]) as $dot |
          [
            (if ($dot.mcpServers // {}) != $man.mcpServers then "mcpServers" else empty end),
            (if any(($dot.projects // {})[] | select(type == "object"); ((.mcpServers // {}) | length > 0) or ((.enabledMcpjsonServers // []) | length > 0) or ((.allowedTools // []) | length > 0)) then "projects.*.mcpServers/allowedTools" else empty end)
          ] | join(", ")
        ' 2>/dev/null || echo "parse-error")
        [ -z "$__mcp_drift" ] ||
          die "Guardrail drift on $__dot_claude (keys: $__mcp_drift). Restore with: chezmoi apply ~/.config/claude/.claude.json"
      fi
    elif ! jq -e '
      (.disableAllHooks != true)
      and ((.permissions.defaultMode // "") != "bypassPermissions")
      and any((.hooks.PreToolUse // [])[] | (.hooks // [])[]; (.command // "") | contains("claude-guard.mjs"))
    ' "$__cfg" >/dev/null 2>&1; then
      die "Guardrail check failed on $__cfg (disableAllHooks, bypassPermissions, or missing claude-guard.mjs hook). Restore with: chezmoi apply ~/.config/claude/settings.json"
    fi
    ;;
  pi)
    [ -r "$__dcg_dir/pi-guard.ts" ] ||
      die "Guardrail missing: $__dcg_dir/pi-guard.ts (run chezmoi apply)"
    ;;
  omp)
    [ -r "$__dcg_dir/omp-guard.ts" ] ||
      die "Guardrail missing: $__dcg_dir/omp-guard.ts (run chezmoi apply)"
    ;;
  opencode)
    __target="$__dcg_dir/opencode-guard.js"
    __link="$AGENT_CONFIG_DIR/plugins/dcg-guard.js"
    [ -r "$__target" ] ||
      die "Guardrail missing: $__target (run chezmoi apply)"
    __link_real=$(readlink -f "$__link" 2>/dev/null || true)
    __target_real=$(readlink -f "$__target" 2>/dev/null || true)
    if [ ! -L "$__link" ] || [ -z "$__link_real" ] || [ "$__link_real" != "$__target_real" ]; then
      die "Guardrail check failed on $__link (must symlink to $__target). Restore with: chezmoi apply ~/.config/opencode/plugins/dcg-guard.js"
    fi
    ;;
  esac
}

verify_guardrails

# claude -w: the worktree args lead the forwarded argv (args after -- follow),
# so every exec path below runs claude --worktree [name] …
if [ "$claude_wt" = true ]; then
  if [ -n "$claude_wt_name" ]; then
    set -- --worktree "$claude_wt_name" "$@"
  elif [ "$claude_wt_sep" = true ]; then
    # Only a word needs shielding from binding as the name; a flag-shaped
    # first arg must stay a flag (after `--` claude would read it as text).
    case "${1:-}" in
    '' | -*) set -- --worktree "$@" ;;
    *) set -- --worktree -- "$@" ;;
    esac
  else
    set -- --worktree "$@"
  fi
fi

# Inject read-only guardrails via CLI flags (skipped for utility subcommands
# that do not start a session). Because ~/.config/dcg/ is read-only inside nono,
# these guards survive even if the agent rewrites its own user settings file.
case "$AGENT_NAME" in
claude)
  case "${1:-}" in
  auth | doctor | install | mcp | plugin | setup-token | update | upgrade | -v | --version) ;;
  *) set -- --settings "$CONFIG_HOME/dcg/claude-settings.json" "$@" ;;
  esac
  ;;
pi)
  case "${1:-}" in
  auth | config | install | list | mcp | remove | uninstall | update | -v | --version) ;;
  *) set -- --extension "$CONFIG_HOME/dcg/pi-guard.ts" "$@" ;;
  esac
  ;;
omp)
  case "${1:-}" in
  clip | completions | compress | gallery | grep | grievances | install | plugin | predict | read | update | upgrade | -v | --version) ;;
  *) set -- "--extension=$CONFIG_HOME/dcg/omp-guard.ts" "$@" ;;
  esac
  ;;
esac

# Leaf commands whose help (opencode v2.3.2) lists no --standalone: they own
# their server or never talk to one, so the flag is rejected. The flag is
# per leaf, not per group: `group:leaf` entries match the first two words.
OPENCODE_NO_STANDALONE='acp pair serve service uninstall update upgrade debug:heap-dump debug:paths mcp:add mcp:debug mcp:get mcp:remove plugin:add plugin:remove'

# Every command that would take --standalone (the TUI, run, models, ...) needs
# a server: the launcher runs a fixed-port `opencode serve` inside the sandbox
# (see the exec below), since OpenCode's own random localhost port is not
# reachable past nono's proxy.
oc_server=false
if [ "$AGENT_NAME" = opencode ]; then
  case "${1:-}" in
  -v | --version) ;;
  '' | -*) oc_server=true ;;
  *)
    case " $OPENCODE_NO_STANDALONE " in
    *" $1 "* | *" $1:${2:-} "*) ;;
    *) oc_server=true ;;
    esac
    ;;
  esac
fi

# Upstream opencode pack requirement: --standalone keeps OpenCode v2's server
# inside the sandbox instead of attaching to the shared background service.
# Injected before nested-launch dispatch so nested sandbox runs also get it.
if [ "$AGENT_NAME" = opencode ]; then
  case "${1:-}" in
  -v | --version) ;;
  *)
    standalone=false
    for __a in "$@"; do
      [ "$__a" = --standalone ] && standalone=true
    done
    if [ "$standalone" = false ]; then
      case " $OPENCODE_NO_STANDALONE " in
      *" ${1:-} "* | *" ${1:-}:${2:-} "*) ;;
      *) set -- --standalone "$@" ;;
      esac
    fi
    ;;
  esac
fi

# Nested launch: the outer launcher supervised engram and nono stripped secrets from the env;
# verify read-only sandbox containment via the canary before trusting AGENT_SANDBOX.
__canary="$CONFIG_HOME/dcg/sandbox-ro-canary"
if [ -n "${AGENT_SANDBOX:-}" ] && [ -f "$__canary" ] && ! (: >>"$__canary") 2>/dev/null; then
  ok "Sandbox: inherited (nested launch); DCG guards: active"
  exec "$BINARY_NAME" "$@"
fi

if [ "$no_sandbox" = true ]; then
  command -v engram >/dev/null 2>&1 && ensure_engram
  ok "Sandbox: disabled (--no-sandbox); DCG guards: active; the agent env carries REAL credential values"
  exec "$BINARY_NAME" "$@"
fi

# Ephemeral-container heuristics after home/.chezmoi.yaml.tmpl: dockerenv/
# containerenv files and cgroup markers match it; WSL is a persistent host, so
# it cancels a match. Deliberately stricter on mountinfo: only an overlay ROOT
# mount counts, because a desktop running containers carries overlay mounts in
# PID 1's mountinfo, and a false positive here runs the agent unsandboxed.
isContainer() {
  # AGENT_HOST_ROOT (empty default) prefixes the paths below: a test seam for fixture roots; real hosts leave it unset.
  __root="${AGENT_HOST_ROOT:-}"
  __container=false
  __explicit=false
  if [ -e "$__root/.dockerenv" ] || [ -e "$__root/run/.containerenv" ]; then
    __container=true
    __explicit=true
  fi
  [ -e "$__root/proc/1/cgroup" ] &&
    grep -Eq 'docker|lxc|podman|kubepods|containerd' "$__root/proc/1/cgroup" && __container=true
  [ -e "$__root/proc/1/mountinfo" ] &&
    awk '$5 == "/" { for (i = 7; i <= NF; i++) if ($i == "-") { fs = $(i + 1); break } } END { print fs }' \
      "$__root/proc/1/mountinfo" | grep -qx overlay && __container=true
  if [ "$__container" = true ] && [ "$__explicit" = false ]; then
    if [ -n "${WSL_DISTRO_NAME:-}" ] || [ -n "${WSL_INTEROP:-}" ] ||
      { [ "$UNAME_S" = Linux ] && uname -r | tr '[:upper:]' '[:lower:]' | grep -q microsoft; }; then
      __container=false
    fi
  fi
  [ "$__container" = true ]
}

# nono absent: on ephemeral container hosts nono is not installed and the
# container itself is the boundary, so the agent runs directly; anywhere
# else this is a misconfigured host.
if ! command -v nono >/dev/null 2>&1; then
  if isContainer; then
    command -v engram >/dev/null 2>&1 && ensure_engram
    info "Sandbox: container (nono not installed; the container is the boundary)"
    exec "$BINARY_NAME" "$@"
  fi
  die "nono not found on PATH: install nono (chezmoi-managed) or pass --no-sandbox"
fi

# The profile extends the upstream pack, which nono does not fetch on its own;
# name the fix before nono fails with "Profile not found".
NONO_PACK_DIR="${NONO_CONFIG:-$CONFIG_HOME/nono}/packages/nolabs-ai/$NONO_PROFILE"
[ -d "$NONO_PACK_DIR" ] ||
  info "nono pack nolabs-ai/$NONO_PROFILE is not installed: run 'nono pull nolabs-ai/$NONO_PROFILE' in your terminal"

# Engram must start before the sandboxed launch: its curl health-check must
# reach localhost directly, not through the nono proxy.
ensure_engram

# Agents never get a tmux server (no socket dir in the sandbox in any
# direction); unsetting keeps an inherited host-session marker out of the env.
unset TMUX

# Runner-context marker: suites gate live probes on it (loud skips
# in-sandbox); host shells stay marker-free and run for real.
export AGENT_SANDBOX=1

# Denials stay silent EPERM (agents report them): nono's post-run "Review
# denied paths" selector is the only prompt UI; also blocks saved-grant drift.
export NONO_NO_SAVE_PROMPT=1

# nono rejects a set-but-empty XDG_RUNTIME_DIR (some GUI-spawned shells
# export one); unset is fine.
[ -n "${XDG_RUNTIME_DIR:-}" ] || unset XDG_RUNTIME_DIR

# nono's runtime logs go to a file: on stderr they print into the agent TUI.
NONO_LOG="${XDG_STATE_HOME:-$HOME/.local/state}/nono/$NONO_PROFILE.log"
mkdir -p "${NONO_LOG%/*}"

# --allow-cwd: pwd_guard already limited launches to a git worktree, and the
# pack sets the cwd access level; without it nono blocks on a y/N prompt,
# which hangs unattended (orchestrator-spawned) launches.
dim "Launch: nono run --profile $NONO_PROFILE --allow-cwd -- $BINARY_NAME ..."
dim "Log:    $NONO_LOG"

if [ "$oc_server" = true ]; then
  # nono opens only explicit localhost ports: use the first free one; the
  # server and TUI share this sandbox and --server replaces --standalone.
  [ "${1:-}" = --standalone ] && shift
  oc_port=4096
  while nc -z 127.0.0.1 "$oc_port" 2>/dev/null; do oc_port=$((oc_port + 1)); done
  oc_log="${XDG_STATE_HOME:-$HOME/.local/state}/opencode/serve.log"
  mkdir -p "${oc_log%/*}"
  # Single quotes are deliberate: the script expands inside the sandbox.
  # shellcheck disable=SC2016
  exec nono run --profile "$NONO_PROFILE" --allow-cwd --open-port "$oc_port" --log-file "$NONO_LOG" -- sh -c '
    port=$1 log=$2
    shift 2
    # serve and client share this per-launch password (set after nono strips
    # *PASSWORD*); serve logs it, so the log keeps only the live session.
    OPENCODE_PASSWORD=$(od -An -N24 -tx1 /dev/urandom | tr -d " \n")
    export OPENCODE_PASSWORD
    opencode serve --hostname 127.0.0.1 --port "$port" >"$log" 2>&1 &
    pid=$!
    trap "kill $pid 2>/dev/null" EXIT INT TERM
    n=0
    until nc -z 127.0.0.1 "$port" 2>/dev/null; do
      n=$((n + 1))
      if [ "$n" -gt 100 ] || ! kill -0 "$pid" 2>/dev/null; then
        printf "opencode serve did not start on port %s (see %s)\n" "$port" "$log" >&2
        exit 1
      fi
      sleep 0.2
    done
    opencode --server "http://127.0.0.1:$port" "$@"
  ' sh "$oc_port" "$oc_log" "$@"
fi

exec nono run --profile "$NONO_PROFILE" --allow-cwd --log-file "$NONO_LOG" -- "$BINARY_NAME" "$@"
