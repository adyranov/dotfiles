{{- /* base/github/external — `.chezmoiexternal.toml` block for a GitHub file or archive.
  Args (dict):
    type            — "archive" | "file" (required)
    target          — destination key (required)
    repo            — "owner/repo@ref" where ref is a tag, branch, or commit (required)
    source          — file path inside repo (required when type = "file")
    stripComponents — int, default 1 (archive only)
    include         — list of glob patterns (archive only)
    exclude         — list of glob patterns to exclude (archive only)
    exact           — bool, emits `exact = true`
    refreshPeriod   — string; defaults to "168h" for main/master, omitted otherwise
  Refs are explicit so rendering never requires GitHub API access. */ -}}
{{- $type := .type -}}
{{- if and (ne $type "archive") (ne $type "file") -}}
{{-   fail (printf "base/github/external: unknown type %q (want \"archive\" or \"file\")" $type) -}}
{{- end -}}
{{- $repoParts := splitList "@" .repo -}}
{{- if ne (len $repoParts) 2 -}}
{{-   fail (printf "base/github/external: repo %q must include an explicit @ref" .repo) -}}
{{- end -}}
{{- $repoName := index $repoParts 0 -}}
{{- $ref := index $repoParts 1 -}}
{{- if or (not $repoName) (not $ref) -}}
{{-   fail (printf "base/github/external: invalid repo %q" .repo) -}}
{{- end -}}
{{- $refreshPeriod := get . "refreshPeriod" | default "" -}}
{{- if and (not $refreshPeriod) (or (eq $ref "main") (eq $ref "master")) -}}
{{-   $refreshPeriod = "168h" -}}
{{- end -}}
["{{ .target }}"]
{{- if eq $type "archive" }}
    type = "archive"
    url = "https://github.com/{{ $repoName }}/archive/{{ $ref }}.tar.gz"
    stripComponents = {{ default 1 (index . "stripComponents") }}
{{-   if index . "include" }}
    include = [{{ range $i, $p := index . "include" }}{{ if $i }}, {{ end }}"{{ $p }}"{{ end }}]
{{-   end }}
{{-   if index . "exclude" }}
    exclude = [{{ range $i, $p := index . "exclude" }}{{ if $i }}, {{ end }}"{{ $p }}"{{ end }}]
{{-   end }}
{{- else if eq $type "file" }}
    type = "file"
    url = "https://raw.githubusercontent.com/{{ $repoName }}/{{ $ref }}/{{ .source }}"
{{- end }}
{{- if $refreshPeriod }}
    refreshPeriod = "{{ $refreshPeriod }}"
{{- end }}
{{- if index . "exact" }}
    exact = true
{{- end }}
