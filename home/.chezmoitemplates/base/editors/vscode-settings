{{- /* Shared VS Code / Cursor settings.json modify-template body. */ -}}
{{- $s := .editors.vscode.settings -}}
{{- $current := dict -}}
{{- if and (hasKey .chezmoi "stdin") (not (empty (trim .chezmoi.stdin))) -}}
{{-   $current = fromJsonc .chezmoi.stdin -}}
{{-   if not $current -}}{{- $current = dict -}}{{- end -}}
{{- end -}}
{{- $managed := dict
    "workbench.colorTheme" $s.theme
    "workbench.iconTheme" $s.iconTheme
    "editor.fontFamily" (printf "%s, Menlo, Monaco, 'Courier New', monospace" $s.fontFamily)
    "editor.fontSize" $s.fontSize
    "editor.tabSize" $s.tabSize
    "editor.formatOnSave" $s.formatOnSave
    "editor.minimap.enabled" false
    "editor.renderWhitespace" "boundary"
    "editor.bracketPairColorization.enabled" true
    "editor.guides.bracketPairs" "active"
    "editor.linkedEditing" true
    "editor.stickyScroll.enabled" true
    "files.autoSave" "onFocusChange"
    "files.trimTrailingWhitespace" true
    "files.insertFinalNewline" true
    "files.trimFinalNewlines" true
    "terminal.integrated.fontFamily" $s.fontFamily
    "telemetry.telemetryLevel" "off"
    "extensions.autoUpdate" true
    "extensions.ignoreRecommendations" false
    "git.autofetch" true
    "git.confirmSync" false
    "git.enableSmartCommit" true
    "claudeCode.environmentVariables" (list (dict "name" "CLAUDE_CONFIG_DIR" "value" (printf "%s/%s" .chezmoi.homeDir (trimPrefix "~/" $s.claude_code_env_dir))))
-}}
{{- if eq .chezmoi.os "darwin" -}}
{{-   $_ := set $managed "terminal.integrated.defaultProfile.osx" "zsh" -}}
{{- else -}}
{{-   $_ := set $managed "terminal.integrated.defaultProfile.linux" "zsh" -}}
{{- end -}}
{{ mergeOverwrite $current $managed | toPrettyJson }}
