{{- /* base/ai/expand-path-groups — Resolve group names to filesystem path lists.
  Usage:
    {{ includeTemplate "base/ai/security/expand-path-groups" (dict "root" . "groups" (list "project_secrets" "ssh_private")) | mustFromJson }}
    {{ includeTemplate "base/ai/security/expand-path-groups" (dict "root" . "groups" $groupNames) | mustFromJson }}
  Output: JSON array of path strings, deduped and sorted.
  Fails render if any group name is unknown.
*/ -}}
{{- $root := .root -}}
{{- $groupNames := index . "groups" | default list -}}
{{- $catalog := (includeTemplate "base/helpers/load-section" (dict "root" $root "section" "ai.permissions.filesystem.paths" "required" true) | mustFromJson) -}}
{{- $result := list -}}
{{- range $name := $groupNames -}}
{{-   if not (hasKey $catalog $name) -}}
{{-     fail (printf "expand-path-groups: unknown path group %q. Available: [%s]" $name (keys $catalog | sortAlpha | join ", ")) -}}
{{-   end -}}
{{-   $paths := index $catalog $name -}}
{{-   $result = concat $result $paths -}}
{{- end -}}
{{- $result | uniq | sortAlpha | toJson -}}
