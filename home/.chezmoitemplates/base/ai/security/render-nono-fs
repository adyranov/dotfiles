{{- /* render-nono-fs — Build the base nono filesystem section from the permission data.
  Usage: {{ includeTemplate "base/ai/security/render-nono-fs" (dict "root" .) | mustFromJson }}
  Output: JSON { allow, read, write, deny } plus unix_socket_subtree only
  when the data grants sockets (empty data key emits nothing).
  Input: ai.permissions.filesystem { read, write, deny, unix_socket_subtree } —
  read/write/deny list path-group names expanded from filesystem.paths.
  Full r+w = every write-group path (nono "allow" is read+write); read-only =
  read-group paths with no write group; tier pipeline in build-fs-tiers. Deny
  carries "~/.config/nono" and its profiles children so an agent cannot edit
  its own (or the base) profile and escalate on relaunch. The
  apply-destination mechanism is removed: live-home applies are
  user-terminal-only and no destination grant joins the write tier. This
  section is NOT a general home-write boundary — the write grants it does
  render are audited separately.
*/ -}}
{{- $root := index . "root" -}}
{{- $fs := (includeTemplate "base/helpers/load-section" (dict "root" $root "section" "ai.permissions.filesystem" "required" true) | mustFromJson) -}}
{{- $read := includeTemplate "base/ai/security/expand-path-groups" (dict "root" $root "groups" (index $fs "read" | default list)) | mustFromJson -}}
{{- $write := includeTemplate "base/ai/security/expand-path-groups" (dict "root" $root "groups" (index $fs "write" | default list)) | mustFromJson -}}
{{- $deny := includeTemplate "base/ai/security/expand-path-groups" (dict "root" $root "groups" (index $fs "deny" | default list)) | mustFromJson -}}
{{- /* Deny the nono profile dir so an agent cannot escalate via its own
  profile. A dir-literal deny covers the dir only, so children ride their own
  keys (dir + dir/*): `**` collapses to the bare dir at render
  (strip-tilde-tails, SIGILL guard); profiles/* blocks overwriting the
  EXISTING profiles/<agent>.json (next-launch escalation). */ -}}
{{- $deny = concat $deny (list "~/.config/nono" "~/.config/nono/profiles" "~/.config/nono/profiles/*") -}}
{{- /* Deny the mise trust store leaves: `mise trust *` is command-axis denied
  and trust lands as links under the granted state parent, so a direct write
  is self-trust — repo mise [tasks] execute on the next mise run. dir+`*`
  keys (share root rides for pre-v6 mise). Renderer-side, NOT a data deny
  group: expanded deny groups join apply-dest-guard's protected floor, and
  the legitimate mise dir grants contain these leaves — the guard refuses
  dir grants containing protected roots. */ -}}
{{- $deny = concat $deny (list
  "~/.local/state/mise/trusted-configs"
  "~/.local/state/mise/trusted-configs/*"
  "~/.local/share/mise/trusted-configs"
  "~/.local/share/mise/trusted-configs/*") -}}
{{- /* Base also honors the agents' overlay hook reads: an overlay cannot subtract a
  base allow (realpath-aware: the ~/.pi symlink into ~/.config/pi silently shadowed
  the pi hook carve-out). */ -}}
{{- $agents := (includeTemplate "base/helpers/load-section" (dict "root" $root "section" "ai.agents" "required" false) | mustFromJson) -}}
{{- $fsCatalog := (includeTemplate "base/helpers/load-section" (dict "root" $root "section" "ai.permissions.filesystem.paths" "required" true) | mustFromJson) -}}
{{- $extraCarve := list -}}
{{- range $name, $a := $agents -}}{{- if eq (kindOf $a) "map" -}}{{- $extraCarve = concat $extraCarve (includeTemplate "base/ai/security/resolve-path-refs" (dict "root" $root "refs" (dig "sandbox" "filesystem" "read" list $a) "catalogJson" $fsCatalog) | mustFromJson) -}}{{- end -}}{{- end -}}
{{- $tiers := includeTemplate "base/ai/security/build-fs-tiers" (dict "root" $root "read" $read "write" $write "deny" $deny "extraCarve" $extraCarve) | mustFromJson -}}
{{-   $out := dict
  "allow" (index $tiers "allow")
  "read" (index $tiers "read")
  "write" (list)
  "deny" (index $tiers "deny")
-}}
{{- /* Socket key rides only when the data grants sockets: base.json carries
  no stale/empty grants (base socket lane is empty: tmux is denied). */ -}}
{{- $sockets := index $fs "unix_socket_subtree" | default list -}}
{{- if $sockets -}}{{- $_ := set $out "unix_socket_subtree" (includeTemplate "base/ai/security/uniq-sort" $sockets | mustFromJson) -}}{{- end -}}
{{- $out | toJson -}}
