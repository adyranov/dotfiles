def main():
    data = json.loads(sys.argv[1])
    reads = [r for r in (anchored(p) for p in data.get("read", [])) if r]
    out = []
    for entry in data.get("allow", []):
        a = anchored(entry)
        if a and any(r != a and r.startswith(a + os.sep) for r in reads):
            continue
        out.append(entry)
    print(json.dumps(out))


if __name__ == "__main__":
    main()
