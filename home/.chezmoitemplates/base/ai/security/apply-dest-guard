def main():
    data = json.loads(sys.argv[1])
    exempt = {anchored(e) for e in data.get("exempt", [])}
    allow_globs = bool(data.get("allow_globs"))
    protected = [
        r
        for r in (anchored(glob_free_prefix(e)) for e in PROTECTED + data.get("protected", []))
        if r and r not in exempt
    ]

    violations = []
    for dest in data.get("destinations", []):
        if dest == ".":
            continue  # nono's own cwd entry in the command-sandbox lists, not an anchorable path
        if dest.startswith("@"):
            # nono provider token (@git:config-files): expanded at sandbox build,
            # and the provider enforces its own trust — nothing to anchor here.
            continue
        if any(c in dest for c in GLOB_CHARS) and not allow_globs:
            violations.append(f"{dest}: glob characters are not valid apply destinations")
            continue
        target = anchored(glob_free_prefix(dest)) if allow_globs else anchored(dest)
        if not target:
            violations.append(f"{dest}: entries must be literal absolute paths")
            continue
        for root in protected:
            if target == root:
                why = "equals protected path"
            elif target.startswith(root + os.sep):
                why = "is inside protected path"
            elif target == os.sep:
                # `/` is the ancestor of everything, including every protected root.
                why = "contains protected path"
            elif root.startswith(target + os.sep):
                why = "contains protected path"
            else:
                continue
            violations.append(f"{dest}: {why} {root}")
            break

    print(json.dumps(violations))


if __name__ == "__main__":
    main()
