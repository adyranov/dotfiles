#!/usr/bin/env python3
"""apply-dest-guard — Render-time validator for the nono command-sandbox path
GRANTS: render-nono-cmd feeds it the chezmoi command_sandbox_* lists and every
per-command fs/exec list. A sandbox grant equal to, an ancestor of, or a
descendant of a protected root would hand an agent its own sandbox, its DCG
gate, an agent runtime config, or a rendered shell file. The descendant
direction is load-bearing: a literal directory deny covers only the directory
itself (see the ssh group comment in permissions.toml), so
`~/.config/nono/profiles/base.json` must be refused, not granted.

Realpath-aware comparison (filter-shadowed-allow's pattern): `~/.pi` is a host
symlink into `~/.config/pi`. On macOS the comparison is case-folded (the
default volume is case-insensitive, so `~/.CONFIG/nono` is that root).
Protected entries anchor on their glob-free prefix (`~/.claude/**` ->
`~/.claude`); rootless globs (`**/.env`) anchor nowhere. Entries must be
literal absolute or `~/` paths: a relative path resolves against the runtime
cwd, which no launch-time grant can bound (the cwd entry "." in the
command-sandbox lists is the one accepted non-anchorable exception).
This is the protected floor, not a containment proof — an entry outside the
home dir (e.g. `/tmp/x`) is accepted by design and bounded by the filesystem
axis; `/` (and anything resolving to it, like `~/../..`) is refused. A grant
that CONTAINS a protected root is refused outright (the deleted
apply-destination mechanism's allow_contains parent carve-outs had no
callers left).

CLI: argv[1] = JSON {"destinations": [...], "protected": [...], "exempt": [...],
"allow_globs": true}
`destinations` is the validated entry list (legacy key name, kept for the
fixture contract).
`exempt` drops built-in roots from this call's floor: the chezmoi command
sandbox grants chezmoi's own config/state dir because the command cannot run
without it.
`allow_globs` (the production grant-list calls) admits native-glob GRANT
entries — nono renders fs globs verbatim, so a shim-scan grant like
`installs/**` is a valid grant. Entry comparison anchors on the glob-free
prefix (same as protected entries), so `~/.config/nono/**` is refused (inside
protected) and a broad `~/.config/**` fails the contains check. Calls without
it stay strict: globs are refused.
Provider tokens (`@provider:token`, e.g. `@git:config-files`) are skipped:
nono expands them at sandbox build and the provider enforces its own trust.
Output: JSON array of violation strings, each naming its entry (empty = accepted).
Always exits 0 — the caller renders the loud `fail` (expand-path-groups'
precedent), which also lets the suite assert on the report.
"""
import json
import os
import sys

# Protected by construction, never grant-list members (not even nested ones);
# the expanded deny groups arrive via argv. The shell-code roots are the rendered
# shell files (~/.zshenv, ~/.config/{zsh,shell}) and the shell-init pair
# (~/Library/Scripts/setenv.sh plus its LaunchAgents loader). ~/.config/chezmoi
# is chezmoi's own config+state: an applicable config.toml would let an agent
# redirect the source dir the user's next terminal apply renders.
PROTECTED = [
    "~/.config/chezmoi",
    "~/.config/dcg",
    "~/.config/nono",
    "~/.config/omp",
    "~/.config/opencode",
    "~/.config/pi",
    "~/.config/shell",
    "~/.config/zsh",
    "~/Library/LaunchAgents",
    "~/Library/Scripts",
    "~/.zshenv",
]

