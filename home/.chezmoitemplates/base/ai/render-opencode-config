{{- /* Render opencode managed config dict as JSON */ -}}
{{- $root := .root -}}
{{- $profile := .profile | default "core" -}}

{{- /* ── Layers ── */ -}}
{{- $opencode := includeTemplate "base/helpers/load-section" (dict "root" $root "section" "ai.agents.opencode" "required" true) | mustFromJson -}}
{{- $personas := includeTemplate "base/helpers/load-section" (dict "root" $root "section" "ai.models.personas" "required" true) | mustFromJson -}}
{{- $cmdPolicies := includeTemplate "base/ai/collect-policies" (dict "root" $root) | mustFromJson -}}
{{- $cmdDeny := index $cmdPolicies "deny" | default list -}}


{{- /* ── Model IDs ── */ -}}
{{- $defaults := index $personas $personas.default -}}
{{- $modelId := includeTemplate "base/ai/render-opencode-model-id" $defaults -}}
{{- $smallModelId := $modelId -}}
{{- if hasKey $personas "utility" -}}
{{-   $smallModelId = includeTemplate "base/ai/render-opencode-model-id" (index $personas "utility") -}}
{{- end -}}

{{- /* ── Settings (read directly from TOML; data is required) ── */ -}}
{{- $s := $opencode.settings -}}

{{- /* compaction */ -}}
{{- $compaction := dict
  "auto" $s.compaction.auto
  "prune" true
  "reserved" $s.compaction.reserved
  "tail_turns" 6
-}}

{{- /* tool_output */ -}}
{{- $toolOutput := dict
  "max_lines" $s.tool_output.max_lines
  "max_bytes" $s.tool_output.max_bytes
-}}

{{- /* watcher */ -}}
{{- $watcher := dict "ignore" $s.watcher.ignore -}}

{{- /* attachment */ -}}
{{- $imageConfig := dict
  "auto_resize" true
  "max_width" 2000
  "max_height" 2000
  "max_base64_bytes" 5242880
-}}
{{- $attachment := dict "image" $imageConfig -}}


{{- /* ── Permissions ── */ -}}
{{- $agentPerms := includeTemplate "base/ai/collect-agent-permissions" (dict "root" $root "agentData" $opencode) | mustFromJson -}}
{{- $allDeny := index $agentPerms "deny" -}}
{{- $infraReadPaths := index $agentPerms "infra_read" -}}
{{- $bash := includeTemplate "base/ai/render-deny-map" (dict "deny" $cmdDeny) | mustFromJson -}}
{{- $editObj := includeTemplate "base/ai/render-deny-map" (dict "deny" $allDeny) | mustFromJson -}}
{{- $readObj := includeTemplate "base/ai/render-deny-map" (dict "deny" $allDeny "exclude" $infraReadPaths) | mustFromJson -}}
{{- $permission := dict
  "*" "allow"
  "read" $readObj
  "edit" $editObj
  "glob" "allow"
  "grep" "allow"
  "list" "allow"
  "task" "allow"
  "question" "allow"
  "webfetch" "allow"
  "websearch" "allow"
  "lsp" "allow"
  "skill" "allow"
  "todowrite" "allow"
  "doom_loop" "deny"
  "bash" $bash
  "external_directory" "allow"
-}}
{{- /* ── Profile plugins (resolved via extends) ── */ -}}
{{- $profileData := includeTemplate "base/ai/resolve-profile" (dict "agentData" $opencode "profile" $profile) | mustFromJson -}}
{{- $plugins := $profileData.plugins | default list -}}
{{- $renderedPlugins := list -}}
{{- range $plugin := $plugins -}}
{{-   if and (kindIs "string" $plugin) (eq $plugin "@plannotator/opencode") -}}
{{- $planningAgents := get $profileData "plannotator_planning_agents" | default (list "plan") -}}
{{-     $renderedPlugins = append $renderedPlugins (list "@plannotator/opencode@latest" (dict "workflow" "plan-agent" "planningAgents" $planningAgents)) -}}
{{-   else -}}
{{-     $renderedPlugins = append $renderedPlugins $plugin -}}
{{-   end -}}
{{- end -}}

{{- /* ── Built-in agents ── */ -}}
{{- $builtinAgentCategories := dict
  "build" "coder"
  "plan" "architect"
  "general" "researcher"
  "explore" "locator"
  "scout" "researcher"
-}}
{{- $builtinAgentModes := dict "build" "primary" "plan" "primary" "general" "subagent" "explore" "subagent" "scout" "subagent" -}}
{{- $agentOverrides := dict -}}
{{- range $agent := keys $builtinAgentCategories | sortAlpha -}}
{{-   $category := index $builtinAgentCategories $agent -}}
{{-   $route := index $personas $category -}}
{{-   if not $route -}}
{{-     fail (printf "render-opencode-config: ai.models has no route for category %q (mapped by agent %q)" $category $agent) -}}
{{-   end -}}
{{-   $agentModelId := includeTemplate "base/ai/render-opencode-model-id" $route -}}
{{-   $agentConfig := dict "model" $agentModelId "mode" (get $builtinAgentModes $agent | default "all") -}}
{{-   $thinking := get $route "thinking" | default "off" -}}
{{-   if ne $thinking "off" -}}
{{-     $_ := set $agentConfig "variant" $thinking -}}
{{-   end -}}
{{-   $_ := set $agentOverrides $agent $agentConfig -}}
{{- end -}}
{{- $disabledAgents := get $profileData "disabled_agents" | default list -}}
{{- range $agent := $disabledAgents -}}
{{-   $agentConfig := get $agentOverrides $agent | default dict -}}
{{-   $_ := set $agentConfig "disable" true -}}
{{-   $_ := set $agentOverrides $agent $agentConfig -}}
{{- end -}}
{{- /* ── Plannotator: configure plan agent prompt and permissions if plugin active ── */ -}}
{{- $hasPlannotator := false -}}
{{- $plannotatorPlanningAgents := list -}}
{{- range $p := $renderedPlugins -}}
{{-   if and (kindIs "slice" $p) (hasPrefix "@plannotator/opencode" (index $p 0)) -}}
{{-     $hasPlannotator = true -}}
{{-     $plannotatorPlanningAgents = get (index $p 1) "planningAgents" | default (list "plan") -}}
{{-   end -}}
{{- end -}}
{{- if $hasPlannotator -}}
{{-   range $agentName := $plannotatorPlanningAgents -}}
{{-     if hasKey $agentOverrides $agentName -}}
{{-       $agentCfg := get $agentOverrides $agentName -}}
{{-       $planningPrompt := includeTemplate "base/ai/render-plannotator-prompts" (dict "phase" "planning" "submit_tool" "submit_plan" "advisor_tool" "" "platform_note" "") -}}
{{-       $_ := set $agentCfg "prompt" $planningPrompt -}}
{{-       $_ := set $agentCfg "permission" (dict "edit" (dict ".plannotator/**" "allow" "*" "deny") "bash" "deny") -}}
{{-     end -}}
{{-   end -}}
{{- end -}}

{{- /* ── Skills & instructions ── */ -}}
{{- $basePaths := index $opencode.skills "paths" | default list -}}
{{- $profilePaths := get $profileData "skills_paths" | default list -}}
{{- $skillsPaths := concat $basePaths $profilePaths | uniq -}}
{{- $instructionsFiles := index $opencode.instructions "files" | default list -}}

{{- /* ── Output ── */ -}}
{{- $hasFormatter := dig "formatter" true $s -}}
{{- $hasLsp := dig "lsp" true $s -}}
{{- $hasSnapshot := dig "snapshot" true $s -}}
{{- $autoupdate := dig "autoupdate" "notify" $s -}}
{{- $share := dig "share" "disabled" $s -}}
{{- $result := dict
  "$schema" "https://opencode.ai/config.json"
  "model" $modelId
  "small_model" $smallModelId
  "autoupdate" $autoupdate
  "share" $share
  "snapshot" $hasSnapshot
  "permission" $permission
  "compaction" $compaction
  "tool_output" $toolOutput
  "skills" (dict "paths" $skillsPaths)
  "instructions" $instructionsFiles
  "default_agent" (get $profileData "default_agent" | default "build")
-}}

{{- $_ := set $result "watcher" $watcher -}}
{{- $_ := set $result "attachment" $attachment -}}
{{- if $renderedPlugins -}}{{- $_ := set $result "plugin" $renderedPlugins -}}{{- end -}}
{{- $_ := set $result "agent" $agentOverrides -}}
{{- if $hasFormatter -}}{{- $_ := set $result "formatter" true -}}{{- end -}}
{{- if $hasLsp -}}{{- $_ := set $result "lsp" true -}}{{- end -}}

{{- $mcpServers := get $profileData "mcp_servers" | default dict -}}
{{- if ne (len $mcpServers) 0 -}}{{- $_ := set $result "mcp" $mcpServers -}}{{- end -}}

{{- $result | toPrettyJson -}}
