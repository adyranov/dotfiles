{{- $entry := .entry -}}
{{- $label := get . "label" | default "library entry" -}}
{{- $repositories := get . "repositories" | default dict -}}
{{- $repository := get $entry "repository" | default "" -}}
{{- if $repository -}}
{{-   if hasKey $entry "repo" -}}{{- fail (printf "%s: use repository or repo, not both" $label) -}}{{- end -}}
{{-   $entry = get $repositories $repository | default dict -}}
{{-   if eq (len $entry) 0 -}}{{- fail (printf "%s: unknown repository %q" $label $repository) -}}{{- end -}}
{{- end -}}
{{- $repo := get $entry "repo" | default "" -}}
{{- if not $repo -}}{{- fail (printf "%s: repo is required" $label) -}}{{- end -}}
{{- $ref := get $entry "ref" | default "" -}}
{{- if not $ref -}}{{- fail (printf "%s: ref is required" $label) -}}{{- end -}}
{{- printf "%s@%s" $repo $ref -}}
