{{- /* Resolve concurrent subagent limit for a preset (falls back to top-level ai.presets then ai.subagent_limit). */ -}}
{{- $root := .root -}}
{{- $prof := index $root.ai.profiles $root.host.profile -}}
{{- $presetName := get . "preset" | default $prof.default_preset -}}
{{- $preset := dig "presets" $presetName dict $prof -}}
{{- if not $preset -}}{{- $preset = dig "presets" $presetName dict $root.ai -}}{{- end -}}
{{- index $preset "subagent_limit" | default $root.ai.subagent_limit | int -}}
