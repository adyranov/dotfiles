{{- /* Render Pi profile settings managed dict as JSON */ -}}
{{- $pi := includeTemplate "base/helpers/load-section" (dict "root" .root "section" "ai.agents.pi" "required" true) | mustFromJson -}}
{{- $tiers := includeTemplate "base/ai/models/load-default-tiers" (dict "root" .root "required" true) | mustFromJson -}}
{{- if not (hasKey $tiers "default") -}}{{- fail "ai.tiers has no 'default' key" -}}{{- end -}}
{{- $profile := includeTemplate "base/ai/agents/resolve-profile" (dict "agentData" $pi "profile" .profile) | mustFromJson -}}
{{- $defaults := index $tiers $tiers.default -}}
{{- $enabledAuth := includeTemplate "base/ai/auth/resolve-enabled-auth-providers" (dict "root" .root) | mustFromJson -}}
{{- /* Pi's enabledModels is the union of every enabled managed model and every
       declared serving model (keyless local/remote endpoints included); this is
       exactly resolve-enabled-auth-providers' valid_models. Union the selected
       preset's provider-qualified routes too, so a profile without explicit
       managed enablement still exposes the models it actually routes to. */ -}}
{{- $enabledModels := get $enabledAuth "valid_models" | default list -}}
{{- if not (get $enabledAuth "has_enabled_data" | default false) -}}
{{- range $_, $route := $tiers -}}
{{-   if not (kindIs "map" $route) -}}{{ continue }}{{- end -}}
{{-   if not (and (hasKey $route "provider") (hasKey $route "model")) -}}{{ continue }}{{- end -}}
{{-   $enabledModels = append $enabledModels (includeTemplate "base/ai/agents/pi/render-pi-model-ref" $route) -}}
{{- end -}}
{{- end -}}
{{- $enabledModels = $enabledModels | uniq -}}
{{- $settings := $pi.settings -}}
{{- $packages := list -}}
{{- $skills := list -}}
{{- range $skill := get $profile "skills" | default list -}}
{{-   $skills = append $skills (printf "../../agents/skills/%s" $skill) -}}
{{- end -}}
{{- $filters := get $profile "package_filters" | default dict -}}
{{- range $name := $profile.packages -}}
{{- /* Scheme-qualified entries (git:, npm:) pass verbatim; bare names are npm.
  ponytail: contains-":" heuristic; whitelist npm:/git: prefixes if pi grows
  scheme support. */ -}}
{{-   $source := $name -}}
{{-   if not (contains ":" $name) -}}{{- $source = printf "npm:%s" $name -}}{{- end -}}
{{-   $filter := index $filters $name -}}
{{-   if $filter -}}
{{-     $pkg := dict "source" $source -}}
{{-     range $k, $v := $filter -}}
{{-       $_ := set $pkg $k $v -}}
{{-     end -}}
{{-     $packages = append $packages $pkg -}}
{{-   else -}}
{{-     $packages = append $packages $source -}}
{{-   end -}}
{{- end -}}
{{- $managed := dict
  "bashMode" (dict
    "toggleShortcut" $settings.bash_mode.toggle_shortcut
    "transcriptMaxBytes" $settings.bash_mode.transcript_max_bytes
    "transcriptMaxLines" $settings.bash_mode.transcript_max_lines
  )
  "compaction" (dict "enabled" true "keepRecentTokens" $profile.compaction.keep_recent_tokens "reserveTokens" $profile.compaction.reserve_tokens)
  "defaultModel" $defaults.model
  "defaultProvider" $defaults.provider
  "defaultThinkingLevel" $defaults.thinking
  "followUpMode" "all"
  "steeringMode" "all"
  "treeFilterMode" "no-tools"
  "enableInstallTelemetry" false
  "enabledModels" $enabledModels
  "npmCommand" (list "mise" "exec" "node@lts" "--" "npm")
  "packages" $packages
  "powerline" (dict
    "fixedEditor" $settings.powerline.fixed_editor
    "mouseScroll" $settings.powerline.mouse_scroll
    "preset" $settings.powerline.preset
  )
  "quietStartup" true
  "retry" (dict "baseDelayMs" 2000 "enabled" true "maxRetries" 3)
  "skills" $skills
  "theme" $settings.theme
  "warnings" (dict "anthropicExtraUsage" true)
-}}
{{- if eq .profile "factory" -}}
{{- /* Fleet role -> tier-class map from profile data (fleet_role_tiers);
  tiers are the primary data, resolved per preset. */ -}}
{{-   $fleetTiers := get $profile "fleet_role_tiers" | default dict -}}
{{-   if $fleetTiers -}}
{{-     $agentOverrides := includeTemplate "base/ai/agents/pi/render-model-category-map" (dict "root" .root "field" "agents" "classMap" $fleetTiers) | mustFromJson -}}
{{-     $_ := set $managed "subagents" (dict "agentOverrides" $agentOverrides) -}}
{{-   end -}}
{{- end -}}
{{- $managed | toPrettyJson -}}
