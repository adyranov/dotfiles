{{- /*
  Renders category-mapped model routes from ai.models.tiers.

  Args (dict):
    root  — chezmoi data root (required)
    field — category field to render, usually "agents" or "skills" (default: "agents")

  Output: JSON dict of mappedName → {model, thinking},
  where model is "provider/model" when provider is set.
*/ -}}
{{- $root := .root -}}
{{- $field := index . "field" | default "agents" -}}
{{- $tiers := includeTemplate "base/ai/models/load-default-tiers" (dict "root" $root "required" true) | mustFromJson -}}
{{- $result := dict -}}
{{- range $tierName := keys $tiers | sortAlpha -}}
{{-   $route := index $tiers $tierName -}}
{{-   if not (kindIs "map" $route) -}}{{ continue }}{{- end -}}
{{-   if not (hasKey $route $field) -}}{{ continue }}{{- end -}}
{{-   if not (hasKey $route "model") -}}
{{-     fail (printf "ai.models.tiers.%s maps %s but has no model route" $tierName $field) -}}
{{-   end -}}
{{-   if not (hasKey $route "thinking") -}}
{{-     fail (printf "ai.models.tiers.%s maps %s but has no thinking route" $tierName $field) -}}
{{-   end -}}
{{-   $names := index $route $field | default list -}}
{{-   range $name := $names -}}
{{-     $model := includeTemplate "base/ai/agents/pi/render-pi-model-ref" $route -}}
{{-     $config := dict "model" $model "thinking" $route.thinking -}}
{{-     $result = merge $result (dict $name $config) -}}
{{-   end -}}
{{- end -}}
{{- $result | toJson -}}
