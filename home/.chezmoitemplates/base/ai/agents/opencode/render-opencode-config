{{- /* Render opencode managed config dict as JSON */ -}}
{{- $root := .root -}}
{{- $profile := .profile | default "core" -}}

{{- /* ── Layers ── */ -}}
{{- $opencode := includeTemplate "base/helpers/load-section" (dict "root" $root "section" "ai.agents.opencode" "required" true) | mustFromJson -}}
{{- $tiers := includeTemplate "base/ai/models/load-default-tiers" (dict "root" $root "required" true) | mustFromJson -}}
{{- $cmdPolicies := includeTemplate "base/ai/security/collect-policies" (dict "root" $root) | mustFromJson -}}
{{- $cmdDeny := index $cmdPolicies "deny" | default list -}}

{{- /* ── Serving providers (shared with Pi): enabled=false opts a provider out. ── */ -}}
{{- $serving := includeTemplate "base/helpers/load-section" (dict "root" $root "section" "ai.serving" "required" false) | mustFromJson -}}
{{- $localServing := index $serving "local" | default dict -}}
{{- $localEnabled := dig "enabled" true $localServing -}}

{{- /* ── Local LLM catalog (shared with Pi via load-local-models) ── */ -}}
{{- $localResolved := includeTemplate "base/ai/models/load-local-models" (dict "root" $root) | mustFromJson -}}
{{- $localModels := get $localResolved "models" | default dict -}}
{{- $localPort := get $localResolved "port" | default 8321 -}}
{{- $localProviderModels := dict -}}
{{- range $id, $m := $localModels -}}
{{-   $modelEntry := dict
        "name" (get $m "name" | default $id)
        "limit" (dict "context" (get $m "context_window" | default 128000) "output" (get $m "context_output" | default 8192))
      -}}
{{-   if get $m "reasoning" -}}
{{-     $_ := set $modelEntry "reasoning" true -}}
{{-   end -}}
{{-   $_ := set $localProviderModels $id $modelEntry -}}
{{- end -}}
{{- $providers := dict -}}
{{- if and $localEnabled $localProviderModels -}}
{{-   $_ := set $providers "local" (dict
        "npm" "@ai-sdk/openai-compatible"
        "name" "Local LLM Gateway"
        "options" (dict "baseURL" (printf "http://127.0.0.1:%v/v1" $localPort) "apiKey" "local")
        "models" $localProviderModels
      ) -}}
{{- end -}}

{{- /* ── Remote OpenAI-compatible serving providers (keyless, declared IDs) ── */}}
{{- range $spId, $sp := $serving -}}
{{-   if not (kindIs "map" $sp) -}}{{- continue -}}{{- end -}}
{{-   $spEnabled := dig "enabled" true $sp -}}
{{-   if and $spEnabled (eq (get $sp "kind" | default "") "openai-compatible") -}}
{{-     $baseURL := get $sp "base_url" | default "" -}}
{{-     if not $baseURL -}}
{{-       fail (printf "render-opencode-config: serving provider %q (openai-compatible) has no base_url" $spId) -}}
{{-     end -}}
{{-     $remoteProviderModels := dict -}}
{{-     range $m := get $sp "models" | default list -}}
{{-       $id := get $m "id" | default "" -}}
{{-       if not $id -}}
{{-         fail (printf "render-opencode-config: serving provider %q has a model without id" $spId) -}}
{{-       end -}}
{{- /* OpenCode v1 requires limit.output when limit is set; default it to its 8192 fallback. */ -}}
{{-       $modelEntry := dict
            "name" (get $m "name" | default $id)
            "limit" (dict "context" (get $m "context_window" | default 128000) "output" (get $m "max_output" | default 8192))
          -}}
{{-       if get $m "reasoning" -}}
{{-         $_ := set $modelEntry "reasoning" true -}}
{{-       end -}}
{{-       if has "image" (get $m "inputs" | default list) -}}
{{-         $_ := set $modelEntry "attachment" true -}}
{{-       end -}}
{{-       $_ := set $remoteProviderModels $id $modelEntry -}}
{{-     end -}}
{{-     if $remoteProviderModels -}}
{{-       $_ := set $providers $spId (dict
            "npm" "@ai-sdk/openai-compatible"
            "name" $spId
            "options" (dict "baseURL" $baseURL)
            "models" $remoteProviderModels
          ) -}}
{{-     end -}}
{{-   end -}}
{{- end -}}

{{- /* ── Model IDs ── */ -}}
{{- if not (hasKey $tiers "default") -}}{{- fail "ai.tiers has no 'default' key" -}}{{- end -}}
{{- $defaults := index $tiers $tiers.default -}}
{{- $modelId := includeTemplate "base/ai/agents/opencode/render-opencode-model-id" (dict "route" $defaults "root" $root) -}}
{{- $smallTier := index $tiers "small" | default dict -}}
{{- $smallModelId := $modelId -}}
{{- if $smallTier -}}
{{-   $smallModelId = includeTemplate "base/ai/agents/opencode/render-opencode-model-id" (dict "route" $smallTier "root" $root) -}}
{{- end -}}

{{- /* ── Settings (read directly from TOML; data is required) ── */ -}}
{{- $s := $opencode.settings -}}

{{- /* compaction */ -}}
{{- $compaction := dict
  "auto" $s.compaction.auto
  "prune" true
  "reserved" $s.compaction.reserved
  "tail_turns" 6
-}}

{{- /* tool_output */ -}}
{{- $toolOutput := dict
  "max_lines" $s.tool_output.max_lines
  "max_bytes" $s.tool_output.max_bytes
-}}

{{- /* watcher */ -}}
{{- $watcher := dict "ignore" $s.watcher.ignore -}}

{{- /* attachment */ -}}
{{- $imageConfig := dict
  "auto_resize" true
  "max_width" 2000
  "max_height" 2000
  "max_base64_bytes" 5242880
-}}
{{- $attachment := dict "image" $imageConfig -}}


{{- /* ── Permissions ── */ -}}
{{- $agentPerms := includeTemplate "base/ai/security/collect-agent-permissions" (dict "root" $root "agentData" $opencode) | mustFromJson -}}
{{- $allDeny := index $agentPerms "deny" -}}
{{- $infraReadPaths := index $agentPerms "infra_read" -}}
{{- $bash := includeTemplate "base/ai/security/render-deny-map" (dict "deny" $cmdDeny) | mustFromJson -}}
{{- $editObj := includeTemplate "base/ai/security/render-deny-map" (dict "deny" $allDeny) | mustFromJson -}}
{{- $readObj := includeTemplate "base/ai/security/render-deny-map" (dict "deny" $allDeny "exclude" $infraReadPaths) | mustFromJson -}}
{{- $permission := dict
  "*" "allow"
  "read" $readObj
  "edit" $editObj
  "glob" "allow"
  "grep" "allow"
  "list" "allow"
  "task" "allow"
  "question" "allow"
  "webfetch" "allow"
  "websearch" "allow"
  "lsp" "allow"
  "skill" "allow"
  "todowrite" "allow"
  "doom_loop" "deny"
  "bash" $bash
  "external_directory" "allow"
-}}
{{- /* ── Profile plugins (resolved via extends) ── */ -}}
{{- $profileData := includeTemplate "base/ai/agents/resolve-profile" (dict "agentData" $opencode "profile" $profile) | mustFromJson -}}
{{- $plugins := $profileData.plugins | default list -}}
{{- $renderedPlugins := list -}}
{{- range $plugin := $plugins -}}
{{-   $renderedPlugins = append $renderedPlugins $plugin -}}
{{- end -}}
{{- /* ── Built-in agents ── */ -}}
{{- $builtinAgentCategories := dict
  "build" "medium"
  "plan" "big"
  "general" "medium"
  "explore" "small"
  "scout" "small"
-}}
{{- $builtinAgentModes := dict "build" "primary" "plan" "primary" "general" "subagent" "explore" "subagent" "scout" "subagent" -}}
{{- $agentOverrides := dict -}}
{{- range $agent := keys $builtinAgentCategories | sortAlpha -}}
{{-   $tier := index $builtinAgentCategories $agent -}}
{{-   $route := index $tiers $tier -}}
{{-   if not $route -}}
{{-     fail (printf "render-opencode-config: ai.tiers has no route for tier %q (mapped by agent %q)" $tier $agent) -}}
{{-   end -}}
{{-   $agentModelId := includeTemplate "base/ai/agents/opencode/render-opencode-model-id" (dict "route" $route "root" $root) -}}
{{-   $agentConfig := dict "model" $agentModelId "mode" (get $builtinAgentModes $agent | default "all") -}}
{{-   $thinking := get $route "thinking" | default "off" -}}
{{-   if ne $thinking "off" -}}
{{-     $_ := set $agentConfig "variant" $thinking -}}
{{-   end -}}
{{-   $_ := set $agentOverrides $agent $agentConfig -}}
{{- end -}}
{{- $disabledAgents := get $profileData "disabled_agents" | default list -}}
{{- range $agent := $disabledAgents -}}
{{-   $agentConfig := get $agentOverrides $agent | default dict -}}
{{-   $_ := set $agentConfig "disable" true -}}
{{-   $_ := set $agentOverrides $agent $agentConfig -}}
{{- end -}}
{{- /* ── Skills & instructions ── */ -}}
{{- $basePaths := index $opencode.skills "paths" | default list -}}
{{- $profilePaths := get $profileData "skills_paths" | default list -}}
{{- $skillsPaths := concat $basePaths $profilePaths | uniq -}}
{{- $baseInstructions := index $opencode.instructions "files" | default list -}}
{{- $instructionsFiles := $baseInstructions -}}
{{- if hasKey $profileData "instructions" -}}
{{-   $instructionsFiles = get $profileData "instructions" -}}
{{- end -}}

{{- /* ── Output ── */ -}}
{{- $hasFormatter := dig "formatter" true $s -}}
{{- $hasLsp := dig "lsp" true $s -}}
{{- $hasSnapshot := dig "snapshot" true $s -}}
{{- $autoupdate := dig "autoupdate" "notify" $s -}}
{{- $share := dig "share" "disabled" $s -}}
{{- $result := dict
  "$schema" "https://opencode.ai/config.json"
  "model" $modelId
  "small_model" $smallModelId
  "autoupdate" $autoupdate
  "share" $share
  "snapshot" $hasSnapshot
  "permission" $permission
  "compaction" $compaction
  "tool_output" $toolOutput
  "skills" (dict "paths" $skillsPaths)
  "instructions" $instructionsFiles
  "default_agent" (get $profileData "default_agent" | default "build")
-}}

{{- $_ := set $result "watcher" $watcher -}}
{{- $_ := set $result "attachment" $attachment -}}
{{- if $renderedPlugins -}}{{- $_ := set $result "plugin" $renderedPlugins -}}{{- end -}}
{{- $_ := set $result "agent" $agentOverrides -}}
{{- if $hasFormatter -}}{{- $_ := set $result "formatter" true -}}{{- end -}}
{{- if $hasLsp -}}{{- $_ := set $result "lsp" true -}}{{- end -}}

{{- $mcpServers := get $profileData "mcp_servers" | default dict -}}
{{- if ne (len $mcpServers) 0 -}}{{- $_ := set $result "mcp" $mcpServers -}}{{- end -}}

{{- if $providers -}}{{- $_ := set $result "provider" $providers -}}{{- end -}}

{{- /* JSONC header: routing lives in model/small_model; agent overrides select
      tier routes; permission, plugin, and mcp hold policy/integrations. */ -}}
// Generated by chezmoi. Edit layered data, not this file.
// model/small_model: default routing; agent: persona overrides.
// permission: tool/path policy; plugin/mcp: integrations.
{{ $result | toPrettyJson }}
