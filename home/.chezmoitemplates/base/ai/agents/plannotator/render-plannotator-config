{{- /* render-plannotator-config — Full Plannotator JSON config.
  Args:
    root:          template data root
    agent:         agent name ("pi") — used to locate profile plannotator settings
    profile:       profile name (default "core")
    platform_note: extra instruction line for planning prompt (default "")
*/ -}}
{{- $root := .root -}}
{{- $agent := .agent -}}
{{- $profile := dig "profile" "core" . -}}
{{- $platformNote := dig "platform_note" "" . -}}

{{- /* Model routing from tiers */ -}}
{{- $tiers := includeTemplate "base/ai/models/load-default-tiers" (dict "root" $root "required" true) | mustFromJson -}}
{{- if not (hasKey $tiers "default") -}}{{- fail "ai.models.tiers has no 'default' key" -}}{{- end -}}
{{- $agentSection := printf "ai.agents.%s" $agent -}}
{{- $agentData := includeTemplate "base/helpers/load-section" (dict "root" $root "section" $agentSection "required" true) | mustFromJson -}}
{{- $defaults := index $tiers $tiers.default -}}

{{- /* Read plannotator config from resolved profile */ -}}
{{- $resolved := includeTemplate "base/ai/agents/resolve-profile" (dict "agentData" $agentData "profile" $profile) | mustFromJson -}}
{{- $cfg := get $resolved "plannotator" | default dict -}}
{{- $planDir := get $cfg "plan_dir" | default ".plannotator/" | trimSuffix "/" | printf "%s/" -}}
{{- $planOnly := get $cfg "plan_only" | default false -}}

{{- $planningCat := get $cfg "planning" | default "big" -}}
{{- $executingCat := get $cfg "executing" | default "medium" -}}
{{- $planningRoute := get $tiers $planningCat -}}
{{- if not $planningRoute -}}
{{-   fail (printf "render-plannotator-config: planning tier %q not found in ai.models.tiers" $planningCat) -}}
{{- end -}}
{{- $executingRoute := get $tiers $executingCat -}}
{{- if not $executingRoute -}}
{{-   fail (printf "render-plannotator-config: executing tier %q not found in ai.models.tiers" $executingCat) -}}
{{- end -}}

{{- /* Phase prompts (shared across agents) */ -}}
{{- $planningPrompt := includeTemplate "base/ai/agents/plannotator/render-plannotator-prompts" (dict "phase" "planning" "platform_note" $platformNote "plan_dir" $planDir "plan_only" $planOnly) -}}
{{- $executingPrompt := includeTemplate "base/ai/agents/plannotator/render-plannotator-prompts" (dict "phase" "executing" "plan_dir" $planDir "plan_only" $planOnly) -}}
{{- $reviewingPrompt := includeTemplate "base/ai/agents/plannotator/render-plannotator-prompts" (dict "phase" "reviewing") -}}

{{- /* Planning-phase active tools */ -}}
{{- $planningTools := list "read" "fffind" "ffgrep" "grep" "find" "ls" "nu" "module_report" "read_symbol" "read_enclosing" "lsp_navigation" "lsp_diagnostics" "lens_diagnostics" "ast_grep_search" "ast_grep_outline" "ast_grep_dump" "web_search" "web_fetch" "ask_user_question" "advisor" "todo" "mem_search" "session_search" "context_checkpoint" "context_timeline" "context_compact" "bash" "write" "edit" "plannotator_submit_plan" -}}

{{- dict
  "defaults" (dict
    "model" (dict "provider" $defaults.provider "id" $defaults.model)
    "thinking" $defaults.thinking
  )
  "phases" (dict
    "planning" (dict
      "model" (dict "provider" ($planningRoute.provider | default $defaults.provider) "id" ($planningRoute.model | default $defaults.model))
      "thinking" ($planningRoute.thinking | default $defaults.thinking)
      "activeTools" $planningTools
      "systemPrompt" $planningPrompt
      "statusLabel" "⏸ plan"
    )
    "executing" (dict
      "model" (dict "provider" ($executingRoute.provider | default $defaults.provider) "id" ($executingRoute.model | default $defaults.model))
      "thinking" ($executingRoute.thinking | default $defaults.thinking)
      "systemPrompt" $executingPrompt
      "statusLabel" "▶ execute"
    )
    "reviewing" (dict
      "systemPrompt" $reviewingPrompt
      "statusLabel" "↻ review"
    )
  )
| toPrettyJson -}}
