{{- $repo := .repo -}}
{{- $memo := .memo | default dict -}}
{{- $target := .target -}}
{{- $prefix := .prefix | default "" -}}
{{- $files := .files | default list -}}
{{- $label := get . "label" | default "library archive" -}}
{{- if not $prefix -}}{{- fail (printf "%s: prefix is required" $label) -}}{{- end -}}
{{- if eq (len $files) 0 -}}{{- fail (printf "%s: files is required" $label) -}}{{- end -}}
{{- $includes := list -}}
{{- range $file := $files -}}
{{-   if not (kindIs "string" $file) -}}{{- fail (printf "%s: files must contain strings" $label) -}}{{- end -}}
{{-   $includes = append $includes (printf "*/%s/%s" $prefix $file) -}}
{{- end -}}
{{ includeTemplate "base/github/external" (dict
    "type" "archive"
    "memo" $memo
    "target" $target
    "repo" $repo
    "stripComponents" (add (len (splitList "/" $prefix)) 1)
    "include" $includes
    "tagPrefix" (get . "tagPrefix" | default "")
    "exact" true) }}
