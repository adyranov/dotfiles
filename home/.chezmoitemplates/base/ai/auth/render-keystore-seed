{{- /* base/ai/auth/render-keystore-seed — One seed body rendered twice:
  the apply script (missing-only) and the seed-keystore command (adds an
  overwrite-one mode). Seeding lives here because neither the launcher nor
  the agent may write the store: the launcher only names this remedy.
  Usage: {{ includeTemplate "base/ai/auth/render-keystore-seed" (dict "root" . "mode" "apply") }}
  Entry set: the gap names (env_injected keys — launcher-exported, so they
  must exist in the store) plus every route whose credential_key is a bare
  keystore account name. Rows with a URI scheme (apple-password/keyring/cmd)
  are delegated to the client's own store and never seeded; rows still on the
  env:// default have no store entry to seed yet.
  Store gate: macOS only until the WSL2/Linux leg provisions a Secret Service;
  any other host renders a no-op (an interactive apply must never prompt for
  tokens a host cannot store). Non-interactive apply renders a no-op too.
  Token discipline: values reach the store through the store tool's own tty
  prompt — never argv, never shell history, never output. The access grant is
  -T to the nono binary specifically; -A (keychain-wide promptless) needs
  explicit user approval and is deliberately not emitted here. */ -}}
{{- $root := index . "root" -}}
{{- $mode := index . "mode" | default "apply" -}}
{{- $os := dig "os" $root.chezmoi.os $root -}}
{{- $interactive := dig "host" "interactive" false $root -}}
{{- if ne $os "darwin" }}
# Keystore seeding is not provisioned on this host yet (macOS ships first).
exit 0
{{- else if and (eq $mode "apply") (not $interactive) }}
# Non-interactive apply: seeding prompts on a tty only.
exit 0
{{- else }}
{{-   $creds := includeTemplate "base/ai/auth/render-credentials" $root | mustFromJson -}}
{{-   $entries := list -}}
{{-   $entries = concat $entries (keys ($creds.env_injected | default dict) | sortAlpha) -}}
{{-   range $row := ($creds.routes | default list) -}}
{{-     $ck := index $row "credential_key" | default "" -}}
{{-     if and $ck (not (contains "://" $ck)) -}}{{- $entries = append $entries $ck -}}{{- end -}}
{{-   end -}}
{{-   $entries = $entries | uniq | sortAlpha -}}
# Seed nono's keystore entries (service "nono") that this host's profile
# resolves from the store. Missing entries only; stored values are never
# re-prompted or rewritten unless named explicitly.
seed_entries="{{ $entries | join " " }}"

nono_bin="$(mise which nono 2>/dev/null || command -v nono || true)"
if [ -z "$nono_bin" ]; then
  echo "❌ nono not found on PATH — the seed grant targets the nono binary." >&2
  exit 1
fi

if ! security show-keychain-info >/dev/null 2>&1; then
  echo "🔒 Login keychain is locked; unlock it, then run this again:" >&2
  echo "   security unlock-keychain" >&2
{{- if eq $mode "command" }}
  exit 1
{{- else }}
  # apply does not fail on a locked store: the launcher probe is the
  # enforcement surface (its banner names this same remedy at launch).
  exit 0
{{- end }}
fi

seed_one() { # name overwrite(true|false) — value read by security's own prompt
  if [ "$2" != true ] && security find-generic-password -s nono -a "$1" -w >/dev/null 2>&1; then
    return 0
  fi
  echo "🔑 Seeding $1 (value prompt follows; it is read on the tty, never argv)"
  if security add-generic-password -s nono -a "$1" -T "$nono_bin" -U -w; then
    echo "✅ Seeded $1"
  else
    echo "❌ Could not seed $1" >&2
  fi
}

seed_missing() {
  for __name in $seed_entries; do
    seed_one "$__name" false
  done
}
{{- if eq $mode "command" }}

case "${1:-}" in
"")
  seed_missing
  ;;
*)
  __want=""
  for __name in $seed_entries; do
    [ "$__name" = "$1" ] && __want="$1"
  done
  if [ -z "$__want" ]; then
    echo "usage: seed-keystore [NAME]" >&2
    echo "known entries: $seed_entries" >&2
    exit 1
  fi
  seed_one "$__want" true
  ;;
esac
{{- else }}

seed_missing
{{- end }}
{{- end }}
