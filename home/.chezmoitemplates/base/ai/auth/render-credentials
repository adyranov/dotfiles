{{- /* render-credentials — Derive the credential policy the sandbox renders.
  Usage (direct root): {{ includeTemplate "base/ai/auth/render-credentials" . | mustFromJson }}
  Usage (wrapper):     {{ includeTemplate "base/ai/auth/render-credentials" (dict "root" . "agent" "omp") | mustFromJson }}
  Output: JSON { inject, secrets, ignore, routes, env_injected, routes_enabled }
    secrets = unique(base secrets + enabled provider keys) - env_injected - ignore
    inject  = env_injected (gap-set alias); routes = validated rows, sorted,
    endpoint_rules resolved from the group, credential_key default env://<name>.
  The scrub is computed first, so no render produces routes without the scrub.
  agent=omp scrubs the full derived set and emits no routes and no gap delivery.
  Validation fails the render naming the row: outside the derived set, in both
  routes and env_injected, non-https upstream, invalid custom_name, unknown
  endpoint_group, attach outside session/command.
*/ -}}
{{- /* Normalize root — accept both direct . and wrapper {root, …} */ -}}
{{- $root := dig "root" . . -}}
{{- $agent := dig "agent" "" . -}}
{{- $credentials := (includeTemplate "base/helpers/load-section" (dict "root" $root "section" "ai.credentials" "required" false) | mustFromJson) -}}
{{- $resolved := includeTemplate "base/ai/auth/resolve-enabled-auth-providers" (dict "root" $root) | mustFromJson -}}
{{- $derived := concat ($credentials.secrets | default list) ($resolved.enabled_api_key_envs | default list) | uniq | sortAlpha -}}
{{- $ignore := $credentials.ignore | default list | uniq | sortAlpha -}}
{{- $gap := ($credentials.env_injected | default dict) | keys | sortAlpha -}}
{{- range $g := $gap -}}
{{-   if not (has $g $derived) -}}{{-   fail (printf "env_injected name %s is not in the derived secret set" $g) -}}{{-   end -}}
{{- end -}}
{{- if eq $agent "omp" -}}
{{-   dict "inject" list "secrets" $derived "ignore" $ignore "routes" list "env_injected" dict "routes_enabled" false | toJson -}}
{{- else -}}
{{-   $policies := $credentials.endpoint_policies | default dict -}}
{{-   $routesData := $credentials.routes | default dict -}}
{{-   $routes := list -}}
{{-   range $name := keys $routesData | sortAlpha -}}
{{-     $row := index $routesData $name -}}
{{-     if not (has $name $derived) -}}{{-     fail (printf "credential route %s is not in the derived secret set" $name) -}}{{-     end -}}
{{-     if has $name $gap -}}{{-     fail (printf "credential route %s is also in env_injected: a name is routed or env-delivered, never both" $name) -}}{{-     end -}}
{{-     $upstream := index $row "upstream" | default "" -}}
{{-     if not (hasPrefix "https://" $upstream) -}}{{-     fail (printf "credential route %s upstream must be https: %s" $name $upstream) -}}{{-     end -}}
{{-     $attach := index $row "attach" | default "session" -}}
{{-     if not (has $attach (list "session" "command")) -}}{{-     fail (printf "credential route %s attach must be session or command: %s" $name $attach) -}}{{-     end -}}
{{-     if and (eq $attach "command") (not (index $row "command" | default "")) -}}{{-     fail (printf "credential route %s is command-attached with no command" $name) -}}{{-     end -}}
{{-     $custom := index $row "custom_name" | default "" -}}
{{-     if and $custom (not (regexMatch "^[a-z0-9_]+$" $custom)) -}}{{-     fail (printf "credential route %s custom_name %s must be lowercase letters, digits, underscores" $name $custom) -}}{{-     end -}}
{{-     $group := index $row "endpoint_group" | default "" -}}
{{-     $rules := list -}}
{{-     if $group -}}
{{-       $globs := index $policies $group | default list -}}
{{-       if not $globs -}}{{-       fail (printf "credential route %s names unknown endpoint_group %s" $name $group) -}}{{-       end -}}
{{-       range $g := $globs -}}
{{-         $parts := splitList ":" $g -}}
{{-         if lt (len $parts) 2 -}}{{-         fail (printf "credential route %s endpoint_group %s entry is not METHOD:PATH: %s" $name $group $g) -}}{{-         end -}}
{{-         $rules = append $rules (dict "method" (index $parts 0) "path" (join ":" (rest $parts))) -}}
{{-       end -}}
{{-     end -}}
{{-     $routes = append $routes (merge (dict "name" $name "credential_key" (printf "env://%s" $name) "endpoint_rules" $rules) $row) -}}
{{-   end -}}
{{-   $secrets := list -}}
{{-   range $s := $derived -}}
{{-     if and (not (has $s $gap)) (not (has $s $ignore)) -}}{{-     $secrets = append $secrets $s -}}{{-     end -}}
{{-   end -}}
{{-   dict
      "inject" $gap
      "secrets" ($secrets | sortAlpha)
      "ignore" $ignore
      "routes" $routes
      "env_injected" ($credentials.env_injected | default dict)
      "routes_enabled" ($credentials.routes_enabled | default false)
  | toJson -}}
{{- end -}}
