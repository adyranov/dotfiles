{{- /* base/headers/script — unified shebang + strict mode.
  Args (dict):
    root    — template data root (required)
    exports — bool (default true): when true, source ~/.config/shell/exports.sh
*/ -}}
{{- $exports := true -}}
{{- if hasKey . "exports" -}}{{- $exports = .exports -}}{{- end -}}
#!/usr/bin/env bash
set -euo pipefail

{{ if $exports -}}
if [ -f "$HOME/.config/shell/exports.sh" ]; then
  # shellcheck disable=SC1091
  . "$HOME/.config/shell/exports.sh"
fi
{{ end -}}
