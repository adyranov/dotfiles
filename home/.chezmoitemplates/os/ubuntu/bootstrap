
app_apt_repo() {
  local name="$1"
  local key_url="$2"
  local repo_line="$3"
  local keyring_path="${4:-}"
  local list_file="/etc/apt/sources.list.d/${name}.list"
  local key_file="${keyring_path:-/etc/apt/trusted.gpg.d/${name}.gpg}"

  sudo install -d -m 0755 "$(dirname "$key_file")"

  if [ ! -s "$key_file" ]; then
    echo "🔑 Importing signing key for ${name}"
    local raw_tmp dearmored_tmp
    raw_tmp="$(mktemp)"
    dearmored_tmp="$(mktemp)"
    curl -fsSL "$key_url" -o "$raw_tmp"
    if grep -q "BEGIN PGP PUBLIC KEY BLOCK" "$raw_tmp"; then
      gpg --dearmor <"$raw_tmp" >"$dearmored_tmp"
      sudo install -m 0644 "$dearmored_tmp" "$key_file"
    else
      sudo install -m 0644 "$raw_tmp" "$key_file"
    fi
    rm -f "$raw_tmp" "$dearmored_tmp"
  else
    echo "✅ Signing key already present for ${name}, skipping"
  fi

  if [ ! -f "$list_file" ] || ! grep -Fx "$repo_line" "$list_file" >/dev/null 2>&1; then
    echo "➕ Configuring APT repository: ${name}"
    printf '%s\n' "$repo_line" | sudo tee "$list_file" >/dev/null
  else
    echo "✅ APT repository ${name} already configured, skipping"
  fi
}

{{- $repos := .repositories.ubuntu -}}
{{- range $toolchain, $toolchainRepos := $repos }}
{{- $enabled := or (eq $toolchain "core") (index $.toolchains $toolchain) -}}
{{- if $enabled }}
{{- range $name, $repo := $toolchainRepos }}
{{- $keyring := "" -}}
{{- if hasKey $repo "keyring_path" }}{{- $keyring = index $repo "keyring_path" }}{{- end }}
app_apt_repo "{{ $name }}" "{{ $repo.key_url }}" "{{ $repo.repo_line }}" {{ quote $keyring }}
{{- end }}
{{- end }}
{{- end }}
