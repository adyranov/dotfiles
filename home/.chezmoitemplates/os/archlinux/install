
echo "🛠️ Updating pacman DB and installing packages…"
{{- $pkgs := includeTemplate "base/packages/collect-packages" (dict "root" . "manager" "system" "format" "install") }}
sudo pacman -Syu --noconfirm --needed {{ $pkgs }} || sudo pacman -Syyu --noconfirm --needed {{ $pkgs }}
echo "✅ pacman packages ensured."
