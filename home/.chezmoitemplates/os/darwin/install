{{- $macportsEnabled := and (eq .host.distro.family "darwin") (eq .host.arch "amd64") -}}
{{- $macportsPath := "/opt/local" -}}
{{- if $macportsEnabled }}
{{- $ports := includeTemplate "base/packages/collect-packages" (dict "root" . "manager" "macports" "format" "install") | trim -}}
{{- if $ports }}

echo "📦 Ensuring MacPorts packages…"
export PATH="{{ $macportsPath }}/bin:{{ $macportsPath }}/sbin:${PATH}"
if [ ! -x {{ $macportsPath }}/bin/port ]; then
  echo "❌ MacPorts is required for: {{ $ports }}" >&2
  echo "   Install MacPorts on this Intel host before running the MacPorts install step." >&2
  exit 1
fi
{{- if .host.restricted }}
if ! sudo -n true 2>/dev/null; then
  echo "❌ Restricted host cannot elevate; preinstall MacPorts packages: $ports" >&2
  exit 1
fi
{{- else }}
{{- includeTemplate "base/helpers/sudo-keep-alive" . }}
{{- end }}
if ! sudo {{ $macportsPath }}/bin/port -N install {{ $ports }}; then
  # An upstream build breakage in one port's dependency chain (e.g. the pandoc/GHC
  # class) must not block apply forever while the requested ports stay active;
  # a port missing at every version stays fatal.
  _ports_missing=""
  _active_ports="$(sudo {{ $macportsPath }}/bin/port -q echo active 2>/dev/null | awk '{print $1}')"
  for _port in {{ $ports }}; do
    # "openssh +fido2" style entries: variants are not port names.
    case "${_port}" in +*) continue;; esac
    _port="${_port%%+*}"
    if ! printf '%s\n' "${_active_ports}" | grep -Fxq "${_port}"; then
      _ports_missing="${_ports_missing} ${_port}"
    fi
  done
  if [ -n "${_ports_missing}" ]; then
    echo "❌ MacPorts packages are not active and cannot be installed:${_ports_missing}" >&2
    exit 1
  fi
  echo "⚠️ MacPorts could not refresh some ports (upstream build breakage?); active versions remain."
fi
echo "✅ MacPorts packages applied."
{{- end }}
{{- end }}
echo "📦 Ensuring Homebrew bundle packages…"
export HOMEBREW_NO_ASK=1
brew bundle --no-upgrade --verbose --file=/dev/stdin <<EOF
{{ includeTemplate "os/darwin/brewfile" . }}
EOF
echo "✅ Homebrew bundle applied."
